+static void bc_color_block(const u8* b, u8 rgba[16][4], int four_always)
+{
+    const u32 c0 = (u32)b[0] | ((u32)b[1] << 8), c1 = (u32)b[2] | ((u32)b[3] << 8);
+    u8 pal[4][4];
+    for (int k = 0; k < 2; k++) {
+        const u32 c = k ? c1 : c0;
+        const u32 r = (c >> 11) & 31u, g = (c >> 5) & 63u, bl = c & 31u;
+        pal[k][0] = (u8)((r << 3) | (r >> 2)); pal[k][1] = (u8)((g << 2) | (g >> 4));
+        pal[k][2] = (u8)((bl << 3) | (bl >> 2)); pal[k][3] = 255;
+    }
+    for (int ch = 0; ch < 3; ch++) {
+        if (four_always || c0 > c1) {
+            pal[2][ch] = (u8)((2u * pal[0][ch] + pal[1][ch]) / 3u);
+            pal[3][ch] = (u8)((pal[0][ch] + 2u * pal[1][ch]) / 3u);
+        } else {
+            pal[2][ch] = (u8)((pal[0][ch] + pal[1][ch]) / 2u);
+            pal[3][ch] = 0;
+        }
+    }
+    pal[2][3] = 255; pal[3][3] = (four_always || c0 > c1) ? 255 : 0;
+    const u32 idx = (u32)b[4] | ((u32)b[5] << 8) | ((u32)b[6] << 16) | ((u32)b[7] << 24);
+    for (int p = 0; p < 16; p++) memcpy(rgba[p], pal[(idx >> (2 * p)) & 3u], 4);
+}
+
+/* src: block rows src_row bytes apart; dst: RGBA8 rows dst_pitch apart. */
+static void bc_decode_rgba(u8* dst, u32 dst_pitch, const u8* src, u32 w, u32 h,
+                           u32 src_row, rsx_texfmt kind)
+{
+    const u32 bs = (kind == RSX_TEXFMT_BC1) ? 8u : 16u;
+    for (u32 by = 0; by < (h + 3u) / 4u; by++) {
+        for (u32 bx = 0; bx < (w + 3u) / 4u; bx++) {
+            const u8* b = src + (u64)by * src_row + (u64)bx * bs;
+            u8 px[16][4];
+            if (kind == RSX_TEXFMT_BC1) {
+                bc_color_block(b, px, 0);
+            } else {
+                bc_color_block(b + 8, px, 1);
+                if (kind == RSX_TEXFMT_BC2) {
+                    for (int p = 0; p < 16; p++) {
+                        const u32 a4 = (b[p >> 1] >> ((p & 1) * 4)) & 15u;
+                        px[p][3] = (u8)(a4 * 17u);
+                    }
+                } else {
+                    const u32 a0 = b[0], a1 = b[1];
+                    u8 ap[8]; ap[0] = (u8)a0; ap[1] = (u8)a1;
+                    if (a0 > a1) for (u32 k = 1; k < 7; k++) ap[k + 1] = (u8)(((7u - k) * a0 + k * a1) / 7u);
+                    else { for (u32 k = 1; k < 5; k++) ap[k + 1] = (u8)(((5u - k) * a0 + k * a1) / 5u);
+                           ap[6] = 0; ap[7] = 255; }
+                    u64 bits = 0;
+                    for (int k = 0; k < 6; k++) bits |= (u64)b[2 + k] << (8 * k);
+                    for (int p = 0; p < 16; p++) px[p][3] = ap[(bits >> (3 * p)) & 7u];
+                }
+            }
+            for (u32 py = 0; py < 4u; py++) {
+                const u32 y = by * 4u + py;
+                if (y >= h) break;
+                u8* row = dst + (u64)y * dst_pitch;
+                for (u32 qx = 0; qx < 4u; qx++) {
+                    const u32 x = bx * 4u + qx;
+                    if (x >= w) break;
+                    memcpy(row + (u64)x * 4u, px[py * 4u + qx], 4);
+                }
+            }
+        }
+    }
+}
