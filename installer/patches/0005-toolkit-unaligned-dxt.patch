+/* Block-compressed (DXT1/23/45) textures whose width or height is not a
+ * multiple of 4 can't be created as BC resources on Windows 10's D3D12 runtime
+ * (CreateCommittedResource fails, message 597; Windows 11 allows them). A
+ * tester on Windows 10 lost J-Stars' menu art and text that way
+ * (512x78 BC3 pieces). Those textures are decoded here to RGBA8 instead, on
+ * every machine, so all of them see the same image. BC_NATIVE=1 keeps them
+ * as BC (test only). */
+static int bc_cpu_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("BC_NATIVE"); on = (e && *e && *e != '0') ? 0 : 1; }
+    return on;
+}
