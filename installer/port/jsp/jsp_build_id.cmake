# ENHANCEMENT (rollback): the build id two players compare before a rollback match (Caps::build, the re-psn room record).
# It is made from the release content, not from the compile time: the installer builds the exe on each player's PC, so
# a time stamp gave two installs of the same release different ids and they refused each other. Inputs: the project
# version, the game region, the glue sources in this folder and the sources of the patched toolkit (its runtime/, libs/
# and include/, which carry the patches), each as relative path + bytes with CR-LF made LF, so a CR-LF checkout gives the
# same id. Build folders and generated files are never inputs. The lift recipe (installer/tools) is covered by the version.
#   jsp_build_id(<out var> <version> <region> <glue dir> <toolkit dir>)  sets <out var> to 0xXXXXXXXX (32 bits of a SHA-256)
# In a project (not cmake -P) every input file is a configure dependency, so a changed source (an update in place)
# re-runs CMake and the id follows; the build otherwise only re-runs CMake when CMakeLists.txt changes.
function(jsp_build_id out version region glue toolkit)
    set(acc "jsp-build-id 2\nversion ${version}\nregion ${region}\n")
    set(deps "")
    foreach(spec IN ITEMS "glue|${glue}|" "toolkit|${toolkit}|runtime/;libs/;include/")
        string(REPLACE "|" ";" parts "${spec}")
        list(GET parts 0 label)
        list(GET parts 1 dir)
        list(LENGTH parts n)
        set(subs "")
        if(n GREATER 2)
            list(SUBLIST parts 2 -1 subs)
        endif()
        if(NOT subs)
            set(subs "")
            set(globs "${dir}/*.c" "${dir}/*.cpp" "${dir}/*.h" "${dir}/*.hpp" "${dir}/*.inc" "${dir}/*.json" "${dir}/*.py"
                      "${dir}/CMakeLists.txt" "${dir}/*.cmake")
        else()
            set(globs "")
            foreach(s IN LISTS subs)
                list(APPEND globs "${dir}/${s}*.c" "${dir}/${s}*.cpp" "${dir}/${s}*.h" "${dir}/${s}*.hpp" "${dir}/${s}*.inc")
            endforeach()
        endif()
        file(GLOB_RECURSE files RELATIVE "${dir}" LIST_DIRECTORIES false ${globs})
        list(FILTER files EXCLUDE REGEX "(^|/)CMakeFiles/|(^|/)__pycache__/|^build(-[^/]*)?/")
        list(SORT files)
        foreach(f IN LISTS files)
            file(READ "${dir}/${f}" text)
            string(REPLACE "\r\n" "\n" text "${text}")
            string(SHA256 h "${text}")
            string(APPEND acc "${label} ${f} ${h}\n")
            list(APPEND deps "${dir}/${f}")
        endforeach()
    endforeach()
    string(SHA256 all "${acc}")
    string(SUBSTRING "${all}" 0 8 id)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${deps})
    endif()
    set(${out} "0x${id}" PARENT_SCOPE)
endfunction()
