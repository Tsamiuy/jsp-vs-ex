+/* Small colour targets the CPU reads back (@0x0055C5A4 reads the 20x11
+ * average-luminance surface the post chain writes into main memory; the v0.15
+ * v0.15 finding "luminance target never read back", color-exposure notes).
+ * current_rt_off() notes every non-display surface drawn to with its guest
+ * clip, pitch and context DMA; render_frame() copies the ones that live in main
+ * memory and are small back to guest memory after the batch. */
+typedef struct { u32 off, cw, ch, pitch, dma; int touched; } RtReadNote;
+#define RT_READ_NOTES 24
+static RtReadNote s_rtread_notes[RT_READ_NOTES];
+static void rtread_note(u32 off, const rsx_state* st)
+{
+    if (!off || !st) return;
+    int free_i = -1;
+    for (int i = 0; i < RT_READ_NOTES; i++) {
+        if (s_rtread_notes[i].off == off) { free_i = i; break; }
+        if (free_i < 0 && !s_rtread_notes[i].off) free_i = i;
+    }
+    if (free_i < 0) return;
+    RtReadNote* n = &s_rtread_notes[free_i];
+    n->off = off; n->cw = st->surface_clip_w; n->ch = st->surface_clip_h;
+    n->pitch = st->surface_color_pitch[0]; n->dma = st->dma_color[0]; n->touched = 1;
+}
+
 /* Which offscreen surface (if any) does the current RSX state render to?
  * Returns 0 for a display buffer (backbuffer), else the surface's RAW RSX
  * offset. RTs are keyed by raw offset -- a texture bound at the same raw
@@ -3849,6 +3872,7 @@ static u32 current_rt_off(u32* out_w, u32* out_h, u32 out_mrt[3])
     if (w < 16 || w > 2048 || h < 16 || h > 2048) { w = 0; h = 0; }
     if (out_w) *out_w = w;
     if (out_h) *out_h = h;
+    if (sel == 0) rtread_note(raw, st);
     return raw;
 }
 
