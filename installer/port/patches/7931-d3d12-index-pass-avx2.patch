Patch 7931: the first pass over 16-bit indices runs 16 at a time with AVX2 (IX_AVX2, on by default).

upload_vpull's pass 1 (byte swap, widen to 32 bits, store, running min / max; with a restart index the restarts become
VPULL_NO, are counted and left out of the range) for 16 indices at a time; the scalar loops still do the tail. Same
results. The build already needs AVX2 (JSP_AVX2). IX_AVX2=0: the scalar loops only.
Measured: replays 2 Players 3v3 walk -1.0 to -1.6 ms, bit-exact; real fights 2 Players 3v3 24.1 -> 25.9 flips/s with
7929 and 7930 on.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 92e8db6..b56eaf8 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -11602,6 +11602,47 @@ static inline void vg_copy(u8* d, const u8* s, u32 n)
     default: memcpy(d, s, n); return;
     }
 }
+/* IX_AVX2 (=0 off): pass 1 below for 16-bit indices, 16 at a time. Returns the restarts. */
+#include <immintrin.h>
+static int ix_avx2_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("IX_AVX2"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+__attribute__((target("avx2"))) static u32 ix16_avx2(const u8* p16, u32 n, u32* raw, u32 rix, int restart,
+                                                     u32* pvmin, u32* pvmax, u32* done)
+{
+    const __m256i bs = _mm256_setr_epi8(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14,
+                                        1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14);
+    const __m256i ones = _mm256_set1_epi32(-1), zero = _mm256_setzero_si256(), vr = _mm256_set1_epi32((int)rix);
+    __m256i vmn = _mm256_set1_epi32(-1), vmx = _mm256_setzero_si256();
+    u32 k = 0, nr = 0;
+    for (; k + 16u <= n; k += 16u) {
+        __m256i w = _mm256_loadu_si256((const __m256i*)(p16 + 2u * k));
+        w = _mm256_shuffle_epi8(w, bs);
+        __m256i a = _mm256_cvtepu16_epi32(_mm256_castsi256_si128(w));
+        __m256i c = _mm256_cvtepu16_epi32(_mm256_extracti128_si256(w, 1));
+        if (restart) {
+            const __m256i ma = _mm256_cmpeq_epi32(a, vr), mc = _mm256_cmpeq_epi32(c, vr);
+            nr += (u32)__builtin_popcount((unsigned)_mm256_movemask_ps(_mm256_castsi256_ps(ma)))
+                + (u32)__builtin_popcount((unsigned)_mm256_movemask_ps(_mm256_castsi256_ps(mc)));
+            vmn = _mm256_min_epu32(vmn, _mm256_blendv_epi8(a, ones, ma)); vmn = _mm256_min_epu32(vmn, _mm256_blendv_epi8(c, ones, mc));
+            vmx = _mm256_max_epu32(vmx, _mm256_blendv_epi8(a, zero, ma)); vmx = _mm256_max_epu32(vmx, _mm256_blendv_epi8(c, zero, mc));
+            a = _mm256_blendv_epi8(a, ones, ma); c = _mm256_blendv_epi8(c, ones, mc);   /* VPULL_NO = 0xFFFFFFFF */
+        } else {
+            vmn = _mm256_min_epu32(vmn, _mm256_min_epu32(a, c));
+            vmx = _mm256_max_epu32(vmx, _mm256_max_epu32(a, c));
+        }
+        _mm256_storeu_si256((__m256i*)(raw + k), a);
+        _mm256_storeu_si256((__m256i*)(raw + k + 8u), c);
+    }
+    u32 t[8]; u32 mn = *pvmin, mx = *pvmax;
+    _mm256_storeu_si256((__m256i*)t, vmn); for (int i = 0; i < 8; i++) if (t[i] < mn) mn = t[i];
+    _mm256_storeu_si256((__m256i*)t, vmx); for (int i = 0; i < 8; i++) if (t[i] > mx) mx = t[i];
+    *pvmin = mn; *pvmax = mx; *done = k;
+    return nr;
+}
