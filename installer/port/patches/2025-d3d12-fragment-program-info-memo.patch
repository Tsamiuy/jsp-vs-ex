+
+/* ------------------------------------------------------------------------- */
+/* Patch 2025: memo for the per-draw fragment-program facts (size, code hash, sampled texture units). Each of those is a walk of the program (three walks
+ * per draw). The result depends only on the instruction slots, not on the inline constant slots the game re-patches per frame, so a memo entry keeps a copy
+ * of the program bytes and a per-slot skip mask: a slot is skipped in the comparison only if all three walks treat it as a constant slot. A hit compares the
+ * remaining 16-byte slots (exact: identical instruction slots give identical walks). Programs over FP_MEMO_MAX bytes or without END are not memoised.
+ * Switch: SHADER_HASH_MEMO=0 turns it off (the three walks run as before). Idea credited to the owner's v0.15 SHADER_HASH_MEMO. */
+#define FP_MEMO_MAX   1024u
+#define FP_MEMO_SLOTS (FP_MEMO_MAX / 16u)
+#define FP_MEMO_SETS  1024u    /* 4-way: 4096 entries (about 4.6 MB) */
+#define FP_MEMO_WAYS  4u
+typedef struct {
+    u32 size, hash, units, nslots;
+    u8 skip[FP_MEMO_SLOTS]; u8 code[FP_MEMO_MAX];
+} FpMemo;
+static FpMemo s_fp_memo[FP_MEMO_SETS * FP_MEMO_WAYS];
+static u8 s_fp_memo_rr[FP_MEMO_SETS];
+unsigned long long g_rsx_fp_memo_hit, g_rsx_fp_memo_miss;
+
+static int fp_memo_enabled(void)
+{
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("SHADER_HASH_MEMO"); en = (e && e[0] == '0') ? 0 : 1; }
+    return en;
+}
+
+/* Fills skip[] and returns the slot count, or 0 when the program is not memoisable. */
+static u32 fp_memo_layout(const u8* uc, u8* skip)
+{
+    u8 c[3][FP_MEMO_SLOTS]; u32 end[3] = {0, 0, 0};
+    for (int w = 0; w < 3; w++) {
+        u32 off = 0, slot = 0; memset(c[w], 0, FP_MEMO_SLOTS);
+        for (;;) {
+            if (slot >= FP_MEMO_SLOTS) return 0;       /* too long (or no END within the limit) */
+            const u32 w0 = rsx_fp_read_word(uc + off), w1 = rsx_fp_read_word(uc + off + 4);
+            const u32 w2 = rsx_fp_read_word(uc + off + 8), w3 = rsx_fp_read_word(uc + off + 12);
+            off += 16; slot++;
+            int k;
+            if (w == 0)      k = (((w1 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST ||
+                                  ((w2 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST ||
+                                  ((w3 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST);   /* size walk: branch too */
+            else if (w == 1) k = !(w2 & FP_BRANCH) && fp_instruction_has_constant(w1, w2, w3);              /* hash walk */
+            else             k = !(w2 & FP_BRANCH) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2); /* texture-unit walk */
+            if (k) { if (slot >= FP_MEMO_SLOTS) return 0; c[w][slot] = 1; off += 16; slot++; }
+            if (w0 & FP_END) break;
+        }
+        end[w] = slot;
+    }
+    u32 n = end[0] > end[1] ? end[0] : end[1]; if (end[2] > n) n = end[2];
+    for (u32 i = 0; i < n; i++)
+        skip[i] = (u8)(((i >= end[0]) || c[0][i]) && ((i >= end[1]) || c[1][i]) && ((i >= end[2]) || c[2][i]));
+    return n;
+}
+
+/* size/hash/units of the program at ucode (max_bytes 0x10000 as the backend passes). Returns 1 if the memo answered. */
+int rsx_fp_info_memo(const u8* ucode, u32* size, u32* hash, u32* units)
+{
+    if (!ucode || !fp_memo_enabled()) return 0;
+    /* Keyed on the program's first instruction slot (never a constant slot) and not on its address: the game rewrites programs into a ring, so the same
+     * program shows up at different addresses. The comparison below covers that slot too, so a shared key is only a hash collision. */
+    u32 kh = 2166136261u;
+    for (int i = 0; i < 16; i++) { kh ^= ucode[i]; kh *= 16777619u; }
+    const u32 set = (kh ^ (kh >> 15)) % FP_MEMO_SETS;
+    FpMemo* ways = &s_fp_memo[set * FP_MEMO_WAYS];
+    for (u32 w = 0; w < FP_MEMO_WAYS; w++) {
+        FpMemo* m = &ways[w];
+        if (!m->nslots) continue;
+        u32 i = 0;
+        for (; i < m->nslots; i++)
+            if (!m->skip[i] && memcmp(ucode + i * 16u, m->code + i * 16u, 16)) break;
+        if (i == m->nslots) { g_rsx_fp_memo_hit++; *size = m->size; *hash = m->hash; *units = m->units; return 1; }
+    }
+    g_rsx_fp_memo_miss++;
+    *size = rsx_fp_program_size(ucode, 0x10000);
+    *hash = rsx_fp_code_hash(ucode, 0x10000);
+    *units = rsx_fp_texture_units(ucode, 0x10000);
+    if (!*size) return 1;
+    u8 skip[FP_MEMO_SLOTS]; u32 n = fp_memo_layout(ucode, skip);
+    if (!n) return 1;
+    FpMemo* m = &ways[s_fp_memo_rr[set]++ % FP_MEMO_WAYS];
+    m->size = *size; m->hash = *hash; m->units = *units; m->nslots = n;
+    memcpy(m->skip, skip, n); memcpy(m->code, ucode, n * 16u);
+    return 1;
+}
