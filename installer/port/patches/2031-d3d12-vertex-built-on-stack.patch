Patch 2031: B32: build each vertex on the stack, then one copy to the write-combined upload heap; word-at-a-time FP code hash. Battle 15-20 -> 42-50 flips/s, 178 -> 22 ms per FIFO tick (boot209_wc vs boot208_prof)

Source: that port's toolkit f8971ed.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 11fc2af3..5ded4c5e 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -253,7 +253,7 @@ typedef struct {
     int nrt;                /* bound colour target count (PSO key)       */
     u32 rtfmt;              /* DXGI format of the colour targets (PSO key) */
     u32 ctrl;               /* SHADER_CONTROL export bits (PSO key)       */
-    u32 ucode_hash;         /* FNV-1a of the FP ucode: apps re-patch inline
+    u32 ucode_hash;         /* hash of the FP ucode: apps re-patch inline
                              * constants per frame (wave's stamp position/
                              * amplitude) -- address-only keying served the
                              * stale compile forever. */
@@ -7010,8 +7010,12 @@ static void read_vp_vertex_fast(const rsx_state* state, u32 vi, VPSlot* out16)
 {
     if (!s_vf.on) { read_vp_vertex(state, vi, out16); return; }
     if (s_vs_on > 0) s_vs.conv++;
-    memcpy(out16, s_vf.tmpl, sizeof s_vf.tmpl);
-    for (int k = 0; k < s_vf.n; k++) rsx_fetch_attrib(state, s_vf.idx[k], vi, out16[s_vf.idx[k]].v);
+    /* Built on the stack: out16 is the upload heap (write-combined), where the
+     * fetch's component-by-component writes each pay for a partial flush. */
+    VPSlot tmp[16];
+    memcpy(tmp, s_vf.tmpl, sizeof tmp);
+    for (int k = 0; k < s_vf.n; k++) rsx_fetch_attrib(state, s_vf.idx[k], vi, tmp[s_vf.idx[k]].v);
+    memcpy(out16, tmp, sizeof tmp);
 }
 
