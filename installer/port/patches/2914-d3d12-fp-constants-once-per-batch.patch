@@ -5209,6 +5209,35 @@ static int vp_upload_tex_slot_impl(u32 off, u32 w, u32 h, u32 fmt, int cube, u32
 /* Snapshot the VP constant bank + viewport epilogue for one draw into its
  * vp_cb slot. Runs at record time so every draw keeps the constants that
  * were live when the guest issued it. */
+/* FPK_REPLAY (patch 2058) switch, shared by the record side and the replay. */
+static int fpk_replay_on(void)
+{
+    static int rp = -1;
+    if (rp < 0) { const char* e = getenv("FPK_REPLAY"); rp = (e && *e == '0') ? 0 : 1; }
+    return rp;
+}
+/* FPK_MEMO (experiment 2026-11-13, default on, =0 off): a fragment program's inline constants are walked out of guest
+ * memory once per batch and copied to every draw of that program, instead of walking the program again for each draw
+ * (a 2 vs 2 has ~4,500 draws a frame over a few hundred programs). s_fpk_batch is bumped at the start of each
+ * render_frame_prepare; the replay of one batch reads every program at the same moment, so the values are the same. */
+typedef struct { u32 fp_addr, batch; int nk; float k[FP_K_MAX * 4]; } FpkMemo;
+static FpkMemo s_fpkm[256];
+static u32 s_fpk_batch = 1;
+static void fpk_fill(u32 fp_addr, const u8* code, float* out)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("FPK_MEMO"); on = (e && *e == '0') ? 0 : 1; }
+    if (!on) { rsx_fp_extract_consts(code, 0x10000, out, FP_K_MAX); return; }
+    FpkMemo* m = &s_fpkm[((fp_addr >> 2) * 2654435761u) >> 24];
+    if (m->fp_addr != fp_addr || m->batch != s_fpk_batch) {
+        int nk = rsx_fp_extract_consts(code, 0x10000, m->k, FP_K_MAX);
+        if (nk < 0) nk = 0;
+        if (nk > FP_K_MAX) nk = FP_K_MAX;
+        m->nk = nk; m->fp_addr = fp_addr; m->batch = s_fpk_batch;
+    }
+    if (m->nk) memcpy(out, m->k, (size_t)m->nk * 16);
+}
