Patch 7933: the HUD-scale box reads vertex positions from a plain-memory copy (UI_POS, on by default; needs 7930).

The CPU vertex paths keep attribute 0 of each vertex they write into the vertex upload ring in a plain-memory side copy,
tagged with the batch; vp_record_cb reads positions from there instead of the write-combined ring (a vertex not noted in
this batch: the old read). Same values, same box, same picture. UI_POS=0: off. Measured: 2 Players 3v3 replays, FIFO
thread 16.28 -> 15.43 ms and 16.22 -> 15.04 ms, pictures bit-exact.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 4bf25a9..4da2151 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -5505,6 +5505,29 @@ static void fpk_fill(u32 fp_addr, const u8* code, float* out)
  * the drawing thread). One 16-byte streaming load (MOVNTDQA, made for reading write-combined memory) per vertex instead.
  * Same values, same box. */
 #include <immintrin.h>
+/* UI_POS (=0 off): attribute 0 of every vertex the CPU paths write into the vertex upload ring,
+ * kept in plain memory (s_pos0, tagged with the batch), so the UI_SCALE box reads it instead of the write-combined ring. */
+static float (*s_pos0)[4]; static u32* s_pos0_gen; static u32 s_pos0_cur = 1;
+static inline void pos0_note(const void* dst, const float* v)
+{
+    if (!s_pos0) return;
+    const intptr_t off = (const u8*)dst - (const u8*)s_d3d.vp_vb_mapped;
+    if (off < 0 || (off & 255) || off >= (intptr_t)2 * MAX_VERTICES * 256) return;
+    const u32 k = (u32)(off >> 8);
+    s_pos0[k][0] = v[0]; s_pos0[k][1] = v[1]; s_pos0[k][2] = v[2]; s_pos0[k][3] = v[3];
+    s_pos0_gen[k] = s_pos0_cur;
+}
+static int ui_pos_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("UI_POS"); on = (e && *e == '0') ? 0 : 1; }
+    if (on && !s_pos0 && s_d3d.vp_vb_mapped) {
+        s_pos0 = (float(*)[4])malloc(sizeof(float[4]) * 2u * MAX_VERTICES);
+        s_pos0_gen = (u32*)calloc(2u * MAX_VERTICES, sizeof(u32));
+        if (!s_pos0 || !s_pos0_gen) { free(s_pos0); free(s_pos0_gen); s_pos0 = NULL; s_pos0_gen = NULL; on = 0; }
+    }
+    return on && s_pos0;
+}
