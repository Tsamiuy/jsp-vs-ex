@@ -206,7 +212,7 @@ static void* vdec_idle_thread(void* arg)
             VdecSlot* v = &s_vdec[h];
             int drained = 0;
             if (v->in_use && v->ff && v->seqStarted && !v->idleDrained &&
-                v->qCount == 0 && v->picsDecoded < v->auCount && v->lastAuMs &&
+                v->qCount == 0 && v->pCount == 0 && v->picsDecoded < v->auCount && v->lastAuMs &&
                 vdec_now_ms() - v->lastAuMs >= idle_ms) {
                 v->idleDrained = 1;
                 vdec_ff_drain(v->ff, vdec_on_picture, v);
@@ -374,6 +380,7 @@ s32 cellVdecEndSeq(CellVdecHandle handle)
 
     /* Pictures the decoder still holds for reordering come out now, each
      * with its PICOUT, before SEQDONE. */
+    vdec_run_pending(handle, 1);   /* VDEC_DEFER: every kept AU first */
     VDEC_LOCK();
     s_vdec[handle].seqStarted = 0;
     const int ff = s_vdec[handle].ff != NULL;
@@ -389,6 +396,40 @@ s32 cellVdecEndSeq(CellVdecHandle handle)
     return CELL_OK;
 }
 
+/* Decode one AU with its AUDONE and PICOUTs (decoder path). */
+static void vdec_decode_one(CellVdecHandle handle, const CellVdecAuInfo* aup)
+{
+    VdecSlot* v = &s_vdec[handle];
+    const CellVdecAuInfo au = *aup;
+    VDEC_LOCK();
+    v->auCount++;
+    v->aus[v->auCount % VDEC_AU_RING] = au;
+    v->newPics = 0;
+    if (au.size)   /* an empty packet would mean end of stream to FFmpeg */
+        vdec_ff_decode(v->ff, vm_ptr8(au.startAddr), au.size, v->auCount,
+                       vdec_on_picture, v);
+    v->lastAuMs = vdec_now_ms();
+    v->idleDrained = 0;
+    VDEC_UNLOCK();
+    vdec_notify(handle, CELL_VDEC_MSG_TYPE_AUDONE, CELL_OK);
+    vdec_notify_new_pics(handle);
+}
+
+/* VDEC_DEFER: decode the kept AUs while the picture queue has room (all of them when `all`, for EndSeq). */
+static void vdec_run_pending(CellVdecHandle handle, int all)
+{
+    VdecSlot* v = &s_vdec[handle];
+    for (;;) {
+        VDEC_LOCK();
+        if (!v->ff || !v->pCount || (!all && v->qCount >= VDEC_BUSY_AT)) { VDEC_UNLOCK(); return; }
+        const CellVdecAuInfo au = v->pend[v->pHead];
+        v->pHead = (v->pHead + 1) % VDEC_PEND;
+        v->pCount--;
+        VDEC_UNLOCK();
+        vdec_decode_one(handle, &au);
+    }
+}
+
 s32 cellVdecDecodeAu(CellVdecHandle handle, s32 mode, const CellVdecAuInfo* auInfo)
 {
     (void)mode;
@@ -423,22 +464,28 @@ s32 cellVdecDecodeAu(CellVdecHandle handle, s32 mode, const CellVdecAuInfo* auIn
