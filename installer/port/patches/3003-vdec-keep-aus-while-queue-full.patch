     if (v->ff) {
+        /* VDEC_DEFER (default on, =0 old; from v0.15): libvdec decodes on its own thread and sends AUDONE when it
+         * takes an AU, so a title that got BUSY waits for the next AUDONE before it tries again. Here decoding is
+         * synchronous, so after a BUSY no AUDONE ever came: J-Stars' opening movie stopped after 18 AUs (the
+         * screen stayed black and the title never came). Now an AU that arrives while the picture queue is full
+         * is kept (the title leaves its memory alone until AUDONE) and decoded when GetPicture makes room, with
+         * its AUDONE and PICOUT then. BUSY only when that list is full too. */
+        static int defer = -1;
+        if (defer < 0) { const char* e = getenv("VDEC_DEFER"); defer = (e && *e == '0') ? 0 : 1; }
         VDEC_LOCK();
+        if (defer && (v->pCount || v->qCount >= VDEC_BUSY_AT)) {
+            if (v->pCount >= VDEC_PEND) { VDEC_UNLOCK(); return (s32)CELL_VDEC_ERROR_BUSY; }
+            v->pend[(v->pHead + v->pCount) % VDEC_PEND] = au;
+            v->pCount++;
+            VDEC_UNLOCK();
+            return CELL_OK;
+        }
         if (v->qCount >= VDEC_BUSY_AT) {
             VDEC_UNLOCK();
             return (s32)CELL_VDEC_ERROR_BUSY;  /* title must take pictures */
         }
-        v->auCount++;
-        v->aus[v->auCount % VDEC_AU_RING] = au;
-        v->newPics = 0;
-        if (au.size)   /* an empty packet would mean end of stream to FFmpeg */
-            vdec_ff_decode(v->ff, vm_ptr8(au.startAddr), au.size, v->auCount,
-                           vdec_on_picture, v);
-        v->lastAuMs = vdec_now_ms();
-        v->idleDrained = 0;
         VDEC_UNLOCK();
-        vdec_notify(handle, CELL_VDEC_MSG_TYPE_AUDONE, CELL_OK);
-        vdec_notify_new_pics(handle);
+        vdec_decode_one(handle, &au);
         return CELL_OK;
     }
 
