+    /* VDEC_DEFER: AUs waiting for room in the picture queue (decoded by GetPicture). */
+    CellVdecAuInfo pend[VDEC_PEND];
+    u32 pHead, pCount;
 } VdecSlot;
 
 static VdecSlot s_vdec[MAX_VDEC];
+static void vdec_run_pending(CellVdecHandle handle, int all);   /* VDEC_DEFER */
 
 /* The handle the guest sees is the slot index plus one, never 0: some
  * titles treat a 0 handle as "no decoder open".
@@ -117,6 +122,7 @@ static void vdec_queue_clear(VdecSlot* v)
     for (u32 i = 0; i < v->qCount; i++)
