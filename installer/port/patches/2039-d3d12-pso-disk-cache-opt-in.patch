Patch 2039: fit: pso_cache.bin opt-in (PSO_CACHE=1); cached pipelines hung the second boot on the loading screen

Source: fit for J-Stars.


diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 567e6250..a36336fa 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -2117,6 +2117,9 @@ static void sc_open(SCache* c)
 {
     const char* e = getenv(c->env);
     c->on = (e && e[0] == '0') ? 0 : 1;
+    /* pso_cache.bin is opt-in for J-Stars (PSO_CACHE=1): with cached pipelines the second start stayed on the
+     * loading screen before the opening movie (both runs with shader_cache.bin alone boot). */
+    if (c == &s_sc_pso) c->on = (e && e[0] == '1') ? 1 : 0;
     if (!c->on) return;
     FILE* in = fopen(c->file, "rb");
     const int existed = in != NULL;
