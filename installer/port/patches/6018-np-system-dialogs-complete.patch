Patch 6018: the message, invitation and profile system dialogs close at once and report it, so a title waiting on them goes on.

sceNpBasicSendMessageGui, sceNpBasicRecvMessageCustom and sceNpProfileCallGui were not exported: their imports were unresolved
(faked CELL_OK) and nothing ever called the title back. J-Stars Victory VS+ marks such a dialog open after the call and clears the
mark only in its handler, so sending or opening invitations and viewing a player's profile stayed on "Communicating..." for good.

There is still no system dialog to show. Each call now returns CELL_OK and queues one completion for the title's next
cellSysutilCheckCallback, as if the player had backed out: the basic handler gets the result event for the message's main type
(SEND_INVITATION_RESULT 13, SEND_MESSAGE_RESULT 12, RECV_INVITATION_RESULT 14, RECV_CUSTOM_DATA_RESULT 20, ...) with retCode
SCE_NP_BASIC_ERROR_CANCEL, and the profile handler gets SCE_NP_PROFILE_ERROR_CANCEL. Calls without NP, without a registered handler
or with bad arguments return the error and queue nothing. sceNpBasicRegisterContextSensitiveHandler now stores its handler (J-Stars
registers only that one), and sceNpBasicAddPlayersHistoryAsync reports ADD_PLAYERS_HISTORY_RESULT (retCode 0) with a fresh request id,
which J-Stars also waits for. ASSUMPTION: a dialog backed out of reports CANCEL and the handler runs from cellSysutilCheckCallback;
J-Stars only tests retCode against 0 and ignores the profile result. Event and error numbers of the SDK (as listed in RPCS3's
sceNp.h, read for the numbers only). Test: libs/network/tests/test_np_basic_dialogs.c (installer/tools/np_dialogs_test.sh).

diff --git a/libs/network/sceNpBasic.c b/libs/network/sceNpBasic.c
index 301c40f..ea50e85 100644
--- a/libs/network/sceNpBasic.c
+++ b/libs/network/sceNpBasic.c
@@ -10,6 +10,7 @@
 #include <stdio.h>
 #include <string.h>
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
+#include "../system/cellSysutil.h"          /* cellSysutilQueueGuestCallbackArgs */
 
 /* ---------------------------------------------------------------------------
  * Internal state
@@ -21,6 +22,52 @@ static SceNpBasicPresenceHandler s_presence_handler = NULL;
 static void* s_handler_arg = NULL;
 static SceNpBasicPresence s_own_presence;
 
+/* The title's basic event handler as the guest sees it: the OPD and its arg
+ * (guest addresses), from sceNpBasicRegisterHandler or
+ * sceNpBasicRegisterContextSensitiveHandler. The "result" events of the
+ * message dialogs and of AddPlayersHistoryAsync go to it. */
+static u32 s_cb_opd, s_cb_arg;
+static u32 s_next_req_id = 1;
+
+/* Numbers of the SDK, not this header's legacy placeholders (the header's
+ * event and error values do not match what titles compare against; the
+ * NO_EVENT note below is the same finding). Event and error values as in
+ * RPCS3's sceNp.h (read for the numbers only); J-Stars Victory VS+ compares
+ * its handler's events against 13, 14 and 18 and GetEvent's return against
+ * 0x8002A66A, which agrees. */
+#define NP_BASIC_EVENT_ADD_FRIEND_RESULT           3
+#define NP_BASIC_EVENT_SEND_ATTACHMENT_RESULT      7
+#define NP_BASIC_EVENT_SEND_MESSAGE_RESULT         12
+#define NP_BASIC_EVENT_SEND_INVITATION_RESULT      13
+#define NP_BASIC_EVENT_RECV_INVITATION_RESULT      14
+#define NP_BASIC_EVENT_ADD_PLAYERS_HISTORY_RESULT  18
+#define NP_BASIC_EVENT_SEND_CUSTOM_DATA_RESULT     19
+#define NP_BASIC_EVENT_RECV_CUSTOM_DATA_RESULT     20
+#define NP_BASIC_EVENT_SEND_URL_ATTACHMENT_RESULT  22
+#define NP_BASIC_ERR_NOT_SUPPORTED     0x8002A663u
+#define NP_BASIC_ERR_INVALID_ARGUMENT  0x8002A665u
+#define NP_BASIC_ERR_NOT_REGISTERED    0x8002A66Du
+#define NP_BASIC_ERR_CANCEL            0x8002A671u
+#define NP_BASIC_MESSAGE_MAIN_TYPE_INVITE       3
+#define NP_BASIC_MESSAGE_MAIN_TYPE_CUSTOM_DATA  4
+#define NP_BASIC_RECV_MESSAGE_OPTIONS_ALL       0x00000007u
+#define NP_PROFILE_ERR_NOT_INITIALIZED   0x8002AB41u
+#define NP_PROFILE_ERR_CANCEL            0x8002AB45u
+#define NP_PROFILE_ERR_INVALID_ARGUMENT  0x8002AB48u
+
+/* int handler(int event, int retCode, u32 reqId, void* arg), called on the
+ * title's next cellSysutilCheckCallback, never inside the call that caused
+ * it: a title sets its "dialog open" flag after the call returns and clears it
+ * in the handler, so a call made from inside would be lost (J-Stars sets its
+ * flag after the call, @0x0045A94C, @0x00455574).
+ * ASSUMPTION: the console calls the basic handler from cellSysutilCheckCallback;
+ * the title only needs it after the call has returned. */
+static void basic_event(s32 event, s32 retCode, u32 reqId)
+{
+    const u64 args[8] = { (u64)(s64)event, (u64)(s64)retCode, reqId, s_cb_arg, 0, 0, 0, 0 };
+    if (s_cb_opd) cellSysutilQueueGuestCallbackArgs(s_cb_opd, args);
+}
+
 /* sceNpBasic is usable once sceNpInit has run: in the SDK a title calls
  * sceNpInit and then sceNpBasic*, and many never call sceNpBasicInit. Checking
  * only Basic's own flag answered NOT_INITIALIZED to every presence, message
@@ -62,6 +109,7 @@ s32 sceNpBasicTerm(void)
     s_initialized = 0;
     s_event_handler = NULL;
     s_presence_handler = NULL;
+    s_cb_opd = s_cb_arg = 0;
     return CELL_OK;
 }
 
@@ -95,6 +143,8 @@ s32 sceNpBasicRegisterHandler(SceNpBasicEventHandler handler,
     s_event_handler = handler;
     s_presence_handler = presenceHandler;
     s_handler_arg = arg;
+    s_cb_opd = (u32)(uintptr_t)handler;
+    s_cb_arg = (u32)(uintptr_t)arg;
     return CELL_OK;
 }
 
@@ -108,6 +158,7 @@ s32 sceNpBasicUnregisterHandler(void)
     s_event_handler = NULL;
     s_presence_handler = NULL;
     s_handler_arg = NULL;
+    s_cb_opd = s_cb_arg = 0;
     return CELL_OK;
 }
 
@@ -259,8 +310,11 @@ s32 sceNpBasicAddBlockListEntry(const SceNpOnlineId* onlineId)
     return CELL_OK;
 }
 
-/* Players met online, and the context-sensitive (XMB) handler: nothing is
- * recorded, the history is empty, the handler is accepted and never fires. */
+/* Players met online: nothing is recorded and the history is empty. The add
+ * still completes: ADD_PLAYERS_HISTORY_RESULT (retCode 0, as the call's own
+ * CELL_OK says) goes to the basic handler. J-Stars marks the add busy after the
+ * call (@0x00456DD4) and only that event clears it (@0x00453B58); its net step
+ * func_00471C50 waits on the flag (@0x00471D48). */
 s32 sceNpBasicGetPlayersHistoryEntryCount(u32 options, u32* count)
 {
     (void)options;
@@ -272,12 +326,95 @@ s32 sceNpBasicGetPlayersHistoryEntryCount(u32 options, u32* count)
 s32 sceNpBasicAddPlayersHistoryAsync(const void* npids, u32 count, const void* description, u32* reqId)
 {
     (void)npids; (void)count; (void)description;
-    if (reqId) vm_write32((u32)(uintptr_t)reqId, 1);
+    const u32 id = s_next_req_id++;
+    if (!s_next_req_id) s_next_req_id = 1;
+    if (reqId) vm_write32((u32)(uintptr_t)reqId, id);
+    basic_event(NP_BASIC_EVENT_ADD_PLAYERS_HISTORY_RESULT, CELL_OK, id);
     return CELL_OK;
 }
 
+/* The context-sensitive handler: the same event handler as RegisterHandler's,
+ * for titles that only register this one (J-Stars does, @0x00456858). */
 s32 sceNpBasicRegisterContextSensitiveHandler(const void* context, void* handler, void* arg)
 {
-    (void)context; (void)handler; (void)arg;
+    if (!context || !handler)
+        return (s32)NP_BASIC_ERR_INVALID_ARGUMENT;
+    s_cb_opd = (u32)(uintptr_t)handler;
+    s_cb_arg = (u32)(uintptr_t)arg;
+    return CELL_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * System dialogs: sending a message or invitation, receiving one, and a
+ * player's profile. There is no system dialog to show, so each one closes
+ * at once as if the player had backed out, and says so through the
+ * title's handler. Without that completion the title waits for it for good:
+ * the imports were unresolved (faked CELL_OK, nothing ever called back) and
+ * J-Stars stayed on "Communicating..." after Invite or a profile.
+ * ASSUMPTION: a dialog the player backs out of ends with the result event
+ * carrying SCE_NP_BASIC_ERROR_CANCEL (the profile dialog: its handler gets
+ * SCE_NP_PROFILE_ERROR_CANCEL). J-Stars only tests retCode against 0
+ * (@0x00453AE4, @0x00453B10) and ignores the profile result (@0x00454870).
+ * -----------------------------------------------------------------------*/
+
+/* (const SceNpBasicMessageDetails* msg, sys_memory_container_t containerId).
+ * SceNpBasicMessageDetails: u64 msgId, u16 mainType (+8), u16 subType, ... */
+s32 sceNpBasicSendMessageGui(u32 msg, u32 containerId)
+{
+    (void)containerId;
+    if (!basic_ready())
+        return (s32)SCE_NP_BASIC_ERROR_NOT_INITIALIZED;
+    if (!s_cb_opd)
+        return (s32)NP_BASIC_ERR_NOT_REGISTERED;
+    if (!msg)
+        return (s32)NP_BASIC_ERR_INVALID_ARGUMENT;
+    static const s32 result_event[6] = {
+        NP_BASIC_EVENT_SEND_ATTACHMENT_RESULT, NP_BASIC_EVENT_SEND_MESSAGE_RESULT,
+        NP_BASIC_EVENT_ADD_FRIEND_RESULT, NP_BASIC_EVENT_SEND_INVITATION_RESULT,
+        NP_BASIC_EVENT_SEND_CUSTOM_DATA_RESULT, NP_BASIC_EVENT_SEND_URL_ATTACHMENT_RESULT };
+    const u32 mainType = vm_read16(msg + 8);
+    if (mainType >= 6)
+        return (s32)NP_BASIC_ERR_INVALID_ARGUMENT;
+    printf("[sceNpBasic] SendMessageGui(mainType=%u): no system dialog, closed\n", mainType);
+    basic_event(result_event[mainType], (s32)NP_BASIC_ERR_CANCEL, 0);
+    return CELL_OK;
+}
+
+/* (SceNpBasicMessageMainType mainType, SceNpBasicMessageRecvOptions recvOptions,
+ *  sys_memory_container_t containerId): the dialog lists received invitations
+ * or custom data messages. */
+s32 sceNpBasicRecvMessageCustom(u32 mainType, u32 recvOptions, u32 containerId)
+{
+    (void)containerId;
+    if (!basic_ready())
+        return (s32)SCE_NP_BASIC_ERROR_NOT_INITIALIZED;
+    if (!s_cb_opd)
+        return (s32)NP_BASIC_ERR_NOT_REGISTERED;
+    mainType &= 0xFFFF;
+    if (mainType != NP_BASIC_MESSAGE_MAIN_TYPE_INVITE && mainType != NP_BASIC_MESSAGE_MAIN_TYPE_CUSTOM_DATA)
+        return (s32)NP_BASIC_ERR_NOT_SUPPORTED;
+    if (recvOptions & ~NP_BASIC_RECV_MESSAGE_OPTIONS_ALL)
+        return (s32)NP_BASIC_ERR_INVALID_ARGUMENT;
+    printf("[sceNpBasic] RecvMessageCustom(mainType=%u): no system dialog, closed\n", mainType);
+    basic_event(mainType == NP_BASIC_MESSAGE_MAIN_TYPE_INVITE ? NP_BASIC_EVENT_RECV_INVITATION_RESULT
+                                                            : NP_BASIC_EVENT_RECV_CUSTOM_DATA_RESULT,
+                (s32)NP_BASIC_ERR_CANCEL, 0);
+    return CELL_OK;
+}
+
+/* sceNpProfileCallGui(const SceNpId* npid, SceNpProfileResultHandler handler,
+ * void* userArg, u64 options); the handler is int (int result, void* arg),
+ * called on the title's next cellSysutilCheckCallback (as above). Kept in this
+ * file: the profile dialog has no other state. */
+s32 sceNpProfileCallGui(u32 npid, u32 handler, u32 userArg, u64 options)
+{
+    (void)npid; (void)options;
+    if (!np_is_initialized())
+        return (s32)NP_PROFILE_ERR_NOT_INITIALIZED;
+    if (!handler)
+        return (s32)NP_PROFILE_ERR_INVALID_ARGUMENT;
+    printf("[sceNpProfile] CallGui: no system dialog, closed\n");
+    const u64 args[8] = { (u64)(s64)(s32)NP_PROFILE_ERR_CANCEL, userArg, 0, 0, 0, 0, 0, 0 };
+    cellSysutilQueueGuestCallbackArgs(handler, args);
     return CELL_OK;
 }
