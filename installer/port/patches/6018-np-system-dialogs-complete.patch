diff --git a/libs/network/tests/test_np_basic_dialogs.c b/libs/network/tests/test_np_basic_dialogs.c
new file mode 100644
index 0000000..f22cc06
--- /dev/null
+++ b/libs/network/tests/test_np_basic_dialogs.c
@@ -0,0 +1,151 @@
+/*
+ * test_np_basic_dialogs - the message, invitation and profile dialogs close
+ * and say so through the title's handler.
+ *
+ *   cc -std=gnu17 -I include -o test_np_basic_dialogs libs/network/tests/test_np_basic_dialogs.c
+ *
+ * Compiles sceNpBasic.c into this file with sysutil stubbed: the stub records
+ * what would be queued for the title's next cellSysutilCheckCallback. Checks
+ * that sceNpBasicSendMessageGui, sceNpBasicRecvMessageCustom and
+ * sceNpProfileCallGui are defined under the names whose NIDs titles import,
+ * that each queues exactly one completion (the result event with
+ * SCE_NP_BASIC_ERROR_CANCEL, or the profile handler with
+ * SCE_NP_PROFILE_ERROR_CANCEL) and calls nothing from inside the call, that
+ * AddPlayersHistoryAsync reports ADD_PLAYERS_HISTORY_RESULT with its request
+ * id, and the error paths (NP not up, no handler, bad arguments) queue nothing.
+ */
+#include "../sceNpBasic.c"
+#include "ps3emu/nid.h"
+
+#include <stdlib.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_linelock_lock(uint32_t a) { (void)a; }
+void spu_linelock_release(uint32_t a) { (void)a; }
+
+/* sceNp.c's accessor, driven by the test. */
+static int s_np_up;
+int np_is_initialized(void) { return s_np_up; }
+
+#define QMAX 16
+static struct { u32 opd; u64 a[8]; } s_q[QMAX];
+static int s_nq;
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8])
+{
+    if (s_nq < QMAX) {
+        s_q[s_nq].opd = opd;
+        memcpy(s_q[s_nq].a, args, sizeof(s_q[s_nq].a));
+    }
+    s_nq++;
+    return CELL_OK;
+}
+
+static int fails = 0;
+#define CHECK(expr, want, what) do { s32 got_ = (s32)(expr); int ok_ = got_ == (s32)(want);              \
+        printf("[%s] %s: 0x%08X (want 0x%08X)\n", ok_ ? "PASS" : "FAIL", what, (u32)got_, (u32)(want)); \
+        if (!ok_) fails++; } while (0)
+#define TRUE_(cond, what) do { int ok_ = !!(cond); printf("[%s] %s\n", ok_ ? "PASS" : "FAIL", what); \
+        if (!ok_) fails++; } while (0)
+
+/* The queued call k: opd and the first four arguments (32-bit views). */
+static void expect(int k, u32 opd, u32 a0, u32 a1, u32 a2, u32 a3, const char* what)
+{
+    int ok = k < s_nq && k < QMAX && s_q[k].opd == opd && (u32)s_q[k].a[0] == a0 && (u32)s_q[k].a[1] == a1
+             && (u32)s_q[k].a[2] == a2 && (u32)s_q[k].a[3] == a3;
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    if (!ok) {
+        fails++;
+        if (k < s_nq && k < QMAX)
+            printf("       got opd 0x%X args 0x%X 0x%X 0x%X 0x%X\n", s_q[k].opd, (u32)s_q[k].a[0], (u32)s_q[k].a[1],
+                   (u32)s_q[k].a[2], (u32)s_q[k].a[3]);
+    }
+}
+
+static void put16(u32 ea, u16 v) { vm_base[ea] = (u8)(v >> 8); vm_base[ea + 1] = (u8)v; }
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    vm_base = calloc(1, 65536);
+    if (!vm_base) return 2;
+    const u32 MSG = 0x1000, REQ = 0x1100, NPID = 0x1200, CTX = 0x1300;
+    const u32 HANDLER = 0x2000, ARG = 0x3000, PHANDLER = 0x4000, PARG = 0x5000;
+    const u32 CANCEL = NP_BASIC_ERR_CANCEL, PCANCEL = NP_PROFILE_ERR_CANCEL;
+
+    /* The names resolve to the NIDs titles import (J-Stars Victory VS+ imports all three). */
+    TRUE_(ps3_compute_nid("sceNpBasicSendMessageGui") == 0x01FBBC9Bu, "NID of sceNpBasicSendMessageGui");
+    TRUE_(ps3_compute_nid("sceNpBasicRecvMessageCustom") == 0x806960ABu, "NID of sceNpBasicRecvMessageCustom");
+    TRUE_(ps3_compute_nid("sceNpProfileCallGui") == 0xCEEEBC7Au, "NID of sceNpProfileCallGui");
+
+    /* NP not up: refused, nothing queued. */
+    put16(MSG + 8, 3);
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), SCE_NP_BASIC_ERROR_NOT_INITIALIZED, "before sceNpInit: SendMessageGui");
+    CHECK(sceNpBasicRecvMessageCustom(3, 2, 0xFFFFFFFFu), SCE_NP_BASIC_ERROR_NOT_INITIALIZED, "before sceNpInit: RecvMessageCustom");
+    CHECK(sceNpProfileCallGui(NPID, PHANDLER, PARG, 0), NP_PROFILE_ERR_NOT_INITIALIZED, "before sceNpInit: ProfileCallGui");
+    CHECK(s_nq, 0, "nothing queued");
+
+    /* NP up, no handler: the completion would have nowhere to go. */
+    s_np_up = 1;
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), NP_BASIC_ERR_NOT_REGISTERED, "no handler: SendMessageGui");
+    CHECK(sceNpBasicRecvMessageCustom(3, 2, 0xFFFFFFFFu), NP_BASIC_ERR_NOT_REGISTERED, "no handler: RecvMessageCustom");
+    CHECK(sceNpBasicRegisterContextSensitiveHandler(NULL, (void*)(uintptr_t)HANDLER, (void*)(uintptr_t)ARG),
+          NP_BASIC_ERR_INVALID_ARGUMENT, "ContextSensitiveHandler without a context");
+    CHECK(s_nq, 0, "nothing queued");
+
+    CHECK(sceNpBasicRegisterContextSensitiveHandler((void*)(uintptr_t)CTX, (void*)(uintptr_t)HANDLER, (void*)(uintptr_t)ARG),
+          CELL_OK, "RegisterContextSensitiveHandler");
+
+    /* Send: one result event per call, chosen by mainType, retCode CANCEL, queued (not called inside). */
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), CELL_OK, "SendMessageGui(INVITE)");
+    CHECK(s_nq, 1, "one completion queued");
+    expect(0, HANDLER, NP_BASIC_EVENT_SEND_INVITATION_RESULT, CANCEL, 0, ARG, "SEND_INVITATION_RESULT (13), CANCEL, the title's arg");
+    put16(MSG + 8, 1);
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), CELL_OK, "SendMessageGui(GENERAL)");
+    expect(1, HANDLER, NP_BASIC_EVENT_SEND_MESSAGE_RESULT, CANCEL, 0, ARG, "SEND_MESSAGE_RESULT (12)");
+    put16(MSG + 8, 6);
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), NP_BASIC_ERR_INVALID_ARGUMENT, "SendMessageGui(mainType 6)");
+    CHECK(sceNpBasicSendMessageGui(0, 0xFFFFFFFFu), NP_BASIC_ERR_INVALID_ARGUMENT, "SendMessageGui(NULL)");
+    CHECK(s_nq, 2, "errors queue nothing");
+
+    /* Receive. */
+    CHECK(sceNpBasicRecvMessageCustom(3, 2, 0xFFFFFFFFu), CELL_OK, "RecvMessageCustom(INVITE, INCLUDE_BOOTABLE)");
+    expect(2, HANDLER, NP_BASIC_EVENT_RECV_INVITATION_RESULT, CANCEL, 0, ARG, "RECV_INVITATION_RESULT (14), CANCEL");
+    CHECK(sceNpBasicRecvMessageCustom(4, 0, 0xFFFFFFFFu), CELL_OK, "RecvMessageCustom(CUSTOM_DATA)");
+    expect(3, HANDLER, NP_BASIC_EVENT_RECV_CUSTOM_DATA_RESULT, CANCEL, 0, ARG, "RECV_CUSTOM_DATA_RESULT (20)");
+    CHECK(sceNpBasicRecvMessageCustom(1, 0, 0xFFFFFFFFu), NP_BASIC_ERR_NOT_SUPPORTED, "RecvMessageCustom(GENERAL)");
+    CHECK(sceNpBasicRecvMessageCustom(3, 8, 0xFFFFFFFFu), NP_BASIC_ERR_INVALID_ARGUMENT, "RecvMessageCustom(unknown option)");
+    CHECK(s_nq, 4, "errors queue nothing");
+
+    /* Players history: the request id written and reported. */
+    CHECK(sceNpBasicAddPlayersHistoryAsync((void*)(uintptr_t)NPID, 1, NULL, (u32*)(uintptr_t)REQ), CELL_OK, "AddPlayersHistoryAsync");
+    const u32 id1 = vm_read32(REQ);
+    expect(4, HANDLER, NP_BASIC_EVENT_ADD_PLAYERS_HISTORY_RESULT, 0, id1, ARG, "ADD_PLAYERS_HISTORY_RESULT (18), retCode 0, its reqId");
+    CHECK(sceNpBasicAddPlayersHistoryAsync((void*)(uintptr_t)NPID, 1, NULL, (u32*)(uintptr_t)REQ), CELL_OK, "AddPlayersHistoryAsync again");
+    TRUE_(vm_read32(REQ) != id1 && vm_read32(REQ) != 0, "a new nonzero request id");
+    expect(5, HANDLER, NP_BASIC_EVENT_ADD_PLAYERS_HISTORY_RESULT, 0, vm_read32(REQ), ARG, "reported with that id");
+
+    /* Profile: its own handler and arg, result CANCEL. */
+    CHECK(sceNpProfileCallGui(NPID, PHANDLER, PARG, 0), CELL_OK, "ProfileCallGui");
+    expect(6, PHANDLER, PCANCEL, PARG, 0, 0, "profile handler(SCE_NP_PROFILE_ERROR_CANCEL, userArg)");
+    CHECK(sceNpProfileCallGui(NPID, 0, PARG, 0), NP_PROFILE_ERR_INVALID_ARGUMENT, "ProfileCallGui without a handler");
+    CHECK(s_nq, 7, "errors queue nothing");
+
+    /* Unregistered: refused again. */
+    CHECK(sceNpBasicUnregisterHandler(), CELL_OK, "UnregisterHandler");
+    put16(MSG + 8, 3);
+    CHECK(sceNpBasicSendMessageGui(MSG, 0xFFFFFFFFu), NP_BASIC_ERR_NOT_REGISTERED, "after UnregisterHandler: SendMessageGui");
+    CHECK(s_nq, 7, "nothing queued");
+
+    free(vm_base);
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
