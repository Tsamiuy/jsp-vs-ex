+static void atlas_vtx_dump(const char* path, const rsx_state* state, u32 first, u32 count, const VPSlot* out)
+{
+    static const char* av = (const char*)1; static u32 want = 0, from = 0, mx = 0, nd = 0;
+    if (av == (const char*)1) { av = getenv("ATLAS_VTX");
+        if (av) { want = (u32)strtoul(av, NULL, 16); const char* c = strchr(av, ':'); from = c ? (u32)atoi(c + 1) : 0;
+                  const char* c2 = c ? strchr(c + 1, ':') : NULL; mx = c2 ? (u32)atoi(c2 + 1) : 4; } }
+    if (!want || s_d3d.cur_texs[0].raw != want || s_d3d.frame_count < from || nd >= mx) return;
+    nd++;
+    fprintf(stderr, "[ATLASVTX] draw %u %s first=%u verts=%u frame=%u attrs:", nd, path, first, count, (u32)s_d3d.frame_count);
+    for (int a = 0; a < 16; a++) if (state->vertex_attribs[a].enabled)
+        fprintf(stderr, " a%d(type=%u size=%u stride=%u off=0x%X)", a, state->vertex_attribs[a].type, state->vertex_attribs[a].size,
+                state->vertex_attribs[a].stride, state->vertex_attribs[a].offset);
+    { const rsx_texture_state* T = &state->textures[0];
+      fprintf(stderr, " | tex0 off=0x%X fmt=0x%X addr=0x%X ctl0=0x%08X ctl1=0x%08X filt=0x%X rect=0x%X ctl3=0x%X", T->offset, T->format, T->address, T->control0, T->control1, T->filter, T->image_rect, T->control3); }
+    fprintf(stderr, "%c", 10);
+    for (u32 k = 0; k < count && k < 400; k++) {
+        fprintf(stderr, "[ATLASVTX] v%u", k);
+        for (int a = 0; a < 16; a++) if (state->vertex_attribs[a].enabled) {
+            const float* v = out[k*16 + a].v;
+            fprintf(stderr, " a%d=(%g,%g,%g,%g)", a, v[0], v[1], v[2], v[3]); }
+        fprintf(stderr, "%c", 10); }
+}
