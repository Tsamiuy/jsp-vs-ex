+/* PSO_ASYNC (2057, default on, PSO_ASYNC=0 off): new programs are built off the drawing thread. The program is decompiled where it is met (it
+ * reads guest memory, which the title may reuse), the HLSL goes to a queue, and PSO_ASYNC_THREADS workers (default 4)
+ * compile it and make the pipeline. Until then vp_get_fp_pso returns NULL with s_fp_pending set and the draw is
+ * skipped: a new effect may miss a frame or two instead of the whole game stalling 100-400 ms per new program
+ * (HITCH=50, bench/exp/2026-11-08_1259-psocache2). The batch pre-pass, which waited for its builds, is skipped. */
+static int s_fp_pending;
+typedef struct { FPJob k; char* hlsl; volatile LONG st; } FPAsync;   /* st: 0 free, 1 queued, 2 building, 3 done */
+#define FP_ASYNC_MAX 512
+static FPAsync s_fpa[FP_ASYNC_MAX];
+static HANDLE s_fpa_sem;
+static int fp_async_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PSO_ASYNC"); v = (e && *e == '0') ? 0 : 1; }   /* default on, =0 off */
+    return v;
+}
+static DWORD WINAPI vp_fp_async_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(s_fpa_sem, INFINITE);
+        for (int i = 0; i < FP_ASYNC_MAX; i++) {
+            FPAsync* a = &s_fpa[i];
+            if (InterlockedCompareExchange(&a->st, 2, 1) != 1) continue;
+            ID3DBlob* pb = NULL; ID3DBlob* e = NULL;
+            HRESULT hr = sc_compile(a->hlsl, "guest_fp", "ps_5_0", &pb, &e);
+            if (e) e->lpVtbl->Release(e);
+            free(a->hlsl); a->hlsl = NULL;
+            if (FAILED(hr) || !pb) a->k.status = 1;
+            else {
+                a->k.hr = vp_fp_make_pso(a->k.vsb, pb, a->k.blend, a->k.nrt, (DXGI_FORMAT)a->k.rtfmt, a->k.cmask,
+                                         a->k.cull, a->k.zs, a->k.vs_idx, &a->k.pso);
+                pb->lpVtbl->Release(pb);
+                a->k.status = 2;
+            }
+            if (a->k.vsb) a->k.vsb->lpVtbl->Release(a->k.vsb);
+            MemoryBarrier();
+            a->st = 3;
+            break;
+        }
+    }
+}
+static void fp_async_start(void)
+{
+    static volatile LONG started = 0;
+    if (started || InterlockedCompareExchange(&started, 1, 0) != 0) return;
+    s_fpa_sem = CreateSemaphoreA(NULL, 0, FP_ASYNC_MAX, NULL);
+    const char* e = getenv("PSO_ASYNC_THREADS");
+    int n = e ? atoi(e) : 4; if (n < 1) n = 1; if (n > 16) n = 16;
+    for (int i = 0; i < n; i++) { HANDLE h = CreateThread(NULL, 0, vp_fp_async_worker, NULL, 0, NULL); if (h) CloseHandle(h); }
+}
+/* 1 = queued or still building (s_fp_pending set), 0 = not known, 2 = finished: its result is in *out (slot freed). */
+static int fp_async_take(const FPJob* key, FPJob* out)
+{
+    for (int i = 0; i < FP_ASYNC_MAX; i++) {
+        FPAsync* a = &s_fpa[i];
+        const LONG st = a->st;
+        if (!st || !fpj_same(&a->k, key)) continue;
+        if (st != 3) return 1;
+        MemoryBarrier();
+        *out = a->k; a->st = 0;
+        return 2;
+    }
+    return 0;
+}
+static int fp_async_queue(const FPJob* key, char* hlsl)
+{
+    fp_async_start();
+    for (int i = 0; i < FP_ASYNC_MAX; i++) {
+        FPAsync* a = &s_fpa[i];
+        if (a->st) continue;
+        a->k = *key; a->k.status = 0; a->k.pso = NULL; a->hlsl = hlsl;
+        if (a->k.vsb) a->k.vsb->lpVtbl->AddRef(a->k.vsb);
+        MemoryBarrier();
+        a->st = 1;
+        ReleaseSemaphore(s_fpa_sem, 1, NULL);
+        return 1;
+    }
+    return 0;   /* queue full: build inline */
+}
