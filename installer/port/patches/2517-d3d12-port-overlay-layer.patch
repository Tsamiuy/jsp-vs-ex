+    hd.NumDescriptors = FRAME_COUNT; hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_jov_heap)))
+        return 0;
+    s_jov_failed = 0;
+    fprintf(stderr, "[OVERLAY] pipeline ready%c", 10);
+    return 1;
+}
