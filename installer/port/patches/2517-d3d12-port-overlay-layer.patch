+static void jov_gpu_present(u32 fi)
+{
+    if (!jov.active) return;                          /* the whole cost of a closed overlay */
+    if (fi >= FRAME_COUNT || !jov.px || !jov_gpu_init()) return;
+    if (!jov_try_lock()) {                            /* an edit is open: keep showing this frame's last copy, if any */
+        if (!s_jov_fr[fi].tex) return;
+        goto draw;
+    }
+    {
+        JovFrame* f = &s_jov_fr[fi];
+        if (f->tex && (f->w != (u32)jov.w || f->h != (u32)jov.h)) {   /* canvas size changed: frame fi's GPU use is done */
+            f->tex->lpVtbl->Release(f->tex); f->tex = NULL;
+            f->up->lpVtbl->Release(f->up); f->up = NULL;
+        }
+        if (!f->tex) {
+            f->w = (u32)jov.w; f->h = (u32)jov.h; f->pitch = (f->w * 4 + 255) & ~255u;
+            D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+            D3D12_RESOURCE_DESC td = {0};
+            td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+            td.Width = f->w; td.Height = f->h; td.DepthOrArraySize = 1; td.MipLevels = 1;
+            td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+            td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+            D3D12_HEAP_PROPERTIES up = {0}; up.Type = D3D12_HEAP_TYPE_UPLOAD;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            bd.Width = (u64)f->pitch * f->h; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+            bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                    D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL, &IID_ID3D12Resource, (void**)&f->tex)) ||
+                FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &up, D3D12_HEAP_FLAG_NONE, &bd,
+                    D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&f->up))) {
+                if (f->tex) { f->tex->lpVtbl->Release(f->tex); f->tex = NULL; }
+                jov_unlock(); return;
+            }
+            D3D12_CPU_DESCRIPTOR_HANDLE h;
+            s_jov_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_jov_heap, &h);
+            h.ptr += (u64)fi * s_d3d.srv_inc;
+            s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, f->tex, NULL, h);
+            jov.pend[fi] = (jov_rect){0, 0, jov.w, jov.h};
+        }
+        jov_rect r = jov_clip(jov.pend[fi]);
+        if (r.x1 > r.x0 && r.y1 > r.y0) {
+            void* p = NULL; D3D12_RANGE none = {0, 0};
+            if (SUCCEEDED(f->up->lpVtbl->Map(f->up, 0, &none, &p)) && p) {
+                for (int y = r.y0; y < r.y1; y++)
+                    memcpy((u8*)p + (size_t)y * f->pitch + (size_t)r.x0 * 4, jov.px + ((size_t)y * jov.w + r.x0) * 4, (size_t)(r.x1 - r.x0) * 4);
+                D3D12_RANGE wr = {(SIZE_T)r.y0 * f->pitch, (SIZE_T)r.y1 * f->pitch};
+                f->up->lpVtbl->Unmap(f->up, 0, &wr);
+                D3D12_RESOURCE_BARRIER b = {0};
+                b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+                b.Transition.pResource = f->tex; b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+                b.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+                b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+                s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+                D3D12_TEXTURE_COPY_LOCATION dl = {0}, sl = {0};
+                dl.pResource = f->tex; dl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+                sl.pResource = f->up; sl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+                sl.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+                sl.PlacedFootprint.Footprint.Width = f->w; sl.PlacedFootprint.Footprint.Height = f->h;
+                sl.PlacedFootprint.Footprint.Depth = 1; sl.PlacedFootprint.Footprint.RowPitch = f->pitch;
+                D3D12_BOX box = {(UINT)r.x0, (UINT)r.y0, 0, (UINT)r.x1, (UINT)r.y1, 1};
+                s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dl, (UINT)r.x0, (UINT)r.y0, 0, &sl, &box);
+                b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+                b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+                s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+            }
+            jov.pend[fi] = (jov_rect){0, 0, 0, 0};
+        }
+        jov_unlock();
+    }
+draw:;
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    s_d3d.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.rtv_heap, &rtv);
+    rtv.ptr += (u64)fi * s_d3d.rtv_descriptor_size;
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &rtv, FALSE, NULL);
+    D3D12_VIEWPORT vp = {0, 0, (float)s_d3d.width, (float)s_d3d.height, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)s_d3d.width, (LONG)s_d3d.height};
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+    cl->lpVtbl->SetGraphicsRootSignature(cl, s_jov_rs);
+    cl->lpVtbl->SetPipelineState(cl, s_jov_pso);
+    ID3D12DescriptorHeap* hh[] = { s_jov_heap };
+    cl->lpVtbl->SetDescriptorHeaps(cl, 1, hh);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh;
+    s_jov_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_jov_heap, &gh);
+    gh.ptr += (u64)fi * s_d3d.srv_inc;
+    cl->lpVtbl->SetGraphicsRootDescriptorTable(cl, 0, gh);
+    cl->lpVtbl->IASetPrimitiveTopology(cl, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    cl->lpVtbl->DrawInstanced(cl, 3, 1, 0, 0);
+    static int logged;
+    if (PS3_LOG_FIRST(logged, 2)) fprintf(stderr, "[OVERLAY] first present with the layer %dx%d -> %ux%u%c", jov.w, jov.h, s_d3d.width, s_d3d.height, 10);
+}
