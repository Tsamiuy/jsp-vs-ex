+/* VF_UNROLL (default on, VF_UNROLL=0 off): the common formats decoded with the
+ * component count fixed per case, the bytes swapped as words, half floats and
+ * u8 normalized through tables. Same values as the loops below (rsx_rd_half_be
+ * turns half denormals into zero, so does the table). The demo fight profile had
+ * read_vp_vertex_fast at 26% of the drawing thread. */
+static u32 s_vf_half[65536];
+static float s_vf_u8n[256];
+static int s_vf_unroll = -1;
+static void vf_tables(void)
+{
+    if (s_vf_unroll >= 0) return;
+    const char* e = getenv("VF_UNROLL");
+    s_vf_unroll = (e && e[0] == '0') ? 0 : 1;
+    for (u32 h = 0; h < 65536; h++) {
+        u8 b[2] = { (u8)(h >> 8), (u8)h };
+        float f = rsx_rd_half_be(b);
+        memcpy(&s_vf_half[h], &f, 4);
+    }
+    for (u32 k = 0; k < 256; k++) s_vf_u8n[k] = k * (1.0f / 255.0f);
+}
+static inline float vf_f32(const u8* p) { u32 w; memcpy(&w, p, 4); w = __builtin_bswap32(w); float f; memcpy(&f, &w, 4); return f; }
+static inline float vf_h16(const u8* p) { u16 w; memcpy(&w, p, 2); float f; memcpy(&f, &s_vf_half[__builtin_bswap16(w)], 4); return f; }
