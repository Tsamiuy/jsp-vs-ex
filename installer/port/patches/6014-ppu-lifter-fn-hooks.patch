+def load_fn_hooks(path: str) -> dict[int, tuple[str, str, int | None]]:
+    """Read a --fn-hooks file:
+
+        {"hooks": [{"addr": "0x00654350", "enter": "ps3_title_ctx_write_begin",
+                    "leave": "ps3_title_ctx_write_end", "note": "..."}, ...]}
+
+    -> {addr: (enter symbol, leave symbol)}."""
+    with open(path) as f:
+        spec = json.load(f)
+    out: dict[int, tuple[str, str, int | None]] = {}
+    for e in spec.get("hooks", []):
+        addr = int(str(e["addr"]), 0)
+        names = (str(e["enter"]), str(e["leave"]))
+        for n in names:
+            if not re.fullmatch(r"[A-Za-z_]\w*", n):
+                sys.exit(f"[ppu_lifter] {path}: hook symbol {n!r} is not a C identifier")
+        if addr & 3 or addr in out:
+            sys.exit(f"[ppu_lifter] {path}: bad or duplicate address 0x{addr:08X}")
+        end = int(str(e["end"]), 0) if "end" in e else None
+        if end is not None and (end <= addr or end & 3):
+            sys.exit(f"[ppu_lifter] {path}: bad hook end at 0x{addr:08X}")
+        out[addr] = (*names, end)
+    return out
+
