+/* ---- 7908 --------------------------------------------------------------------------------------------------------
+ * Every poll composes the four ports in a local buffer and publishes each port once, at the end (s_data_fresh goes up after
+ * that), so a reader that lost the pad lock never sees a half-built report. Without a reorder the layout is the old one
+ * (slot order, 6500 INPUT_MODE, PAD_PAD_P2). */
+typedef struct { PadHostState st; int ok, polled; } PadKb;
+static int pad_kb_get(PadKb* kb, int port)
+{
+    if (!kb->polled) { kb->polled = 1; pad_host_release(&kb->st); kb->ok = pad_poll_keyboard_to(&kb->st, port); }
+    return kb->ok;
+}
+static void pad_neutral(PadHostState* hs)   /* connected, nothing pressed, sticks centred */
+{
+    pad_host_release(hs);
+    hs->connected = 1;
+}
+static int pad_p2(void) { static int p2 = -1; if (p2 < 0) { const char* e = getenv("PAD_PAD_P2"); p2 = !(e && e[0] == '0'); } return p2; }
