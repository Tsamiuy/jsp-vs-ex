+/* The old layout: P[i] = what port i shows, dev[i] = the device behind it (-1 none; PJ_DEV_KEYBOARD). */
+static void pad_layout_default(PadHostState* P, int* dev, const PadHostState* raw, PadKb* kb)
+{
+    const int m = pad_input_mode(), p2 = pad_p2();
+    for (int i = 0; i < 4; i++) { P[i] = raw[i]; dev[i] = raw[i].connected ? i : -1; }
+    /* 6500: Keyboard / Keyboard & Mouse chosen: the keyboard is player 1, so a controller found on port 0 moves to
+     * port 1 (player 2). Controller chosen: the keyboard is player 2. PAD_PAD_P2=0 turns both off. */
+    if (p2 && P[0].connected && !P[1].connected && (m == PAD_MODE_KEYBOARD || m == PAD_MODE_KBM)) { P[1] = P[0]; dev[1] = dev[0]; }
+    if (!P[0].connected || m == PAD_MODE_KEYBOARD || m == PAD_MODE_KBM) {
+        if (pad_kb_get(kb, 0)) { P[0] = kb->st; dev[0] = PJ_DEV_KEYBOARD; }
+    } else if (p2 && m == PAD_MODE_CONTROLLER && !P[1].connected) {
+        if (pad_kb_get(kb, 1)) { P[1] = kb->st; dev[1] = PJ_DEV_KEYBOARD; }
+    }
+}
