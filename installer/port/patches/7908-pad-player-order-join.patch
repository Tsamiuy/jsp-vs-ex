diff --git a/libs/input/pad_join.h b/libs/input/pad_join.h
new file mode 100644
index 0000000..4dfa97c
--- /dev/null
+++ b/libs/input/pad_join.h
@@ -0,0 +1,177 @@
+/* pad_join.h -- who is player N: the device-to-player table of cellPad (toolkit patch 7908; ENHANCEMENT).
+ *
+ * Pure logic, no I/O, no clock of its own: cellPad.c feeds it one snapshot of every device per poll, and the host test
+ * (installer/tools/pad_join_test.c in the port tree) drives it the same way.
+ *
+ * Devices: 0..3 the host pad slots (XInput slot; the DualSense stand-in is device 0), 4 the keyboard.
+ * Players: 0..3 (player 1..4), the PS3 pad ports the game reads.
+ *
+ * Until a reorder is made (pj_begin or the chord) the table is NOT in force (pj.active == 0) and cellPad.c keeps the old
+ * rules (slot order, INPUT_MODE, PAD_PAD_P2). After a reorder:
+ *  - join mode: a device's first button press takes the lowest free player, and is swallowed (the device stays neutral
+ *    for the game until all its buttons were released once). A device that has not pressed is not given to the game.
+ *    A device that is already pressing when join begins (the press that started it) must be released first.
+ *    Join ends when every device flagged `must` has joined, when all four players are taken, or on a new Start press
+ *    from the device of player 1 (swallowed like a join press); devices left over then take the lowest free players.
+ *  - after join: a device that disconnects frees its player; one that connects later takes the lowest free player.
+ *  - player 1 stays occupied whenever any device has a player: if its device leaves, the lowest-numbered other player moves
+ *    to player 1 (the game's menus read port 0).
+ *  - chord: Select + L3 + R3 held PJ_CHORD_MS on one device starts join (pj_chord).
+ */
+#ifndef PAD_JOIN_H
+#define PAD_JOIN_H
+#include <stdint.h>
+#include <string.h>
+
+#define PJ_PLAYERS 4
+#define PJ_DEVS    5
+#define PJ_DEV_KEYBOARD 4
+#define PJ_CHORD_MS 2000
+/* CELL_PAD_CTRL_* bits as cellPad.h has them, repeated so this header stands alone (a static assert in cellPad.c checks them) */
+#define PJ_BTN_SELECT 0x0001
+#define PJ_BTN_L3     0x0002
+#define PJ_BTN_R3     0x0004
+#define PJ_BTN_START  0x0008
+#define PJ_CHORD_BITS (PJ_BTN_SELECT | PJ_BTN_L3 | PJ_BTN_R3)
+
+typedef struct {
+    uint8_t  connected;
+    uint8_t  must;      /* join cannot end by "everyone pressed" while this device is connected and has not joined */
+    uint16_t buttons;   /* CELL_PAD_CTRL_* digital mask, low word (all buttons incl. d-pad and L2/R2 as digital) */
+} PadJoinDev;
+
+typedef struct {
+    int     active, joining;
+    int8_t  player_of[PJ_DEVS];     /* -1 = none */
+    int8_t  dev_of[PJ_PLAYERS];     /* -1 = none */
+    uint8_t was_conn[PJ_DEVS], armed[PJ_DEVS], swallow[PJ_DEVS];
+    uint16_t prev[PJ_DEVS];
+    uint64_t chord_since[PJ_DEVS];  /* 0 = not held */
+    uint8_t chord_fired[PJ_DEVS];
+    int     request;                /* a begin asked for from outside (the port's menu row), taken at the next update */
+} PadJoin;
+
+static inline void pj_init(PadJoin* j)
+{
+    memset(j, 0, sizeof *j);
+    memset(j->player_of, -1, sizeof j->player_of);
+    memset(j->dev_of, -1, sizeof j->dev_of);
+}
+
+static inline int pj_free_player(const PadJoin* j)
+{
+    for (int p = 0; p < PJ_PLAYERS; p++) if (j->dev_of[p] < 0) return p;
+    return -1;
+}
+static inline void pj_assign(PadJoin* j, int dev, int p) { j->player_of[dev] = (int8_t)p; j->dev_of[p] = (int8_t)dev; }
+static inline void pj_free_dev(PadJoin* j, int dev)
+{
+    if (j->player_of[dev] >= 0) j->dev_of[j->player_of[dev]] = -1;
+    j->player_of[dev] = -1;
+}
+
+/* Asks for a reorder; takes effect in the next pj_update. */
+static inline void pj_begin(PadJoin* j) { __atomic_store_n(&j->request, 1, __ATOMIC_RELEASE); }
+
+/* The player the next press takes, 1-based; 0 when join is not running or all four are taken. */
+static inline int pj_next_player(const PadJoin* j)
+{
+    if (!j->joining) return 0;
+    const int p = pj_free_player(j);
+    return p < 0 ? 0 : p + 1;
+}
+
+/* The device behind player (port) p, or -1. Without a reorder (active == 0) the caller does not ask. */
+static inline int pj_dev_for_player(const PadJoin* j, int p) { return p >= 0 && p < PJ_PLAYERS ? j->dev_of[p] : -1; }
+/* 1 = the game sees this device neutral: its joining press is still held. */
+static inline int pj_hidden(const PadJoin* j, int dev) { return j->swallow[dev]; }
+/* 1 = the device holds the whole chord right now (cellPad.c hides those bits from the game) */
+static inline int pj_chord_held(const PadJoin* j, int dev) { return j->chord_since[dev] != 0; }
+
+/* Chord detection on a snapshot taken in default mode or after join. Returns 1 once per hold, when it reached PJ_CHORD_MS.
+ * now_ms must be > 0. Wall-clock input on purpose: it times a human hold, game logic never sees it. */
+static inline int pj_chord(PadJoin* j, const PadJoinDev* in, uint64_t now_ms)
+{
+    int fire = 0;
+    for (int d = 0; d < PJ_DEVS; d++) {
+        const int held = in[d].connected && (in[d].buttons & PJ_CHORD_BITS) == PJ_CHORD_BITS;
+        if (!held) { j->chord_since[d] = 0; j->chord_fired[d] = 0; continue; }
+        if (!j->chord_since[d]) j->chord_since[d] = now_ms;
+        if (!j->chord_fired[d] && now_ms - j->chord_since[d] >= PJ_CHORD_MS) { j->chord_fired[d] = 1; fire = 1; }
+    }
+    return fire;
+}
+
+static inline void pj_end_join(PadJoin* j, const PadJoinDev* in)
+{
+    j->joining = 0;
+    for (int d = 0; d < PJ_DEVS; d++) {   /* the ones that never pressed: lowest free player, in device order */
+        if (!in[d].connected || j->player_of[d] >= 0) continue;
+        const int p = pj_free_player(j);
+        if (p < 0) break;
+        pj_assign(j, d, p);
+    }
+}
+
+/* One poll. in[PJ_DEVS]: every device's state now. Call pj_chord first in the same poll when the chord is wanted. */
+static inline void pj_update(PadJoin* j, const PadJoinDev* in)
+{
+    for (int d = 0; d < PJ_DEVS; d++) {
+        if (!in[d].connected) {
+            if (j->was_conn[d]) { pj_free_dev(j, d); j->armed[d] = 0; j->swallow[d] = 0; j->was_conn[d] = 0; }
+        } else if (!j->was_conn[d]) {
+            j->was_conn[d] = 1; j->armed[d] = 0;
+        }
+    }
+    if (__atomic_exchange_n(&j->request, 0, __ATOMIC_ACQ_REL)) {
+        j->active = 1; j->joining = 1;
+        memset(j->player_of, -1, sizeof j->player_of);
+        memset(j->dev_of, -1, sizeof j->dev_of);
+        memset(j->armed, 0, sizeof j->armed);
+        memset(j->swallow, 0, sizeof j->swallow);
+        memset(j->prev, 0xFF, sizeof j->prev);   /* nothing counts as a new press until the first release */
+    }
+    if (!j->active) return;
+    for (int d = 0; d < PJ_DEVS; d++)
+        if (in[d].connected && !in[d].buttons) { j->armed[d] = 1; j->swallow[d] = 0; }
+
+    if (j->joining) {
+        int ended = 0;
+        for (int d = 0; d < PJ_DEVS && !ended; d++) {   /* Start from player 1 ends join (not the press that joined it) */
+            if (in[d].connected && j->player_of[d] == 0 && !j->swallow[d] &&
+                (in[d].buttons & PJ_BTN_START) && !(j->prev[d] & PJ_BTN_START)) {
+                j->swallow[d] = 1;
+                pj_end_join(j, in);
+                ended = 1;
+            }
+        }
+        if (!ended) {
+            for (int d = 0; d < PJ_DEVS; d++) {
+                if (!in[d].connected || !j->armed[d] || j->player_of[d] >= 0 || !in[d].buttons) continue;
+                const int p = pj_free_player(j);
+                if (p < 0) break;
+                pj_assign(j, d, p);
+                j->swallow[d] = 1;
+            }
+            int joined = 0, waiting = 0;
+            for (int d = 0; d < PJ_DEVS; d++) {
+                if (j->player_of[d] >= 0) joined++;
+                else if (in[d].connected && in[d].must) waiting++;
+            }
+            if (joined && (!waiting || pj_free_player(j) < 0)) pj_end_join(j, in);
+        }
+    } else {
+        for (int d = 0; d < PJ_DEVS; d++) {   /* connected later: lowest free player */
+            if (!in[d].connected || j->player_of[d] >= 0) continue;
+            const int p = pj_free_player(j);
+            if (p < 0) break;
+            pj_assign(j, d, p);
+        }
+    }
+    if (j->dev_of[0] < 0) {   /* player 1 left: the lowest other player takes over */
+        for (int p = 1; p < PJ_PLAYERS; p++)
+            if (j->dev_of[p] >= 0) { const int d = j->dev_of[p]; pj_free_dev(j, d); pj_assign(j, d, 0); break; }
+    }
+    for (int d = 0; d < PJ_DEVS; d++) j->prev[d] = in[d].buttons;
+}
+#endif
