Patch 3007: the tick-locked audio's output keeps a cushion, fades its gaps and counts them (AUDIO_LOCK_SMOOTH=0 turns it off).

Symptom (testers, 2-player rollback, 0.7.0-test1): choppy audio. In the tick-locked mode (patch 3005) the 6-7 blocks of a tick reach the
device in one burst at the tick boundary, and nothing kept a cushion in the 60 ms WASAPI buffer: a late tick (a rollback re-run, a long
FIFO drain, the time-sync stretch of up to 2 ms per tick on the peer that is ahead, a flip schedule restart) let the device run dry (a hard
cut), and once dry the buffer stayed at its floor, so every later late tick was another gap; a burst into a fuller buffer dropped whole
blocks. Nothing counted either: the AUDIO_RATE underrun counter is in the free-running path only.

Now, for the OUTPUT only (blocks mixed, read index and notify events are as before, so determinism is untouched; the mix thread never
waits on the device in the lock): about to run dry between ticks, the last chunk plays on time-reversed with a fade to zero; the next
burst is preceded by silence up to a cushion (AUDIO_LOCK_CUSHION_MS, default 30, capped so a 7-block burst still fits in the device
buffer, PS3_AUDIO_BUF_MS) and fades in; below the cushion each block is stretched by up to AUDIO_LOCK_DRC frames of 256 (default 2,
0.8%; 0 = off) so the cushion builds back. One "[audio-lock]" line when the lock ends (underruns, silence put in, fade tails, dropped
blocks, level before a burst), every ~5 s with AUDIO_LOCK_LOG=1; the counters also run with the smoothing off (A/B).

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index fe85113..eaf43df 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -772,6 +772,143 @@ void ps3_audio_lock_rewind(long long blocks)
     g_ps3_audio_lock_done = blocks; g_ps3_audio_lock_target = blocks;
 }
 
+#ifdef _WIN32
+/* J-Stars patch 3007 (rollback audio, AUDIO_LOCK_SMOOTH=0 turns it off): the output side of the tick-locked mode (patch 3005). There the blocks of a tick
+ * reach the device in one burst at the tick boundary (6-7 blocks, 32-37 ms) and nothing kept a cushion in the device buffer: a tick that came late (a
+ * rollback re-run, a long drain, the time-sync stretch of up to 2 ms per tick on the peer that is ahead, a flip schedule restart) let the device run dry,
+ * a hard cut and a click, and once dry the buffer stayed at its floor, so from then on every late tick was another gap (choppy audio); a burst into a
+ * fuller buffer dropped whole blocks (a skip). Now, for the OUTPUT only (what the guest sees -- blocks mixed, read index, notify events -- is unchanged,
+ * so determinism is untouched, and the mix thread never waits on the device in the lock):
+ *  - when the device is about to run dry between ticks, the last chunk sent is played on time-reversed with a 5 ms fade to zero (no hard cut);
+ *  - the first block after that is preceded by silence up to a cushion (AUDIO_LOCK_CUSHION_MS, default 30, capped by the device buffer,
+ *    PS3_AUDIO_BUF_MS, so that a 7-block burst still fits on top) and fades in: one clean pause instead of a run of clicks;
+ *  - while the level before a burst is under the cushion, each block is stretched by up to AUDIO_LOCK_DRC frames of 256 (default 2 = 0.8%, linear
+ *    interpolation; 0 = off) so the cushion builds back slowly; well over it, one frame shorter;
+ *  - counters: one "[audio-lock]" line when the lock ends (underruns, silence put in, fade tails, dropped blocks, trough level), and every ~5 s with
+ *    AUDIO_LOCK_LOG=1. The counters run with the smoothing off too (the A/B measurement). */
+static int lk_env(const char* e, int def) { return (e && *e) ? atoi(e) : def; }
+static int   s_lk_smooth = -1, s_lk_cushion_ms = 30, s_lk_drc = 2, s_lk_log = 0;
+static int   s_lk_active = 0, s_lk_burst = 1, s_lk_have_last = 0, s_lk_tailed = 0, s_lk_fadein = 0, s_lk_k = 0;
+static float s_lk_last[(CELL_AUDIO_BLOCK_SAMPLES + 8) * 2]; static u32 s_lk_last_n = 0;   /* the last chunk sent (the fade tail's source) */
+static float s_lk_out[(CELL_AUDIO_BLOCK_SAMPLES + 8) * 2];
+static float s_lk_zeros[CELL_AUDIO_BLOCK_SAMPLES * 2];
+static float s_lk_prev[2];
+static unsigned long long s_lk_blocks, s_lk_underruns, s_lk_sil_frames, s_lk_tails, s_lk_drops, s_lk_slow, s_lk_fast, s_lk_bursts;
+static double s_lk_trough_sum; static long s_lk_trough_min = -1;
+static int lk_cap_frames(void)
+{
+#if AUDIO_BACKEND_WASAPI
+    return (int)s_wasapi_buf_frames;
+#else
+    return 0;
+#endif
+}
+static void lk_begin(void)
+{
+    if (s_lk_smooth < 0) {
+        s_lk_smooth = lk_env(getenv("AUDIO_LOCK_SMOOTH"), 1) != 0; s_lk_cushion_ms = lk_env(getenv("AUDIO_LOCK_CUSHION_MS"), 30);
+        s_lk_drc = lk_env(getenv("AUDIO_LOCK_DRC"), 2); if (s_lk_drc < 0) s_lk_drc = 0; if (s_lk_drc > 8) s_lk_drc = 8;
+        s_lk_log = lk_env(getenv("AUDIO_LOCK_LOG"), 0);
+    }
+    s_lk_active = 1; s_lk_burst = 1; s_lk_have_last = 0; s_lk_tailed = 0; s_lk_fadein = 0; s_lk_k = 0; s_lk_last_n = 0;
+    s_lk_blocks = s_lk_underruns = s_lk_sil_frames = s_lk_tails = s_lk_drops = s_lk_slow = s_lk_fast = s_lk_bursts = 0;
+    s_lk_trough_sum = 0; s_lk_trough_min = -1;
+}
+static int lk_cushion_frames(void)
+{
+    const int cap = lk_cap_frames();
+    int c = s_lk_cushion_ms * (CELL_AUDIO_SAMPLE_RATE / 1000);
+    const int fits = cap - 8 * CELL_AUDIO_BLOCK_SAMPLES;   /* a 7-block burst (+1 block of slack) must still fit on top of it */
+    if (c > fits) c = fits;
+    return c < 0 ? 0 : c;
+}
+static void lk_report(const char* why)
+{
+    const double fpms = CELL_AUDIO_SAMPLE_RATE / 1000.0;
+    fprintf(stderr, "[audio-lock] %s: %llu blocks, %llu underruns (%.0f ms of silence put in), %llu fade tails, %llu blocks dropped (device full), "
+                    "%llu stretched / %llu shortened, level before a burst min %.1f ms mean %.1f ms, cushion %.1f ms, device buffer %.1f ms, smoothing %s\n",
+            why, s_lk_blocks, s_lk_underruns, s_lk_sil_frames / fpms, s_lk_tails, s_lk_drops, s_lk_slow, s_lk_fast,
+            s_lk_trough_min < 0 ? 0.0 : s_lk_trough_min / fpms, s_lk_bursts ? s_lk_trough_sum / s_lk_bursts / fpms : 0.0,
+            lk_cushion_frames() / fpms, lk_cap_frames() / fpms, s_lk_smooth ? "on" : "off (AUDIO_LOCK_SMOOTH=0)");
+}
+static void lk_end(void) { if (!s_lk_active) return; s_lk_active = 0; lk_report("lock ended"); }
+static void lk_keep_last(const float* f, u32 n)
+{
+    if (n > CELL_AUDIO_BLOCK_SAMPLES + 8) n = CELL_AUDIO_BLOCK_SAMPLES + 8;
+    memcpy(s_lk_last, f, n * 2 * sizeof(float)); s_lk_last_n = n; s_lk_have_last = 1; s_lk_tailed = 0;
+    s_lk_prev[0] = f[(n - 1) * 2]; s_lk_prev[1] = f[(n - 1) * 2 + 1];
+}
+/* Idle between ticks: when the device is about to run dry, play the last chunk on backwards with a fade to zero (continuous at the join). */
+static void lk_idle_tail(void)
+{
+    if (!s_lk_smooth || !s_lk_have_last || s_lk_tailed || !s_lk_last_n) return;
+    const int cap = lk_cap_frames(), rm = audio_backend_room();
+    if (cap <= 0 || rm < 0) return;
+    if (cap - rm >= CELL_AUDIO_BLOCK_SAMPLES) return;   /* over one block (5.3 ms) still queued */
+    const u32 n = s_lk_last_n;
+    if ((int)n > rm) return;
+    for (u32 i = 0; i < n; i++) {
+        const float g = 1.0f - (float)(i + 1) / (float)n;
+        s_lk_out[i * 2] = s_lk_last[(n - 1 - i) * 2] * g; s_lk_out[i * 2 + 1] = s_lk_last[(n - 1 - i) * 2 + 1] * g;
+    }
+    audio_backend_submit(s_lk_out, n);
+    s_lk_tailed = 1; s_lk_tails++;
+}
+/* One mixed, unmuted block (s_mix_buffer) to the device. */
+static void lk_submit_block(void)
+{
+    s_lk_blocks++;
+    const int cap = lk_cap_frames(), rm = audio_backend_room();
+    if (rm < 0 || cap <= 0) { audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES); s_lk_burst = 0; return; }   /* no device: as before */
+    int level = cap - rm;
+    const int cushion = lk_cushion_frames();
+    if (s_lk_burst) {   /* the first block after an idle wait: the level now is the low point before this tick's burst */
+        s_lk_burst = 0; s_lk_bursts++; s_lk_trough_sum += level; if (s_lk_trough_min < 0 || level < s_lk_trough_min) s_lk_trough_min = level;
+        const int dry = s_lk_have_last && (level < CELL_AUDIO_BLOCK_SAMPLES / 4 || s_lk_tailed);   /* ran dry, or only the fade tail was left */
+        if (dry) s_lk_underruns++;
+        if (s_lk_smooth && dry) s_lk_fadein = 1;
+        if (s_lk_smooth && (dry || !s_lk_have_last) && cushion > level) {   /* re-prime: silence up to the cushion, then fade in */
+            int want = cushion - level;
+            while (want > 0) { const int n = want > (int)CELL_AUDIO_BLOCK_SAMPLES ? (int)CELL_AUDIO_BLOCK_SAMPLES : want; audio_backend_submit(s_lk_zeros, (u32)n); want -= n; s_lk_sil_frames += (u32)n; }
+            level = cushion; s_lk_fadein = 1;
+        }
+        s_lk_k = 0;   /* the stretch of this burst's blocks, from the low point */
+        if (s_lk_smooth && s_lk_drc > 0) {
+            const int e = cushion - level;   /* frames short of the cushion */
+            if (e > (int)CELL_AUDIO_BLOCK_SAMPLES / 2) { s_lk_k = e / (int)CELL_AUDIO_BLOCK_SAMPLES + 1; if (s_lk_k > s_lk_drc) s_lk_k = s_lk_drc; }
+            else if (e < -2 * (int)CELL_AUDIO_BLOCK_SAMPLES) s_lk_k = -1;
+        }
+    }
+    if (!s_lk_smooth) {   /* patch 3005 as it was, counted */
+        if (rm >= (int)CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES); s_lk_have_last = 1; } else s_lk_drops++;
+        return;
+    }
+    const u32 N = CELL_AUDIO_BLOCK_SAMPLES, M = (u32)((int)N + s_lk_k);
+    const int room_now = audio_backend_room();
+    if (room_now >= 0 && room_now < (int)M) { s_lk_drops++; s_lk_fadein = 1; return; }   /* device full: dropped (as before); the next block fades in */
+    if (s_lk_fadein || !s_lk_have_last) { s_lk_prev[0] = s_mix_buffer[0]; s_lk_prev[1] = s_mix_buffer[1]; }
+    if (M == N) memcpy(s_lk_out, s_mix_buffer, N * 2 * sizeof(float));
+    else {   /* linear interpolation over prev, x[0..N-1]: output j = 1..M at t = j*N/M (M == N gives x exactly) */
+        if (s_lk_k > 0) s_lk_slow++; else s_lk_fast++;
+        for (u32 j = 1; j <= M; j++) {
+            const double t = (double)j * N / M; const u32 i = (u32)t; const float fr = (float)(t - i);
+            for (int ch = 0; ch < 2; ch++) {
+                const float a = i == 0 ? s_lk_prev[ch] : s_mix_buffer[(i - 1) * 2 + ch];
+                s_lk_out[(j - 1) * 2 + ch] = i >= N ? s_mix_buffer[(N - 1) * 2 + ch] : a + fr * (s_mix_buffer[i * 2 + ch] - a);
+            }
+        }
+    }
+    if (s_lk_fadein) {
+        const u32 F = 128;   /* 2.7 ms */
+        for (u32 i = 0; i < F && i < M; i++) { const float g = (float)(i + 1) / (float)F; s_lk_out[i * 2] *= g; s_lk_out[i * 2 + 1] *= g; }
+        s_lk_fadein = 0;
+    }
+    audio_backend_submit(s_lk_out, M);
+    lk_keep_last(s_lk_out, M);
+    if (s_lk_log && (s_lk_blocks % 938) == 0) lk_report("running");
+}
+#endif
+
 #ifdef _WIN32
 static unsigned long long g_audio_underruns;
 static unsigned __stdcall audio_mix_thread_func(void* arg)
@@ -803,14 +940,16 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
     if (!s_lock_wake) s_lock_wake = CreateEventW(NULL, FALSE, FALSE, NULL);   /* patch 3005 */
     while (s_mix_thread_running) {
         if (g_ps3_audio_lock_target >= 0) {   /* patch 3005: tick-locked (see ps3_audio_lock_idle) */
-            if (g_ps3_audio_lock_done >= g_ps3_audio_lock_target) { WaitForSingleObject(s_lock_wake, 2); continue; }
+            if (!s_lk_active) lk_begin();   /* patch 3007 */
+            if (g_ps3_audio_lock_done >= g_ps3_audio_lock_target) { s_lk_burst = 1; lk_idle_tail(); WaitForSingleObject(s_lock_wake, 2); continue; }
             audio_mix_one_block();
-            if (!g_ps3_audio_lock_mute) { const int rm = audio_backend_room(); if (rm < 0 || rm >= CELL_AUDIO_BLOCK_SAMPLES) audio_backend_submit(s_mix_buffer, CELL_AUDIO_BLOCK_SAMPLES); }
+            if (!g_ps3_audio_lock_mute) lk_submit_block();   /* patch 3007: the output side (cushion, fades, counters) */
             g_ps3_audio_lock_done++;
             audio_notify_event_queues();
             QueryPerformanceCounter(&q0); blocks = 0;   /* back on the clock from here when the lock ends */
             continue;
         }
+        lk_end();   /* patch 3007: the lock's output counters, once */
         const int room = audio_backend_room();
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
 #if AUDIO_BACKEND_WASAPI
