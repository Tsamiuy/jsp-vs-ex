diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
index dba84d4a..db4d4e45 100644
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -29,6 +29,14 @@
 /* Steady-clock milliseconds of the last cellFsRead, for a host that waits until file
  * streaming goes quiet (J-Stars holds its game-data check until then). */
 extern "C" { volatile unsigned long long g_ppu_fs_last_read_ms = 0; }
+/* Milliseconds since the last guest file read (6007: PAD_SCRIPT "~N" events wait for loading to finish). */
+extern "C" unsigned long long ppu_fs_idle_ms(void)
+{
+    const unsigned long long now = (unsigned long long)std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    const unsigned long long last = g_ppu_fs_last_read_ms;
+    return now > last ? now - last : 0;
+}
 #include <mutex>
 #include <atomic>
 #include <sys/stat.h>
