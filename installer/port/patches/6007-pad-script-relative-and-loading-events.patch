+       * written with "+" and "~" follows the game however long its loading screens take. */
+      static struct { double t; unsigned mask; int hold; int kind; } ev[256]; static int n_ev = 0;
       static unsigned long long t0 = 0;   /* not ULONGLONG: this builds on POSIX too */
       if (s_sc < 0) {
           s_sc = 0;
@@ -1003,12 +1007,14 @@ skip_inject: ;
               s_sc = 1; t0 = GetTickCount64();
               const char* p = e;
               while (*p && n_ev < 256) {
+                  int kind = 0;
+                  if (*p == '+') { kind = 1; p++; } else if (*p == '~') { kind = 2; p++; }
                   double t = strtod(p, (char**)&p);
                   if (*p == ':') p++;
                   unsigned m = (unsigned)strtoul(p, (char**)&p, 0);
