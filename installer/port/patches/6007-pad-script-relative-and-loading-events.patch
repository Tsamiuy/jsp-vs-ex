+                  ev[n_ev].t = t; ev[n_ev].mask = m; ev[n_ev].hold = hold; ev[n_ev].kind = kind; n_ev++;
                   while (*p == ',' || *p == ' ') p++;
               }
               printf("[cellPad] PAD_SCRIPT: %d event(s)%s\n", n_ev,
@@ -1024,8 +1030,19 @@ skip_inject: ;
            * hold it for a fixed number of polls, which is what a real press
            * looks like regardless of poll rate. */
           static int fired[256], held[256];
+          static double fired_at[256]; static unsigned long long fired_ms[256];
           for (int i = 0; i < n_ev; i++) {
-              if (!fired[i] && now >= ev[i].t) { fired[i] = 1; held[i] = ev[i].hold; }
+              if (!fired[i]) {
+                  const int prev_ok = (i == 0) || fired[i - 1];
+                  int go = 0;
