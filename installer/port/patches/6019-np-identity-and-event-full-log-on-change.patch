--- a/libs/network/sceNp.c
+++ b/libs/network/sceNp.c
@@ -51,6 +51,43 @@ static void np_build_fake_id(SceNpId* npId)
     npId->handle.term = '\0';
 }
 
+/* Patch 6019: titles poll the identity getters (J-Stars asks for its NP ID about
+ * 15 times a second while online), so each getter logs its first call and then
+ * only a call whose answer differs from the last one it logged, with the call
+ * count. The answer itself is never printed, only its length: a log or a
+ * support bundle must not carry the player's online name. */
+typedef struct {
+    const char*        name;
+    unsigned long long calls;
+    char               last[SCE_NP_ONLINEID_MAX_LENGTH + 1];
+    int                seen;
+    char               busy;            /* spin lock: a few compares under it */
+} np_id_log_site;
+
+static np_id_log_site s_log_npid    = { .name = "GetNpId" };
+static np_id_log_site s_log_oid     = { .name = "GetOnlineId" };
+static np_id_log_site s_log_oname   = { .name = "GetOnlineName" };
+static np_id_log_site s_log_profile = { .name = "GetUserProfile" };
+
+static void np_id_log(np_id_log_site* s, s32 userId, const char* value)
+{
+    char cur[sizeof(s->last)];
+    strncpy(cur, value ? value : "", sizeof(cur) - 1);
+    cur[sizeof(cur) - 1] = '\0';
+    while (__atomic_test_and_set(&s->busy, __ATOMIC_ACQUIRE)) {
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+    const unsigned long long n = ++s->calls;
+    const int first = !s->seen, changed = first || strcmp(cur, s->last) != 0;
+    if (changed) { memcpy(s->last, cur, sizeof(cur)); s->seen = 1; }
+    __atomic_clear(&s->busy, __ATOMIC_RELEASE);
+    if (changed)
+        printf("[sceNp] %s(user=%d) -> online id %s (%u chars), call %llu\n", s->name, userId,
+               first ? "set" : "changed", (unsigned)strlen(cur), n);
+}
+
 /* ---------------------------------------------------------------------------
  * API implementations
  * -----------------------------------------------------------------------*/
@@ -60,8 +97,8 @@ s32 sceNpInit(u32 poolSize, void* poolPtr)
     (void)poolSize;
     (void)poolPtr;
 
-    printf("[sceNp] Init(poolSize=%u, username=\"%s\")\n",
-           poolSize, np_psnr_online_id());
+    printf("[sceNp] Init(poolSize=%u, online id set (%u chars))\n",
+           poolSize, (unsigned)strlen(np_psnr_online_id()));
 
     if (s_np_initialized)
         return SCE_NP_ERROR_ALREADY_INITIALIZED;
@@ -99,7 +136,7 @@ s32 sceNpGetNpId(s32 userId, SceNpId* npId)
      * time it asked for its NP ID online. */
     npId = GUEST_PTR(npId, SceNpId*);
     np_build_fake_id(npId);
-    printf("[sceNp] GetNpId(user=%d) -> \"%s\"\n", userId, np_psnr_online_id());
+    np_id_log(&s_log_npid, userId, np_psnr_online_id());
     return CELL_OK;
 }
 
@@ -118,7 +155,7 @@ s32 sceNpGetOnlineId(s32 userId, SceNpOnlineId* onlineId)
     strncpy(onlineId->data, np_psnr_online_id(), SCE_NP_ONLINEID_MAX_LENGTH);
     onlineId->term = '\0';
 
-    printf("[sceNp] GetOnlineId(user=%d) -> \"%s\"\n", userId, np_psnr_online_id());
+    np_id_log(&s_log_oid, userId, np_psnr_online_id());
     return CELL_OK;
 }
 
@@ -137,8 +174,7 @@ s32 sceNpGetOnlineName(s32 userId, SceNpOnlineName* onlineName)
     strncpy(onlineName->data, np_psnr_online_id(),
             SCE_NP_ONLINENAME_MAX_LENGTH - 1);
 
-    printf("[sceNp] GetOnlineName(user=%d) -> \"%s\"\n",
-           userId, np_psnr_online_id());
+    np_id_log(&s_log_oname, userId, np_psnr_online_id());
     return CELL_OK;
 }
 
@@ -159,8 +195,7 @@ s32 sceNpGetUserProfile(s32 userId, SceNpUserInfo* userInfo)
             SCE_NP_ONLINENAME_MAX_LENGTH - 1);
     /* Leave avatar URL empty */
 
-    printf("[sceNp] GetUserProfile(user=%d) -> \"%s\"\n",
-           userId, np_psnr_online_id());
+    np_id_log(&s_log_profile, userId, np_psnr_online_id());
     return CELL_OK;
