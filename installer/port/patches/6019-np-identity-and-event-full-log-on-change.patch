diff --git a/libs/network/tests/test_np_identity_log.c b/libs/network/tests/test_np_identity_log.c
new file mode 100644
index 0000000..8610fd5
--- /dev/null
+++ b/libs/network/tests/test_np_identity_log.c
@@ -0,0 +1,134 @@
+/*
+ * test_np_identity_log - the NP identity getters log their first call and a
+ * changed answer, never the online id itself (patch 6019).
+ *
+ *   cc -std=gnu17 -I include -o test_np_identity_log libs/network/tests/test_np_identity_log.c
+ *   (installer/tools/np_log_test.sh builds and runs it)
+ *
+ * Compiles sceNp.c into this file with the online id under the test's control
+ * and the process's stdout sent to a temporary file. Checks: 1000 calls of
+ * each getter with one id log exactly one line per getter; a changed id logs
+ * exactly one more per getter; the sceNpManager* forms share their getter's
+ * line; Init logs no id; nothing logged ever holds either id.
+ */
+#include "../sceNp.c"
+
+#include <stdlib.h>
+#include <unistd.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_linelock_lock(uint32_t a) { (void)a; }
+void spu_linelock_release(uint32_t a) { (void)a; }
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8]) { (void)opd; (void)args; return CELL_OK; }
+void edat_add_klicensee(const uint8_t klic[16]) { (void)klic; }
+
+static const char* s_id = "Zqxv-Tester_01";      /* 14 chars */
+int np_psnr_enabled(void) { return 1; }
+const char* np_psnr_online_id(void) { return s_id; }
+
+#define NPID    0x1000u
+#define ONLID   0x1100u
+#define ONAME   0x1200u
+#define PROFILE 0x1400u
+
+static int fails = 0;
+#define EXPECT(cond, what) do { if (!(cond)) { fprintf(stderr, "FAIL: %s\n", what); fails++; } } while (0)
+
+static FILE* s_cap;
+static int   s_saved_fd = -1;
+
+static void capture_begin(void)
+{
+    fflush(stdout);
+    s_cap = tmpfile();
+    s_saved_fd = dup(1);
+    if (!s_cap || s_saved_fd < 0 || dup2(fileno(s_cap), 1) < 0) { perror("capture"); exit(2); }
+}
+
+/* -> the captured text (malloc'd), stdout restored. */
+static char* capture_end(void)
+{
+    fflush(stdout);
+    dup2(s_saved_fd, 1);
+    close(s_saved_fd);
+    fseek(s_cap, 0, SEEK_END);
+    long n = ftell(s_cap);
+    if (n < 0) n = 0;
+    rewind(s_cap);
+    char* t = (char*)calloc(1, (size_t)n + 1);
+    if (n && fread(t, 1, (size_t)n, s_cap) != (size_t)n) { perror("read"); exit(2); }
+    fclose(s_cap);
+    return t;
+}
+
+static int count(const char* text, const char* needle)
+{
+    int n = 0;
+    for (const char* p = text; (p = strstr(p, needle)) != NULL; p += strlen(needle)) n++;
+    return n;
+}
+
+static void call_all(int times)
+{
+    for (int i = 0; i < times; i++) {
+        sceNpGetNpId(0, (SceNpId*)(uintptr_t)NPID);
+        sceNpGetOnlineId(0, (SceNpOnlineId*)(uintptr_t)ONLID);
+        sceNpGetOnlineName(0, (SceNpOnlineName*)(uintptr_t)ONAME);
+        sceNpGetUserProfile(0, (SceNpUserInfo*)(uintptr_t)PROFILE);
+    }
+}
+
+int main(void)
+{
+    vm_base = (uint8_t*)calloc(1, 65536);
+    if (!vm_base) return 2;
+
+    capture_begin();
+    EXPECT(sceNpInit(131072, (void*)0x8000) == CELL_OK, "sceNpInit");
+    call_all(1000);
+    for (int i = 0; i < 1000; i++) sceNpManagerGetNpId((SceNpId*)(uintptr_t)NPID);
+    char* first = capture_end();
+
+    EXPECT(count(first, "[sceNp] Init(poolSize=131072, online id set (14 chars))") == 1, "Init logs the id's length once");
+    EXPECT(count(first, "[sceNp] GetNpId(") == 1, "1000 + 1000 GetNpId calls with one id: exactly 1 line");
+    EXPECT(count(first, "[sceNp] GetNpId(user=0) -> online id set (14 chars), call 1\n") == 1, "GetNpId first line");
+    EXPECT(count(first, "[sceNp] GetOnlineId(") == 1, "1000 GetOnlineId calls: 1 line");
+    EXPECT(count(first, "[sceNp] GetOnlineName(") == 1, "1000 GetOnlineName calls: 1 line");
+    EXPECT(count(first, "[sceNp] GetUserProfile(") == 1, "1000 GetUserProfile calls: 1 line");
+    EXPECT(count(first, "\n") == 5, "5 lines in all (Init + 4 getters)");
+    /* the getters still answer with the id */
+    EXPECT(strcmp((const char*)vm_base + NPID, s_id) == 0, "GetNpId still writes the id");
+    EXPECT(strcmp((const char*)vm_base + ONAME, s_id) == 0, "GetOnlineName still writes the id");
+
+    capture_begin();
+    s_id = "Wmrk7";                                  /* 5 chars */
+    call_all(1000);
+    for (int i = 0; i < 1000; i++) sceNpManagerGetNpId((SceNpId*)(uintptr_t)NPID);
+    char* second = capture_end();
+
+    EXPECT(count(second, "[sceNp] GetNpId(user=0) -> online id changed (5 chars), call 2001\n") == 1,
+           "a changed id: 1 more GetNpId line, with the call count");
+    EXPECT(count(second, "[sceNp] GetOnlineId(user=0) -> online id changed (5 chars), call 1001\n") == 1, "GetOnlineId changed");
+    EXPECT(count(second, "[sceNp] GetOnlineName(user=0) -> online id changed (5 chars), call 1001\n") == 1, "GetOnlineName changed");
+    EXPECT(count(second, "[sceNp] GetUserProfile(user=0) -> online id changed (5 chars), call 1001\n") == 1, "GetUserProfile changed");
+    EXPECT(count(second, "\n") == 4, "4 lines for the change (one per getter)");
+
+    /* the id never reaches the log */
+    EXPECT(!strstr(first, "Zqxv") && !strstr(second, "Zqxv"), "the first id is never printed");
+    EXPECT(!strstr(first, "Wmrk7") && !strstr(second, "Wmrk7"), "the second id is never printed");
+    EXPECT(!strstr(first, "PS3Player") && !strstr(second, "PS3Player"), "the default name is never printed");
+
+    if (fails) { fputs(first, stderr); fputs(second, stderr); }
+    printf("test_np_identity_log: %s (%d failure%s)\n", fails ? "FAIL" : "ok", fails, fails == 1 ? "" : "s");
+    free(first); free(second);
+    return fails ? 1 : 0;
+}
diff --git a/runtime/syscalls/evt_full_log.h b/runtime/syscalls/evt_full_log.h
new file mode 100644
index 0000000..55c0b35
--- /dev/null
+++ b/runtime/syscalls/evt_full_log.h
@@ -0,0 +1,91 @@
+/*
+ * ps3recomp - the log of sys_event_port_send answering EBUSY (patch 6019)
+ *
+ * A port whose queue is full answers CELL_EBUSY, as lv2 does; a title with a
+ * size-1 queue meets that all the time and simply sends again later. Logging
+ * every EBUSY wrote over a hundred thousand lines in one session, so each port
+ * logs only:
+ *   - its first EBUSY;
+ *   - the end of its first run of EBUSY (the next send its queue takes), with
+ *     the run's length;
+ *   - at exit, if it ever answered EBUSY: the total, the number of runs and
+ *     the longest run.
+ * At most three lines per port, however long the session. Logging only: what
+ * the send returns does not depend on any of this.
+ */
+#ifndef PS3_EVT_FULL_LOG_H
+#define PS3_EVT_FULL_LOG_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+typedef struct {
+    unsigned long long total;    /* EBUSY answers so far */
+    unsigned long long runs;     /* runs of EBUSY started */
+    unsigned long long run;      /* EBUSY answers of the current run, 0 between runs (atomic: read without the lock) */
+    unsigned long long longest;  /* longest run that has ended */
+    int                first_run_ended;
+    char               busy;     /* spin lock: a few counters under it */
+} evt_full_site;
+
+/* A CPU pause in spin loops (x86 PAUSE; elsewhere nothing). */
+#if defined(__x86_64__) || defined(__i386__)
+#define EVT_FULL_SPIN_PAUSE() __builtin_ia32_pause()
+#else
+#define EVT_FULL_SPIN_PAUSE() ((void)0)
+#endif
+
+static inline void evt_full_lock(evt_full_site* s)
+{
+    while (__atomic_test_and_set(&s->busy, __ATOMIC_ACQUIRE)) EVT_FULL_SPIN_PAUSE();
+}
+
+static inline void evt_full_unlock(evt_full_site* s)
+{
+    __atomic_clear(&s->busy, __ATOMIC_RELEASE);
+}
+
+/* The port's queue was full: the send answers EBUSY. */
+static inline void evt_full_note_busy(evt_full_site* s, FILE* out, uint32_t port, int queue)
+{
+    evt_full_lock(s);
+    const int first = s->total++ == 0;
+    if (__atomic_fetch_add(&s->run, 1, __ATOMIC_RELAXED) == 0) s->runs++;
+    evt_full_unlock(s);
+    if (first)
+        fprintf(out, "[evt] port_send(port=%u): queue %d FULL -> EBUSY (logged once per port: the end of this run "
+                     "and the totals at exit follow)\n", port, queue);
+}
+
+/* The port's queue took an event. Cheap when no run is open. */
+static inline void evt_full_note_sent(evt_full_site* s, FILE* out, uint32_t port, int queue)
+{
+    if (!__atomic_load_n(&s->run, __ATOMIC_RELAXED)) return;
+    evt_full_lock(s);
+    const unsigned long long r = __atomic_exchange_n(&s->run, 0, __ATOMIC_RELAXED);
+    if (r > s->longest) s->longest = r;
+    const int report = r && !s->first_run_ended;
+    if (report) s->first_run_ended = 1;
+    evt_full_unlock(s);
+    if (report)
+        fprintf(out, "[evt] port_send(port=%u): queue %d took an event again after %llu EBUSY (later runs are "
+                     "only counted)\n", port, queue, r);
+}
+
+/* At exit: one line per port of `sites` (port number = index + 1) that ever answered EBUSY. */
+static inline void evt_full_summary(evt_full_site* sites, unsigned count, FILE* out)
+{
+    for (unsigned i = 0; i < count; i++) {
+        evt_full_site* s = &sites[i];
+        evt_full_lock(s);
+        const unsigned long long total = s->total, runs = s->runs;
+        const unsigned long long open = __atomic_load_n(&s->run, __ATOMIC_RELAXED);
+        const unsigned long long longest = open > s->longest ? open : s->longest;
+        evt_full_unlock(s);
+        if (total)
+            fprintf(out, "[evt] port_send(port=%u): %llu EBUSY in %llu runs, longest run %llu\n",
+                    i + 1, total, runs, longest);
+    }
+}
+
+#endif /* PS3_EVT_FULL_LOG_H */
diff --git a/runtime/syscalls/sys_event.c b/runtime/syscalls/sys_event.c
index 4ee9a14..75f718f 100644
--- a/runtime/syscalls/sys_event.c
+++ b/runtime/syscalls/sys_event.c
@@ -1118,6 +1118,12 @@ uint32_t sys_event_find_queue_by_key(uint64_t key)
     return 0;
 }
 
+/* EBUSY from a full queue is logged per port, a bounded number of lines
+ * (patch 6019, evt_full_log.h). */
+#include "evt_full_log.h"
+static evt_full_site s_evt_full[SYS_EVENT_PORT_MAX];
+static void evt_full_at_exit(void) { evt_full_summary(s_evt_full, SYS_EVENT_PORT_MAX, stderr); }
+
 int64_t sys_event_port_send(ppu_context* ctx)
 {
     uint32_t port_id = LV2_ARG_U32(ctx, 0);
@@ -1202,10 +1208,12 @@ int64_t sys_event_port_send(ppu_context* ctx)
       g_spu_pending_evt_valid = 0; }
 
     if (event_queue_push(q, &evt) < 0) {
-        fprintf(stderr, "[evt] port_send(port=%u): queue %d FULL -> EBUSY%c",
-                port_id, qidx, 10);
+        static char s_at_exit;
+        if (!__atomic_test_and_set(&s_at_exit, __ATOMIC_RELAXED)) atexit(evt_full_at_exit);
+        evt_full_note_busy(&s_evt_full[port_id - 1], stderr, port_id, qidx);
         return (int64_t)(int32_t)CELL_EBUSY;
     }
+    evt_full_note_sent(&s_evt_full[port_id - 1], stderr, port_id, qidx);
 
     return CELL_OK;
 }
diff --git a/runtime/syscalls/tests/test_evt_full_log.c b/runtime/syscalls/tests/test_evt_full_log.c
new file mode 100644
index 0000000..8753cbb
--- /dev/null
+++ b/runtime/syscalls/tests/test_evt_full_log.c
@@ -0,0 +1,73 @@
+/*
+ * test_evt_full_log - sys_event_port_send's EBUSY is logged a bounded number
+ * of times per port (patch 6019, runtime/syscalls/evt_full_log.h).
+ *
+ *   cc -std=gnu17 -o test_evt_full_log runtime/syscalls/tests/test_evt_full_log.c
+ *   (installer/tools/np_log_test.sh builds and runs it)
+ *
+ * Checks: the first EBUSY of a port logs one line; 100000 more log nothing;
+ * the next send that is taken logs the run's length once; later runs, long
+ * or alternating with taken sends, log nothing; sends with no run open log
+ * nothing; a second port has lines of its own; the exit summary is one line
+ * per port that ever answered EBUSY, with the totals.
+ */
+#include "../evt_full_log.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+static int fails = 0;
+#define EXPECT(cond, what) do { if (!(cond)) { fprintf(stderr, "FAIL: %s\n", what); fails++; } } while (0)
+
+static char* read_all(FILE* f)
+{
+    fflush(f);
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    rewind(f);
+    char* t = (char*)calloc(1, (size_t)(n > 0 ? n : 0) + 1);
+    if (n > 0 && fread(t, 1, (size_t)n, f) != (size_t)n) { perror("read"); exit(2); }
+    return t;
+}
+
+static int count(const char* text, const char* needle)
+{
+    int n = 0;
+    for (const char* p = text; (p = strstr(p, needle)) != NULL; p += strlen(needle)) n++;
+    return n;
+}
+
+int main(void)
+{
+    static evt_full_site sites[8];
+    FILE* out = tmpfile();
+    if (!out) { perror("tmpfile"); return 2; }
+
+    for (int i = 0; i < 5; i++) evt_full_note_sent(&sites[2], out, 3, 7);    /* no run open: nothing */
+    for (int i = 0; i < 100001; i++) evt_full_note_busy(&sites[2], out, 3, 7);
+    evt_full_note_sent(&sites[2], out, 3, 7);                                  /* first run ends: 100001 */
+    for (int i = 0; i < 50000; i++) {                                          /* a size-1 queue: busy, taken, ... */
+        evt_full_note_busy(&sites[2], out, 3, 7);
+        evt_full_note_sent(&sites[2], out, 3, 7);
+    }
+    for (int i = 0; i < 300000; i++) evt_full_note_busy(&sites[2], out, 3, 7);  /* a long later run, never ended */
+    for (int i = 0; i < 3; i++) evt_full_note_busy(&sites[5], out, 6, 1);       /* another port */
+    char* during = read_all(out);
+
+    EXPECT(count(during, "\n") == 3, "3 lines for 450004 EBUSY on two ports");
+    EXPECT(count(during, "[evt] port_send(port=3): queue 7 FULL -> EBUSY (logged once per port") == 1, "port 3 first EBUSY");
+    EXPECT(count(during, "[evt] port_send(port=3): queue 7 took an event again after 100001 EBUSY") == 1, "port 3 first run's end");
+    EXPECT(count(during, "[evt] port_send(port=6): queue 1 FULL -> EBUSY (logged once per port") == 1, "port 6 first EBUSY");
+
+    evt_full_summary(sites, 8, out);
+    char* all = read_all(out);
+    const char* summary = all + strlen(during);
+    EXPECT(count(summary, "\n") == 2, "summary: one line per port that answered EBUSY");
+    EXPECT(count(summary, "[evt] port_send(port=3): 450001 EBUSY in 50002 runs, longest run 300000\n") == 1, "port 3 totals");
+    EXPECT(count(summary, "[evt] port_send(port=6): 3 EBUSY in 1 runs, longest run 3\n") == 1, "port 6 totals");
+
+    if (fails) fputs(all, stderr);
+    printf("test_evt_full_log: %s (%d failure%s)\n", fails ? "FAIL" : "ok", fails, fails == 1 ? "" : "s");
+    free(during); free(all); fclose(out);
+    return fails ? 1 : 0;
+}
