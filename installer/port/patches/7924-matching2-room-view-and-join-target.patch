+/* ---------------------------------------------------------------------------
+ * J-Stars patch 7924 (port, Discord Rich Presence and Join): a read-only view
+ * of the room and a join target. Any thread; each takes the state lock alone.
+ * -----------------------------------------------------------------------*/
+
+int ps3_np_matching2_room(u64* room, int* members, int* max, int* is_owner, char* peer, int peer_n)
+{
+    int r = 0;
+    if (room) *room = 0;
+    if (members) *members = 0;
+    if (max) *max = 0;
+    if (is_owner) *is_owner = 0;
+    if (peer && peer_n > 0) peer[0] = 0;
+    STATE_LOCK();
+    for (int i = 1; s_init && i <= SCE_NP_MATCHING2_CTX_MAX; i++) {
+        const m2_ctx* c = &s_ctx[i];
+        if (!c->in_use || !c->started) continue;
+        r = 1;
+        if (!c->room.in) continue;
+        r = 2;
+        if (room) *room = c->room.id;
+        if (members) *members = c->room.n;
+        if (max) *max = c->room.max;
+        if (is_owner) *is_owner = c->room.owner == c->room.me;
+        for (int k = 0; peer && peer_n > 0 && k < c->room.n; k++)
+            if (c->room.m[k].id != c->room.me) { snprintf(peer, (size_t)peer_n, "%s", c->room.m[k].online_id); break; }
+        break;
+    }
+    STATE_UNLOCK();
+    return r;
+}
+
+void ps3_np_matching2_set_join_target(u64 room)
+{
+    STATE_LOCK();
+    s_join_target = room;
+    s_join_state = room ? PS3_M2_JOIN_PENDING : PS3_M2_JOIN_NONE;
+    for (int i = 1; room && s_init && i <= SCE_NP_MATCHING2_CTX_MAX; i++)
+        if (s_ctx[i].in_use && s_ctx[i].started && s_ctx[i].room.in && s_ctx[i].room.id == room) s_join_state = PS3_M2_JOIN_JOINED;
+    STATE_UNLOCK();
+    if (room) printf("[sceNpMatching2] join target: room %llu\n", (unsigned long long)room);
+    else printf("[sceNpMatching2] join target cleared\n");
+}
+
+int ps3_np_matching2_join_target(u64* room)
+{
+    STATE_LOCK();
+    if (room) *room = s_join_target;
+    const int st = s_join_state;
+    STATE_UNLOCK();
+    return st;
+}
