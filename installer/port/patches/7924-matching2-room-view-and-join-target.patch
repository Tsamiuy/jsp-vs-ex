 s32 sceNpMatching2CreateRoom(u16 ctxId, u32 opt, u32 reqId);
 
+/* J-Stars patch 7924 (port, Discord Rich Presence and Join). Not SDK exports.
+ * ps3_np_matching2_room: 0 no started context, 1 a started context outside a
+ * room, 2 in a room (its id, member count, slots, whether this game owns it,
+ * and the online name of the first other member, "" when alone).
+ * ps3_np_matching2_set_join_target(room): while set, a SearchRoom answer lists
+ * that one room only (if it also passes the title's own filters); 0 clears.
+ * ps3_np_matching2_join_target: the PS3_M2_JOIN_* state of the target. */
+enum {
+    PS3_M2_JOIN_NONE = 0, PS3_M2_JOIN_PENDING = 1, PS3_M2_JOIN_LISTED = 2, PS3_M2_JOIN_JOINED = 3,
+    PS3_M2_JOIN_NOT_FOUND = -1, PS3_M2_JOIN_FULL = -2, PS3_M2_JOIN_FILTERED = -3, PS3_M2_JOIN_FAILED = -4
+};
+int  ps3_np_matching2_room(u64* room, int* members, int* max, int* is_owner, char* peer, int peer_n);
+void ps3_np_matching2_set_join_target(u64 room);
+int  ps3_np_matching2_join_target(u64* room);
+
 #ifdef __cplusplus
 }
 #endif
