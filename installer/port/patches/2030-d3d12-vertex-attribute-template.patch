Patch 2030: B32 step 2: per-draw attribute template, decode only array attributes (VF_FAST=0 old). Indexed upload ~132 -> 82-109 ns per vertex (boot168_vf)

Source: the maintainer's other port, toolkit b600eb8.


diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 92bc6711..2c3a26d1 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -6861,6 +6861,31 @@ static void read_vp_vertex(const rsx_state* state, u32 vi, VPSlot* out16)
     }
 }
 
+/* B32 step 2 (b): per draw, the attributes that come from arrays and a
+ * 256-byte template holding the constant-register values of the rest; per
+ * vertex, copy the template and decode only the arrays. that port's battle draws
+ * enable ~5 of 16, and read_vp_vertex called the fetch 16 times per vertex.
+ * Same values as read_vp_vertex (rsx_fetch_attrib gives a disabled or
+ * stride-0 attribute its constant). VF_FAST=0: the full fetch. */
+static struct { int n; int idx[16]; VPSlot tmpl[16]; int on; } s_vf = { 0, {0}, {{{0}}}, -1 };
+static void vf_prepare(const rsx_state* state)
+{
+    if (s_vf.on < 0) { const char* e = getenv("VF_FAST"); s_vf.on = (e && *e == '0') ? 0 : 1; }
+    s_vf.n = 0;
+    for (int i = 0; i < 16; i++) {
+        const rsx_vertex_attrib* a = &state->vertex_attribs[i];
+        if (a->enabled && a->stride) { s_vf.idx[s_vf.n++] = i; memset(s_vf.tmpl[i].v, 0, sizeof s_vf.tmpl[i].v); }
+        else rsx_fetch_attrib(state, i, 0, s_vf.tmpl[i].v);
+    }
+}
+static void read_vp_vertex_fast(const rsx_state* state, u32 vi, VPSlot* out16)
+{
+    if (!s_vf.on) { read_vp_vertex(state, vi, out16); return; }
+    if (s_vs_on > 0) s_vs.conv++;
+    memcpy(out16, s_vf.tmpl, sizeof s_vf.tmpl);
+    for (int k = 0; k < s_vf.n; k++) rsx_fetch_attrib(state, s_vf.idx[k], vi, out16[s_vf.idx[k]].v);
+}
+
