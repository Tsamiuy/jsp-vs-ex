     if (!state || !vm_base || !s_d3d.vp_vb_mapped || !s_d3d.vp_ib_mapped) return 0;
@@ -7382,7 +7409,7 @@ static u32 upload_strip_vp_ix(const rsx_state* state, u32 first, u32 count, int
         if (s_ix_stamp[ix] != s_ix_gen) {
             s_ix_stamp[ix] = s_ix_gen;
