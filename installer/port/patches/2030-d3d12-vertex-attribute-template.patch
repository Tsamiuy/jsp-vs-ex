@@ -7315,7 +7341,7 @@ static u32 upload_tris_vp_ix(const rsx_state* state, u32 first, u32 count, int c
         if (s_ix_stamp[ix] != s_ix_gen) {
             s_ix_stamp[ix] = s_ix_gen;
             s_ix_slot[ix] = n;
-            read_vp_vertex(state, ix, &vb[(u64)(s_ix_vbase + n) * 16]);
+            read_vp_vertex_fast(state, ix, &vb[(u64)(s_ix_vbase + n) * 16]);
             n++;
         }
         ib[k] = s_ix_slot[ix];
@@ -7342,6 +7368,7 @@ static int strip_ix_on(void)
 }
