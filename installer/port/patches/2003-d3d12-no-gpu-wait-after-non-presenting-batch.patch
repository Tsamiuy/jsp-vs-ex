Patch 2003: mid-frame flush without a CPU stall, failed fragment-program pipelines are cached, per-second [RSXFPS] line.

move_to_next_frame() after a non-presenting render_frame() waited for the fence it had just signalled, so every mid-frame flush and
every offscreen-only batch stalled the CPU until the GPU finished. A failed fragment-program build is remembered instead of being
retried every draw.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 6fbcee64..02442d51 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -2747,11 +2747,21 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
         s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&pso);
     pb->lpVtbl->Release(pb);
     if (FAILED(hr)) {
-        static int _e3=0; if (PS3_LOG_FIRST(_e3, 16)) printf("[FP] PSO FAIL (fp=0x%08X, 0x%08lX)\n", fp_addr, hr);
-        return NULL;
-    }
+        static int _e3=0; if (PS3_LOG_FIRST(_e3, 16)) {
+            printf("[FP] PSO FAIL (fp=0x%08X, 0x%08lX)\n", fp_addr, hr);
+            printf("[FP]   nrt=%d rtfmt=%u blend=0x%08X zs=0x%llX cmask=0x%X cull=%u vs=%d\n",
+                   nrt, (unsigned)rtfmt, (unsigned)blend, (unsigned long long)zs, (unsigned)cmask, (unsigned)cull, vs_idx);
+            if (_e3 == 1) { fprintf(stderr, "[FPFAIL-HLSL-BEGIN]\n%.3500s\n[FPFAIL-HLSL-END]\n", hlsl); fflush(stderr); }
+        }
+        /* J-Stars: keep the failure in the cache (pso NULL = draws take the
+         * fallback PS). Uncached, every draw of every frame repeated the full
+         * decompile + D3DCompile (15 s per 633-draw batch measured).
+         * Known cause of the failures: the VP root signature has only t0-t3. */
+        pso = NULL;
+    } else {
     { static int _ok=0; if (PS3_LOG_FIRST(_ok, 32)) printf("[FP] guest FP pipeline ready (fp=0x%08X)\n", fp_addr); }
     rdoc_name((ID3D12Object*)pso, "pso fp 0x%08X ucode %08X vs %d", fp_addr, uhash, vs_idx);
+    }
 
     /* insert (evict oldest when full) */
     if (s_d3d.vp_fp_n >= VP_FP_CACHE) {
@@ -4167,6 +4177,8 @@ static void ds_convert(int i, int rt)
  * render-to-texture pass) must still run -- it is what fills the texture a
  * later batch samples -- but presenting it would show a half-built frame. */
 static int s_present_this_frame = 1;
+/* VP_MIDFLUSH_WAIT=1: old behaviour, wait for the GPU after a non-presenting batch (comparison). */
+static int s_midflush_wait = 0;
 
 /* Resolve a DRAW_*_TEX value: a hex raw offset, or the literal "duck" for the
  * content-identified duck texture. */
@@ -5964,7 +5976,14 @@ skip_dump_consider: ;
     }
     rdoc_frame_end();
 
-    move_to_next_frame();
+    /* J-Stars: a batch that did not present keeps the same back buffer, so
+     * move_to_next_frame() would only wait for the fence it just signalled
+     * (a full CPU stall per mid-frame flush). The next render_frame() drains
+     * the GPU first (wait_for_gpu) before it reuses the allocator, texture ring
+     * and SRV heap, and the vertex/constant/index halves flip with the parity,
+     * so recording after a flush overlaps with the GPU rendering it. */
+    if (s_present_this_frame || s_midflush_wait)
+        move_to_next_frame();
 
     s_d3d.frame_count++;
 
@@ -5973,9 +5992,16 @@ skip_dump_consider: ;
     {
         static ULONGLONG s_tt0 = 0;
         static u64 s_tframes = 0;
+        static u64 s_tpres = 0;
         s_tframes++;
+        s_tpres += s_present_this_frame ? 1 : 0;
         ULONGLONG tnow = GetTickCount64();
         if (s_tt0 == 0) s_tt0 = tnow;
+        if (tnow - s_tt0 >= 1000)
+            fprintf(stderr, "[RSXFPS] renders/s=%.1f presents/s=%.1f frame_count=%u draws=%u\n",
+                    s_tframes * 1000.0 / (double)(tnow - s_tt0),
+                    s_tpres * 1000.0 / (double)(tnow - s_tt0), s_d3d.frame_count, s_dbg_last_draws);
+        if (tnow - s_tt0 >= 1000) s_tpres = 0;
         if (tnow - s_tt0 >= 1000 && s_d3d.hwnd) {
             extern char g_rsx_title_base[128];
             char tb[256];
@@ -7205,19 +7231,24 @@ static void vp_flush_if_full(u32 guest_count, int indexed)
 {
     static int off = -1;
     if (off < 0) off = getenv("VP_NO_MIDFLUSH") ? 1 : 0;
+    { static int w = 0; if (!w) { w = 1; s_midflush_wait = getenv("VP_MIDFLUSH_WAIT") != NULL; } }
     if (off || !s_d3d.initialized || s_d3d.draw_count == 0) return;
     u32 used = s_d3d.vp_vb_offset / VP_VERT_STRIDE;
     int full = used + guest_count * 3u > MAX_VERTICES || s_d3d.draw_count + 8 >= MAX_DRAWS;
     if (indexed && s_d3d.vp_ib_offset + guest_count * 3u > VP_MAX_INDICES) full = 1;
     if (!full) return;
     static u32 n = 0;
-    if (n < 20 || (n % 1000) == 0)
-        fprintf(stderr, "[MIDFLUSH] #%u records=%u vertices=%u/%u -> run without present\n",
-                n, s_d3d.draw_count, used, (u32)MAX_VERTICES);
-    n++;
+    static double t_end = 0.0;
+    double t0 = perf_now();
+    u32 recs = s_d3d.draw_count;
     s_present_this_frame = 0;
     render_frame();
     s_present_this_frame = 1;
+    if (n < 40 || (n % 1000) == 0)
+        fprintf(stderr, "[MIDFLUSH] #%u records=%u vertices=%u/%u -> run without present, render %.3fs, %.3fs since the last flush\n",
+                n, recs, used, (u32)MAX_VERTICES, perf_now() - t0, t_end > 0.0 ? t0 - t_end : 0.0);
+    n++;
+    t_end = perf_now();
 }
 
