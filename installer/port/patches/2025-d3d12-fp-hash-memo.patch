+/* The draw path asks for a program's code hash, size and texture-unit mask on every draw (about 1,100 a frame in a
+ * J-Stars fight), and each is a walk over the microcode (the hash a serial multiply per byte). All three depend only
+ * on the instruction blocks rsx_fp_code_hash visits, so: walk the program the same way, copy those blocks out and
+ * fold them into a 64-bit key, then look the key up in a small per-thread table whose entries keep the blocks they
+ * were computed from. A hit needs the same block count and identical blocks (memcmp), i.e. exactly the bytes the
+ * full functions would read, so the answers are the same. Keyed by content, not address: J-Stars copies every
+ * draw's program into a ring. The inline constants are skipped, as rsx_fp_code_hash skips them; the texture-unit
+ * mask does not depend on them either. SHADER_HASH_MEMO=0 computes everything every call. */
+#define FPM_SETS 256u
+#define FPM_WAYS 4u
+typedef struct { u64 key; u32 nblk, hash, size, units, cap; u8* blk; } FpMemoEntry;
+typedef struct { FpMemoEntry e[FPM_SETS][FPM_WAYS]; u8 rr[FPM_SETS]; u8 scratch[65536]; } FpMemo;
+static _Thread_local FpMemo* t_fpm;
+
+u32 rsx_fp_code_hash_memo(const u8* ucode, u32 max_bytes, u32* size_out, u32* units_out)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SHADER_HASH_MEMO"); on = (e && *e == '0') ? 0 : 1; }
+    FpMemo* m = t_fpm;
+    if (on && !m && ucode) m = t_fpm = (FpMemo*)calloc(1, sizeof(FpMemo));
+    if (!on || !m || !ucode || max_bytes > sizeof m->scratch) {
+        if (size_out) *size_out = rsx_fp_program_size(ucode, max_bytes);
+        if (units_out) *units_out = rsx_fp_texture_units(ucode, max_bytes);
+        return rsx_fp_code_hash(ucode, max_bytes);
+    }
+    /* The walk of rsx_fp_code_hash, copying instead of hashing. */
+    u64 k = 0x9E3779B97F4A7C15ull;
+    u32 off = 0, n = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        u64 a, b;
+        memcpy(&a, ucode + off, 8); memcpy(&b, ucode + off + 8, 8);
+        memcpy(m->scratch + (size_t)n * 16u, ucode + off, 16);
+        k = ((k << 23) | (k >> 41)) ^ a ^ (b * 0xC2B2AE3D27D4EB4Full);
+        n++;
+        off += 16;
+        const int is_branch = (w2 & FP_BRANCH) != 0;
+        const int has_k = !is_branch &&
+            ((((w1 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST) ||
+             (((w2 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST) ||
+             (((w3 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST));
+        if (has_k) off += 16;
+        if (w0 & FP_END) break;
+    }
+    k ^= (u64)n * 0x9E3779B97F4A7C15ull;
+    const u32 set = (u32)(k ^ (k >> 29) ^ (k >> 47)) & (FPM_SETS - 1u);
+    FpMemoEntry* e = m->e[set];
+    for (u32 w = 0; w < FPM_WAYS; w++)
+        if (e[w].blk && e[w].key == k && e[w].nblk == n &&
+            memcmp(e[w].blk, m->scratch, (size_t)n * 16u) == 0) {
+            if (size_out) *size_out = e[w].size;
+            if (units_out) *units_out = e[w].units;
+            return e[w].hash;
+        }
+    const u32 h = rsx_fp_code_hash(ucode, max_bytes);
+    const u32 size = rsx_fp_program_size(ucode, max_bytes);
+    const u32 units = rsx_fp_texture_units(ucode, max_bytes);
+    if (size_out) *size_out = size;
+    if (units_out) *units_out = units;
+    FpMemoEntry* v = &e[m->rr[set]++ % FPM_WAYS];
+    if (v->cap < n * 16u || !v->blk) {
+        u8* nb = (u8*)realloc(v->blk, n ? (size_t)n * 16u : 16u);
+        if (!nb) return h;
+        v->blk = nb; v->cap = n ? n * 16u : 16u;
+    }
+    memcpy(v->blk, m->scratch, (size_t)n * 16u);
+    v->key = k; v->nblk = n; v->hash = h; v->size = size; v->units = units;
+    return h;
+}
+
