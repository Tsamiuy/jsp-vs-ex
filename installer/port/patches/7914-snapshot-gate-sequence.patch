diff --git a/runtime/syscalls/sys_snapshot_census.c b/runtime/syscalls/sys_snapshot_census.c
index 7ecd6ab..0221959 100644
--- a/runtime/syscalls/sys_snapshot_census.c
+++ b/runtime/syscalls/sys_snapshot_census.c
@@ -13,6 +13,9 @@
 #include "sys_mutex.h"
 #include "sys_rwlock.h"
 #include "sys_ppu_thread.h"
+#ifdef _WIN32
+#include <windows.h>   /* patch 7914: WakeByAddressAll */
+#endif
 
 /* the port's View (jsp_snapshot_sync.h) is sized for exactly these tables */
 _Static_assert(SYS_EVENT_QUEUE_MAX == 128 && SYS_SEMAPHORE_MAX == 256 && PPU_THREAD_MAX == 64, "jsy::kEvq / kSem / kThr");
@@ -38,6 +41,53 @@ static __thread uint64_t t_mark_tid;
 #define MARK_TID(tid) do { if (t_mark_tid) (tid) = t_mark_tid; } while (0)
 volatile long g_ps3_hle_mark_overflows = 0, g_ps3_hle_mark_unbalanced = 0, g_ps3_hle_mark_fiber_swaps = 0;
 
+/* Patch 7914: the gate sequence of the port's event-driven quiesce gate (jsp_snapshot_sync.h gate_ev, JSP_SNAPSHOT_GATE=ev). Each bump site is
+ * a no-op unless the port armed it: one relaxed load of g_ps3_gate_armed. Armed, a site increments g_ps3_gate_line.seq (seq_cst) and, when the port's main thread
+ * waits on it (g_ps3_gate_line.waiters, seq_cst), wakes it with WakeByAddressAll. The waiter reads the sequence BEFORE its unfrozen precheck and WaitOnAddress
+ * compares it, so a bump between the two is never lost. The sites (counted per site for the log): 0 a thread enters an HLE call at a role park lr (the port's
+ * list), 1 a flip completion is marked pending (cellGcm_request_tick / cellGcmTickFlip set bit 2), 2 the flip pump (the interrupt thread's) marks the flip DONE, 3 the FIFO drain publishes
+ * a new get equal to put, 4 SPURS job-chain jobs in flight drop to 0, 5 a fiber enters cellFiberPpuWaitSignal. A missing site only costs a wait timeout
+ * (counted by the port as wake_timeouts): the frozen judge still decides every capture. */
+#define PS3_GATE_SITES 12
+/* One cache line holds everything the bumps WRITE (the sequence, the waiter count, the per-site counters) and nothing else, so the hot read of g_ps3_gate_armed
+ * (written once at init) never shares a line with it. The port waits on &g_ps3_gate_line.seq. */
+struct ps3_gate_line_t { volatile uint32_t seq; volatile int32_t waiters; volatile uint32_t bumps[PS3_GATE_SITES]; uint8_t pad[8]; } __attribute__((aligned(64)));
+struct ps3_gate_line_t g_ps3_gate_line;
+volatile int g_ps3_gate_armed __attribute__((aligned(64))) = 0;
+static uint32_t s_gate_lr[8];
+static volatile int s_gate_nlr = 0;
+static uint32_t s_gate_tnid[8];   /* HLE import NIDs that are a transit call (the port's Cfg::nid_transit): leaving one ends a block */
+static volatile int s_gate_ntnid = 0;
+void ps3_gate_bump(int site)
+{
+    if (site >= 0 && site < PS3_GATE_SITES) __atomic_add_fetch(&g_ps3_gate_line.bumps[site], 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&g_ps3_gate_line.seq, 1, __ATOMIC_SEQ_CST);
+#ifdef _WIN32
+    if (__atomic_load_n(&g_ps3_gate_line.waiters, __ATOMIC_SEQ_CST)) WakeByAddressAll((PVOID)&g_ps3_gate_line.seq);
+#endif
+}
+/* The port arms the sites once at init (before any thread waits) with the role park lrs (at most 8). on = 0 disarms. */
+void ps3_gate_arm(int on, const uint32_t* park_lrs, int n)
+{
+    if (n < 0) n = 0;
+    if (n > 8) n = 8;
+    for (int i = 0; i < n; i++) s_gate_lr[i] = park_lrs[i];
+    s_gate_nlr = n;
+    __atomic_store_n(&g_ps3_gate_armed, on ? 1 : 0, __ATOMIC_SEQ_CST);
+}
+/* Transit NIDs (at most 8), set once at init like the park lrs. */
+void ps3_gate_arm_transit(const uint32_t* nids, int n)
+{
+    if (n < 0) n = 0;
+    if (n > 8) n = 8;
+    for (int i = 0; i < n; i++) s_gate_tnid[i] = nids[i];
+    s_gate_ntnid = n;
+}
+void ps3_gate_bump_counts(uint32_t* out)   /* out[PS3_GATE_SITES = 12] */
+{
+    for (int i = 0; i < PS3_GATE_SITES; i++) out[i] = g_ps3_gate_line.bumps[i];
+}
+
