+/* A blocking receive waits here, in short poll slices, instead of inside the host recv, so sys_net_abort_socket can end it: on a PS3
+ * the aborted call returns -1 with errno EINTR. J-Stars' P2P teardown (0x46A2B8, after a lost opponent) sets its stop flag, aborts the
+ * UDP socket and joins the receive thread, which sits in a blocking recvfrom and leaves on EINTR. The host recvfrom never woke (the
+ * abort was not implemented), the join never returned and the next Online Battle sat on "Communicating..." for good.
+ * The poll still returns the moment the socket turns readable; the slices only bound how long an abort or close takes to be seen.
+ * wait_begin runs once per recv/recvfrom call, so the abort state and the SO_RCVTIMEO deadline hold across recvfrom's passes over
+ * psnr's own packets. */
+typedef struct {
+    long          seen;       /* abort_seen when the call started: an abort_gen other than this one is an abort */
+    host_socket_t fd;         /* the host socket the call started on */
+    uint64_t      deadline;   /* monotonic ms when SO_RCVTIMEO runs out, 0 = none */
+} recv_wait;
+
+static uint64_t mono_ms(void)
+{
+#ifdef _WIN32
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart) QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (uint64_t)(c.QuadPart / f.QuadPart) * 1000u + (uint64_t)(c.QuadPart % f.QuadPart) * 1000u / (uint64_t)f.QuadPart;
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+#endif
+}
+
+static void wait_begin(int32_t s, recv_wait* w)
+{
+    w->seen = net_atomic_load(&s_sockets[s].abort_seen);
+    w->fd = s_sockets[s].host_fd;
+    w->deadline = s_sockets[s].rcvtimeo_ms ? mono_ms() + s_sockets[s].rcvtimeo_ms : 0;
+}
+
+/* Aborted since the call started, or closed under it (close and finalize_network bump abort_gen; the in_use and host_fd checks also
+ * catch a slot or host socket that was reused). A closed socket ends the wait with EINTR, as the blocking host recv did on Windows
+ * when another thread closed the socket (WSAEINTR); a guest loop that leaves on EINTR still leaves. */
+static int wait_aborted(int32_t s, recv_wait* w)
+{
+    const long gen = net_atomic_load(&s_sockets[s].abort_gen);
+    if (gen != w->seen) {
+        net_atomic_cas(&s_sockets[s].abort_seen, w->seen, gen);   /* consumed; other waiters keep their own snapshot */
+        return 1;
+    }
+    return !s_sockets[s].in_use || s_sockets[s].host_fd != w->fd;
+}
+
+/* Returns 0 = data (or an error) is ready for the host call, -1 = SO_RCVTIMEO ran out (EWOULDBLOCK), -2 = aborted or closed (EINTR),
+ * -3 = the poll itself failed (host_fail() gives the error). */
+static int wait_readable(int32_t s, int32_t flags, recv_wait* w)
+{
+    if (s_sockets[s].nonblocking || (flags & SYS_NET_MSG_DONTWAIT)) return 0;
+    for (;;) {
+        if (wait_aborted(s, w)) return -2;
+        int slice = 100;
+        if (w->deadline) {
+            const uint64_t now = mono_ms();
+            if (now >= w->deadline) return -1;
+            if (w->deadline - now < 100) slice = (int)(w->deadline - now);
+        }
+        host_pollfd p;
+        p.fd = w->fd;
+        p.events = POLLIN;
+        p.revents = 0;
+        const int r = host_poll(&p, 1, slice);
+        if (wait_aborted(s, w)) return -2;
+        if (r > 0) return 0;
+        if (r < 0) {
+#ifndef _WIN32
+            if (errno == EINTR) continue;   /* a signal: look at the abort state again, never fall into a blocking recv */
+#endif
+            return -3;
+        }
+    }
+}
