 static uint32_t errno_cell(void) { return vm_read32((uint32_t)call("_sys_net_errno_loc", 0, 0, 0, 0, 0, 0)); }
 
+/* A receiver blocked in recvfrom on another thread (a title's receive thread), and what it saw. The main thread acts once the
+ * receiver says it is about to call recvfrom; an abort that lands before the call starts still ends it (the abort stays pending), so
+ * the result does not depend on timing. Every rx socket has a 5 s SO_RCVTIMEO, so a lost abort fails the test (EWOULDBLOCK) instead
+ * of hanging it. */
+static struct { int32_t s; uint32_t ret, err, err0; volatile long started; } s_rx;
+static void rx_body(void)
+{
+    s_rx.err0 = errno_cell();   /* a new thread's errno: 0, whatever other threads left */
+    net_atomic_store(&s_rx.started, 1);
+    s_rx.ret = (uint32_t)call("recvfrom", s_rx.s, BUF + 0x400, 64, 0, 0, 0);
+    s_rx.err = errno_cell();
+}
+static void wait_rx_started(void)
+{
+    while (!net_atomic_load(&s_rx.started)) net_yield();
+}
+#ifdef _WIN32
+static DWORD WINAPI rx_thread(LPVOID u) { (void)u; rx_body(); return 0; }
+static void run_rx(int (*mid)(void))
+{
+    net_atomic_store(&s_rx.started, 0);
+    HANDLE h = CreateThread(NULL, 0, rx_thread, NULL, 0, NULL);
+    wait_rx_started(); mid();
+    assert(WaitForSingleObject(h, 15000) == WAIT_OBJECT_0);   /* watchdog: never hang the suite */
+    CloseHandle(h);
+}
+#else
+static void* rx_thread(void* u) { (void)u; rx_body(); return NULL; }
+static void run_rx(int (*mid)(void))
+{
+    pthread_t t;
+    net_atomic_store(&s_rx.started, 0);
+    pthread_create(&t, NULL, rx_thread, NULL);
+    wait_rx_started(); mid(); pthread_join(t, NULL);   /* returns within the 5 s SO_RCVTIMEO at worst */
+}
+#endif
+static int abort_rx(void) { return C3("sys_net_abort_socket", s_rx.s, 0, 0); }
+static int send_rx(void) { return (int)call("sendto", s_rx.s, BUF + 0x500, 2, 0, ADDR_A + 0x40, 16); }
+static int close_rx(void) { sleep_ms(20); return C1("socketclose", s_rx.s); }
+static int late_abort_rx(void) { sleep_ms(700); return abort_rx(); }
+static int psnr_then_abort_rx(void)
+{
+    const uint8_t lo[4] = { 127, 0, 0, 1 };
+    assert(s_sender("PSNR\x02zzzz", 9, lo, np_psnr_p2p_port()) == 9);   /* wakes the receiver; the filter eats it and recvfrom loops */
+    return abort_rx();
+}
+static void set_rcvtimeo(int32_t s, uint64_t sec, uint64_t usec)
+{
+    vm_write64(OPT, sec);
+    vm_write64(OPT + 8, usec);
