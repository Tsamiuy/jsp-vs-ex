@@ -4222,6 +4231,23 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
 
 /* The SET_SHADER_CONTROL bits a guest FP's translation depends on. */
 #define FP_CTRL_BITS (CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS | CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT)
+/* SET_SHADER_PACKER for the draw being recorded: nonzero = the colour is written through the sRGB curve (8-bit
+ * integer targets only; rsx_fp_srgb_output_enabled). SRGB_OUT=0: off (the old linear output). that port d95db3c. */
+static u32 rec_fp_ctrl(void);
+static u32 rec_srgb_out(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SRGB_OUT"); on = (e && *e == '0') ? 0 : 1; }
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!on || !st || !st->shader_packer) return 0;
+    const u32 r = (u32)rsx_fp_srgb_output_enabled(st->shader_packer, rec_fp_ctrl(), st->surface_format & 0x1Fu);
+    { static u32 seen[8]; static int ns = 0; const u32 k = st->shader_packer ^ (st->surface_format << 8) ^ (r << 31);
+      int f = 0; for (int i = 0; i < ns; i++) f |= seen[i] == k;
+      if (!f && ns < 8) { seen[ns++] = k;
+          fprintf(stderr, "[SRGBOUT] packer=0x%X surface fmt=0x%X fp=0x%X -> sRGB output %s%c", st->shader_packer,
+                  st->surface_format & 0x1Fu, st->shader_program, r ? "ON" : "off (float/32-bit target)", 10); } }
+    return r;
+}
 static u32 rec_fp_ctrl(void)
 {
     const rsx_state* st = s_d3d.current_rsx_state;
