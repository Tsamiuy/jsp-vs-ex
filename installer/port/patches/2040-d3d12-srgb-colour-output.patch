+    /* SET_SHADER_PACKER: the RSX writes this program's colour through the linear -> sRGB curve (key bit 29).
+     * From that port (toolkit d95db3c): without it its tone map came out linear. */
+    if (cube_mask & (1u << 29)) {
+        const int r = rsx_fp_apply_srgb_output(hlsl, sizeof hlsl);
+        static int _sg = 0; if (PS3_LOG_FIRST(_sg, 12))
+            fprintf(stderr, "[SRGBOUT] fp=0x%X compiled with sRGB output -> %d%c", fp_addr, r, 10);
