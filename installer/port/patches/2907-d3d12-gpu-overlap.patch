+/* Patch 2907: GPU_OVERLAP=1, the CPU builds the next frame while the GPU draws this one. */
+static int gpu_overlap_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GPU_OVERLAP"); on = (e && *e == '1') ? 1 : 0;
+                  if (on) fprintf(stderr, "[OVERLAP] on: render_frame does not wait for the GPU first%c", 10); }
