@@ -0,0 +1,374 @@
+/* Patch 2069: the pipeline warm-up file (pipelines.bin), 64-bit offsets, bounded and compacted.
+ *
+ * Plain C with no Direct3D types, so a host test can compile it (installer/tools/psow_file_test.c).
+ *
+ * File layout: one file head {'PSWH', format, stamp, record head size, 0} (24 bytes), then records. A record is a fixed head of `hdr_size` bytes
+ * whose first 24 bytes are PswRecHead (magic, vs_len, ps_len, n_il, key), then vs_len + ps_len bytes of shader bytecode.
+ * A file without the head (written before this patch) is read as records from byte 0 and given a head when it is rewritten.
+ *
+ * The warm-up does not hold the file in memory: psw_scan notes where each record starts, and each warm-up thread reads one record at a
+ * time from its own handle (psw_read_record).
+ *
+ * Why this exists: the reader took the file size with `long` (32 bits on Windows), so a file of 2 GiB or more read as
+ * negative, nothing was loaded and nothing was said; with an empty noted-set every pipeline of the run was appended again,
+ * so the file grew by a whole table each start. Here every size and offset is 64-bit, every early return logs its reason,
+ * a key already in the file is never appended, and a file with repeated keys, a damaged tail, more records than the table
+ * holds, or a head from another build is rewritten to a temporary file that replaces the old one in one step. */
+#ifndef PSOW_FILE_H
+#define PSOW_FILE_H
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <io.h>
+#else
+#include <sys/types.h>
+#include <unistd.h>
+#endif
+
+#ifndef PSW_LOG
+#define PSW_LOG(...) do { fprintf(stderr, "[PSOW] "); fprintf(stderr, __VA_ARGS__); fputc('\n', stderr); } while (0)
+#endif
+
+typedef int64_t psw_off;   /* every file size and offset in this file: never `long`, never ftell/fseek */
+#ifdef _WIN32
+static psw_off psw_tell(FILE* f) { return (psw_off)_ftelli64(f); }
+static int psw_seek(FILE* f, psw_off o, int whence) { return _fseeki64(f, o, whence); }
+#else
+typedef char psw_off_t_is_64_bit[sizeof(off_t) == 8 ? 1 : -1];
+static psw_off psw_tell(FILE* f) { return (psw_off)ftello(f); }
+static int psw_seek(FILE* f, psw_off o, int whence) { return fseeko(f, (off_t)o, whence); }
+#endif
+
+/* Replace dst with tmp in one step; the old dst stays when this fails. (A test may define PSW_REPLACE.) */
+#ifndef PSW_REPLACE
+#ifdef _WIN32
+#define PSW_REPLACE(tmp, dst) (MoveFileExA((tmp), (dst), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) ? 0 : -1)
+#else
+#define PSW_REPLACE(tmp, dst) rename((tmp), (dst))
+#endif
+#endif
+static int psw_sync(FILE* f)
+{
+#ifdef _WIN32
+    return _commit(_fileno(f));
+#else
+    return fsync(fileno(f));
+#endif
+}
+
+#define PSW_REC_MAGIC  0x32575350u   /* "PSW2": a record */
+#define PSW_FILE_MAGIC 0x48575350u   /* "PSWH": the file head */
+#define PSW_FORMAT     3u
+typedef struct { uint32_t magic, vs_len, ps_len, n_il; uint64_t key; } PswRecHead;   /* first 24 bytes of a record */
+typedef struct { uint32_t magic, format; uint64_t stamp; uint32_t hdr_size, reserved; } PswFileHead;   /* 24 bytes; hdr_size lets a reader (the support bundle) walk the records */
+
+/* Set of keys already in the file (this run or on disk): at most `max` keys in a table twice that size (so a probe ends). */
+typedef struct { uint64_t* slot; uint32_t slots, n, max; } PswNoted;
+static int psw_noted_init(PswNoted* s, uint32_t max)
+{
+    uint32_t n = 16; while (n < max * 2u) n <<= 1;
+    s->slot = (uint64_t*)calloc(n, sizeof(uint64_t)); s->slots = n; s->n = 0; s->max = max;
+    return s->slot != NULL;
+}
+static void psw_noted_clear(PswNoted* s) { if (s->slot) memset(s->slot, 0, (size_t)s->slots * sizeof(uint64_t)); s->n = 0; }
+static void psw_noted_free(PswNoted* s) { free(s->slot); s->slot = NULL; s->slots = s->n = 0; }
+static int psw_noted_has(const PswNoted* s, uint64_t key)
+{
+    uint32_t i = (uint32_t)(key ^ (key >> 29)) & (s->slots - 1u);
+    while (s->slot[i]) { if (s->slot[i] == key) return 1; i = (i + 1u) & (s->slots - 1u); }
+    return 0;
+}
+/* Forget a key (back-shift deletion, so no probe chain is cut). */
+static void psw_noted_remove(PswNoted* s, uint64_t key)
+{
+    const uint32_t mask = s->slots - 1u;
+    uint32_t i = (uint32_t)(key ^ (key >> 29)) & mask;
+    while (s->slot[i] && s->slot[i] != key) i = (i + 1u) & mask;
+    if (!s->slot[i]) return;
+    for (uint32_t j = i;;) {
+        s->slot[i] = 0;
+        for (;;) {
+            j = (j + 1u) & mask;
+            if (!s->slot[j]) { s->n--; return; }
+            const uint64_t kk = s->slot[j];
+            const uint32_t home = (uint32_t)(kk ^ (kk >> 29)) & mask;
+            if (i <= j ? (home <= i || home > j) : (home <= i && home > j)) break;   /* j's chain passes i: it moves to i */
+        }
+        s->slot[i] = s->slot[j]; i = j;
+    }
+}
+/* 0 = new key, now noted; 1 = already noted; 2 = new but the set is at its maximum (not noted). */
+static int psw_noted_add(PswNoted* s, uint64_t key)
+{
+    uint32_t i = (uint32_t)(key ^ (key >> 29)) & (s->slots - 1u);
+    while (s->slot[i]) { if (s->slot[i] == key) return 1; i = (i + 1u) & (s->slots - 1u); }
+    if (s->n >= s->max) return 2;
+    s->slot[i] = key; s->n++;
+    return 0;
+}
+
+typedef struct {
+    const char* path;
+    uint32_t hdr_size;      /* bytes of a record's fixed head (>= sizeof(PswRecHead)) */
+    uint32_t max_bytes;     /* most bytes of one shader */
+    uint32_t max_records;   /* the capacity of the file: the most distinct records it keeps */
+    uint64_t stamp;         /* identity of the build whose pipelines these are (changes when the translator or the record layout does) */
+    /* Optional: 1 when a whole record (head, VS, PS in one buffer) still hashes to its key. A record that fails is not copied by a
+     * rewrite and not built by the warm-up. */
+    int (*verify)(const unsigned char* rec, uint32_t hdr_size, uint32_t vs_len, uint32_t ps_len);
+    PswNoted noted;
+    psw_off* offs;          /* file offset of the first record of each key, in file order (filled by psw_scan): the warm-up reads from these */
+    uint32_t n_offs;
+    FILE* out;
+    psw_off size;           /* file size after prepare */
+    uint32_t n_records;     /* records in the file after prepare */
+    int ready, dead, full_said, marked;
+} PswCache;
+
+static int psw_init(PswCache* c, const char* path, uint32_t hdr_size, uint32_t max_bytes, uint32_t max_records, uint64_t stamp)
+{
+    memset(c, 0, sizeof *c);
+    c->path = path; c->hdr_size = hdr_size; c->max_bytes = max_bytes; c->max_records = max_records; c->stamp = stamp;
+    c->offs = (psw_off*)calloc(max_records ? max_records : 1, sizeof(psw_off));
+    return psw_noted_init(&c->noted, max_records) && c->offs != NULL;
+}
+static void psw_free(PswCache* c)
+{
+    if (c->out) { fclose(c->out); c->out = NULL; }
+    psw_noted_free(&c->noted); free(c->offs); c->offs = NULL; c->n_offs = 0;
+}
+/* The error of a failed C stdio call (fopen, fread, fwrite, fflush, remove): errno. */
+static unsigned long psw_error(void) { return (unsigned long)errno; }
+/* The error of a failed PSW_REPLACE: GetLastError() on Windows (MoveFileEx does not set errno), errno elsewhere. Read right after it. */
+static unsigned long psw_replace_error(void)
+{
+#ifdef _WIN32
+    return (unsigned long)GetLastError();
+#else
+    return (unsigned long)errno;
+#endif
+}
+
+/* A flag set once and read by many threads without a lock: an acquire read and a full-barrier store. */
+#ifdef _WIN32
+static int psw_flag_get(volatile long* f) { return InterlockedCompareExchange(f, 0, 0) != 0; }
+static void psw_flag_set(volatile long* f) { InterlockedExchange(f, 1); }
+#else
+static int psw_flag_get(volatile long* f) { return __atomic_load_n(f, __ATOMIC_ACQUIRE) != 0; }
+static void psw_flag_set(volatile long* f) { __atomic_store_n(f, 1, __ATOMIC_SEQ_CST); }
+#endif
+
+/* 1 = a valid record head at pos (end = where the record ends); 0 = not a record (end of the list: nothing, a torn or bad head);
+ * -1 = the file could not be read there (an I/O error is not the end of the file). */
+static int psw_rec_at(const PswCache* c, FILE* f, psw_off pos, psw_off size, PswRecHead* h, psw_off* end)
+{
+    if (pos < 0 || size - pos < (psw_off)c->hdr_size) return 0;
+    if (psw_seek(f, pos, SEEK_SET) != 0) return -1;
+    if (fread(h, sizeof *h, 1, f) != 1) return ferror(f) ? -1 : 0;
+    if (h->magic != PSW_REC_MAGIC || !h->key || h->vs_len > c->max_bytes || h->ps_len > c->max_bytes ||
+        (h->n_il != 0 && h->n_il != 16)) return 0;
+    *end = pos + (psw_off)c->hdr_size + (psw_off)h->vs_len + (psw_off)h->ps_len;
+    return *end <= size;
+}
+
+typedef struct { psw_off size, good_end; int has_head, stamp_ok; uint64_t n_rec, n_unique, n_repeat, n_over; } PswScan;
+/* Walk the records (seeking over the bytecode, so a multi-gigabyte file costs one small read per record). Distinct keys go
+ * into c->noted and their offsets into c->offs. Returns 0, or -1 when the size or a record head cannot be read. */
+static int psw_scan(PswCache* c, FILE* f, PswScan* s)
+{
+    memset(s, 0, sizeof *s); c->n_offs = 0;
+    if (psw_seek(f, 0, SEEK_END) != 0) return -1;
+    s->size = psw_tell(f);
+    if (s->size < 0 || psw_seek(f, 0, SEEK_SET) != 0) return -1;
+    psw_off pos = 0; PswFileHead fh;
+    if (s->size >= (psw_off)sizeof fh && fread(&fh, sizeof fh, 1, f) == 1 && fh.magic == PSW_FILE_MAGIC) {
+        s->has_head = 1; s->stamp_ok = fh.format == PSW_FORMAT && fh.stamp == c->stamp && fh.hdr_size == c->hdr_size;
+        pos = (psw_off)sizeof fh;
+        if (!s->stamp_ok) { s->good_end = pos; return 0; }
+    }
+    PswRecHead h; psw_off end; int r;
+    while ((r = psw_rec_at(c, f, pos, s->size, &h, &end)) > 0) {
+        s->n_rec++;
+        const int a = psw_noted_add(&c->noted, h.key);
+        if (a == 0) { s->n_unique++; if (c->n_offs < c->max_records) c->offs[c->n_offs++] = pos; }
+        else if (a == 1) s->n_repeat++; else s->n_over++;
+        pos = end;
+    }
+    if (r < 0) return -1;
+    s->good_end = pos;
+    return 0;
+}
+
+/* Write the file again to path.tmp (the head, then the first valid record of each key, at most max_records; none when
+ * keep_records is 0) and replace the old file with it. The old file is not touched unless every byte is written and synced
+ * and the replacement succeeds; on any failure the temporary file is removed (and a failure to remove it is logged) and -1 is
+ * returned. A record whose bytes do not hash to its key (c->verify) is left out and counted in *dropped. */
+static int psw_rewrite(PswCache* c, int keep_records, uint64_t* kept, uint64_t* dropped)
+{
+    char tmp[1024]; PswNoted seen; FILE *in = NULL, *out = NULL; int rc = -1; const char* why = ""; unsigned long err = 0;
+    unsigned char* rec = NULL;
+    *kept = 0; *dropped = 0;
+    if (snprintf(tmp, sizeof tmp, "%s.tmp", c->path) >= (int)sizeof tmp) { PSW_LOG("%s: path too long, file kept as it is", c->path); return -1; }
+    if (!psw_noted_init(&seen, c->max_records)) { PSW_LOG("%s: out of memory, file kept as it is", c->path); return -1; }
+    out = fopen(tmp, "wb");
+    if (!out) { why = "cannot create the temporary file"; err = psw_error(); goto done; }
+    PswFileHead fh = { PSW_FILE_MAGIC, PSW_FORMAT, c->stamp, c->hdr_size, 0 };
+    if (fwrite(&fh, sizeof fh, 1, out) != 1) { why = "cannot write the head"; err = psw_error(); goto done; }
+    if (keep_records) {
+        const size_t cap = (size_t)c->hdr_size + 2u * (size_t)c->max_bytes;
+        rec = (unsigned char*)malloc(cap);
+        if (!rec) { why = "out of memory for the record buffer"; err = 0; goto done; }
+        in = fopen(c->path, "rb");
+        if (!in) { why = "cannot reopen the old file"; err = psw_error(); goto done; }
+        if (psw_seek(in, 0, SEEK_END) != 0) { why = "cannot size the old file"; err = psw_error(); goto done; }
+        const psw_off size = psw_tell(in); psw_off pos = 0; PswFileHead oh;
+        if (size < 0 || psw_seek(in, 0, SEEK_SET) != 0) { why = "cannot size the old file"; err = psw_error(); goto done; }
+        if (size >= (psw_off)sizeof oh && fread(&oh, sizeof oh, 1, in) == 1 && oh.magic == PSW_FILE_MAGIC) pos = (psw_off)sizeof oh;
+        PswRecHead h; psw_off end; int r;
+        while ((r = psw_rec_at(c, in, pos, size, &h, &end)) > 0) {
+            if (psw_noted_has(&seen, h.key)) { pos = end; continue; }   /* a repeat: the first one was taken */
+            const size_t n = (size_t)(end - pos);
+            if (psw_seek(in, pos, SEEK_SET) != 0 || fread(rec, 1, n, in) != n) { why = "read failed"; err = psw_error(); goto done; }
+            pos = end;
+            if (c->verify && !c->verify(rec, c->hdr_size, h.vs_len, h.ps_len)) { (*dropped)++; continue; }   /* its key stays free for a whole copy later */
+            if (psw_noted_add(&seen, h.key) != 0) continue;                  /* beyond the capacity */
+            if (fwrite(rec, 1, n, out) != n) { why = "write failed"; err = psw_error(); goto done; }
+            (*kept)++;
+        }
+        if (r < 0) { why = "a record head could not be read"; err = psw_error(); goto done; }
+    }
+    if (fflush(out) != 0 || ferror(out) || psw_sync(out) != 0) { why = "write or sync failed"; err = psw_error(); goto done; }
+    if (fclose(out) != 0) { out = NULL; why = "close failed"; err = psw_error(); goto done; }
+    out = NULL;
+    if (in) { fclose(in); in = NULL; }
+    if (PSW_REPLACE(tmp, c->path) != 0) { why = "cannot replace the old file"; err = psw_replace_error(); goto done; }
+    rc = 0;
+done:
+    if (out) fclose(out);
+    if (in) fclose(in);
+    free(rec);
+    if (rc != 0) {
+        PSW_LOG("%s: rewrite failed (%s, error %lu), the old file is kept", c->path, why, err);
+        if (remove(tmp) != 0 && errno != ENOENT) PSW_LOG("%s: the temporary file %s could not be removed (error %lu); it can be deleted by hand", c->path, tmp, psw_error());
+    }
+    psw_noted_free(&seen);
+    return rc;
+}
+
+/* Read the file head and records, compact it when it needs it, and note every key. Logs what it found and why it returns.
+ * Returns the number of records in the file (0 when there is none or it was emptied), or -1 when the cache cannot be used
+ * this run (nothing is read or written then, the file is left as it is). After it, c->offs[0 .. c->n_offs) are the offsets
+ * psw_read_record reads from. */
+/* path + ".rewrite": left by psw_mark_bad when the warm-up refused a record, so the next start rewrites the file (and drops it). */
+static void psw_marker_name(const PswCache* c, char* out, size_t n) { snprintf(out, n, "%s.rewrite", c->path); }
+static int psw_prepare(PswCache* c)
+{
+    FILE* f = fopen(c->path, "rb"); PswScan s;
+    char marker[1032]; int marked;
+    c->ready = 1;
+    psw_marker_name(c, marker, sizeof marker);
+    { FILE* m = fopen(marker, "rb"); marked = m != NULL; if (m) fclose(m); }
+    if (!f) { PSW_LOG("%s: no file yet (first start)", c->path); return 0; }
+    if (psw_scan(c, f, &s) != 0) {
+        const unsigned long e = psw_error();
+        fclose(f); c->dead = 1;
+        PSW_LOG("%s: cannot read the file size or a record head (error %lu); warm-up is off for this run and the file is kept", c->path, e);
+        return -1;
+    }
+    fclose(f);
+    PSW_LOG("%s: %lld bytes, %s, %llu records (%llu distinct, %llu repeated, %llu beyond the capacity of %u), %lld bytes after the last whole record",
+            c->path, (long long)s.size, !s.has_head ? "no head (older build)" : s.stamp_ok ? "head matches this build" : "head from another build",
+            (unsigned long long)s.n_rec, (unsigned long long)s.n_unique, (unsigned long long)s.n_repeat, (unsigned long long)s.n_over,
+            c->max_records, (long long)(s.size - s.good_end));
+    if (s.size == 0) { c->size = 0; c->n_offs = 0; return 0; }   /* an empty file: the first note writes the head */
+    const int stale = s.has_head && !s.stamp_ok;
+    if (stale || !s.has_head || s.n_repeat || s.n_over || s.good_end != s.size || marked) {
+        uint64_t kept = 0, dropped = 0;
+        if (psw_rewrite(c, !stale, &kept, &dropped) != 0) {
+            c->dead = 1; psw_noted_clear(&c->noted); c->n_offs = 0;
+            PSW_LOG("%s: warm-up is off for this run", c->path);
+            return -1;
+        }
+        if (marked && remove(marker) != 0) PSW_LOG("%s: the marker %s could not be removed (error %lu); the file is rewritten again at the next start", c->path, marker, psw_error());
+        PSW_LOG("%s: rewritten to %llu records (%s)%s", c->path, (unsigned long long)kept,
+                stale ? "emptied, it was made by another build" : "repeats, damaged tail, over-capacity records, records that failed a read and the missing head removed",
+                dropped ? "; some records did not match their key" : "");
+        if (dropped) PSW_LOG("%s: %llu records did not hash to their key (a torn write in the middle of an older file) and were dropped", c->path, (unsigned long long)dropped);
+        /* the new file is the truth: count it again (the keys of a dropped record are free again) */
+        psw_noted_clear(&c->noted);
+        f = fopen(c->path, "rb");
+        if (!f || psw_scan(c, f, &s) != 0) {
+            const unsigned long e = psw_error();
+            if (f) fclose(f);
+            c->dead = 1; psw_noted_clear(&c->noted); c->n_offs = 0;
+            PSW_LOG("%s: cannot read the rewritten file (error %lu); warm-up is off for this run", c->path, e);
+            return -1;
+        }
+        fclose(f);
+    }
+    c->n_records = (uint32_t)s.n_unique; c->size = s.size;
+    PSW_LOG("%s: %u records, %lld bytes", c->path, c->n_records, (long long)c->size);
+    return (int)c->n_records;
+}
+
+/* Read record number idx (of c->offs) into buf (cap bytes: hdr_size + 2 * max_bytes is always enough) from f, a handle the caller
+ * opened on the file (each warm-up thread has its own, so nothing is shared and the file is never held in memory).
+ * 1 = read whole and (when c->verify is set) hashing to its key; 0 = not readable (bad head, torn, or the file changed);
+ * 2 = read whole but failed c->verify (h is valid: its key is the one to forget, see psw_mark_bad). */
+static int psw_read_record(const PswCache* c, FILE* f, uint32_t idx, unsigned char* buf, size_t cap, PswRecHead* h)
+{
+    if (idx >= c->n_offs) return 0;
+    const psw_off pos = c->offs[idx];
+    if (psw_seek(f, pos, SEEK_SET) != 0 || fread(h, sizeof *h, 1, f) != 1) return 0;
+    if (h->magic != PSW_REC_MAGIC || !h->key || h->vs_len > c->max_bytes || h->ps_len > c->max_bytes) return 0;
+    const size_t n = (size_t)c->hdr_size + h->vs_len + h->ps_len;
+    if (n > cap || psw_seek(f, pos, SEEK_SET) != 0 || fread(buf, 1, n, f) != n) return 0;
+    return (!c->verify || c->verify(buf, c->hdr_size, h->vs_len, h->ps_len)) ? 1 : 2;
+}
+
+/* The warm-up refused record `key` (return 2 of psw_read_record): forget the key, so the pipeline can be noted again, and leave the marker
+ * that makes the next start rewrite the file. The caller serialises with psw_note. */
+static void psw_mark_bad(PswCache* c, uint64_t key)
+{
+    psw_noted_remove(&c->noted, key);
+    if (c->marked) return;
+    char marker[1032]; psw_marker_name(c, marker, sizeof marker);
+    FILE* m = fopen(marker, "wb");
+    if (m) { fclose(m); c->marked = 1; PSW_LOG("%s: a record did not match its key; the file is rewritten at the next start", c->path); }
+    else PSW_LOG("%s: a record did not match its key and the marker %s could not be made (error %lu)", c->path, marker, psw_error());
+}
+
+/* Append one record: 0 appended, 1 its key is already in the file, 2 the file is at its capacity (said once), -1 writing is off
+ * or failed (said once). `rec` is the fixed head (hdr_size bytes, its first 24 bytes a PswRecHead). The caller serialises. */
+static int psw_note(PswCache* c, const void* rec, const void* vs, const void* ps)
+{
+    const PswRecHead* h = (const PswRecHead*)rec;
+    if (c->dead) return -1;
+    const int r = psw_noted_add(&c->noted, h->key);
+    if (r == 1) return 1;
+    if (r == 2) {
+        if (!c->full_said) { c->full_said = 1; PSW_LOG("%s: full (%u records), new pipelines are not kept for the next start", c->path, c->max_records); }
+        return 2;
+    }
+    if (!c->out) {
+        c->out = fopen(c->path, "ab");
+        if (c->out && psw_seek(c->out, 0, SEEK_END) == 0 && psw_tell(c->out) == 0) {
+            PswFileHead fh = { PSW_FILE_MAGIC, PSW_FORMAT, c->stamp, c->hdr_size, 0 };
+            if (fwrite(&fh, sizeof fh, 1, c->out) != 1) { fclose(c->out); c->out = NULL; }
+        }
+        if (!c->out) { c->dead = 1; PSW_LOG("%s: cannot open for appending (error %lu); new pipelines are not kept", c->path, psw_error()); return -1; }
+    }
+    if (fwrite(rec, c->hdr_size, 1, c->out) != 1 || (h->vs_len && fwrite(vs, 1, h->vs_len, c->out) != h->vs_len) ||
+        (h->ps_len && fwrite(ps, 1, h->ps_len, c->out) != h->ps_len) || fflush(c->out) != 0) {
+        c->dead = 1; fclose(c->out); c->out = NULL;
+        PSW_LOG("%s: write failed (error %lu); new pipelines are not kept (the damaged tail is cut at the next start)", c->path, psw_error());
+        return -1;
+    }
+    c->n_records++;
+    return 0;
