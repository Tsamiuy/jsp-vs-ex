diff --git a/libs/video/psow_file.h b/libs/video/psow_file.h
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/libs/video/psow_file.h
@@ -0,0 +1,283 @@
+/* Patch 2069: the pipeline warm-up file (pipelines.bin), 64-bit offsets, bounded and compacted.
+ *
+ * Plain C with no Direct3D types, so a host test can compile it (installer/tools/psow_file_test.c).
+ *
+ * File layout: one file head {'PSWH', format, stamp, record head size, 0} (24 bytes), then records. A record is a fixed head of `hdr_size` bytes
+ * whose first 24 bytes are PswRecHead (magic, vs_len, ps_len, n_il, key), then vs_len + ps_len bytes of shader bytecode.
+ * A file without the head (written before this patch) is read as records from byte 0 and given a head when it is rewritten.
+ *
+ * Why this exists: the reader took the file size with `long` (32 bits on Windows), so a file of 2 GiB or more read as
+ * negative, nothing was loaded and nothing was said; with an empty noted-set every pipeline of the run was appended again,
+ * so the file grew by a whole table each start. Here every size and offset is 64-bit, every early return logs its reason,
+ * a key already in the file is never appended, and a file with repeated keys, a damaged tail, more records than the table
+ * holds, or a head from another build is rewritten to a temporary file that replaces the old one in one step. */
+#ifndef PSOW_FILE_H
+#define PSOW_FILE_H
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <io.h>
+#else
+#include <sys/types.h>
+#include <unistd.h>
+#endif
+
+#ifndef PSW_LOG
+#define PSW_LOG(...) do { fprintf(stderr, "[PSOW] "); fprintf(stderr, __VA_ARGS__); fputc('\n', stderr); } while (0)
+#endif
+
+typedef int64_t psw_off;   /* every file size and offset in this file: never `long`, never ftell/fseek */
+#ifdef _WIN32
+static psw_off psw_tell(FILE* f) { return (psw_off)_ftelli64(f); }
+static int psw_seek(FILE* f, psw_off o, int whence) { return _fseeki64(f, o, whence); }
+#else
+typedef char psw_off_t_is_64_bit[sizeof(off_t) == 8 ? 1 : -1];
+static psw_off psw_tell(FILE* f) { return (psw_off)ftello(f); }
+static int psw_seek(FILE* f, psw_off o, int whence) { return fseeko(f, (off_t)o, whence); }
+#endif
+
+/* Replace dst with tmp in one step; the old dst stays when this fails. (A test may define PSW_REPLACE.) */
+#ifndef PSW_REPLACE
+#ifdef _WIN32
+#define PSW_REPLACE(tmp, dst) (MoveFileExA((tmp), (dst), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) ? 0 : -1)
+#else
+#define PSW_REPLACE(tmp, dst) rename((tmp), (dst))
+#endif
+#endif
+static int psw_sync(FILE* f)
+{
+#ifdef _WIN32
+    return _commit(_fileno(f));
+#else
+    return fsync(fileno(f));
+#endif
+}
+
+#define PSW_REC_MAGIC  0x32575350u   /* "PSW2": a record */
+#define PSW_FILE_MAGIC 0x48575350u   /* "PSWH": the file head */
+#define PSW_FORMAT     3u
+typedef struct { uint32_t magic, vs_len, ps_len, n_il; uint64_t key; } PswRecHead;   /* first 24 bytes of a record */
+typedef struct { uint32_t magic, format; uint64_t stamp; uint32_t hdr_size, reserved; } PswFileHead;   /* 24 bytes; hdr_size lets a reader (the support bundle) walk the records */
+
+/* Set of keys already in the file (this run or on disk): at most `max` keys in a table twice that size (so a probe ends). */
+typedef struct { uint64_t* slot; uint32_t slots, n, max; } PswNoted;
+static int psw_noted_init(PswNoted* s, uint32_t max)
+{
+    uint32_t n = 16; while (n < max * 2u) n <<= 1;
+    s->slot = (uint64_t*)calloc(n, sizeof(uint64_t)); s->slots = n; s->n = 0; s->max = max;
+    return s->slot != NULL;
+}
+static void psw_noted_clear(PswNoted* s) { if (s->slot) memset(s->slot, 0, (size_t)s->slots * sizeof(uint64_t)); s->n = 0; }
+static void psw_noted_free(PswNoted* s) { free(s->slot); s->slot = NULL; s->slots = s->n = 0; }
+/* 0 = new key, now noted; 1 = already noted; 2 = new but the set is at its maximum (not noted). */
+static int psw_noted_add(PswNoted* s, uint64_t key)
+{
+    uint32_t i = (uint32_t)(key ^ (key >> 29)) & (s->slots - 1u);
+    while (s->slot[i]) { if (s->slot[i] == key) return 1; i = (i + 1u) & (s->slots - 1u); }
+    if (s->n >= s->max) return 2;
+    s->slot[i] = key; s->n++;
+    return 0;
+}
+
+typedef struct {
+    const char* path;
+    uint32_t hdr_size;      /* bytes of a record's fixed head (>= sizeof(PswRecHead)) */
+    uint32_t max_bytes;     /* most bytes of one shader */
+    uint32_t max_records;   /* the capacity of the file: the most distinct records it keeps */
+    uint64_t stamp;         /* identity of the build whose pipelines these are (changes when the translator or the record layout does) */
+    PswNoted noted;
+    FILE* out;
+    psw_off size;           /* file size after prepare */
+    uint32_t n_records;     /* records in the file after prepare */
+    int ready, dead, full_said;
+} PswCache;
+
+static int psw_init(PswCache* c, const char* path, uint32_t hdr_size, uint32_t max_bytes, uint32_t max_records, uint64_t stamp)
+{
+    memset(c, 0, sizeof *c);
+    c->path = path; c->hdr_size = hdr_size; c->max_bytes = max_bytes; c->max_records = max_records; c->stamp = stamp;
+    return psw_noted_init(&c->noted, max_records);
+}
+
+/* A valid record head at pos, or 0. */
+static int psw_rec_at(const PswCache* c, FILE* f, psw_off pos, psw_off size, PswRecHead* h, psw_off* end)
+{
+    if (pos < 0 || size - pos < (psw_off)c->hdr_size) return 0;
+    if (psw_seek(f, pos, SEEK_SET) != 0 || fread(h, sizeof *h, 1, f) != 1) return 0;
+    if (h->magic != PSW_REC_MAGIC || !h->key || h->vs_len > c->max_bytes || h->ps_len > c->max_bytes ||
+        (h->n_il != 0 && h->n_il != 16)) return 0;
+    *end = pos + (psw_off)c->hdr_size + (psw_off)h->vs_len + (psw_off)h->ps_len;
+    return *end <= size;
+}
+
+typedef struct { psw_off size, good_end; int has_head, stamp_ok; uint64_t n_rec, n_unique, n_repeat, n_over; } PswScan;
+/* Walk the records (seeking over the bytecode, so a multi-gigabyte file costs one small read per record). Distinct keys go
+ * into c->noted. Returns 0, or -1 when the size cannot be read. */
+static int psw_scan(PswCache* c, FILE* f, PswScan* s)
+{
+    memset(s, 0, sizeof *s);
+    if (psw_seek(f, 0, SEEK_END) != 0) return -1;
+    s->size = psw_tell(f);
+    if (s->size < 0 || psw_seek(f, 0, SEEK_SET) != 0) return -1;
+    psw_off pos = 0; PswFileHead fh;
+    if (s->size >= (psw_off)sizeof fh && fread(&fh, sizeof fh, 1, f) == 1 && fh.magic == PSW_FILE_MAGIC) {
+        s->has_head = 1; s->stamp_ok = fh.format == PSW_FORMAT && fh.stamp == c->stamp && fh.hdr_size == c->hdr_size;
+        pos = (psw_off)sizeof fh;
+        if (!s->stamp_ok) { s->good_end = pos; return 0; }
+    }
+    PswRecHead h; psw_off end;
+    while (psw_rec_at(c, f, pos, s->size, &h, &end)) {
+        s->n_rec++;
+        const int r = psw_noted_add(&c->noted, h.key);
+        if (r == 0) s->n_unique++; else if (r == 1) s->n_repeat++; else s->n_over++;
+        pos = end;
+    }
+    s->good_end = pos;
+    return 0;
+}
+
+/* Write the file again to path.tmp (the head, then the first record of each key, at most max_records; none when
+ * keep_records is 0) and replace the old file with it. The old file is not touched unless every byte is written and synced
+ * and the replacement succeeds; on any failure the temporary file is removed and -1 is returned. */
+static int psw_rewrite(PswCache* c, int keep_records, uint64_t* kept)
+{
+    char tmp[1024]; PswNoted seen; FILE *in = NULL, *out = NULL; int rc = -1; const char* why = "";
+    *kept = 0;
+    if (snprintf(tmp, sizeof tmp, "%s.tmp", c->path) >= (int)sizeof tmp) { PSW_LOG("%s: path too long, file kept as it is", c->path); return -1; }
+    if (!psw_noted_init(&seen, c->max_records)) { PSW_LOG("%s: out of memory, file kept as it is", c->path); return -1; }
+    out = fopen(tmp, "wb");
+    if (!out) { why = "cannot create the temporary file"; goto done; }
+    PswFileHead fh = { PSW_FILE_MAGIC, PSW_FORMAT, c->stamp, c->hdr_size, 0 };
+    if (fwrite(&fh, sizeof fh, 1, out) != 1) { why = "cannot write the head"; goto done; }
+    if (keep_records) {
+        in = fopen(c->path, "rb");
+        if (!in) { why = "cannot reopen the old file"; goto done; }
+        if (psw_seek(in, 0, SEEK_END) != 0) { why = "cannot size the old file"; goto done; }
+        const psw_off size = psw_tell(in); psw_off pos = 0; PswFileHead oh;
+        if (size < 0 || psw_seek(in, 0, SEEK_SET) != 0) { why = "cannot size the old file"; goto done; }
+        if (size >= (psw_off)sizeof oh && fread(&oh, sizeof oh, 1, in) == 1 && oh.magic == PSW_FILE_MAGIC) pos = (psw_off)sizeof oh;
+        PswRecHead h; psw_off end; static unsigned char buf[1 << 16];
+        while (psw_rec_at(c, in, pos, size, &h, &end)) {
+            if (psw_noted_add(&seen, h.key) == 0) {
+                psw_off at = pos;
+                if (psw_seek(in, at, SEEK_SET) != 0) { why = "seek failed"; goto done; }
+                while (at < end) {
+                    const size_t n = (size_t)((end - at) < (psw_off)sizeof buf ? (end - at) : (psw_off)sizeof buf);
+                    if (fread(buf, 1, n, in) != n) { why = "read failed"; goto done; }
+                    if (fwrite(buf, 1, n, out) != n) { why = "write failed"; goto done; }
+                    at += (psw_off)n;
+                }
+                (*kept)++;
+            }
+            pos = end;
+        }
+    }
+    if (fflush(out) != 0 || ferror(out) || psw_sync(out) != 0) { why = "write or sync failed"; goto done; }
+    if (fclose(out) != 0) { out = NULL; why = "close failed"; goto done; }
+    out = NULL;
+    if (in) { fclose(in); in = NULL; }
+    if (PSW_REPLACE(tmp, c->path) != 0) { why = "cannot replace the old file"; goto done; }
+    rc = 0;
+done:
+    if (out) fclose(out);
+    if (in) fclose(in);
+    if (rc != 0) { remove(tmp); PSW_LOG("%s: rewrite failed (%s, errno %d), the old file is kept", c->path, why, errno); }
+    psw_noted_free(&seen);
+    return rc;
+}
+
+/* Read the file head and records, compact it when it needs it, and note every key. Logs what it found and why it returns.
+ * Returns the number of records in the file (0 when there is none or it was emptied), or -1 when the cache cannot be used
+ * this run (nothing is read or written then, the file is left as it is). */
+static int psw_prepare(PswCache* c)
+{
+    FILE* f = fopen(c->path, "rb"); PswScan s;
+    c->ready = 1;
+    if (!f) { PSW_LOG("%s: no file yet (first start)", c->path); return 0; }
+    if (psw_scan(c, f, &s) != 0) {
+        fclose(f); c->dead = 1;
+        PSW_LOG("%s: cannot read the file size (errno %d); warm-up is off for this run and the file is kept", c->path, errno);
+        return -1;
+    }
+    fclose(f);
+    PSW_LOG("%s: %lld bytes, %s, %llu records (%llu distinct, %llu repeated, %llu beyond the capacity of %u), %lld bytes after the last whole record",
+            c->path, (long long)s.size, !s.has_head ? "no head (older build)" : s.stamp_ok ? "head matches this build" : "head from another build",
+            (unsigned long long)s.n_rec, (unsigned long long)s.n_unique, (unsigned long long)s.n_repeat, (unsigned long long)s.n_over,
+            c->max_records, (long long)(s.size - s.good_end));
+    if (s.size == 0) { c->size = 0; return 0; }   /* an empty file: the first note writes the head */
+    const int stale = s.has_head && !s.stamp_ok;
+    if (stale || !s.has_head || s.n_repeat || s.n_over || s.good_end != s.size) {
+        uint64_t kept = 0;
+        if (stale) psw_noted_clear(&c->noted);
+        if (psw_rewrite(c, !stale, &kept) != 0) {
+            c->dead = 1; psw_noted_clear(&c->noted);
+            PSW_LOG("%s: warm-up is off for this run", c->path);
+            return -1;
+        }
+        PSW_LOG("%s: rewritten to %llu records (%s)", c->path, (unsigned long long)kept,
+                stale ? "emptied, it was made by another build" : "repeats, damaged tail, over-capacity records and the missing head removed");
+        c->n_records = (uint32_t)kept;
+    } else {
+        c->n_records = (uint32_t)s.n_unique;
+    }
+    FILE* g = fopen(c->path, "rb");
+    if (g) { if (psw_seek(g, 0, SEEK_END) == 0) c->size = psw_tell(g); fclose(g); }
+    PSW_LOG("%s: %u records, %lld bytes", c->path, c->n_records, (long long)c->size);
+    return (int)c->n_records;
+}
+
+typedef struct { unsigned char* buf; size_t size; size_t first; } PswImage;   /* the whole file; records start at `first` */
+/* Read the prepared file into memory (call only when prepare returned > 0). 0 on success. */
+static int psw_read_all(const PswCache* c, PswImage* img)
+{
+    memset(img, 0, sizeof *img);
+    FILE* f = fopen(c->path, "rb");
+    if (!f) { PSW_LOG("%s: cannot open for reading (errno %d); no pipelines are warmed", c->path, errno); return -1; }
+    if (c->size <= 0 || (uint64_t)c->size > (uint64_t)SIZE_MAX) { fclose(f); PSW_LOG("%s: size %lld does not fit memory", c->path, (long long)c->size); return -1; }
+    img->buf = (unsigned char*)malloc((size_t)c->size);
+    if (!img->buf) { fclose(f); PSW_LOG("%s: out of memory for %lld bytes; no pipelines are warmed", c->path, (long long)c->size); return -1; }
+    if (fread(img->buf, 1, (size_t)c->size, f) != (size_t)c->size) {
+        fclose(f); free(img->buf); img->buf = NULL;
+        PSW_LOG("%s: short read of %lld bytes; no pipelines are warmed", c->path, (long long)c->size);
+        return -1;
+    }
+    fclose(f);
+    img->size = (size_t)c->size;
+    PswFileHead fh; img->first = (img->size >= sizeof fh && (memcpy(&fh, img->buf, sizeof fh), fh.magic == PSW_FILE_MAGIC)) ? sizeof fh : 0;
+    return 0;
+}
+
+/* Append one record: 0 appended, 1 its key is already in the file, 2 the file is at its capacity (said once), -1 writing is off
+ * or failed (said once). `rec` is the fixed head (hdr_size bytes, its first 24 bytes a PswRecHead). The caller serialises. */
+static int psw_note(PswCache* c, const void* rec, const void* vs, const void* ps)
+{
+    const PswRecHead* h = (const PswRecHead*)rec;
+    if (c->dead) return -1;
+    const int r = psw_noted_add(&c->noted, h->key);
+    if (r == 1) return 1;
+    if (r == 2) {
+        if (!c->full_said) { c->full_said = 1; PSW_LOG("%s: full (%u records), new pipelines are not kept for the next start", c->path, c->max_records); }
+        return 2;
+    }
+    if (!c->out) {
+        c->out = fopen(c->path, "ab");
+        if (c->out && psw_seek(c->out, 0, SEEK_END) == 0 && psw_tell(c->out) == 0) {
+            PswFileHead fh = { PSW_FILE_MAGIC, PSW_FORMAT, c->stamp, c->hdr_size, 0 };
+            if (fwrite(&fh, sizeof fh, 1, c->out) != 1) { fclose(c->out); c->out = NULL; }
+        }
+        if (!c->out) { c->dead = 1; PSW_LOG("%s: cannot open for appending (errno %d); new pipelines are not kept", c->path, errno); return -1; }
+    }
+    if (fwrite(rec, c->hdr_size, 1, c->out) != 1 || (h->vs_len && fwrite(vs, 1, h->vs_len, c->out) != h->vs_len) ||
+        (h->ps_len && fwrite(ps, 1, h->ps_len, c->out) != h->ps_len) || fflush(c->out) != 0) {
+        c->dead = 1; fclose(c->out); c->out = NULL;
+        PSW_LOG("%s: write failed (errno %d); new pipelines are not kept (the damaged tail is cut at the next start)", c->path, errno);
+        return -1;
+    }
+    c->n_records++;
+    return 0;
+}
+#endif
