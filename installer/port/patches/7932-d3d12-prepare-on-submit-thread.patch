+/* PREP_PIPE: PREP_PIPE=1 (with PIPE on) runs render_frame_prepare on the
+ * submit thread too. The FIFO thread waits for the GPU itself before it records into the ring half batch N-1 used, the
+ * walker's label-like writes wait until prepare has read guest memory (the gate), and prepare reads the batch's
+ * fragment programs from a copy made at the hand-off (fp_bytes). Off by default. */
+static void render_frame_prepare(RfFrame* f);
+static const u8* fp_bytes(u32 off);
+static volatile DWORD s_ft_pipe_tid;   /* the submit thread (fp_bytes serves the copy only there) */
+static volatile LONG s_prep_busy;
+static HANDLE s_prep_done;
+static u64 s_prep_gate_n, s_prep_gate_waits; static double s_prep_gate_ms;
+static int prep_pipe_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PREP_PIPE"); on = (e && *e == '1') ? 1 : 0;
+                  if (on) { s_prep_done = CreateEventA(NULL, TRUE, TRUE, NULL); if (!s_prep_done) on = 0; }
+                  if (on) fprintf(stderr, "[PREP_PIPE] on: prepare runs on the submit thread, label gate on%c", 10); }
+    return on;
+}
+static void prep_gate(void)   /* FIFO thread (walker), before a label-like write */
+{
+    s_prep_gate_n++;
+    if (!s_prep_busy) return;
+    LARGE_INTEGER q0, q1, fq; QueryPerformanceCounter(&q0);
+    for (;;) {
+        const DWORD r = MsgWaitForMultipleObjects(1, &s_prep_done, FALSE, INFINITE, QS_SENDMESSAGE);
+        if (r == WAIT_OBJECT_0) break;
+        MSG m; PeekMessageA(&m, NULL, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE);
+    }
+    QueryPerformanceCounter(&q1); QueryPerformanceFrequency(&fq);
+    s_prep_gate_ms += (double)(q1.QuadPart - q0.QuadPart) * 1000.0 / (double)fq.QuadPart;
+    s_prep_gate_waits++;
+}
