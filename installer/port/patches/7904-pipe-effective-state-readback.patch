Patch 7904: read the effective PIPE decision without initializing it.

Publish the actual pipe_on outcome after backend readiness, preserving its
existing environment/debug/thread-failure policy. The getter reads only an
atomic witness. Both shutdown routes and unsupported initialization/producer
ordering invalidate before a late completion can publish. Legacy PIPE lifetime
is not reset on backend reinit; deliberately keep readback unavailable afterward.
This is local state evidence, not a settings ACK or worker-health check.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -493,6 +493,52 @@
     RfFrame f;
     u64 n_sub, n_wait; double wait_ms;   /* [PIPE] stats */
 } s_pipe = { -1 };
+/* PIPE effective-state witness (7904). This never changes producer policy.
+ * The legacy worker/events/on survive shutdown, so only the first backend
+ * lifetime can be witnessed. Unsupported early/concurrent observation and any
+ * shutdown/reinit permanently report unavailable instead of trusting old state.
+ * All witness access is atomic; the getter never reads owner-only s_pipe data. */
+enum {
+    PIPE_WITNESS_NEW, PIPE_WITNESS_INIT, PIPE_WITNESS_READY,
+    PIPE_WITNESS_OBSERVING, PIPE_WITNESS_OFF, PIPE_WITNESS_ON,
+    PIPE_WITNESS_UNAVAILABLE
+};
+static volatile LONG s_pipe_witness = PIPE_WITNESS_NEW;
+static void pipe_effective_close(void)
+{
+    InterlockedExchange(&s_pipe_witness, PIPE_WITNESS_UNAVAILABLE);
+}
+static void pipe_effective_begin(void)
+{
+    if (InterlockedCompareExchange(&s_pipe_witness, PIPE_WITNESS_INIT, PIPE_WITNESS_NEW) != PIPE_WITNESS_NEW)
+        pipe_effective_close();
+}
+static void pipe_effective_ready(void)
+{
+    InterlockedCompareExchange(&s_pipe_witness, PIPE_WITNESS_READY, PIPE_WITNESS_INIT);
+}
+/* Only called inside the one-time initializer. A known outcome here means
+ * another initializer beat this caller after its stale on<0 condition. */
+static int pipe_effective_observe_begin(void)
+{
+    const LONG before = InterlockedCompareExchange(&s_pipe_witness, PIPE_WITNESS_OBSERVING, PIPE_WITNESS_READY);
+    if (before == PIPE_WITNESS_READY) return 1;
+    if (before != PIPE_WITNESS_UNAVAILABLE)
+        pipe_effective_close();
+    return 0;
+}
+static void pipe_effective_observe_end(int observed, int on)
+{
+    if (observed)
+        InterlockedCompareExchange(&s_pipe_witness, on ? PIPE_WITNESS_ON : PIPE_WITNESS_OFF, PIPE_WITNESS_OBSERVING);
+}
+int rsx_d3d12_pipe_effective_state(void)
+{
+    const LONG state = InterlockedCompareExchange(&s_pipe_witness, PIPE_WITNESS_NEW, PIPE_WITNESS_NEW);
+    return state == PIPE_WITNESS_OFF ? 0 : state == PIPE_WITNESS_ON ? 1 : -1;
+}
+/* End PIPE effective-state witness. */
+
 static DWORD WINAPI pipe_thread(LPVOID arg)
 {
     (void)arg;
@@ -506,6 +552,7 @@
 static int pipe_on(void)
 {
     if (s_pipe.on < 0) {
+        const int observed = pipe_effective_observe_begin();
         const char* e = getenv("PIPE");
         int on = (e && *e == '1') ? 1 : 0;
         /* Debug switches that read or edit records, guest memory or readbacks from the submit half keep the old path. */
@@ -521,6 +568,7 @@
             else fprintf(stderr, "[PIPE] on: draw loop, Execute and Present on their own thread (tid %lu)%c", (unsigned long)GetThreadId(s_pipe.th), 10);
         }
         s_pipe.on = on;
+        pipe_effective_observe_end(observed, s_pipe.on);
     }
     return s_pipe.on;
 }
@@ -9669,6 +9717,7 @@

 static void d3d12_shutdown(void* ud)
 {
+    pipe_effective_close();
     (void)ud;
     printf("[D3D12] Backend shutdown\n");
 }
@@ -12358,6 +12407,7 @@

