+    pipe_effective_begin();
     memset(&s_d3d, 0, sizeof(s_d3d));
     s_d3d.draws = s_draws_buf[0];
     s_d3d.width = width;
@@ -12405,12 +12455,14 @@
     }
     s_d3d.hwnd = create_window(width, height, title);
     if (!s_d3d.hwnd) {
+        pipe_effective_close();
         printf("[D3D12] ERROR: Window creation failed\n");
         return -1;
     }

     /* Initialize D3D12 */
     if (init_d3d12(s_d3d.bb_w, s_d3d.bb_h) != 0) {   /* the swap chain: guest size x RES_SCALE */
+        pipe_effective_close();
         printf("[D3D12] ERROR: D3D12 initialization failed\n");
         return -1;
     }
@@ -12436,6 +12488,7 @@
     rsx_set_backend(&s_d3d12_backend);

     s_d3d.initialized = 1;
+    pipe_effective_ready();
     s_d3d.last_fps_time = GetTickCount64();

     printf("[D3D12] Backend ready: %ux%u\n", width, height);
@@ -12444,6 +12497,7 @@

 void rsx_d3d12_backend_shutdown(void)
 {
+    pipe_effective_close();
     if (!s_d3d.initialized) return;

     pipe_wait();     /* PIPE=1: the batch in flight first */
@@ -12621,6 +12675,7 @@
     return -1;
 }
 void rsx_d3d12_backend_shutdown(void) {}
+int rsx_d3d12_pipe_effective_state(void) { return -1; }
 int rsx_d3d12_backend_pump_messages(void) { return 0; }
 void rsx_d3d12_backend_present(void) {}

