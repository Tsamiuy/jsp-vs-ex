+/* Actual PIPE policy outcome: -1 unavailable, 0 off, 1 on. Pure atomic read;
+ * never initializes PIPE. Valid only after first backend readiness and actual
+ * producer completion. Shutdown, reinit or unsupported producer overlap leaves
+ * it unavailable; it is not a worker-health or application-completion receipt. */
+int rsx_d3d12_pipe_effective_state(void);
+
