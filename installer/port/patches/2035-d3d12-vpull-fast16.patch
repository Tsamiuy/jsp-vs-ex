+    static int f16 = -1;
+    if (f16 < 0) { const char* ev = getenv("VPULL_FAST16"); f16 = (ev && *ev == '0') ? 0 : 1; }
+    if (f16 && sixteen && !restart_en && npre == 0) {
+        const u8* p16 = ip + (u64)first * 2u;
+        for (u32 k = 0; k < total; k++) {
+            const u32 ix = ((u32)p16[2u * k] << 8) | p16[2u * k + 1u];
+            raw[k] = ix;
+            vmin = ix < vmin ? ix : vmin;
+            vmax = ix > vmax ? ix : vmax;
+        }
+    } else
     for (u32 k = 0; k < total; k++) {
         const u32 kk = k < npre ? pre[k] : first + (k - npre);
         const u32 ix = sixteen ? (((u32)ip[kk * 2] << 8) | ip[kk * 2 + 1])
