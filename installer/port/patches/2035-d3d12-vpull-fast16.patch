+          char* rp = strstr(hlsl, mrt ? "_out.t0 = " : "_po.c0 = ");
           if (rp) { char* semi = strchr(rp, ';');
             if (semi) {
                 char rep[256];
-                snprintf(rep, sizeof rep, "_po.c0 = float4((%s).xyz, 1.0)", sh);
+                snprintf(rep, sizeof rep, "%s = float4((%s).xyz, 1.0)", mrt ? "_out.t0" : "_po.c0", sh);
                 size_t newlen = strlen(rep), tail = strlen(semi) + 1;
                 if ((size_t)(rp - hlsl) + newlen + tail < sizeof(hlsl)) {
                     memmove(rp + newlen, semi, tail);
@@ -8025,6 +8027,20 @@ static u32 upload_vpull(const rsx_state* st, u32 first, u32 count, u32 prim)
     const int restart_en = strip && strip_restart_on(st);
     u32* raw = s_vpull.raw;
     u32 vmin = 0xFFFFFFFFu, vmax = 0;
+    /* The common case (16-bit indices, no restart, no strip prefix) as a
+     * branch-free loop: same raw[] and range as the general loop below, which
