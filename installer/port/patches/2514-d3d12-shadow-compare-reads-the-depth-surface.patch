           if (!*q) memcpy(hlsl, tmp, (size_t)(o - tmp) + 1);
       }
     }
-    { /* 2048: units compared through the byte copy of a D24S8 surface read the full depth from its bytes */
+    { /* 2048: units compared through the byte copy of a D24S8 surface read the full depth from its bytes
+       * (2514: not when the depth surface itself is bound) */
