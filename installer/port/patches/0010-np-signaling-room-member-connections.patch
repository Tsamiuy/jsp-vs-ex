+    if (c->status == SCE_NP_SIGNALING_CONN_STATUS_ACTIVE) {   /* already up: say so, as a new activation would */
+        conn_event((SceNpSignalingConnId)(idx + 1), SCE_NP_SIGNALING_EVENT_ESTABLISHED, 0);
+        conn_check_mutual(idx);
+    }
+    return CELL_OK;
 }
 
