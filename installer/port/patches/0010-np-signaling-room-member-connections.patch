-    if (ctxId >= SCE_NP_SIGNALING_CTX_MAX || !s_ctx[ctxId].in_use)
-        return (s32)SCE_NP_SIGNALING_ERROR_CTX_NOT_FOUND;
-    s_ctx[ctxId].extHandler = handler;
-    s_ctx[ctxId].extHandlerArg = arg;
