+/* pad_hid.h -- PlayStation pads read as raw HID devices: which ones, and what their input reports mean
+ * (toolkit patch 7909; ENHANCEMENT; extends the DualSense reader of patch 6503).
+ *
+ * Pure logic, no I/O (cellPad.c does the Windows HID calls, the host test installer/tools/pad_join_test.c feeds reports).
+ *
+ * Byte offsets are described from published documentation, not from any code:
+ *  - DualShock 4 (PS4 controller), USB input report 0x01 (64 bytes) and Bluetooth input report 0x11 (78 bytes): the PS4 developer
+ *    wiki, page "DualShock 4" (psdevwiki.com/ps4/DS4-USB and DS4-BT). USB: byte 0 report id, then LX LY RX RY (0 = left / up,
+ *    128 = centre), byte 5 = hat in the low nibble (0 = up, clockwise, 8 = released) and Square 0x10, Cross 0x20, Circle 0x40,
+ *    Triangle 0x80, byte 6 = L1 0x01, R1 0x02, L2 0x04, R2 0x08, Share 0x10, Options 0x20, L3 0x40, R3 0x80, byte 7 = PS and
+ *    touchpad click and a counter, byte 8 = L2 analog, byte 9 = R2 analog. Bluetooth 0x11: bytes 1..2 are flags, the same data
+ *    starts at byte 3 (two bytes later than USB). A Bluetooth DualShock 4 sends only the short report 0x01 (10 bytes, the data at
+ *    byte 1 as on USB, ending after R2) until feature report 0x02 is read once; then it sends 0x11.
+ *  - DualSense (PS5 controller): the same wiki ("DualSense"), and the layout 6503 already read: USB report 0x01 (64 bytes) with
+ *    LX LY RX RY L2 R2 counter at bytes 1..7, byte 8 = hat and face buttons (as DualShock 4 byte 5), byte 9 = L1 R1 L2 R2 Create
+ *    Options L3 R3 (as DualShock 4 byte 6); Bluetooth full report 0x31 with the same data from byte 2; the short Bluetooth report
+ *    0x01 (until feature report 0x05 is read once) is the DualShock 4 short layout.
+ * RPCS3 is not a source for this file; nothing here is copied from GPL code.
+ *
+ * The output uses the XInput button values (A = Cross, B = Circle, X = Square, Y = Triangle, BACK = Share / Create, START =
+ * Options) so cellPad.c runs it through the same mapping as an XInput pad, including the PAD_BTN_* rebinds.
+ */
+#ifndef PAD_HID_H
+#define PAD_HID_H
+#include <stdint.h>
+#include <string.h>
+
+#define PH_VENDOR_SONY 0x054C
+#define PH_MAX_PADS    4        /* HID pads read at once (players are at most four) */
+
+enum { PH_NONE = 0, PH_DUALSENSE = 1, PH_DS4 = 2 };
+
+/* XInput wButtons values (XINPUT_GAMEPAD_*, xinput.h); cellPad.c asserts they match. */
+#define PH_X_DPAD_UP    0x0001
+#define PH_X_DPAD_DOWN  0x0002
+#define PH_X_DPAD_LEFT  0x0004
+#define PH_X_DPAD_RIGHT 0x0008
+#define PH_X_START      0x0010
+#define PH_X_BACK       0x0020
+#define PH_X_LTHUMB     0x0040
+#define PH_X_RTHUMB     0x0080
+#define PH_X_LSHOULDER  0x0100
+#define PH_X_RSHOULDER  0x0200
+#define PH_X_A          0x1000
+#define PH_X_B          0x2000
+#define PH_X_X          0x4000
+#define PH_X_Y          0x8000
+
+/* Which pad a USB / Bluetooth HID device is: DualSense 0CE6, DualSense Edge 0DF2, DualShock 4 v1 05C4, DualShock 4 v2 09CC. */
+static inline int ph_kind(unsigned vid, unsigned pid)
+{
+    if (vid != PH_VENDOR_SONY) return PH_NONE;
+    if (pid == 0x0CE6 || pid == 0x0DF2) return PH_DUALSENSE;
+    if (pid == 0x05C4 || pid == 0x09CC) return PH_DS4;
+    return PH_NONE;
+}
+
+/* A first, cheap look at a device path before it is opened: Windows puts the vendor id into the path (USB "vid_054c", Bluetooth
+ * "vid&0002054c"), so the paths of other makers are skipped without opening them. The real check is ph_kind on the opened device. */
+static inline int ph_path_may_be_sony(const char* path)
+{
+    for (const char* p = path; *p; p++)
+        if (p[0] == '0' && p[1] == '5' && p[2] == '4' && (p[3] == 'c' || p[3] == 'C')) return 1;
+    return 0;
+}
+
+/* The top-level collection of a pad: Generic Desktop page, usage Joystick (4) or Game Pad (5). */
+static inline int ph_is_gamepad(unsigned usage_page, unsigned usage) { return usage_page == 0x01 && (usage == 0x04 || usage == 0x05); }
+
+/* The feature report that switches a Bluetooth pad from the short to the full input report, and its length (id included). */
+static inline int ph_bt_switch_id(int kind)  { return kind == PH_DS4 ? 0x02 : 0x05; }
+static inline int ph_bt_switch_len(int kind) { return kind == PH_DS4 ? 37 : 41; }
+
+/* Windows reports InputReportByteLength: 64 over USB, more over Bluetooth (78 for the DualSense; the DualShock 4 lists a longer
+ * descriptor). Anything above 64 is Bluetooth. */
+static inline int ph_is_bluetooth(unsigned input_report_len) { return input_report_len > 64; }
+
+typedef struct {
+    uint16_t buttons;               /* PH_X_* */
+    uint8_t  l2, r2;                /* 0..255 */
+    int16_t  lx, ly, rx, ry;        /* XInput style: up = positive */
+} PadHidPad;
+
+static inline int16_t ph_axis(uint8_t v)   /* HID 0..255, 128 centre -> -32768..32512 */
+{
+    return (int16_t)(((int)v - 128) * 256);
+}
+static inline int16_t ph_axis_up(uint8_t v)   /* HID: 0 = up -> positive */
+{
+    return (int16_t)((128 - (int)v) * 256 - (v == 0));   /* 128 * 256 = 32768 does not fit: 32767 */
+}
+
+/* Parses one input report as read from the device (report id first). Returns 1 and fills *o, or 0 when the report is not a pad
+ * state (other id, too short). */
+static inline int ph_parse(int kind, const uint8_t* r, unsigned len, PadHidPad* o)
+{
+    if (len < 1 || (kind != PH_DUALSENSE && kind != PH_DS4)) return 0;
+    uint8_t stick[4], face, b1, l2, r2;
+    if (kind == PH_DUALSENSE && r[0] == 0x31 && len >= 11) {            /* Bluetooth full report */
+        memcpy(stick, r + 2, 4); l2 = r[6]; r2 = r[7]; face = r[9]; b1 = r[10];
+    } else if (kind == PH_DUALSENSE && r[0] == 0x01 && len >= 64) {     /* USB */
+        memcpy(stick, r + 1, 4); l2 = r[5]; r2 = r[6]; face = r[8]; b1 = r[9];
+    } else if (kind == PH_DS4 && r[0] == 0x01 && len >= 64) {           /* USB */
+        memcpy(stick, r + 1, 4); face = r[5]; b1 = r[6]; l2 = r[8]; r2 = r[9];
+    } else if (kind == PH_DS4 && r[0] == 0x11 && len >= 12) {           /* Bluetooth full report: USB layout, two bytes later */
+        memcpy(stick, r + 3, 4); face = r[7]; b1 = r[8]; l2 = r[10]; r2 = r[11];
+    } else if (r[0] == 0x01 && len >= 10 && len < 64) {                 /* Bluetooth short report, either pad */
+        memcpy(stick, r + 1, 4); face = r[5]; b1 = r[6]; l2 = r[8]; r2 = r[9];
+    } else return 0;
+    static const uint16_t hat[8] = {
+        PH_X_DPAD_UP, PH_X_DPAD_UP | PH_X_DPAD_RIGHT, PH_X_DPAD_RIGHT, PH_X_DPAD_DOWN | PH_X_DPAD_RIGHT,
+        PH_X_DPAD_DOWN, PH_X_DPAD_DOWN | PH_X_DPAD_LEFT, PH_X_DPAD_LEFT, PH_X_DPAD_UP | PH_X_DPAD_LEFT };
+    uint16_t b = 0;
+    if ((face & 15) < 8) b |= hat[face & 15];
+    if (face & 0x10) b |= PH_X_X;           /* Square */
+    if (face & 0x20) b |= PH_X_A;           /* Cross */
+    if (face & 0x40) b |= PH_X_B;           /* Circle */
+    if (face & 0x80) b |= PH_X_Y;           /* Triangle */
+    if (b1 & 0x01) b |= PH_X_LSHOULDER;
+    if (b1 & 0x02) b |= PH_X_RSHOULDER;
+    if (b1 & 0x10) b |= PH_X_BACK;          /* Share / Create */
+    if (b1 & 0x20) b |= PH_X_START;         /* Options */
+    if (b1 & 0x40) b |= PH_X_LTHUMB;
+    if (b1 & 0x80) b |= PH_X_RTHUMB;
+    o->buttons = b; o->l2 = l2; o->r2 = r2;
+    o->lx = ph_axis(stick[0]); o->ly = ph_axis_up(stick[1]);
+    o->rx = ph_axis(stick[2]); o->ry = ph_axis_up(stick[3]);
+    return 1;
+}
+
+/* The old layout's ports (nothing reordered): the XInput pads keep their slot as the port; the HID pads then take the lowest ports no
+ * XInput pad holds, in reader order. dev[port] = the XInput slot (0..3), hid_base + HID index, or -1 (port empty). So a lone XInput
+ * pad stays on its slot, a lone HID pad is port 0, and an HID pad next to an XInput pad on slot 0 is port 1. */
+static inline void ph_port_devs(const uint8_t* xconn, const uint8_t* hconn, int hid_base, int* dev)
+{
+    for (int i = 0; i < 4; i++) dev[i] = xconn[i] ? i : -1;
+    for (int i = 0, h = 0; i < 4; i++) {
+        if (xconn[i]) continue;
+        while (h < PH_MAX_PADS && !hconn[h]) h++;
+        if (h >= PH_MAX_PADS) break;
+        dev[i] = hid_base + h; h++;
+    }
+}
+#endif
