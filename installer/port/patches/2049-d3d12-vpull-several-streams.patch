+/* VPULL_MULTI (default on, =0 off): attributes in up to 4 streams. A stream is a (stride, memory) with all its
+ * attributes within 4 KB of its lowest. */
+static int vpull_layout_multi(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("VPULL_MULTI"); on = (e && *e == '0') ? 0 : 1; }
+    if (!on) return 0;
+    int ns = 0;
+    for (int c = 0; c < s_vf.n; c++) {
+        const VFAttr* f = &s_vfa[c];
+        if (!f->plain || !f->stride) return 0;
+        int j;
+        for (j = 0; j < ns; j++)
+            if (s_vpull.str_S[j] == f->stride && s_vpull.str_loc[j] == f->loc &&
+                (f->off >= s_vpull.str_base[j] ? f->off - s_vpull.str_base[j] : s_vpull.str_base[j] - f->off) <= 4096u)
+                break;
+        if (j == ns) {
+            if (ns >= 4) return 0;
+            s_vpull.str_S[ns] = f->stride; s_vpull.str_loc[ns] = f->loc; s_vpull.str_base[ns] = f->off; s_vpull.str_ext[ns] = 0;
+            ns++;
+        } else if (f->off < s_vpull.str_base[j]) s_vpull.str_base[j] = f->off;
+        s_vpull.a_str[c] = j;
+    }
+    rsx_vpull_tab* t = &s_vpull.tab_cur;
+    memset(t, 0, sizeof *t);
+    for (int i = 0; i < 16; i++) memcpy(t->konst[i], s_vf.tmpl[i].v, sizeof t->konst[i]);
+    for (int c = 0; c < s_vf.n; c++) {
+        const VFAttr* f = &s_vfa[c];
+        const int j = s_vpull.a_str[c];
+        const u32 rel = f->off - s_vpull.str_base[j];
+        if (rel > 4096u) return 0;
+        const u32 type = (f->type >= 1u && f->type <= 7u) ? f->type : 2u;
+        const u32 e = rel + rsx_vpull_type_size(type, f->n);
+        if (e > s_vpull.str_ext[j]) s_vpull.str_ext[j] = e;
+        const int idx = s_vf.idx[c];
+        s_vpull.a_rel[c] = rel;
+        t->attr[idx][0] = rel;          /* + the stream's place in the record, in upload_vpull */
+        t->attr[idx][1] = f->stride;
+        t->attr[idx][2] = type;
+        t->attr[idx][3] = f->n;
+        t->konst[idx][0] = 0.0f; t->konst[idx][1] = 0.0f; t->konst[idx][2] = 0.0f; t->konst[idx][3] = 1.0f;
+    }
+    s_vpull.nstr = ns;
+    s_vpull.S = s_vpull.str_S[0]; s_vpull.lbase = s_vpull.str_base[0]; s_vpull.extent = s_vpull.str_ext[0];
+    s_vpull.loc = s_vpull.str_loc[0]; s_vpull.pad = 0;
+    return 1;
+}
