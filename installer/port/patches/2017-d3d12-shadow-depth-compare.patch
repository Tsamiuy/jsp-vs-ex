                              * pipelines and must not share a cache entry. */
     u64 zs;                 /* depth/stencil state, rsx_zs_key (PSO key) */
+    u8 shadow[16];          /* packed shadow-compare descriptor per unit (PSO key) */
     ID3D12PipelineState* pso;
 } VPFPEntry;
