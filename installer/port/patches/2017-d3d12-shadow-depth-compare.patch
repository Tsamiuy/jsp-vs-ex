@@ -2336,7 +2337,40 @@
 /* fragment program -> DXBC blob, split out of vp_get_fp_pso so that the
  * misses of one batch can be compiled on worker threads (D3DCompile was 23 of
  * the 27 ms per miss). Thread-safe: its own HLSL buffer, no D3D12 calls. */
-static ID3DBlob* vp_fp_compile_blob(u32 fp_addr, u32 off, u32 ctrl, u32 cube_mask)
+/* shadow-compare descriptors. The RSX compares a depth texture's texel with the lookup's r
+ * coordinate (SET_TEXTURE_ADDRESS func); without the descriptors the decompiler returns the raw
+ * depth and a shadow lookup becomes a depth value used as a light factor. Packed one byte per unit
+ * so the pipeline key can compare them: enabled (2 bits) | func<<2 | linear<<5 | unnormalized<<6. */
+static int off_rt_find(u32 off);
+static int off_ds_find(u32 off);
+static void vp_shadow_pack(const D3D12DrawRecord* dr, u32 off, u8 sh[16])
+{
+    extern uint8_t* vm_base;
+    memset(sh, 0, 16);
+    static int en = -1;
+    if (en < 0) { const char* e = getenv("RSX_SHADOW_CMP"); en = e ? atoi(e) : 1; }
+    if (!en || !dr || !vm_base) return;
+    u32 units = rsx_fp_texture_units(vm_base + off, 0x10000);
+    static u32 s_units_seen[64]; static int s_units_n;
+    for (u32 u = 0; u < 16 && u < VP_TEX_UNITS; u++) {
+        if (!(units & (1u << u))) continue;
+        if (u >= 4) { u32 k = (u << 24) | ((dr->tex[u].fmt & 0xFF) << 16) | (dr->tex[u].addr >> 16 & 0xFFFF); int f = 0;
+            for (int i = 0; i < s_units_n; i++) if (s_units_seen[i] == k) f = 1;
+            if (!f && s_units_n < 64) { s_units_seen[s_units_n++] = k;
+                fprintf(stderr, "[SHUNIT] fp_off=0x%X t%u set=%d fmt=0x%02X %ux%u mips=%u addr=0x%08X filt=0x%08X ctrl0=0x%08X raw=0x%08X offrt=%d offds=%d ctrl1=0x%08X%c",
+                        off, u, dr->tex[u].set, dr->tex[u].fmt, dr->tex[u].w, dr->tex[u].h, dr->tex[u].mips,
+                        dr->tex[u].addr, dr->tex[u].filter, dr->tex[u].ctrl0, dr->tex[u].raw,
+                        off_rt_find(dr->tex[u].raw), off_ds_find(dr->tex[u].raw), dr->tex[u].ctrl1, 10); } }
+        if (!dr->tex[u].set) continue;
+        rsx_fp_shadow_desc d;
+        rsx_fp_shadow_desc_from_texture(&d, dr->tex[u].fmt, 2, dr->tex[u].cube, dr->tex[u].mips,
+                                        dr->tex[u].filter, dr->tex[u].addr, dr->tex[u].ctrl0);
+        if (!d.enabled) continue;
+        sh[u] = (u8)((d.enabled & 3) | (d.func << 2) | (d.linear << 5) | (d.unnormalized << 6));
+    }
+}
+
+static ID3DBlob* vp_fp_compile_blob(u32 fp_addr, u32 off, u32 ctrl, u32 cube_mask, const u8 sh[16])
 {
     extern uint8_t* vm_base;
     HRESULT hr;
