Patch 6003: PAD_SCRIPT takes an optional hold length, "<t>:<mask>:<polls>". (Upstream candidate.)

PAD_SCRIPT holds every press for a fixed 40 polls. Menus that auto-repeat a held d-pad then move the cursor two rows. A third
field sets the number of polls the press is held (default 40, unchanged). Test-input tooling only.

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -913,7 +913,7 @@
      * LEFT 0x0080, RIGHT 0x0020, CROSS 0x4000, CIRCLE 0x2000, TRIANGLE 0x1000.
      * Legit input simulation on the same footing as PAD_AUTOPRESS/PAD_STICK. */
     { static int s_sc = -1;
-      static struct { double t; unsigned mask; } ev[256]; static int n_ev = 0;
+      static struct { double t; unsigned mask; int hold; } ev[256]; static int n_ev = 0;
       static unsigned long long t0 = 0;   /* not ULONGLONG: this builds on POSIX too */
       if (s_sc < 0) {
           s_sc = 0;
@@ -925,7 +925,9 @@
                   double t = strtod(p, (char**)&p);
                   if (*p == ':') p++;
                   unsigned m = (unsigned)strtoul(p, (char**)&p, 0);
-                  ev[n_ev].t = t; ev[n_ev].mask = m; n_ev++;
+                  int hold = 40;   /* J-Stars 6003: optional ":<polls>" after the mask */
+                  if (*p == ':') { p++; hold = (int)strtol(p, (char**)&p, 0); if (hold < 1) hold = 1; }
+                  ev[n_ev].t = t; ev[n_ev].mask = m; ev[n_ev].hold = hold; n_ev++;
                   while (*p == ',' || *p == ' ') p++;
               }
               printf("[cellPad] PAD_SCRIPT: %d event(s)%s\n", n_ev,
@@ -942,7 +944,7 @@
            * looks like regardless of poll rate. */
           static int fired[256], held[256];
           for (int i = 0; i < n_ev; i++) {
-              if (!fired[i] && now >= ev[i].t) { fired[i] = 1; held[i] = 40; }
+              if (!fired[i] && now >= ev[i].t) { fired[i] = 1; held[i] = ev[i].hold; }
               if (held[i] > 0) {
                   held[i]--;
                   data->button[CELL_PAD_BTN_OFFSET_DIGITAL1] |= (u16)(ev[i].mask & 0xFF);
