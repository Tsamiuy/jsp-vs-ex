Patch 2023: textures flagged with TEXTURE_ADDRESS gamma bits are read as sRGB.

TEXTURE_ADDRESS bits 20..22 select per-channel gamma (sRGB to linear on read). They were ignored, so gamma-flagged albedo textures were read as
plain UNORM and dark parts came out lifted (washed-out characters and stages). A texture with all three bits set is now read through the
matching _SRGB view (BC1/BC2/BC3/RGBA8). RSX_TEX_GAMMA=0 turns it off; the first hits are logged as [tex-gamma].

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -5346,6 +5346,17 @@
                             (_bf == 0x87) ? DXGI_FORMAT_BC2_UNORM :
                             (_bf == 0x88) ? DXGI_FORMAT_BC3_UNORM :
                                             DXGI_FORMAT_R8_UNORM;
+                        /* TEXTURE_ADDRESS bits 20..22 = per-channel gamma (sRGB->linear on read, RGB only).
+                         * Unhandled before: the texture was read as plain UNORM, so dark parts of gamma-flagged
+                         * albedos came out lifted. RSX_TEX_GAMMA=0 restores the old read; log: [tex-gamma]. */
+                        { static int tg = -1; if (tg < 0) { const char* e = getenv("RSX_TEX_GAMMA"); tg = e ? atoi(e) : 1; }
+                          u32 gb = (dr->tex[_u].addr >> 20) & 7u;
+                          if (gb) { static int gn; if (gn++ < 12) fprintf(stderr, "[tex-gamma] unit %d fmt=0x%02X addr=0x%08X gamma=%u%s\n", _u, (unsigned)_bf, (unsigned)dr->tex[_u].addr, gb, tg ? "" : " (ignored)"); }
+                          if (tg && gb == 7u) {
+                              if (sf == DXGI_FORMAT_BC1_UNORM) sf = DXGI_FORMAT_BC1_UNORM_SRGB;
+                              else if (sf == DXGI_FORMAT_BC2_UNORM) sf = DXGI_FORMAT_BC2_UNORM_SRGB;
+                              else if (sf == DXGI_FORMAT_BC3_UNORM) sf = DXGI_FORMAT_BC3_UNORM_SRGB;
+                              else if (sf == DXGI_FORMAT_R8G8B8A8_UNORM) sf = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB; } }
                         srv_write_ex(wslot, s_d3d.vp_tex[ts].res, sf,
                                   (_bf == 0x81) ? 0x1000
                                                 : rsx_remap_to_d3d(dr->tex[_u].ctrl1, _bf),
