Patch 2010: the offscreen render-target table, the depth SRV table and the per-draw SRV windows are sized together.

MAX_OFF_RTS was 16 and the post chain of the 3D title scene uses 17 offscreen colour targets. Raising the constant alone broke the
picture: the SRV heap slots were hard-coded, so the extra render-target slots overlapped the depth SRVs. The three tables are now
derived from one set of constants.

--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -167,7 +167,7 @@
     D3D12_RESOURCE_STATES st;          /* tracked resource state */
     int                   used;        /* referenced this frame */
 } OffRT;
-#define MAX_OFF_RTS  16  /* demosaic double-buffers its 6-surface pass chain */
+#define MAX_OFF_RTS  24  /* demosaic double-buffers its 6-surface pass chain */
 
 /* Depth surface, one per guest zeta offset. The pass chain keeps several
  * (God of War HD: the scene's 2x-AA depth at 0x17F0000 and the resolved depth
@@ -183,12 +183,12 @@
     u64                   last_frame;  /* frame_count of the last pass that bound it */
 } OffDS;
 #define MAX_OFF_DS   6
-#define DS_SRV_BASE  21  /* SRV heap slots 21..32 hold depth + stencil SRVs (2 per OffDS) */
-#define RT_SRV_BASE  5   /* SRV heap slots 5..20 hold offscreen-RT SRVs */
+#define RT_SRV_BASE  5   /* SRV heap slots RT_SRV_BASE.. hold offscreen-RT SRVs (MAX_OFF_RTS of them) */
+#define DS_SRV_BASE  (RT_SRV_BASE + MAX_OFF_RTS)   /* then depth + stencil SRVs (2 per OffDS) */
 /* Per-draw SRV windows: each VP draw gets 4 consecutive descriptors (t0-t3)
  * so multi-unit fragment programs see all their textures (demosaic's
  * interpolation passes sample 3 units). */
-#define DRAW_SRV_BASE 40
+#define DRAW_SRV_BASE (DS_SRV_BASE + 2 * MAX_OFF_DS + 4)   /* the three tables above must not overlap (raising MAX_OFF_RTS alone did) */
 #define SRV_HEAP_SIZE (DRAW_SRV_BASE + MAX_DRAWS * VP_TEX_UNITS)
 
