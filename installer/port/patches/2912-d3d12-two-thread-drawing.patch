+static DWORD WINAPI pipe_thread(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(s_pipe.go, INFINITE);
+        render_frame_submit(&s_pipe.f);
+        SetEvent(s_pipe.done);
+    }
+    return 0;
+}
+static int pipe_on(void)
+{
+    if (s_pipe.on < 0) {
