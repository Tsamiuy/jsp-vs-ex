+/* Two-thread drawing (patch 2912; PIPE=1, default off; after another title's port). render_frame_prepare stays on the
+ * FIFO thread; render_frame_submit (draw loop, post passes, Close/Execute, Present) runs on its own thread for batch N
+ * while the FIFO thread records batch N+1 into the other draw list and the other half of every upload ring (vp_parity).
+ * RfFrame is the batch the submit half reads: its own draw list, count and parity, plus snapshots of the live state it
+ * used to read (present flag, legacy MVP). The FIFO thread waits for the submit thread (pipe_wait) before the next
+ * prepare and before anything that would change what a submit in flight reads (VS slot reuse, base VS build, shutdown). */
+typedef struct RfFrame {
+    double rf0; u32 fi;
+    D3D12DrawRecord* draws; u32 n; int parity; int present; int piped;
+    int have_st; float vc[16];
