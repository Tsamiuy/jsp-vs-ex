+/* FIFO thread: wait until the submit half has finished the batch in flight. The window belongs to this thread, and
+ * Present on the submit thread can SendMessage to it, so sent messages keep being delivered while waiting (a plain
+ * wait deadlocked at the first frames in another title's port). Posted messages stay queued for the normal pump. */
+static void pipe_wait(void)
+{
+    if (!s_pipe.busy) return;
+    LARGE_INTEGER q0, q1, fq; QueryPerformanceCounter(&q0);
+    for (;;) {
+        const DWORD r = MsgWaitForMultipleObjects(1, &s_pipe.done, FALSE, INFINITE, QS_SENDMESSAGE);
+        if (r == WAIT_OBJECT_0) break;
+        MSG m; PeekMessageA(&m, NULL, 0, 0, PM_NOREMOVE | PM_QS_SENDMESSAGE);
+    }
+    QueryPerformanceCounter(&q1); QueryPerformanceFrequency(&fq);
+    s_pipe.wait_ms += (double)(q1.QuadPart - q0.QuadPart) * 1000.0 / (double)fq.QuadPart;
+    s_pipe.n_wait++;
+    s_pipe.busy = 0;
+}
