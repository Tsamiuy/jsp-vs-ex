+        int on = (e && *e == '1') ? 1 : 0;
+        /* Debug switches that read or edit records, guest memory or readbacks from the submit half keep the old path. */
+        static const char* const dbg[] = { "RSX_DRAWLOG", "RSX_CAP", "RTT_SAVERT", "D3D12_IQ", "VP_TESTTRI", "RT_CLEARLOG",
+            "DRAWARGS", "VP_SUBMIT", "CELLMARK_DUMP_MINDRAWS", "GPU_OVERLAP", NULL };
+        for (int i = 0; on && dbg[i]; i++)
+            if (getenv(dbg[i])) { on = 0; fprintf(stderr, "[PIPE] off: %s is set%c", dbg[i], 10); }
+        if (on) {
+            s_pipe.go = CreateEventA(NULL, FALSE, FALSE, NULL);
+            s_pipe.done = CreateEventA(NULL, FALSE, FALSE, NULL);
+            s_pipe.th = (s_pipe.go && s_pipe.done) ? CreateThread(NULL, 0, pipe_thread, NULL, 0, NULL) : NULL;
+            if (!s_pipe.th) { on = 0; fprintf(stderr, "[PIPE] off: thread not created%c", 10); }
+            else fprintf(stderr, "[PIPE] on: draw loop, Execute and Present on their own thread (tid %lu)%c", (unsigned long)GetThreadId(s_pipe.th), 10);
