Patch 2019: the texture pitch register (TEXTURE_CONTROL3 [19:0]) reaches the D3D12 upload.

The backend always called rsx_texture_layout with pitch 0, so rows of linear textures were read at the natural width; compressed
(DXT) linear textures also ignored the pitch. They now space their source rows by the pitch while the decoded rows stay packed.
RSX_TEX_PITCH=0 restores pitch 0.

Re-fitted for v0.19.0: v0.19.0 (#600) tracks the pitch register itself; what is left is the RSX_TEX_PITCH switch, the [TEXPITCH] log and the pitch for the mip chain.

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index b2bda618..b5603288 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -3094,7 +3094,16 @@ static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips
      * layout.c owns them so the Metal backend can read a guest texture without
      * re-deriving any of it. Only the DXGI mapping below is ours. */
     rsx_tex_layout tl;
-    rsx_texture_layout_pitched(fmt, w, h, pitch_arg, &tl);
+    /* the pitch register (TEXTURE_CONTROL3 [19:0]) spaces the rows of a LINEAR texture
+     * (LN bit); the layout code ignored it for compressed ones. RSX_TEX_PITCH=0 passes 0 again. */
+    static int s_pitch_arg_on = -1;
+    if (s_pitch_arg_on < 0) { const char* e = getenv("RSX_TEX_PITCH"); s_pitch_arg_on = e ? atoi(e) : 1; }
+    rsx_texture_layout_pitched(fmt, w, h, s_pitch_arg_on ? pitch_arg : 0u, &tl);
+    if ((fmt & 0x20u) && pitch_arg) { static u32 seen[32]; static int ns = 0; u32 k = (fmt << 24) ^ (w << 8) ^ pitch_arg; int f = 0;
+        for (int i = 0; i < ns; i++) if (seen[i] == k) f = 1;
+        if (!f && ns < 32) { seen[ns++] = k;
+            fprintf(stderr, "[TEXPITCH] linear fmt=0x%02X %ux%u pitch=%u natural=%u used_row=%u%c", fmt, w, h, pitch_arg,
+                    tl.compressed ? ((w + 3) / 4) * tl.block_bytes : w * tl.bytes_per_texel, tl.row_bytes, 10); } }
     int argb = (tl.fmt == RSX_TEXFMT_R8G8B8A8);
     int dxt  = tl.compressed;
     /* Compressed rows are counted in blocks, so keep bpp at 1 for the byte
@@ -3259,7 +3268,7 @@ static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips
     UINT64 mtotal = 0;
     u32 levels = 1;
     if (s_mips_on && !cube && mips > 1 && !(dxt && ((w & 3u) || (h & 3u)))) {
-        levels = rsx_texture_mip_chain(fmt, w, h, mips, 0u, mlv);
+        levels = rsx_texture_mip_chain(fmt, w, h, mips, s_pitch_arg_on ? pitch_arg : 0u, mlv);
         if (levels > 1) {
             D3D12_RESOURCE_DESC md = {0};
             md.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
diff --git a/libs/video/rsx_texture_layout.c b/libs/video/rsx_texture_layout.c
index 51a30a23..5129f83f 100644
--- a/libs/video/rsx_texture_layout.c
+++ b/libs/video/rsx_texture_layout.c
@@ -101,9 +101,13 @@ void rsx_texture_layout_pitched(u32 rsx_fmt, u32 w, u32 h, u32 pitch,
         out->bytes_per_texel = 0;
         out->swizzled = 0;
         out->row_bytes = ((w + 3u) / 4u) * out->block_bytes;
+        out->dst_row_bytes       = out->row_bytes;
+        /* a linear (LN) compressed texture has a pitch register like any linear one:
+         * the source rows are `pitch` bytes apart, the decoded rows stay packed. */
+        if (pitch > out->row_bytes && (rsx_fmt & 0x20u))
+            out->row_bytes = pitch;
         out->rows      = (h + 3u) / 4u;
         out->dst_bytes_per_texel = 0;
-        out->dst_row_bytes       = out->row_bytes;
     } else {
         /* Swizzled unless the LN bit is set. The hardware requires power-of-two
          * dimensions to swizzle, so a NPOT image is linear regardless. */
@@ -281,7 +285,7 @@ void rsx_texture_decode(void* dst, u32 dst_pitch,
          * rather than converted -- only the row stride changes. */
         for (u32 y = 0; y < tl->rows; y++)
             memcpy(d + (size_t)y * dst_pitch,
-                   src + (size_t)y * tl->row_bytes, tl->row_bytes);
+                   src + (size_t)y * tl->row_bytes, tl->dst_row_bytes);
         return;
     }
 
