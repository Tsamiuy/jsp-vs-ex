+/* Misses of the current batch: collected by a first pass over the draws
+ * (s_fp_collect), built (decompile + D3DCompile + pipeline) in parallel, then
+ * taken by the normal pass. */
+static int s_fp_collect;
+typedef struct {
+    u32 fp_addr, off, ctrl, cube, hash, blend, rtfmt, cmask, cull, vs_hash, gen;
+    int vs_idx, nrt; u64 zs; ID3DBlob* vsb;
+    int status;                       /* 0 pending, 1 compile failed, 2 pipeline made (hr) */
+    HRESULT hr; ID3D12PipelineState* pso;
+} FPJob;
+#define FP_JOBS_MAX 4096
+static FPJob s_fpj[FP_JOBS_MAX];
+static int s_fpj_n;
+static volatile LONG s_fpj_next;
+
+static int fpj_same(const FPJob* j, const FPJob* k)
+{
+    return j->hash == k->hash && j->ctrl == k->ctrl && j->cube == k->cube && j->vs_idx == k->vs_idx &&
+           j->vs_hash == k->vs_hash && j->gen == k->gen && j->blend == k->blend && j->nrt == k->nrt &&
+           j->rtfmt == k->rtfmt && j->cmask == k->cmask && j->cull == k->cull && j->zs == k->zs;
+}
+static void vp_fp_jobs_reset(void)
+{
+    for (int i = 0; i < s_fpj_n; i++)
+        if (s_fpj[i].pso) { s_fpj[i].pso->lpVtbl->Release(s_fpj[i].pso); s_fpj[i].pso = NULL; }
+    s_fpj_n = 0;
+}
+static void vp_fp_job_add(const FPJob* k)
+{
+    for (int i = 0; i < s_fpj_n; i++) if (fpj_same(&s_fpj[i], k)) return;
+    if (s_fpj_n >= FP_JOBS_MAX) return;
+    s_fpj[s_fpj_n] = *k; s_fpj[s_fpj_n].status = 0; s_fpj[s_fpj_n].pso = NULL; s_fpj_n++;
+}
+static FPJob* vp_fp_find_done(const FPJob* k)
+{
+    for (int i = 0; i < s_fpj_n; i++)
+        if (s_fpj[i].status && fpj_same(&s_fpj[i], k)) return &s_fpj[i];
+    return NULL;
+}
+static DWORD WINAPI vp_fp_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        LONG i = InterlockedIncrement(&s_fpj_next) - 1;
+        if (i >= s_fpj_n) return 0;
+        FPJob* j = &s_fpj[i];
+        ID3DBlob* pb = vp_fp_compile_blob(j->fp_addr, j->off, j->ctrl, j->cube);
+        if (!pb) { j->status = 1; continue; }
+        j->hr = vp_fp_make_pso(j->vsb, pb, j->blend, j->nrt, (DXGI_FORMAT)j->rtfmt, j->cmask, j->cull, j->zs, &j->pso);
+        pb->lpVtbl->Release(pb);
+        j->status = 2;
+    }
+}
+/* FP_PAR_COMPILE=0 keeps the serial path; FP_THREADS=N workers (default 12). */
+static int vp_fp_par_threads(void)
+{
+    static int n = -1;
+    if (n < 0) {
+        const char* e = getenv("FP_PAR_COMPILE");
+        const char* t = getenv("FP_THREADS");
+        n = (e && e[0] == '0') ? 0 : (t ? atoi(t) : 12);
+        if (n > 32) n = 32;
+    }
+    return n;
+}
+static void vp_fp_run_jobs(void)
+{
+    int nt = vp_fp_par_threads();
+    if (s_fpj_n < 2 || nt < 2) return;       /* one miss: compile inline */
+    if (nt > s_fpj_n) nt = s_fpj_n;
+    HANDLE th[32]; int k = 0;
+    s_fpj_next = 0;
+    for (int i = 0; i < nt; i++) { th[k] = CreateThread(NULL, 0, vp_fp_worker, NULL, 0, NULL); if (th[k]) k++; }
+    if (!k) return;
+    WaitForMultipleObjects((DWORD)k, th, TRUE, INFINITE);
+    for (int i = 0; i < k; i++) CloseHandle(th[i]);
+    { static int pn = 0; if (pn < 5) { pn++;
+        fprintf(stderr, "[FPPAR] %d programs compiled on %d threads%c", s_fpj_n, k, 10); } }
+}
