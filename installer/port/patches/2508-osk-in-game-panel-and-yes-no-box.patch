Patch 2508: the on-screen keyboard and the port's Yes/No box, from the v0.15 port.

cellOskDialog: LoadAsync no longer answers at once and sends no sysutil events (titles waited for FINISHED forever;
J-Stars' J-Customize deck rename locked up). OSK_DIALOG=2 (default) opens a text panel inside the game window,
OSK_DIALOG=1 a separate Windows text box, OSK_DIALOG=0 the old instant answer. LOADED, FINISHED and UNLOADED go out on
the title's cellSysutilCheckCallback polls (cellOskDialog_tick). LoadAsync starts the dialog without cellOskDialogInit
(J-Stars imports no Init). The same panel serves a title port as a Yes/No box (cellOskDialog_confirm_open / _poll)
or a choice between two named buttons (cellOskDialog_choice_open).

D3D12 backend: the panel is drawn on the CPU (gradients by hand, text by GDI) like the game's own message box,
scaled to the back buffer and copied over it before present; while it is up the window's keys type into it (Enter
and Esc answer it, not on auto-repeat). rsx_d3d12_request_close() closes the window as its close button would.

Tested (US disc): see the J-Stars STATUS entry for the feature build with this patch.

diff --git a/libs/misc/cellOskDialog.c b/libs/misc/cellOskDialog.c
index 17e7c674..109c92f8 100644
--- a/libs/misc/cellOskDialog.c
+++ b/libs/misc/cellOskDialog.c
@@ -10,6 +10,17 @@
 #include "cellOskDialog.h"
 #include <stdio.h>
 #include <string.h>
+#include <stdlib.h>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <process.h>
+#else
+typedef long LONG;
+#define InterlockedExchange(p, v) __atomic_exchange_n((p), (v), __ATOMIC_SEQ_CST)
+static inline LONG InterlockedCompareExchange(volatile LONG* p, LONG v, LONG cmp)
+{ __atomic_compare_exchange_n(p, &cmp, v, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); return cmp; }
+#endif
 #include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
 #include "../guest_struct.h"   /* GUEST_EA, vm_read/vm_write: guest EA -> host */
 
@@ -25,6 +36,297 @@ static char s_default_response[CELL_OSK_MAX_TEXT_LENGTH + 1] = "";
 static CellOskDialogChar s_result_text[CELL_OSK_MAX_TEXT_LENGTH + 1];
 static u32               s_result_length = 0;
 
+/* ---------------------------------------------------------------------------
+ * Host text box (Windows; OSK_DIALOG=0 keeps the old instant answer)
+ *
+ * The PS3 shows its on-screen keyboard and tells the title through sysutil
+ * events: LOADED when it is up, FINISHED when the user is done, UNLOADED after
+ * cellOskDialogUnloadAsync. Answering LoadAsync instantly and sending no event
+ * left titles waiting for FINISHED forever (J-Stars' J-Customize deck rename,
+ * Square: the game locked up). Here a small Windows window with a text field
+ * stands in for the keyboard: it opens with the current text, Enter / OK
+ * accepts, Esc / Cancel cancels, and the events go out on the title's next
+ * cellSysutilCheckCallback poll (cellOskDialog_tick).
+ * -----------------------------------------------------------------------*/
+#define CELL_SYSUTIL_OSKDIALOG_LOADED    0x0502
+#define CELL_SYSUTIL_OSKDIALOG_FINISHED  0x0503
+#define CELL_SYSUTIL_OSKDIALOG_UNLOADED  0x0504
+extern void cellSysutilQueueEvent(int slot, u32 status, u32 param);
+
+static void osk_queue_event(u32 status)
+{
+    for (int slot = 0; slot < 4; slot++)        /* every registered slot */
+        cellSysutilQueueEvent(slot, status, 0);
+}
+
+/* OSK_DIALOG: 0 = old instant answer, 1 = separate Windows text box,
+ * 2 (default) = a panel drawn inside the game window (the D3D12 backend draws
+ * it, its window procedure feeds the keys here). */
+static int osk_mode(void)
+{
+#ifdef _WIN32
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("OSK_DIALOG"); m = e ? atoi(e) : 2; if (m < 0 || m > 2) m = 2; }
+    return m;
+#else
+    return 0;
+#endif
+}
+static int osk_dialog_on(void) { return osk_mode() != 0; }
+
+static volatile LONG s_osk_state = 0;   /* 0 idle, 1 box open, 2 done (FINISHED pending), 3 FINISHED sent */
+static s32 s_osk_result = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK;
+static u32 s_osk_limit = CELL_OSK_MAX_TEXT_LENGTH;
+static wchar_t s_osk_title[CELL_OSK_MAX_TEXT_LENGTH + 1];
+
+/* ---- in-game panel (OSK_DIALOG=2) ---------------------------------------
+ * The text being typed lives here; the backend polls overlay_gen() and
+ * redraws its panel when it changes. Keys come from the game window's
+ * procedure on the window thread, the game reads the result on its own
+ * thread, so the text is guarded by a lock. */
+#ifdef _WIN32
+static SRWLOCK s_ov_lock = SRWLOCK_INIT;
+static volatile LONG s_ov_active = 0, s_ov_gen = 0;
+static wchar_t s_ov_text[CELL_OSK_MAX_TEXT_LENGTH + 1];
+static u32 s_ov_len = 0;
+static volatile LONG s_ov_sel = 0;     /* highlighted button: 0 OK, 1 Cancel */
+/* The same panel as a Yes/No confirmation for the port (no text field):
+ * cellOskDialog_confirm_open(), then cellOskDialog_confirm_poll() for the
+ * answer. s_ov_mode 1 = confirm; its result: -1 pending, 0 No, 1 Yes.
+ * s_ov_mode 2 = a choice between two named buttons (cellOskDialog_choice_open):
+ * 1 the left one, 0 the right one, 2 backed out (Esc / Circle). */
+static volatile LONG s_ov_mode = 0, s_confirm_result = -1;
+static wchar_t s_choice_label[2][40];
+
+int cellOskDialog_overlay_active(void) { return s_ov_active != 0; }
+unsigned cellOskDialog_overlay_gen(void) { return (unsigned)s_ov_gen; }
+int cellOskDialog_overlay_sel(void) { return (int)s_ov_sel; }
+int cellOskDialog_overlay_mode(void) { return (int)s_ov_mode; }
+const wchar_t* cellOskDialog_choice_label(int b) { return s_choice_label[b ? 1 : 0]; }
+
+void cellOskDialog_overlay_get(wchar_t* prompt, int pmax, wchar_t* text, int tmax)
+{
+    AcquireSRWLockShared(&s_ov_lock);
+    wcsncpy(prompt, s_osk_title, (size_t)pmax - 1); prompt[pmax - 1] = 0;
+    wcsncpy(text, s_ov_text, (size_t)tmax - 1);     text[tmax - 1] = 0;
+    ReleaseSRWLockShared(&s_ov_lock);
+}
+
+static void osk_overlay_finish(s32 result)
+{
+    if (s_ov_mode != 0) {   /* confirmation or choice: report the answer, no OSK events */
+        InterlockedExchange(&s_confirm_result, result == CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK ? 1 : 0);
+        InterlockedExchange(&s_ov_active, 0);
+        InterlockedExchange(&s_ov_mode, 0);
+        InterlockedIncrement(&s_ov_gen);
+        return;
+    }
+    AcquireSRWLockExclusive(&s_ov_lock);
+    if (result == CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK) {
+        for (u32 i = 0; i <= s_ov_len; i++) s_result_text[i] = (CellOskDialogChar)s_ov_text[i];
+        s_result_length = s_ov_len;
+        if (!s_ov_len) result = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_NO_INPUT_TEXT;
+    }
+    s_osk_result = result;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_ov_active, 0);
+    InterlockedIncrement(&s_ov_gen);
+    InterlockedExchange(&s_osk_state, 2);    /* FINISHED goes out on the next poll */
+}
+
+/* A typed character (UTF-16). */
+void cellOskDialog_overlay_char(unsigned ch)
+{
+    if (!s_ov_active || s_ov_mode != 0 || ch < 0x20 || ch == 0x7F) return;
+    AcquireSRWLockExclusive(&s_ov_lock);
+    if (s_ov_len < s_osk_limit && s_ov_len < CELL_OSK_MAX_TEXT_LENGTH) {
+        s_ov_text[s_ov_len++] = (wchar_t)ch; s_ov_text[s_ov_len] = 0; }
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedIncrement(&s_ov_gen);
+}
+
+/* A key press: Enter presses the highlighted button (OK or Cancel), Left/Right/
+ * Tab move the highlight, Esc cancels, Backspace deletes. Returns 1 when the key
+ * belongs to the panel. */
+static ULONGLONG s_confirm_opened;   /* GetTickCount64 when the Yes/No box opened */
+int cellOskDialog_overlay_key(unsigned vk)
+{
+    if (!s_ov_active) return 0;
+    /* The Enter that opened the Yes/No box (a pad poll saw it as START) can
+     * reach the window afterwards; it must not answer the box at once. */
+    if (vk == VK_RETURN && s_ov_mode != 0 && GetTickCount64() - s_confirm_opened < 400) return 1;
+    if (vk == VK_ESCAPE && s_ov_mode == 2) {   /* a choice: backing out is its own answer */
+        InterlockedExchange(&s_confirm_result, 2);
+        InterlockedExchange(&s_ov_active, 0);
+        InterlockedExchange(&s_ov_mode, 0);
+        InterlockedIncrement(&s_ov_gen);
+        return 1;
+    }
+    if (vk == VK_RETURN) {
+        osk_overlay_finish(s_ov_sel ? CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED
+                                    : CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK);
+        return 1;
+    }
+    if (vk == VK_LEFT || vk == VK_RIGHT || vk == VK_TAB) {
+        InterlockedExchange(&s_ov_sel, vk == VK_LEFT ? 0 : vk == VK_RIGHT ? 1 : !s_ov_sel);
+        InterlockedIncrement(&s_ov_gen);
+        return 1;
+    }
+    if (vk == VK_ESCAPE) { osk_overlay_finish(CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED); return 1; }
+    if (vk == VK_BACK && s_ov_mode == 0) {
+        AcquireSRWLockExclusive(&s_ov_lock);
+        if (s_ov_len) s_ov_text[--s_ov_len] = 0;
+        ReleaseSRWLockExclusive(&s_ov_lock);
+        InterlockedIncrement(&s_ov_gen);
+    }
+    return 1;
+}
+
+static void osk_overlay_open(void)
+{
+    AcquireSRWLockExclusive(&s_ov_lock);
+    s_ov_len = 0;
+    for (; s_ov_len < s_result_length && s_ov_len < s_osk_limit; s_ov_len++)
+        s_ov_text[s_ov_len] = (wchar_t)s_result_text[s_ov_len];
+    s_ov_text[s_ov_len] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_ov_sel, 0);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+}
+/* Open the panel as a Yes/No question (No highlighted). 0 if a panel is up. */
+int cellOskDialog_confirm_open(const wchar_t* prompt)
+{
+    if (s_ov_active) return 0;
+    s_confirm_opened = GetTickCount64();
+    AcquireSRWLockExclusive(&s_ov_lock);
+    wcsncpy(s_osk_title, prompt, CELL_OSK_MAX_TEXT_LENGTH);
+    s_osk_title[CELL_OSK_MAX_TEXT_LENGTH] = 0;
+    s_ov_len = 0; s_ov_text[0] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_confirm_result, -1);
+    InterlockedExchange(&s_ov_sel, 1);
+    InterlockedExchange(&s_ov_mode, 1);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+    return 1;
+}
+/* Open the panel as a choice between two buttons (the left one highlighted).
+ * The answer comes from cellOskDialog_confirm_poll: 1 left, 0 right, 2 back. */
+int cellOskDialog_choice_open(const wchar_t* prompt, const wchar_t* left, const wchar_t* right)
+{
+    if (s_ov_active) return 0;
+    s_confirm_opened = GetTickCount64();
+    AcquireSRWLockExclusive(&s_ov_lock);
+    wcsncpy(s_osk_title, prompt, CELL_OSK_MAX_TEXT_LENGTH);
+    s_osk_title[CELL_OSK_MAX_TEXT_LENGTH] = 0;
+    wcsncpy(s_choice_label[0], left, 39);  s_choice_label[0][39] = 0;
+    wcsncpy(s_choice_label[1], right, 39); s_choice_label[1][39] = 0;
+    s_ov_len = 0; s_ov_text[0] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_confirm_result, -1);
+    InterlockedExchange(&s_ov_sel, 0);
+    InterlockedExchange(&s_ov_mode, 2);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+    return 1;
+}
+/* -1 while open (or never opened), else 1 Yes / 0 No (choice: 1 / 0 / 2), once. */
+int cellOskDialog_confirm_poll(void)
+{
+    return (int)InterlockedExchange(&s_confirm_result, -1);
+}
+#else
+int cellOskDialog_overlay_active(void) { return 0; }
+int cellOskDialog_overlay_sel(void) { return 0; }
+int cellOskDialog_overlay_mode(void) { return 0; }
+int cellOskDialog_confirm_open(const wchar_t* prompt) { (void)prompt; return 0; }
+int cellOskDialog_choice_open(const wchar_t* prompt, const wchar_t* left, const wchar_t* right)
+{ (void)prompt; (void)left; (void)right; return 0; }
+int cellOskDialog_confirm_poll(void) { return -1; }
+#endif
+
+#ifdef _WIN32
+static HWND s_osk_edit;
+static LRESULT CALLBACK osk_wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    switch (m) {
+    case WM_COMMAND:
+        if (LOWORD(w) == IDOK || LOWORD(w) == IDCANCEL) {
+            wchar_t buf[CELL_OSK_MAX_TEXT_LENGTH + 1];
+            int n = GetWindowTextW(s_osk_edit, buf, (int)s_osk_limit + 1);
+            if (LOWORD(w) == IDOK) {
+                for (int i = 0; i < n; i++) s_result_text[i] = (CellOskDialogChar)buf[i];
+                s_result_text[n] = 0;
+                s_result_length = (u32)n;
+                s_osk_result = n ? CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK
+                                 : CELL_OSK_DIALOG_INPUT_FIELD_RESULT_NO_INPUT_TEXT;
+            } else {
+                s_osk_result = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED;
+            }
+            DestroyWindow(h);
+            return 0;
+        }
+        break;
+    case WM_CLOSE:
+        SendMessageW(h, WM_COMMAND, IDCANCEL, 0);
+        return 0;
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    }
+    return DefWindowProcW(h, m, w, l);
+}
+
+static unsigned __stdcall osk_thread(void* arg)
+{
+    (void)arg;
+    HINSTANCE inst = GetModuleHandleW(NULL);
+    WNDCLASSW wc; memset(&wc, 0, sizeof wc);
+    wc.lpfnWndProc = osk_wndproc; wc.hInstance = inst; wc.lpszClassName = L"ps3recomp_osk";
+    wc.hCursor = LoadCursorW(NULL, (LPCWSTR)IDC_ARROW); wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    RegisterClassW(&wc);
+    const int W = 460, H = 150;
+    HWND h = CreateWindowExW(WS_EX_TOPMOST | WS_EX_DLGMODALFRAME, L"ps3recomp_osk",
+                             s_osk_title[0] ? s_osk_title : L"Enter text",
+                             WS_CAPTION | WS_SYSMENU | WS_VISIBLE,
+                             (GetSystemMetrics(SM_CXSCREEN) - W) / 2, (GetSystemMetrics(SM_CYSCREEN) - H) / 2,
+                             W, H, NULL, NULL, inst, NULL);
+    HFONT font = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
+    wchar_t init[CELL_OSK_MAX_TEXT_LENGTH + 1];
+    u32 i = 0; for (; i < s_result_length && i < CELL_OSK_MAX_TEXT_LENGTH; i++) init[i] = s_result_text[i];
+    init[i] = 0;
+    s_osk_edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", init, WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL,
+                                 12, 14, W - 40, 26, h, (HMENU)100, inst, NULL);
+    HWND ok = CreateWindowExW(0, L"BUTTON", L"OK", WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_DEFPUSHBUTTON,
+                              W - 200, 56, 80, 28, h, (HMENU)IDOK, inst, NULL);
+    HWND cancel = CreateWindowExW(0, L"BUTTON", L"Cancel", WS_CHILD | WS_VISIBLE | WS_TABSTOP,
+                                  W - 110, 56, 80, 28, h, (HMENU)IDCANCEL, inst, NULL);
+    SendMessageW(s_osk_edit, WM_SETFONT, (WPARAM)font, TRUE);
+    SendMessageW(ok, WM_SETFONT, (WPARAM)font, TRUE);
+    SendMessageW(cancel, WM_SETFONT, (WPARAM)font, TRUE);
+    SendMessageW(s_osk_edit, EM_LIMITTEXT, (WPARAM)s_osk_limit, 0);
+    SendMessageW(s_osk_edit, EM_SETSEL, 0, -1);
+    SetForegroundWindow(h);
+    SetFocus(s_osk_edit);
+    MSG msg;
+    while (GetMessageW(&msg, NULL, 0, 0) > 0) {
+        if (!IsDialogMessageW(h, &msg)) { TranslateMessage(&msg); DispatchMessageW(&msg); }
+    }
+    InterlockedExchange(&s_osk_state, 2);    /* FINISHED goes out on the next poll */
+    return 0;
+}
+#endif
+
+/* Called from cellSysutilCheckCallback: send FINISHED once the box closed. */
+void cellOskDialog_tick(void)
+{
+    if (InterlockedCompareExchange(&s_osk_state, 3, 2) == 2) {
+        printf("[cellOskDialog] input finished (result %d, %u chars)\n", s_osk_result, s_result_length);
+        osk_queue_event(CELL_SYSUTIL_OSKDIALOG_FINISHED);
+    }
+}
+
 /* Convert narrow string to UTF-16LE (simple ASCII subset) */
 static void osk_ascii_to_utf16(const char* src, CellOskDialogChar* dst,
                                 u32 maxChars)
@@ -125,6 +427,12 @@ s32 cellOskDialogLoadAsync(u32 container,
 {
     (void)container; (void)dialogParam;
 
+    /* The libsysutil_oskdialog the titles link has no Init call (the NID
+     * registered as cellOskDialogInit is not one they import): J-Stars goes
+     * straight to LoadAsync, which then failed with NOT_INITIALIZED and its
+     * deck-rename screen waited forever. Treat LoadAsync as the start. */
+    if (!s_osk_initialized && osk_dialog_on())
+        s_osk_initialized = 1;
     if (!s_osk_initialized)
         return CELL_OSK_ERROR_NOT_INITIALIZED;
 
@@ -174,6 +482,29 @@ s32 cellOskDialogLoadAsync(u32 container,
         s_result_length = 0;
     }
 
+    if (osk_dialog_on()) {
+#ifdef _WIN32
+        u32 lim = info_ea ? vm_read32(info_ea + OSKIF_O_LIMIT_LENGTH) : 0;
+        s_osk_limit = (lim && lim < CELL_OSK_MAX_TEXT_LENGTH) ? lim : CELL_OSK_MAX_TEXT_LENGTH;
+        s_osk_title[0] = 0;
+        if (message_ea) {
+            static CellOskDialogChar t[CELL_OSK_MAX_TEXT_LENGTH + 1];
+            u32 n = osk_guest_utf16(message_ea, t, CELL_OSK_MAX_TEXT_LENGTH);
+            for (u32 i = 0; i <= n; i++) s_osk_title[i] = (wchar_t)t[i];
+        }
+        s_osk_result = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK;
+        InterlockedExchange(&s_osk_state, 1);
+        osk_queue_event(CELL_SYSUTIL_OSKDIALOG_LOADED);
+        if (osk_mode() == 2) {
+            osk_overlay_open();                      /* drawn by the backend */
+        } else {
+            HANDLE th = (HANDLE)_beginthreadex(NULL, 0, osk_thread, NULL, 0, NULL);
+            if (th) CloseHandle(th);
+            else InterlockedExchange(&s_osk_state, 2);   /* no window: answer with the current text */
+        }
+#endif
+    }
+
     return CELL_OK;
 }
 
@@ -190,7 +521,7 @@ s32 cellOskDialogUnloadAsync(CellOskDialogCallbackReturnParam* result)
     if (result) {
         u32 res_ea = GUEST_EA(result);
         vm_write32(res_ea + OSKRET_O_RESULT,
-                   CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK);
+                   osk_dialog_on() ? (u32)s_osk_result : CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK);
         vm_write32(res_ea + OSKRET_O_NUMCHARS, s_result_length);
         u32 str_ea = vm_read32(res_ea + OSKRET_O_PRESULTSTRING);
         if (str_ea && s_result_length > 0) {
@@ -201,6 +532,10 @@ s32 cellOskDialogUnloadAsync(CellOskDialogCallbackReturnParam* result)
     }
 
     s_osk_loaded = 0;
+    if (osk_dialog_on()) {
+        InterlockedExchange(&s_osk_state, 0);
+        osk_queue_event(CELL_SYSUTIL_OSKDIALOG_UNLOADED);
+    }
