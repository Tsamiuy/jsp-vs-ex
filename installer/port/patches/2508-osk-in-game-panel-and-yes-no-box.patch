+/* In-game text panel for the on-screen keyboard (cellOskDialog, OSK_DIALOG=2). */
+extern int      cellOskDialog_overlay_active(void);
+extern unsigned cellOskDialog_overlay_gen(void);
+extern void     cellOskDialog_overlay_get(wchar_t* prompt, int pmax, wchar_t* text, int tmax);
+extern void     cellOskDialog_overlay_char(unsigned ch);
+extern int      cellOskDialog_overlay_key(unsigned vk);
+extern int      cellOskDialog_overlay_sel(void);
+extern int      cellOskDialog_overlay_mode(void);   /* 1 = Yes/No confirmation, 2 = choice */
+extern const wchar_t* cellOskDialog_choice_label(int b);
+
 static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
+    /* While the text panel is up, the keyboard types into it (and Esc cancels
+     * it instead of closing the game). */
+    if (cellOskDialog_overlay_active()) {
+        if (msg == WM_CHAR) {
+            char c = (char)wp; wchar_t w = 0;
+            if (MultiByteToWideChar(CP_ACP, 0, &c, 1, &w, 1) == 1) cellOskDialog_overlay_char(w);
+            return 0;
+        }
+        /* auto-repeat of Enter/Esc must not answer the panel a second time */
+        if (msg == WM_KEYDOWN && (lp & 0x40000000) && (wp == VK_RETURN || wp == VK_ESCAPE)) return 0;
+        if (msg == WM_KEYDOWN && cellOskDialog_overlay_key((unsigned)wp)) return 0;
+    }
     switch (msg) {
     case WM_MOUSEWHEEL: {   /* 2501: cellPad mouse menus (INPUT_MODE=kbm, patch 6500): wheel = up/down */
         extern volatile long g_pad_wheel;
