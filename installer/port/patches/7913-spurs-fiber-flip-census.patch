+/* Patch 7913 (read-only, takes no lock): the flip / pending-event state, for the rollback snapshot's quiesce gate.
+ * out[0] flip_status (CELL_GCM_FLIP_STATUS_*: DONE = no flip outstanding)  out[1] flip_req_seq  out[2] flip_tick_seq
+ * out[3] flips_queued (flip commands the guest put in the FIFO)  out[4] flips_reached (executed by the drain)  out[5] flips_completed
+ * out[6] direct_pending (a direct flip waiting for its tick)  out[7] gcm_pending (bit0 vblank, bit1 flip: a handler call not yet delivered)
+ * out[8] flip_lock_held
+ * Labels: the drain writes a label release while it parses the command, so with put == get every label the guest emitted is written; a flip command
+ * still ahead of the drain (queued != reached) is the observable form of "labels not yet written". The runtime keeps no other label queue. */
+void cellGcm_flip_census(uint32_t* out)
+{
+    out[0] = s_flip_status; out[1] = s_flip_req_seq; out[2] = s_flip_tick_seq;
+    out[3] = s_fifo_flips_queued; out[4] = s_fifo_flips_reached; out[5] = s_fifo_flips_completed;
+    out[6] = (uint32_t)s_flip_direct_pending; out[7] = (uint32_t)s_gcm_pending; out[8] = (uint32_t)s_flip_lock;
+}
