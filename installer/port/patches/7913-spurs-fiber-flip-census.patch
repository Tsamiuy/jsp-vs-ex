@@ -271,3 +271,11 @@ s32 cellSpursJobQueueSemaphoreTryAcquire(CellSpursJobQueue* jq)
     (void)jq;
     return CELL_OK;
 }
+
+/* Patch 7913 (read-only, takes no lock): jobs the HLE queues still count as pending (jobCount of every queue in use). */
+u32 ps3_spurs_jq_pending(void)
+{
+    u32 n = 0;
+    for (int i = 0; i < CELL_SPURS_JQ_MAX_QUEUES; i++) if (s_queues[i].in_use) n += s_queues[i].jobCount;
+    return n;
+}
