+/*
+ * ps3recomp - RSX vertex pulling (VPULL=1, opt-in, D3D12 backend)
+ *
+ * The vertex shader decodes the game's own vertex bytes instead of the CPU
+ * converting every vertex into a 256-byte float4 slot (read_vp_vertex_fast in
+ * rsx_d3d12_backend.c). Ported from the J-Stars patch (jstars-notes
+ * patches/vpull + vpull-once) to that port's backend, which keeps its own index
+ * handling (indexed lists, strips and fans turned into list indices on the
+ * CPU), so no strip cut value is involved.
+ *
+ * One interleaved vertex stream per draw record: every array attribute has
+ * the same stride S, the same memory and no frequency divider. Per index
+ * batch the CPU copies the guest bytes of the vertices the batch spans into a
+ * byte ring (vertex k of the record's region at k * S) and writes the batch's
+ * indices rebased to that copy. The shader gets:
+ *   t8  ByteAddressBuffer   the record's region (root SRV)
+ *   t9  ByteAddressBuffer   the decode tables below (exact values)
+ *   b2  VPullTab            per attribute: byte offset in the vertex, stride,
+ *                           type (0 = constant register), components; and the
+ *                           values a vertex starts from (the constant register
+ *                           for a constant attribute, (0,0,0,1) for an array)
+ *
+ * The decode gives the same float bits as vf_decode (VF_FAST=2, the default).
+ * GPU division is not correctly rounded, so the normalised types read their
+ * value from tables the CPU fills with vf_decode's own expressions
+ * (rsx_vpull_fill_lut); the rest is integer work plus int->float conversions
+ * that are exact.
+ *
+ * Self-contained (no D3D12, no guest memory): the decompiler includes it for
+ * RSX_VPULL_HLSL.
+ */
+#ifndef PS3RECOMP_RSX_VPULL_H
+#define PS3RECOMP_RSX_VPULL_H
+
+#include "ps3emu/ps3types.h"
+
+/* Decode table layout, in floats (the HLSL below hard-codes 256, 65792 and
+ * 67840). */
+#define RSX_VPULL_LUT_UB    0u                       /* p * (1/255), p = 0..255        */
+#define RSX_VPULL_LUT_S1    256u                     /* (s16)u / 32767, u = 0..65535    */
+#define RSX_VPULL_LUT_CMPXY (256u + 65536u)          /* 11-bit pattern -> x / 1023      */
+#define RSX_VPULL_LUT_CMPZ  (256u + 65536u + 2048u)  /* 10-bit pattern -> z / 511       */
+#define RSX_VPULL_LUT_COUNT (256u + 65536u + 2048u + 1024u)
+
+/* Per-record table (constant buffer b2), 512 bytes. */
+typedef struct rsx_vpull_tab {
+    u32   attr[16][4];   /* x = byte offset in the vertex, y = stride, z = type (0 = constant), w = n */
+    float konst[16][4];  /* start value: constant register, or (0,0,0,1) for an array attribute */
+} rsx_vpull_tab;
+#define RSX_VPULL_TAB_BYTES 512u
+
+/* Same expressions as vf_decode in rsx_d3d12_backend.c. */
+static inline void rsx_vpull_fill_lut(float* lut)
+{
+    for (u32 p = 0; p < 256u; p++) lut[RSX_VPULL_LUT_UB + p] = (float)(int)p * (1.0f / 255.0f);
+    for (u32 u = 0; u < 65536u; u++) lut[RSX_VPULL_LUT_S1 + u] = (float)(s16)(u16)u / 32767.0f;
+    for (u32 b = 0; b < 2048u; b++) { s32 x = (s32)b; if (x & 0x400) x -= 0x800;
+                                      lut[RSX_VPULL_LUT_CMPXY + b] = (float)x / 1023.0f; }
+    for (u32 b = 0; b < 1024u; b++) { s32 z = (s32)b; if (z & 0x200) z -= 0x400;
+                                      lut[RSX_VPULL_LUT_CMPZ + b] = (float)z / 511.0f; }
+}
+
+/* Bytes one attribute occupies in a vertex, as vf_decode reads it. Types
+ * outside 1..7 are read as float32 there, and are given type 2 here. */
+static inline u32 rsx_vpull_type_size(u32 type, u32 n)
+{
+    switch (type) {
+    case 2: return 4u * n;                     /* F            */
+    case 3: case 1: case 5: return 2u * n;     /* SF, S1, S32K */
+    case 4: case 7: return n;                  /* UB, UB256    */
+    case 6: return 4u;                         /* CMP          */
+    default: return 4u * n;
+    }
+}
+
+/* HLSL: the decoder the pulling vertex shader calls (vpull_attr). */
+#define RSX_VPULL_HLSL \
+"ByteAddressBuffer vpull_bytes : register(t8);\n" \
+"ByteAddressBuffer vpull_lut : register(t9);\n" \
+"cbuffer VPullTab : register(b2) { uint4 vpull_a[16]; float4 vpull_k[16]; };\n" \
+"uint vpull_ld(uint a) {\n" \
+"    uint s = (a & 3u) * 8u; uint2 w = vpull_bytes.Load2(a & ~3u);\n" \
+"    return s ? ((w.x >> s) | (w.y << (32u - s))) : w.x;\n" \
+"}\n" \
+"uint vpull_be32(uint a) { uint x = vpull_ld(a);\n" \
+"    return (x << 24) | ((x << 8) & 0xFF0000u) | ((x >> 8) & 0xFF00u) | (x >> 24); }\n" \
+"float vpull_tabf(uint i) { return asfloat(vpull_lut.Load(i * 4u)); }\n" \
+"float vpull_half(uint h) {\n" \
+"    uint s = (h >> 15) & 1u, e = (h >> 10) & 0x1Fu, m = h & 0x3FFu, f;\n" \
+"    if (e == 0u) f = s << 31;\n" \
+"    else if (e == 31u) f = (s << 31) | 0x7F800000u | (m << 13);\n" \
+"    else f = (s << 31) | ((e - 15u + 127u) << 23) | (m << 13);\n" \
+"    return asfloat(f);\n" \
+"}\n" \
+"float4 vpull_attr(uint i, uint vid) {\n" \
+"    uint4 d = vpull_a[i]; float4 t = vpull_k[i];\n" \
+"    [branch] if (d.z == 0u) return t;\n" \
+"    uint a = d.x + vid * d.y;\n" \
+"    [branch] if (d.z == 6u) {\n" \
+"        uint w = vpull_be32(a);\n" \
+"        return float4(vpull_tabf(65792u + (w & 0x7FFu)), vpull_tabf(65792u + ((w >> 11) & 0x7FFu)),\n" \
+"                      vpull_tabf(67840u + ((w >> 22) & 0x3FFu)), 1.0);\n" \
+"    }\n" \
+"    uint es = (d.z == 2u) ? 4u : ((d.z == 4u || d.z == 7u) ? 1u : 2u);\n" \
+"    [unroll] for (uint k = 0u; k < 4u; k++) {\n" \
+"        if (k < d.w) {\n" \
+"            uint x = vpull_ld(a + k * es);\n" \
+"            uint r = (es == 4u) ? ((x << 24) | ((x << 8) & 0xFF0000u) | ((x >> 8) & 0xFF00u) | (x >> 24))\n" \
+"                   : ((es == 2u) ? (((x & 0xFFu) << 8) | ((x >> 8) & 0xFFu)) : (x & 0xFFu));\n" \
+"            float v = asfloat(r);\n" \
+"            if (d.z == 3u) v = vpull_half(r);\n" \
+"            else if (d.z == 5u) v = (float)((int)(r << 16) >> 16);\n" \
+"            else if (d.z == 7u) v = (float)r;\n" \
+"            [branch] if (d.z == 1u || d.z == 4u) v = vpull_tabf((d.z == 1u ? 256u : 0u) + r);\n" \
+"            t[k] = v;\n" \
+"        }\n" \
+"    }\n" \
+"    return t;\n" \
+"}\n"
+
+#endif /* PS3RECOMP_RSX_VPULL_H */
