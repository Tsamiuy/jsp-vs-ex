+/* [VPULL] every 5 s: FIFO index batches pulled vs left to the CPU path (and
+ * why), bytes uploaded, and pulled records not drawn. */
+static void vpull_report(void)
+{
+    const double now = perf_now();
+    if (s_vpull.t0 == 0.0) { s_vpull.t0 = now; return; }
+    const double sec = now - s_vpull.t0;
+    if (sec < 5.0) return;
+    const u64 all = s_vpull.n_batch + s_vpull.n_cpu;
+    fprintf(stderr, "[VPULL] %.1f s: pulled %llu of %llu indexed draws (%.0f%%, %llu records) | CPU path:"
+                    " layout %llu, sparse %llu, full %llu, no VS %llu, other prim %llu |"
+                    " uploaded %.1f MB vertex bytes + %.1f MB indices (%.1f MB/s) | not drawn %llu%c",
+            sec, (unsigned long long)s_vpull.n_batch, (unsigned long long)all,
+            all ? 100.0 * (double)s_vpull.n_batch / (double)all : 0.0, (unsigned long long)s_vpull.n_rec,
+            (unsigned long long)s_vpull.fb_layout, (unsigned long long)s_vpull.fb_sparse,
+            (unsigned long long)s_vpull.fb_full, (unsigned long long)s_vpull.fb_vs,
+            (unsigned long long)s_vpull.fb_prim,
+            (double)s_vpull.vbytes / 1048576.0, (double)s_vpull.n_idx * 4.0 / 1048576.0,
+            ((double)s_vpull.vbytes + (double)s_vpull.n_idx * 4.0) / 1048576.0 / sec,
+            (unsigned long long)s_vpull.n_skip, 10);
+    s_vpull.n_batch = s_vpull.n_rec = s_vpull.n_idx = s_vpull.vbytes = s_vpull.n_cpu = 0;
+    s_vpull.fb_layout = s_vpull.fb_sparse = s_vpull.fb_full = s_vpull.fb_vs = s_vpull.fb_prim = 0;
+    s_vpull.n_skip = 0;
+    s_vpull.t0 = now;
+}
