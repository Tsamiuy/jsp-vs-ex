+/* ---- VPULL (see s_vpull): vertex pulling for indexed lists, strips, fans ---- */
+
+/* Can this call's attributes be pulled? Needs vf_prepare(st) first. Fills the
+ * layout and the attribute table into s_vpull. One stream: every array
+ * attribute plain (no frequency divider), the same stride and memory, all
+ * within 4 KB of the lowest; VF_FAST=2 (the decode this one reproduces). */
+static int vpull_layout(void)
+{
+    if (s_vf.on != 2 || s_vf.n <= 0) return 0;
+    const VFAttr* f0 = &s_vfa[0];
+    u32 base = f0->off;
+    for (int c = 0; c < s_vf.n; c++) {
+        const VFAttr* f = &s_vfa[c];
+        if (!f->plain || f->stride != f0->stride || f->loc != f0->loc) return 0;
+        if (f->off < base) base = f->off;
+    }
+    const u32 S = f0->stride;
+    if (!S) return 0;
+    rsx_vpull_tab* t = &s_vpull.tab_cur;
+    memset(t, 0, sizeof *t);
+    for (int i = 0; i < 16; i++) memcpy(t->konst[i], s_vf.tmpl[i].v, sizeof t->konst[i]);
+    u32 end = 0;
+    for (int c = 0; c < s_vf.n; c++) {
+        const VFAttr* f = &s_vfa[c];
+        const u32 rel = f->off - base;
+        if (rel > 4096u) return 0;                       /* far apart: not one stream */
+        const u32 type = (f->type >= 1u && f->type <= 7u) ? f->type : 2u;   /* vf_decode: unknown = float32 */
+        const u32 e = rel + rsx_vpull_type_size(type, f->n);
+        if (e > end) end = e;
+        const int idx = s_vf.idx[c];
+        t->attr[idx][0] = rel;
+        t->attr[idx][1] = S;
+        t->attr[idx][2] = type;
+        t->attr[idx][3] = f->n;
+        /* vf_decode: an array attribute's missing components are (0,0,0,1). */
+        t->konst[idx][0] = 0.0f; t->konst[idx][1] = 0.0f; t->konst[idx][2] = 0.0f; t->konst[idx][3] = 1.0f;
+    }
+    s_vpull.S = S; s_vpull.lbase = base; s_vpull.extent = end; s_vpull.loc = f0->loc;
+    s_vpull.pad = (end > S) ? (end - 1u) / S : 0u;      /* whole vertices the tail reaches into */
+    return 1;
+}
