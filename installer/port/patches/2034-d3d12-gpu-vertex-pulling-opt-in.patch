+/* Copy `len` guest bytes at array offset `off` to dst, one 1 MB page at a
+ * time, resolved as vf_decode resolves them (loc: 1 = LOCAL, 0 = MAIN). */
+static void vpull_copy(u8* dst, u32 off, u32 len, u32 loc)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int, u32);
+    while (len) {
+        const u32 pg = off >> 20;
+        u32 n = 0x100000u - (off & 0xFFFFFu);
+        if (n > len) n = len;
+        memcpy(dst, vm_base + cellGcmResolveLocated((int)loc, pg << 20) + (off & 0xFFFFFu), n);
+        dst += n; off += n; len -= n;
+    }
+}
+
+/* One FIFO index batch of an indexed TRIANGLES (prim 5) / TRIANGLE_STRIP /
+ * TRIANGLE_FAN draw, pulled. The batch's list indices are the ones
+ * upload_tris_vp_ix / upload_strip_vp_ix would write (same strip prefix,
+ * parity, restart and fan hub), as guest indices; the guest bytes of the
+ * vertices they span go to the record's region in the ring, and each index
+ * becomes seg_k + (vertex - seg_lo). A batch whose vertices lie in, or start
+ * at most 64 vertices above, the record's current segment uses that copy and
+ * appends only what lies above it (VPULL_ONCE=0: a new segment every batch).
+ * Returns the indices written (s_vpull.last_cont: it continued the open
+ * record), or VPULL_NO with nothing changed: the CPU path takes the call. */
+static u32 upload_vpull(const rsx_state* st, u32 first, u32 count, u32 prim)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    s_vpull.last_cont = 0;
+    if (!st || !vm_base || !s_vpull.ring_mapped || !s_d3d.vp_ib_mapped || !count) return VPULL_NO;
+    if (!st->vertex_attribs[0].enabled) return VPULL_NO;
+    vf_prepare(st);
+    if (!vpull_layout()) { s_vpull.fb_layout++; return VPULL_NO; }
+    const int strip = prim != RSX_PRIMITIVE_TRIANGLES;
+    const int fan = prim == RSX_PRIMITIVE_TRIANGLE_FAN;
+    const int cont = vpull_can_continue(first);
+    u32 pre[2] = {0, 0}; int scont = 0; u32 npre = 0;
+    if (strip) npre = strip_cont_prefix(&s_sc_indexed, st, first, fan, pre, &scont);
+    const u32 total = count + npre;
+    const u32 max_out = strip ? (total > 2 ? (total - 2) * 3 : 0) : count;
+    if (s_d3d.vp_ib_offset + max_out > VP_MAX_INDICES) { s_vpull.fb_full++; return VPULL_NO; }
+    if (total > s_vpull.raw_cap) {
+        u32* n = (u32*)realloc(s_vpull.raw, (size_t)total * sizeof(u32));
+        if (!n) return VPULL_NO;
+        s_vpull.raw = n; s_vpull.raw_cap = total;
+    }
+    if (strip && max_out > s_vpull.tri_cap) {
+        u32* n = (u32*)realloc(s_vpull.tri, (size_t)max_out * sizeof(u32));
+        if (!n) return VPULL_NO;
+        s_vpull.tri = n; s_vpull.tri_cap = max_out;
+    }
+    /* Pass 1: the guest indices and the range they span. */
+    const int local = ((st->index_array_dma & 0xF) == 0);
+    const u8* ip = vm_base + cellGcmResolveLocated(local, st->index_array_offset);
+    const int sixteen = (((st->index_array_dma >> 4) & 0xF) == 1);
+    const int restart_en = strip && strip_restart_on(st);
+    u32* raw = s_vpull.raw;
+    u32 vmin = 0xFFFFFFFFu, vmax = 0;
+    for (u32 k = 0; k < total; k++) {
+        const u32 kk = k < npre ? pre[k] : first + (k - npre);
+        const u32 ix = sixteen ? (((u32)ip[kk * 2] << 8) | ip[kk * 2 + 1])
+                               : (((u32)ip[kk * 4] << 24) | ((u32)ip[kk * 4 + 1] << 16) |
+                                  ((u32)ip[kk * 4 + 2] << 8) | ip[kk * 4 + 3]);
+        if (restart_en && ix == st->restart_index) { raw[k] = VPULL_NO; continue; }
+        if (ix == VPULL_NO) { s_vpull.fb_sparse++; return VPULL_NO; }   /* not a vertex anyone pulls */
+        raw[k] = ix;
+        if (ix < vmin) vmin = ix;
+        if (ix > vmax) vmax = ix;
+    }
+    /* Pass 2: the list, in guest indices (upload_strip_vp_ix's loop). */
+    const u32* tri = raw;
+    u32 out = count, pos = 0, t = 0, seg0_abs = first;
+    if (strip) {
+        u32* tl = s_vpull.tri;
+        u32 seg0 = 0;
+        out = 0; t = scont ? s_sc_indexed.tris : 0; seg0_abs = scont ? s_sc_indexed.hub : first;
+        for (u32 k = 0; k < total; k++) {
+            if (raw[k] == VPULL_NO) { pos = 0; t = 0; continue; }
+            if (pos == 0) {
+                seg0 = k;
+                if (k >= npre) seg0_abs = first + (k - npre);
+            }
+            if (pos >= 2) {
+                u32 i0 = fan ? seg0 : k - 2, i1 = k - 1, i2 = k;
+                if (!fan && (t & 1)) { const u32 tmp = i1; i1 = i2; i2 = tmp; }
+                tl[out + 0] = raw[i0];
+                tl[out + 1] = raw[i1];
+                tl[out + 2] = raw[i2];
+                out += 3;
+                t++;
+            }
+            pos++;
+        }
+        tri = tl;
+    }
+    if (!out) {   /* a word with no whole triangle: keep the strip's state, copy nothing */
+        strip_cont_save(&s_sc_indexed, st, first + count, pos, t, seg0_abs, fan);
+        s_vpull.last_cont = cont;
+        return 0;
+    }
+    /* Pass 3: where the vertices go. */
+    const u32 span = vmax - vmin + 1u, S = s_vpull.S;
+    /* A new record whose first batch spans far more vertices than it uses
+     * would copy mostly unused bytes: leave it to the CPU path. Later batches
+     * of the record reuse the copy (VPULL_ONCE), so a mesh drawn in many words
+     * may pay off anyway: VPULL_SPARSE=<factor> (default 8, 0 = never). */
+    static int sparse = -1;
+    if (sparse < 0) { const char* ev = getenv("VPULL_SPARSE"); sparse = ev ? atoi(ev) : 8; if (sparse < 0) sparse = 0; }
+    if (!cont && sparse && span > 4096u && (u64)span > (u64)sparse * count) { s_vpull.fb_sparse++; return VPULL_NO; }
+    int vs = -1;
+    if (!cont) {
+        vs = vp_get_vs_pull(st);
+        if (vs < 0) { s_vpull.fb_vs++; return VPULL_NO; }
+    }
+    static int once = -1;
+    if (once < 0) { const char* ev = getenv("VPULL_ONCE"); once = (ev && *ev == '0') ? 0 : 1; }
+    const u32 rec_base = cont ? s_vpull.rec_base : ((s_vpull.off + 15u) & ~15u);
+    const u32 rec_k = cont ? s_vpull.rec_k : 0u;
+    u64 at = 0, len = 0;
+    u32 copy_lo = vmin, seg_k, seg_lo, seg_hi;
+    if (once && cont && s_vpull.seg_valid && vmin >= s_vpull.seg_lo && vmin <= s_vpull.seg_hi + 64u) {
+        seg_k = s_vpull.seg_k; seg_lo = s_vpull.seg_lo; seg_hi = s_vpull.seg_hi;
+        if (vmax >= seg_hi) {   /* append seg_hi..vmax after the segment */
+            copy_lo = seg_hi;
+            at = (u64)rec_base + (u64)(seg_k + (seg_hi - seg_lo)) * S;
+            len = (u64)(vmax - seg_hi) * S + s_vpull.extent;
+            seg_hi = vmax + 1u;
+        }
+    } else {                    /* a new segment at the end of the record */
+        seg_k = rec_k; seg_lo = vmin; seg_hi = vmax + 1u;
+        at = (u64)rec_base + (u64)rec_k * S;
+        len = (u64)(span - 1u) * S + s_vpull.extent;
+    }
+    if (at + len > s_vpull.ring_bytes) { s_vpull.fb_full++; return VPULL_NO; }
+    /* Committed from here on. */
+    u8* ring = s_vpull.ring_mapped + (u64)s_d3d.vp_parity * ((u64)s_vpull.ring_bytes + VPULL_RING_SLACK);
+    if (len) vpull_copy(ring + at, s_vpull.lbase + copy_lo * S, (u32)len, s_vpull.loc);
+    u32* ib = (u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_MAX_INDICES + s_d3d.vp_ib_offset;
+    const u32 k0 = seg_k - seg_lo;   /* index = seg_k + (v - seg_lo), mod 2^32 */
+    for (u32 i = 0; i < out; i++) ib[i] = k0 + tri[i];
+    if (strip) strip_cont_save(&s_sc_indexed, st, first + count, pos, t, seg0_abs, fan);
+    s_vpull.rec_base = rec_base;
+    s_vpull.seg_k = seg_k; s_vpull.seg_lo = seg_lo; s_vpull.seg_hi = seg_hi; s_vpull.seg_valid = 1;
+    s_vpull.rec_k = seg_k + (seg_hi - seg_lo) + s_vpull.pad;
+    { const u64 o = (u64)rec_base + (u64)s_vpull.rec_k * S;
+      s_vpull.off = o > s_vpull.ring_bytes ? s_vpull.ring_bytes : (u32)o; }
+    if (!cont) {
+        s_vpull.vs_idx = vs;
+        s_vpull.rec_S = S; s_vpull.rec_lbase = s_vpull.lbase; s_vpull.rec_loc = s_vpull.loc;
+        memcpy(&s_vpull.rec_tab, &s_vpull.tab_cur, sizeof s_vpull.rec_tab);
+    }
+    s_d3d.vp_ib_offset += out;
+    s_vpull.last_cont = cont;
+    s_vpull.n_batch++; s_vpull.n_rec += cont ? 0u : 1u; s_vpull.n_idx += out; s_vpull.vbytes += len;
+    return out;
+}
