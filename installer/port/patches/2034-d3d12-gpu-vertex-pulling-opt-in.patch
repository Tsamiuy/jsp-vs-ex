+#define VPULL_MARGIN     (8u << 20)     /* flush the batch below this much ring room */
+#define VPULL_RP_BYTES   (3 + VP_TEX_UNITS)   /* root parameter of t8 (the record's bytes) */
+#define VPULL_RP_LUT     (4 + VP_TEX_UNITS)   /* t9 (decode tables) */
+#define VPULL_RP_TAB     (5 + VP_TEX_UNITS)   /* b2 (the record's attribute table) */
