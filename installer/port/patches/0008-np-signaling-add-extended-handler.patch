sceNpSignaling: export AddExtendedHandler and store the handler per context

sceNpSignalingAddExtendedHandler (NID 0x50B86D94) was not exported, so the call fell through to the unresolved-NID
path (CELL_OK, nothing stored). A title that creates its context with a null handler and registers this one instead
could never receive a signaling event.


diff --git a/libs/network/sceNpSignaling.c b/libs/network/sceNpSignaling.c
index 17df8fbd..74331d35 100644
--- a/libs/network/sceNpSignaling.c
+++ b/libs/network/sceNpSignaling.c
@@ -18,6 +18,8 @@ typedef struct {
     int in_use;
     SceNpSignalingHandler handler;
     void* handlerArg;
+    SceNpSignalingHandler extHandler;   /* sceNpSignalingAddExtendedHandler (guest descriptor) */
+    void* extHandlerArg;
 } SignalingCtx;
 
 static SignalingCtx s_ctx[SCE_NP_SIGNALING_CTX_MAX];
@@ -79,6 +81,20 @@ s32 sceNpSignalingDestroyCtx(SceNpSignalingCtxId ctxId)
     return CELL_OK;
 }
 
+/* The extended handler receives the extended events (peer activated, ...) besides the ones the CreateCtx handler
+ * gets. A title may create the context with a null handler and register this one instead. Stored
+ * here; the connection operations below are still offline stubs and raise no events yet. */
+s32 sceNpSignalingAddExtendedHandler(SceNpSignalingCtxId ctxId, SceNpSignalingHandler handler, void* arg)
+{
+    printf("[sceNpSignaling] AddExtendedHandler(ctx=%u, handler=0x%08X)\n", ctxId, (u32)(uintptr_t)handler);
+    if (!signaling_ready()) return (s32)SCE_NP_SIGNALING_ERROR_NOT_INITIALIZED;
+    if (ctxId >= SCE_NP_SIGNALING_CTX_MAX || !s_ctx[ctxId].in_use)
+        return (s32)SCE_NP_SIGNALING_ERROR_CTX_NOT_FOUND;
+    s_ctx[ctxId].extHandler = handler;
+    s_ctx[ctxId].extHandlerArg = arg;
+    return CELL_OK;
+}
+
 /* Connection operations — offline stubs */
 
 s32 sceNpSignalingActivateConnection(SceNpSignalingCtxId ctxId,
diff --git a/libs/network/sceNpSignaling.h b/libs/network/sceNpSignaling.h
index 62c41f0f..58ba92e5 100644
--- a/libs/network/sceNpSignaling.h
+++ b/libs/network/sceNpSignaling.h
@@ -64,6 +64,8 @@ s32 sceNpSignalingTerm(void);
 s32 sceNpSignalingCreateCtx(const void* npId, SceNpSignalingHandler handler,
                               void* arg, SceNpSignalingCtxId* ctxId);
 s32 sceNpSignalingDestroyCtx(SceNpSignalingCtxId ctxId);
+s32 sceNpSignalingAddExtendedHandler(SceNpSignalingCtxId ctxId, SceNpSignalingHandler handler,
+                                      void* arg);
 
 s32 sceNpSignalingActivateConnection(SceNpSignalingCtxId ctxId,
                                        const void* peerNpId,
