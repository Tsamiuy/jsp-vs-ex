+      if (g_cellpad_canon_hook && port_no < PAD_MAX_HOST_PORTS) {
+          const u32 st7915 = s_port_setting[port_no];
+          const int sl = (st7915 & CELL_PAD_SETTING_SENSOR_ON) ? CELL_PAD_LEN_CHANGE_SENSOR_ON :
