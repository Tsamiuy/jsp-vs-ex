+/* 7915 (rollback stepper): the canonical pad record. The hook sees the record the host layer built for the port (after the
+ * 6501 filters) and may replace it whole (len, button[]): the netplay input is then the same bytes on every peer and a replayed tick reads the
+ * recorded input, not the device. Returns 1 when it wrote the record. NULL by default. */
+int (*g_cellpad_canon_hook)(u32 port_no, u16* button, s32* len, int setting_len, int host_connected) = 0;
+/* 7915: lets the stepper present the session's slots as connected (port_status / now_connect) whatever the host devices are. NULL by default. */
+void (*g_cellpad_info_hook)(CellPadInfo2* info) = 0;
+
 /* Immutable after startup. Standalone input builds have no network dependency. */
