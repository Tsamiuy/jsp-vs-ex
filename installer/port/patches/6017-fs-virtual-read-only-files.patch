diff --git a/runtime/ppu/tests/test_fs_vfile.cpp b/runtime/ppu/tests/test_fs_vfile.cpp
new file mode 100644
index 0000000..0de6929
--- /dev/null
+++ b/runtime/ppu/tests/test_fs_vfile.cpp
@@ -0,0 +1,306 @@
+/*
+ * ps3recomp - virtual read-only files (ps3emu/fs_vfile.h, ppu_fs.cpp).
+ *
+ * A trivial provider serves "ABC" followed by the host file's bytes for one
+ * path. The test drives the guest calls on real files and checks:
+ *   - with g_ps3_fs_vfile_ops NULL, the same file reads and stats as the host
+ *     file (nothing changes);
+ *   - with the provider set: open, lseek SEEK_END (= virtual size), read,
+ *     fstat (= virtual size), a read that crosses the virtual end (short count,
+ *     the provider is never asked past its size), a read at the end (0), close
+ *     (the view is released), and a re-open that serves the same bytes;
+ *   - a seek before the start is EINVAL and leaves the position, a seek past
+ *     the end is allowed;
+ *   - cellFsAioRead on a virtual fd reads the virtual bytes and does not move
+ *     the fd's position;
+ *   - read-write and truncating opens and other paths are not offered, and
+ *     cellFsSdataOpen never serves a virtual file;
+ *   - an fd keeps the ops it was opened with after the pointer is cleared.
+ *
+ *   tools/test_ppu_fs_vfile.py [--exe-out PATH]
+ *   test_fs_vfile [DIR]      (DIR: scratch directory; default /tmp, or the temp dir on Windows)
+ */
+#include "../../platform/ps3_dev_flash.c"
+#include "ppu_fs.cpp"
+#ifdef _WIN32
+#  include <windows.h>
+#endif
+
+/* ---- link stubs: nothing on the paths this test drives calls them ---- */
+extern "C" {
+uint8_t* vm_base = nullptr;
+uint32_t ppu_vm_size = 0;
+void vm_write32(uint64_t a, uint32_t v) { uint32_t be = __builtin_bswap32(v); memcpy(vm_base + a, &be, 4); }
+void vm_write64(uint64_t a, uint64_t v) { uint64_t be = __builtin_bswap64(v); memcpy(vm_base + a, &be, 8); }
+void ppu_guest_caller(char* out, size_t n) { if (n) out[0] = 0; }
+void ps3_vfs_ps3game_fallback(char* path, size_t cap) { (void)path; (void)cap; }
+void ydkj_host_bt(const char* tag) { (void)tag; }
+void ps3_hle_register_ctx(uint32_t, const char*, void (*)(ppu_context*)) {}
+}
+ps3_guest_caller_fn g_ps3_guest_caller = nullptr;
+const char* edat_resolve(const char* host_path, char* buf, size_t cap) { (void)buf; (void)cap; return host_path; }
+
+static uint32_t rd32(uint32_t a) { uint32_t v; memcpy(&v, vm_base + a, 4); return __builtin_bswap32(v); }
+static uint64_t rd64(uint32_t a) { uint64_t v; memcpy(&v, vm_base + a, 8); return __builtin_bswap64(v); }
+
+static int fails = 0;
+#define CHECK(c, ...) do { const bool ok_ = (c); printf(ok_ ? "[PASS] " : "[FAIL] "); printf(__VA_ARGS__); \
+                           printf("\n"); if (!ok_) fails++; } while (0)
+
+enum : uint32_t { PATH = 0x100, FDP = 0x500, NP = 0x508, POSP = 0x510, STATB = 0x600, AIO = 0x700, AIOID = 0x780,
+                  BUF = 0x1000 };
+
+/* ---- the trivial provider: "ABC" + the host file, for paths ending in vfile_test.bin ---- */
+static const char PREFIX[] = "ABC";
+static const uint64_t PRE = 3;
+struct ps3_fs_vfile { uint64_t host_size; };
+static int g_opens = 0, g_closes = 0, g_live = 0;
+static uint64_t g_max_end = 0;   /* the furthest byte any read asked for (pos + n) */
+
+static ps3_fs_vfile* t_open(const char* guest, const char* host)
+{
+    const size_t n = strlen(guest), k = strlen("vfile_test.bin");
+    if (n < k || strcmp(guest + n - k, "vfile_test.bin") != 0) return nullptr;
+    fs_stat64_t st;
+    if (FS_STAT64(host, &st) != 0) return nullptr;
+    ps3_fs_vfile* v = new ps3_fs_vfile{ (uint64_t)st.st_size };
+    g_opens++; g_live++;
+    return v;
+}
+static uint64_t t_size(ps3_fs_vfile* v) { return PRE + v->host_size; }
+static size_t t_read(ps3_fs_vfile* v, FILE* host, uint64_t pos, void* dst, size_t n)
+{
+    if (pos + n > g_max_end) g_max_end = pos + n;
+    uint8_t* d = (uint8_t*)dst;
+    size_t done = 0;
+    while (done < n) {
+        const uint64_t p = pos + done;
+        if (p >= t_size(v)) break;
+        if (p < PRE) { d[done++] = (uint8_t)PREFIX[p]; continue; }
+        if (FS_SEEK64(host, (int64_t)(p - PRE), SEEK_SET) != 0) break;
+        const size_t got = fread(d + done, 1, n - done, host);
+        if (!got) break;
+        done += got;
+    }
+    return done;
+}
+static void t_close(ps3_fs_vfile* v) { g_closes++; g_live--; delete v; }
+static const ps3_fs_vfile_ops OPS = { t_open, t_size, t_read, t_close };
+
+/* ---- guest calls ---- */
+static ppu_context mk(uint64_t a = 0, uint64_t b = 0, uint64_t c = 0, uint64_t d = 0)
+{
+    ppu_context ctx; memset(&ctx, 0, sizeof ctx);
+    ctx.gpr[3] = a; ctx.gpr[4] = b; ctx.gpr[5] = c; ctx.gpr[6] = d;
+    return ctx;
+}
+static uint32_t rc_of(ppu_context& ctx) { return (uint32_t)ctx.gpr[3]; }
+static uint32_t open_guest(const char* guest, uint32_t flags, uint32_t* fd)
+{
+    strcpy((char*)vm_base + PATH, guest);
+    ppu_context ctx = mk(PATH, flags, FDP);
+    cellFsOpen(&ctx);
+    if (rc_of(ctx) == 0 && fd) *fd = rd32(FDP);
+    return rc_of(ctx);
+}
+static uint32_t sdata_open_guest(const char* guest, uint32_t* fd)
+{
+    strcpy((char*)vm_base + PATH, guest);
+    ppu_context ctx = mk(PATH, 0, FDP);
+    cellFsSdataOpen(&ctx);
+    if (rc_of(ctx) == 0 && fd) *fd = rd32(FDP);
+    return rc_of(ctx);
+}
+static uint32_t lseek_guest(uint32_t fd, int64_t off, uint32_t whence, uint64_t* pos)
+{
+    ppu_context ctx = mk(fd, (uint64_t)off, whence, POSP);
+    cellFsLseek(&ctx);
+    if (rc_of(ctx) == 0 && pos) *pos = rd64(POSP);
+    return rc_of(ctx);
+}
+/* -> bytes read (or ~0 on an error code); the bytes land at BUF */
+static uint64_t read_guest(uint32_t fd, uint64_t n)
+{
+    memset(vm_base + BUF, 0xEE, (size_t)n + 16);
+    ppu_context ctx = mk(fd, BUF, n, NP);
+    cellFsRead(&ctx);
+    return rc_of(ctx) == 0 ? rd64(NP) : ~0ull;
+}
+static uint64_t fstat_size(uint32_t fd)
+{
+    ppu_context ctx = mk(fd, STATB);
+    cellFsFstat(&ctx);
+    return rc_of(ctx) == 0 ? rd64(STATB + 0x24) : ~0ull;
+}
+static void close_guest(uint32_t fd) { ppu_context ctx = mk(fd); cellFsClose(&ctx); }
+static uint64_t aio_read_guest(uint32_t fd, uint64_t off, uint64_t n)
+{
+    vm_write32(AIO + 0x00, fd);
+    vm_write64(AIO + 0x08, off);
+    vm_write32(AIO + 0x10, BUF);
+    vm_write64(AIO + 0x18, n);
+    memset(vm_base + BUF, 0xEE, (size_t)n + 16);
+    ppu_context ctx = mk(AIO, AIOID, 0 /* no callback */);
+    cellFsAioRead(&ctx);
+    /* n is not returned without a callback; count the bytes the read changed instead (the file holds no 0xEE). */
+    uint64_t got = 0;
+    while (got < n && vm_base[BUF + got] != 0xEE) got++;
+    return got;
+}
+
+int main(int argc, char** argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    static uint8_t mem[0x40000];
+    vm_base = mem; ppu_vm_size = sizeof mem;
+
+    const char* dir = argc > 1 ? argv[1] : NULL;
+#ifdef _WIN32
+    char tmp[MAX_PATH];
+    if (!dir) { DWORD n = GetTempPathA(sizeof tmp, tmp); if (n && n < sizeof tmp) { tmp[n - 1] = 0; dir = tmp; } }
+#endif
+    if (!dir) dir = "/tmp";
+    ppu_vfs_root = dir;
+
+    /* The host file: 5000 bytes, an odd size, with no 0xEE byte and not starting with "NPD". */
+    enum { HSIZE = 5000 };
+    static uint8_t host_bytes[HSIZE];
+    for (int i = 0; i < HSIZE; i++) host_bytes[i] = (uint8_t)('a' + (i * 7 + i / 13) % 26);
+    char host[1100], other[1100];
+    snprintf(host, sizeof host, "%s/ps3recomp_vfile_test.bin", dir);
+    snprintf(other, sizeof other, "%s/ps3recomp_vfile_other.bin", dir);
+    const char* const files[2] = { host, other };
+    for (const char* p : files) {
+        FILE* f = fopen(p, "wb");
+        if (!f || fwrite(host_bytes, 1, HSIZE, f) != HSIZE) { printf("FAIL (could not write %s)\n", p); return 1; }
+        fclose(f);
+    }
+    static uint8_t virt[PRE + HSIZE];
+    memcpy(virt, PREFIX, PRE);
+    memcpy(virt + PRE, host_bytes, HSIZE);
+    const uint64_t VSIZE = PRE + HSIZE;
+    const char* G = "/dev_hdd1/ps3recomp_vfile_test.bin";
+    const char* GO = "/dev_hdd1/ps3recomp_vfile_other.bin";
+
+    /* ---- no provider: nothing changes ---- */
+    {
+        CHECK(g_ps3_fs_vfile_ops == nullptr, "g_ps3_fs_vfile_ops is NULL by default");
+        uint32_t fd = 0;
+        CHECK(open_guest(G, 0, &fd) == 0, "open without a provider (fd %u)", fd);
+        CHECK(fstat_size(fd) == HSIZE, "fstat without a provider = host size %d", HSIZE);
+        uint64_t pos = 0;
+        CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_END, &pos) == 0 && pos == HSIZE, "SEEK_END without a provider = %llu",
+              (unsigned long long)pos);
+        lseek_guest(fd, 0, CELL_FS_SEEK_SET, nullptr);
+        const uint64_t n = read_guest(fd, 8192);
+        CHECK(n == HSIZE && memcmp(mem + BUF, host_bytes, HSIZE) == 0, "read without a provider = the host bytes (%llu)",
+              (unsigned long long)n);
+        close_guest(fd);
+        CHECK(g_opens == 0 && g_closes == 0, "provider never called while NULL");
+    }
+
+    __atomic_store_n(&g_ps3_fs_vfile_ops, &OPS, __ATOMIC_RELEASE);
+
+    /* ---- open, SEEK_END, read, fstat, crossing read, close ---- */
+    uint32_t fd = 0;
+    CHECK(open_guest(G, 0, &fd) == 0 && g_opens == 1 && g_live == 1, "read-only open is claimed (fd %u, opens %d)", fd,
+          g_opens);
+    uint64_t pos = 99;
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_END, &pos) == 0 && pos == VSIZE, "SEEK_END = virtual size %llu (got %llu)",
+          (unsigned long long)VSIZE, (unsigned long long)pos);
+    CHECK(lseek_guest(fd, -10, CELL_FS_SEEK_END, &pos) == 0 && pos == VSIZE - 10, "SEEK_END -10 = %llu",
+          (unsigned long long)pos);
+    CHECK(read_guest(fd, 10) == 10 && memcmp(mem + BUF, virt + VSIZE - 10, 10) == 0, "the last 10 virtual bytes");
+    CHECK(fstat_size(fd) == VSIZE, "fstat = virtual size %llu", (unsigned long long)VSIZE);
+    CHECK(read_guest(fd, 16) == 0, "a read at the virtual end returns 0");
+
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_SET, &pos) == 0 && pos == 0, "SEEK_SET 0");
+    CHECK(read_guest(fd, 2) == 2 && memcmp(mem + BUF, "AB", 2) == 0, "first 2 bytes 'AB'");
+    CHECK(read_guest(fd, 4) == 4 && memcmp(mem + BUF, virt + 2, 4) == 0 && mem[BUF] == 'C',
+          "a read across the prefix/file border ('C' + 3 file bytes)");
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_CUR, &pos) == 0 && pos == 6, "SEEK_CUR 0 = 6 (got %llu)",
+          (unsigned long long)pos);
+
+    g_max_end = 0;
+    CHECK(lseek_guest(fd, (int64_t)VSIZE - 100, CELL_FS_SEEK_SET, &pos) == 0, "seek to virtual end - 100");
+    uint64_t n = read_guest(fd, 2048);
+    CHECK(n == 100 && memcmp(mem + BUF, virt + VSIZE - 100, 100) == 0 && mem[BUF + 100] == 0xEE,
+          "a 2048-byte read crossing the virtual end returns the short count 100 (got %llu), nothing past it written",
+          (unsigned long long)n);
+    CHECK(g_max_end == VSIZE, "the provider was never asked past the virtual size (furthest %llu)",
+          (unsigned long long)g_max_end);
+
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_SET, nullptr) == 0, "rewind");
+    n = read_guest(fd, 0x10000);
+    CHECK(n == VSIZE && memcmp(mem + BUF, virt, (size_t)VSIZE) == 0, "a whole read = 'ABC' + the file (%llu B)",
+          (unsigned long long)n);
+
+    /* ---- seek rules ---- */
+    CHECK(lseek_guest(fd, 7, CELL_FS_SEEK_SET, &pos) == 0 && pos == 7, "SEEK_SET 7");
+    CHECK(lseek_guest(fd, -8, CELL_FS_SEEK_CUR, nullptr) == 0x80010002u, "a seek before the start is EINVAL");
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_CUR, &pos) == 0 && pos == 7, "and the position stays 7 (got %llu)",
+          (unsigned long long)pos);
+    CHECK(lseek_guest(fd, 0, 3, nullptr) == 0x80010002u, "unknown whence is EINVAL");
+    CHECK(lseek_guest(fd, 100, CELL_FS_SEEK_END, &pos) == 0 && pos == VSIZE + 100, "a seek past the end is allowed");
+    CHECK(read_guest(fd, 16) == 0, "and a read there returns 0");
+
+    /* ---- AIO read: virtual bytes, position untouched ---- */
+    CHECK(lseek_guest(fd, 1, CELL_FS_SEEK_SET, nullptr) == 0, "SEEK_SET 1");
+    n = aio_read_guest(fd, 1, 6);
+    CHECK(n == 6 && memcmp(mem + BUF, virt + 1, 6) == 0, "AIO read at 1 = 'BC' + 4 file bytes");
+    n = aio_read_guest(fd, VSIZE - 3, 64);
+    CHECK(n == 3 && memcmp(mem + BUF, virt + VSIZE - 3, 3) == 0, "AIO read crossing the end returns 3 bytes (%llu)",
+          (unsigned long long)n);
+    CHECK(lseek_guest(fd, 0, CELL_FS_SEEK_CUR, &pos) == 0 && pos == 1, "AIO did not move the position (%llu)",
+          (unsigned long long)pos);
+    CHECK(read_guest(fd, 3) == 3 && memcmp(mem + BUF, "BC", 2) == 0, "the next read continues at 1");
+
+    close_guest(fd);
+    CHECK(g_closes == 1 && g_live == 0, "close releases the view (closes %d)", g_closes);
+    CHECK(fstat_size(fd) == ~0ull, "the closed fd is gone");
+
+    /* ---- re-open: same bytes, a fresh position ---- */
+    uint32_t fd2 = 0;
+    CHECK(open_guest(G, 0, &fd2) == 0 && g_opens == 2, "re-open is claimed again (fd %u)", fd2);
+    CHECK(fstat_size(fd2) == VSIZE, "re-open: fstat = virtual size");
+    n = read_guest(fd2, 0x10000);
+    CHECK(n == VSIZE && memcmp(mem + BUF, virt, (size_t)VSIZE) == 0, "re-open: reads from 0, the same bytes");
+    close_guest(fd2);
+    CHECK(g_closes == 2 && g_live == 0, "re-open's close releases its view");
+
+    /* ---- opens the provider is not offered or declines ---- */
+    {
+        uint32_t f3 = 0;
+        CHECK(open_guest(G, CELL_FS_O_RDWR, &f3) == 0 && g_opens == 2, "a read-write open is not offered");
+        CHECK(fstat_size(f3) == HSIZE, "and serves the host file");
+        close_guest(f3);
+        CHECK(g_closes == 2, "and its close does not call the provider");
+        CHECK(open_guest(GO, 0, &f3) == 0 && g_opens == 2 && fstat_size(f3) == HSIZE,
+              "another path is declined and serves the host file");
+        close_guest(f3);
+        uint32_t f4 = 0;
+        CHECK(sdata_open_guest(G, &f4) == 0, "cellFsSdataOpen of a claimed path opens (fd %u)", f4);
+        CHECK(g_opens == 3 && g_closes == 3 && g_live == 0, "SdataOpen asked the provider and released it at once");
+        CHECK(fstat_size(f4) == HSIZE, "and serves the host file, not the virtual one");
+        close_guest(f4);
+        CHECK(g_closes == 3, "closing the SdataOpen fd does not call the provider");
+    }
+
+    /* ---- an open fd keeps its ops after the pointer is cleared ---- */
+    {
+        uint32_t f5 = 0;
+        CHECK(open_guest(G, 0, &f5) == 0 && g_opens == 4, "open with the provider");
+        __atomic_store_n(&g_ps3_fs_vfile_ops, (const ps3_fs_vfile_ops*)nullptr, __ATOMIC_RELEASE);
+        CHECK(fstat_size(f5) == VSIZE, "after clearing the pointer the open fd still serves the virtual size");
+        close_guest(f5);
+        CHECK(g_closes == 4 && g_live == 0, "and its close still releases the view");
+        CHECK(open_guest(G, 0, &f5) == 0 && g_opens == 4 && fstat_size(f5) == HSIZE,
+              "a new open after clearing serves the host file");
+        close_guest(f5);
+    }
+
+    remove(host);
+    remove(other);
+    printf("%s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    return fails ? 1 : 0;
+}
diff --git a/tools/test_ppu_fs_vfile.py b/tools/test_ppu_fs_vfile.py
new file mode 100644
index 0000000..bf46bd6
--- /dev/null
+++ b/tools/test_ppu_fs_vfile.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Virtual read-only files for cellFs (include/ps3emu/fs_vfile.h, runtime/ppu/ppu_fs.cpp).
+
+With g_ps3_fs_vfile_ops NULL nothing changes. With a provider set, a read-only
+cellFsOpen it claims serves the provider's bytes: Lseek SEEK_END and Fstat use
+the virtual size, Read returns the short count at the virtual end, AioRead reads
+the virtual bytes without moving the fd's position, Close releases the view, a
+re-open serves the same bytes; read-write opens and cellFsSdataOpen are never
+virtual. This builds runtime/ppu/tests/test_fs_vfile.cpp (which includes
+ppu_fs.cpp) against a ppu_recomp.h made from the lifter's own HEADER_PREAMBLE
+and runs it.
+
+It needs a host C++ compiler (under CI=1 a missing one fails instead of
+skipping).
+
+Usage:
+    python3 tools/test_ppu_fs_vfile.py [--exe-out PATH] [--build-only]
+"""
+
+import argparse
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+FIXTURE = os.path.join(ROOT, "runtime", "ppu", "tests", "test_fs_vfile.cpp")
+INCLUDE_DIRS = ["include", "runtime/ppu", "runtime/memory", "runtime", "libs", "."]
+
+
+def _cxx():
+    return (shutil.which(os.environ.get("CXX", "c++")) or shutil.which("g++")
+            or shutil.which("clang++"))
+
+
+def _stub_header():
+    spec = importlib.util.spec_from_file_location(
+        "ppu_lifter", os.path.join(TOOLS, "ppu_lifter.py"))
+    lifter = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(lifter)
+    return lifter.HEADER_PREAMBLE
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--exe-out", help="keep the built test program at this path")
+    ap.add_argument("--build-only", action="store_true",
+                    help="build (for another machine, e.g. a Windows target) and stop")
+    args = ap.parse_args()
+
+    cxx = _cxx()
+    if cxx is None:
+        if os.environ.get("CI"):
+            print("FAIL: no C++ compiler found")
+            return 1
+        print("skip test_ppu_fs_vfile: no C++ compiler")
+        return 0
+    with tempfile.TemporaryDirectory() as td:
+        with open(os.path.join(td, "ppu_recomp.h"), "w") as fh:
+            fh.write(_stub_header())
+        exe = args.exe_out or os.path.join(td, "test_fs_vfile")
+        cmd = [cxx, "-std=gnu++17", "-w", "-I" + td]
+        cmd += ["-I" + os.path.join(ROOT, d) for d in INCLUDE_DIRS]
+        cmd += ["-o", exe, FIXTURE]
+        if "mingw" in os.path.basename(cxx):
+            cmd += ["-static"]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            print("FAIL: fixture did not build")
+            print((r.stdout + r.stderr)[-4000:])
+            return 1
+        if args.build_only:
+            print(f"built {exe}")
+            return 0
+        r = subprocess.run([exe, td], capture_output=True, text=True)
+        sys.stdout.write(r.stdout)
+        sys.stderr.write(r.stderr)
+        return r.returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
