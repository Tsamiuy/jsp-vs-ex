+/* Patch 6017: virtual read-only files (ps3emu/fs_vfile.h). A port provider may claim a read-only open; that fd keeps
+ * its real host FILE* (so every other handler and the fd table work as before), and Read, Lseek, Fstat and AioRead go
+ * through the provider with the guest's position kept here (g_fd_vpos, under the fd's stream lock). NULL by default. */
+extern "C" { const ps3_fs_vfile_ops* volatile g_ps3_fs_vfile_ops = nullptr; }
+/* Per fd: the view and the ops it was opened with. Set at open before the fd reaches the guest (ops first, then the
+ * view with release), cleared at close under g_fd_lock; a handler reads the slot once, like fd_file(). */
+static ps3_fs_vfile*           g_fd_vf[FS_MAX];
