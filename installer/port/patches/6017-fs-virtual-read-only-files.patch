+struct FsVfile { ps3_fs_vfile* vf; const ps3_fs_vfile_ops* ops; };
+static FsVfile fd_vfile(int fd)
+{
+    FsVfile v = { nullptr, nullptr };
+    if (fd < 0 || fd >= FS_MAX) return v;
+    v.vf = __atomic_load_n(&g_fd_vf[fd], __ATOMIC_ACQUIRE);
+    if (v.vf) v.ops = __atomic_load_n(&g_fd_vops[fd], __ATOMIC_ACQUIRE);
+    if (!v.ops) v.vf = nullptr;
+    return v;
+}
+static const ps3_fs_vfile_ops* fs_vfile_provider(void)
+{
+    return __atomic_load_n(&g_ps3_fs_vfile_ops, __ATOMIC_ACQUIRE);
