new file mode 100644
index 0000000..3172cdc
--- /dev/null
+++ b/include/ps3emu/fs_vfile.h
@@ -0,0 +1,59 @@
+/*
+ * ps3recomp - virtual read-only files for cellFs (runtime/ppu/ppu_fs.cpp).
+ *
+ * A title port may serve a file the guest opens read-only through a view of its
+ * own: the guest still gets a real fd on the real host file, but cellFsRead,
+ * cellFsLseek, cellFsFstat and cellFsAioRead on that fd see the provider's bytes
+ * and size instead of the host file's. cellFsClose releases the view. Use: a port
+ * that overrides entries inside a game archive without writing to it (the
+ * provider answers with the original bytes plus its own changes).
+ *
+ * g_ps3_fs_vfile_ops is NULL by default, and then nothing changes: one atomic
+ * load per cellFsOpen, one table read per Read/Lseek/Fstat/Close/AioRead. Set it
+ * before the guest starts (or at any time: an fd keeps the ops it was opened
+ * with until it is closed).
+ *
+ * Contract:
+ *  - open(guest_path, host_path): called for read-only opens (no O_TRUNC) after
+ *    the host file is open. Return NULL to leave the file alone. It must not
+ *    touch the guest's fd, and must not keep `host` FILE*s of its own past
+ *    close(). It may be called for a path that is then closed at once without
+ *    a read (cellFsSdataOpen asks it only to log that the path is not served).
+ *  - size(vf): the virtual size in bytes; constant for the life of the view.
+ *  - read(vf, host, pos, dst, n): copy n bytes of the virtual file at pos into
+ *    dst and return how many were copied. ppu_fs.cpp never asks past size(vf)
+ *    (it clamps n first), so a short return means an error. `host` is the real
+ *    file of this fd; the caller holds its stdio lock, and the provider may seek
+ *    it (cellFs keeps the guest's position itself for a virtual fd).
+ *  - close(vf): the guest closed the fd. Called once per successful open.
+ * All four may be called from any guest thread; calls for one fd are serialised
+ * by its stream lock, calls for different fds are not.
+ */
+#ifndef PS3EMU_FS_VFILE_H
+#define PS3EMU_FS_VFILE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ps3_fs_vfile ps3_fs_vfile;   /* opaque, owned by the provider */
+
+typedef struct ps3_fs_vfile_ops {
+    ps3_fs_vfile* (*open)(const char* guest_path, const char* host_path);
+    uint64_t      (*size)(ps3_fs_vfile* vf);
+    size_t        (*read)(ps3_fs_vfile* vf, FILE* host, uint64_t pos, void* dst, size_t n);
+    void          (*close)(ps3_fs_vfile* vf);
+} ps3_fs_vfile_ops;
+
+/* Defined in runtime/ppu/ppu_fs.cpp. NULL = no provider. */
+extern const ps3_fs_vfile_ops* volatile g_ps3_fs_vfile_ops;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3EMU_FS_VFILE_H */
