     uint32_t fd_ptr = (uint32_t)ctx->gpr[5];
     host_path(hpath, sizeof hpath, gpath);
+    /* Patch 6504: a read-only open may be pointed at another host file by the port's resolver (ps3emu/fs_path_ops.h). */
+    if ((flags & 0x3) == CELL_FS_O_RDONLY && !(flags & (CELL_FS_O_TRUNC | CELL_FS_O_CREAT)))
+        if (const ps3_fs_path_ops* pops = fs_path_provider()) pops->resolve(gpath, hpath, sizeof hpath, nullptr);
 
