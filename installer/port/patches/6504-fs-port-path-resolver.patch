+/* Patch 6504: the port path resolver (ps3emu/fs_path_ops.h). NULL by default. */
+extern "C" { const ps3_fs_path_ops* volatile g_ps3_fs_path_ops = nullptr; }
+static const ps3_fs_path_ops* fs_path_provider(void)
+{
+    return __atomic_load_n(&g_ps3_fs_path_ops, __ATOMIC_ACQUIRE);
+}
+
 /* Translate a guest path to a host path under ppu_vfs_root. Known PS3 mount
  * prefixes are stripped; the rest is appended to the root. */
 static void host_path(char* out, size_t cap, const char* guest)
@@ -340,6 +348,9 @@
