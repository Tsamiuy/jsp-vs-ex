 static unsigned long long s_pad_empty_until[PAD_MAX_HOST_PORTS];
 
+/* DualSense (PS5) over USB or Bluetooth, read as a raw HID device: Windows
+ * has no XInput driver for it. A reader thread keeps the newest input report;
+ * pad_dualsense_state() turns it into an XINPUT_STATE so port 0 goes through
+ * the same mapping (and PAD_BTN_* rebinds, with Cross = A position, Circle = B,
+ * Square = X, Triangle = Y, Create = BACK, Options = START). Used only when
+ * XInput has no controller on port 0. PAD_NO_DUALSENSE=1 turns it off. (Patch 6503, from the v0.15 port.) */
+static SRWLOCK s_ds_lock = SRWLOCK_INIT;
+static unsigned char s_ds_report[80];
+static volatile LONG s_ds_ok = 0;          /* 1 while a DualSense is open and reporting */
+static volatile LONG s_ds_len = 0;         /* length of the newest report */
+
+static HANDLE ds_open(int* bt)
+{
+    GUID g; HidD_GetHidGuid(&g);
+    HDEVINFO set = SetupDiGetClassDevsA(&g, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+    if (set == INVALID_HANDLE_VALUE) return INVALID_HANDLE_VALUE;
+    HANDLE found = INVALID_HANDLE_VALUE;
+    SP_DEVICE_INTERFACE_DATA ifd; ifd.cbSize = sizeof ifd;
+    for (DWORD k = 0; found == INVALID_HANDLE_VALUE && SetupDiEnumDeviceInterfaces(set, NULL, &g, k, &ifd); k++) {
+        DWORD need = 0;
+        SetupDiGetDeviceInterfaceDetailA(set, &ifd, NULL, 0, &need, NULL);
+        SP_DEVICE_INTERFACE_DETAIL_DATA_A* d = (SP_DEVICE_INTERFACE_DETAIL_DATA_A*)malloc(need);
+        if (!d) continue;
+        d->cbSize = sizeof *d;
+        if (SetupDiGetDeviceInterfaceDetailA(set, &ifd, d, need, NULL, NULL)) {
+            HANDLE h = CreateFileA(d->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                                   FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+            if (h != INVALID_HANDLE_VALUE) {
+                HIDD_ATTRIBUTES a; a.Size = sizeof a;
+                PHIDP_PREPARSED_DATA pp; HIDP_CAPS caps;
+                if (HidD_GetAttributes(h, &a) && a.VendorID == 0x054C &&
+                    (a.ProductID == 0x0CE6 || a.ProductID == 0x0DF2) &&       /* DualSense, DualSense Edge */
+                    HidD_GetPreparsedData(h, &pp)) {
+                    HidP_GetCaps(pp, &caps); HidD_FreePreparsedData(pp);
+                    *bt = caps.InputReportByteLength > 64;                       /* USB 64, Bluetooth 78 */
+                    found = h;
+                } else CloseHandle(h);
+            }
+        }
+        free(d);
+    }
+    SetupDiDestroyDeviceInfoList(set);
+    return found;
+}
+
+static DWORD WINAPI ds_reader(LPVOID unused)
+{
+    (void)unused;
+    for (;;) {
+        int bt = 0;
+        HANDLE h = ds_open(&bt);
+        if (h == INVALID_HANDLE_VALUE) { Sleep(2000); continue; }
+        /* Bluetooth starts in a short DS4-style report; reading feature report
+         * 0x05 (calibration) switches it to the full 0x31 report. */
+        if (bt) { unsigned char f[64] = {0x05}; HidD_GetFeature(h, f, 41); }
+        printf("[cellPad] DualSense connected (%s)\n", bt ? "Bluetooth" : "USB"); fflush(stdout);
+        unsigned char buf[96];
+        for (;;) {
+            DWORD n = 0;
+            if (!ReadFile(h, buf, sizeof buf, &n, NULL) || n < 10) break;
+            AcquireSRWLockExclusive(&s_ds_lock);
+            memcpy(s_ds_report, buf, n < sizeof s_ds_report ? n : sizeof s_ds_report);
+            s_ds_len = (LONG)n;
+            ReleaseSRWLockExclusive(&s_ds_lock);
+            InterlockedExchange(&s_ds_ok, 1);
+        }
+        InterlockedExchange(&s_ds_ok, 0);
+        CloseHandle(h);
+        printf("[cellPad] DualSense disconnected\n"); fflush(stdout);
+        Sleep(1000);
+    }
+}
+
+static int pad_dualsense_state(XINPUT_STATE* st)
+{
+    static int started = 0;
+    if (!started) {
+        started = 1;
+        if (getenv("PAD_NO_DUALSENSE")) return 0;
+        CreateThread(NULL, 64 * 1024, ds_reader, NULL, 0, NULL);
+    }
+    if (!s_ds_ok) return 0;
+    unsigned char r[80];
+    AcquireSRWLockShared(&s_ds_lock);
+    memcpy(r, s_ds_report, sizeof r);
+    ReleaseSRWLockShared(&s_ds_lock);
+    /* d = sticks/triggers/buttons as laid out in the full report:
+     * 0 LX 1 LY 2 RX 3 RY 4 L2 5 R2 6 counter 7 hat|Sq/X/O/Tri 8 L1 R1 L2 R2 Create Options L3 R3 9 PS. */
+    unsigned char d[10];
+    if (r[0] == 0x31) memcpy(d, r + 2, 10);               /* Bluetooth, full report */
+    else if (r[0] == 0x01 && s_ds_len >= 64) memcpy(d, r + 1, 10);   /* USB */
+    else if (r[0] == 0x01) {   /* Bluetooth short report (switch not taken): DS4 order */
+        d[0] = r[1]; d[1] = r[2]; d[2] = r[3]; d[3] = r[4];
+        d[7] = r[5]; d[8] = r[6]; d[9] = r[7]; d[4] = r[8]; d[5] = r[9]; d[6] = 0;
+    } else return 0;
+    memset(st, 0, sizeof *st);
+    XINPUT_GAMEPAD* gp = &st->Gamepad;
+    static const WORD hat[8] = {
+        XINPUT_GAMEPAD_DPAD_UP, XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_RIGHT,
+        XINPUT_GAMEPAD_DPAD_RIGHT, XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_RIGHT,
+        XINPUT_GAMEPAD_DPAD_DOWN, XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_LEFT,
+        XINPUT_GAMEPAD_DPAD_LEFT, XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_LEFT };
+    if ((d[7] & 15) < 8) gp->wButtons |= hat[d[7] & 15];
+    if (d[7] & 0x10) gp->wButtons |= XINPUT_GAMEPAD_X;          /* Square */
+    if (d[7] & 0x20) gp->wButtons |= XINPUT_GAMEPAD_A;          /* Cross */
+    if (d[7] & 0x40) gp->wButtons |= XINPUT_GAMEPAD_B;          /* Circle */
+    if (d[7] & 0x80) gp->wButtons |= XINPUT_GAMEPAD_Y;          /* Triangle */
+    if (d[8] & 0x01) gp->wButtons |= XINPUT_GAMEPAD_LEFT_SHOULDER;
+    if (d[8] & 0x02) gp->wButtons |= XINPUT_GAMEPAD_RIGHT_SHOULDER;
+    if (d[8] & 0x10) gp->wButtons |= XINPUT_GAMEPAD_BACK;       /* Create */
+    if (d[8] & 0x20) gp->wButtons |= XINPUT_GAMEPAD_START;      /* Options */
+    if (d[8] & 0x40) gp->wButtons |= XINPUT_GAMEPAD_LEFT_THUMB;
+    if (d[8] & 0x80) gp->wButtons |= XINPUT_GAMEPAD_RIGHT_THUMB;
+    gp->bLeftTrigger = d[4]; gp->bRightTrigger = d[5];
+    gp->sThumbLX = (SHORT)(((int)d[0] - 128) * 256);
+    gp->sThumbLY = (SHORT)((128 - (int)d[1]) * 256 - (d[1] == 0));   /* HID: 0 = up */
+    gp->sThumbRX = (SHORT)(((int)d[2] - 128) * 256);
+    gp->sThumbRY = (SHORT)((128 - (int)d[3]) * 256 - (d[3] == 0));
+    return 1;
+}
