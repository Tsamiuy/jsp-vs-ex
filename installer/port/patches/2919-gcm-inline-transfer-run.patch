+/* toolkit 2919: a run of NV308A inline-transfer data words (COLOR, methods 0x0400..0x1FFC) inside one IO page, with
+ * no per-word diagnostic on. The destination is worked out once and checked against the tiling once for the whole
+ * row; the words are written in order with vm_write32, as gcm_2d_method does one at a time. 0 = not taken (tiled
+ * destination, or no IO mapping): the caller goes word by word. GCM2D_RUN=0: off. */
+static int gcm_2d_inline_run(u32 method, u32 io_off, u32 count)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM2D_RUN"); on = (e && *e == '0') ? 0 : 1; }
+    if (!on) return 0;
+    const u32 dea = gcm_io2ea(io_off);
+    if (!dea) return 0;
+    const u32 idx = (method - 0x0400) >> 2;
+    const u32 px = (s_gcm2d.point & 0xFFFF) + idx, py = s_gcm2d.point >> 16;
+    const u32 dst_pitch = s_gcm2d.pitch >> 16;
+    const int local = (s_gcm2d.dst_dma != 0xFEED0001u);
+    const u32 at = s_gcm2d.dst_offset + py * dst_pitch + px * 4;
+    if (gcm_rect_tiled(local, at, 4u * count, 1)) return 0;
+    const u32 ea = cellGcmResolveLocated(local, s_gcm2d.dst_offset) + py * dst_pitch + px * 4;
+    for (u32 i = 0; i < count; i++) vm_write32(ea + i * 4, vm_read32(dea + i * 4));
+    { static int lg = 0; if (PS3_LOG_FIRST(lg, 2))
+          printf("[GCM2D] 2919: inline run of %u words to 0x%08X (%s)%c", count, ea, local ? "local" : "main", 10); }
+    return 1;
+}
