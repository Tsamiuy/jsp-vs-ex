+/* Decision logic for re-opening the WASAPI render device (J-Stars patch 3004). No Windows headers: the host test
+ * (tests/test_audio_device_recover.c) drives it with fake HRESULTs and a fake clock. */
+#ifndef PS3R_AUDIO_WASAPI_RECOVER_H
+#define PS3R_AUDIO_WASAPI_RECOVER_H
+#include <stdint.h>
+#include <wchar.h>
+
+#define PS3R_AUDCLNT_E_DEVICE_INVALIDATED    0x88890004u
+#define PS3R_AUDCLNT_E_ENDPOINT_CREATE_FAILED 0x8889000Fu
+#define PS3R_AUDCLNT_E_SERVICE_NOT_RUNNING   0x88890010u
+#define PS3R_AUDCLNT_E_RESOURCES_INVALIDATED 0x88890026u
+
+/* Device-gone class for GetBuffer/ReleaseBuffer/Start results: the endpoint was unplugged, disabled, taken over by
+ * the user's default-device change or the audio service restarted (sleep, driver reset). */
+static inline int ps3r_wasapi_hr_is_device_gone(uint32_t hr)
+{
+    return hr == PS3R_AUDCLNT_E_DEVICE_INVALIDATED || hr == PS3R_AUDCLNT_E_SERVICE_NOT_RUNNING ||
+           hr == PS3R_AUDCLNT_E_RESOURCES_INVALIDATED || hr == PS3R_AUDCLNT_E_ENDPOINT_CREATE_FAILED;
+}
+/* GetCurrentPadding fails only when the stream is unusable, so any failure there means re-open. */
+static inline int ps3r_wasapi_padding_failed_means_lost(uint32_t hr) { return (int32_t)hr < 0; }
+
+#define PS3R_AUDIO_RETRY_FIRST_MS   0u     /* first try at the loss itself: the new default may already be there */
+#define PS3R_AUDIO_RETRY_STEP_MS    500u   /* then 500, 1000, 2000 ms ... */
+#define PS3R_AUDIO_RETRY_MAX_MS     2000u
+#define PS3R_AUDIO_POLL_MS          1000u  /* healthy: look at the default endpoint this often */
+
+typedef struct {
+    int      lost;           /* 1 while no device is open */
+    uint32_t attempts;       /* failed re-opens since the loss */
+    uint64_t lost_at_ms;
+    uint64_t next_try_ms;
+    uint64_t next_poll_ms;
+} ps3r_audio_dev_state;
+
+static inline void ps3r_audio_dev_init(ps3r_audio_dev_state* s, uint64_t now) {
+    s->lost = 0; s->attempts = 0; s->lost_at_ms = 0; s->next_try_ms = 0; s->next_poll_ms = now + PS3R_AUDIO_POLL_MS;
+}
+static inline void ps3r_audio_dev_lost(ps3r_audio_dev_state* s, uint64_t now) {
+    s->lost = 1; s->attempts = 0; s->lost_at_ms = now; s->next_try_ms = now + PS3R_AUDIO_RETRY_FIRST_MS;
+}
+static inline int ps3r_audio_dev_retry_due(const ps3r_audio_dev_state* s, uint64_t now) {
+    return s->lost && now >= s->next_try_ms;
+}
+static inline void ps3r_audio_dev_open_failed(ps3r_audio_dev_state* s, uint64_t now) {
+    uint32_t step = PS3R_AUDIO_RETRY_STEP_MS << (s->attempts < 4 ? s->attempts : 4);
+    if (step > PS3R_AUDIO_RETRY_MAX_MS) step = PS3R_AUDIO_RETRY_MAX_MS;
+    s->attempts++; s->next_try_ms = now + step;
+}
+static inline void ps3r_audio_dev_opened(ps3r_audio_dev_state* s, uint64_t now) {
+    s->lost = 0; s->attempts = 0; s->next_poll_ms = now + PS3R_AUDIO_POLL_MS;
+}
+static inline int ps3r_audio_dev_poll_due(const ps3r_audio_dev_state* s, uint64_t now) {
+    return !s->lost && now >= s->next_poll_ms;
+}
+static inline void ps3r_audio_dev_polled(ps3r_audio_dev_state* s, uint64_t now) { s->next_poll_ms = now + PS3R_AUDIO_POLL_MS; }
+/* The default render endpoint is a different one than the stream runs on (a stream opened on the old device keeps
+ * playing there, so no HRESULT ever reports the switch). Empty/NULL current id = lookup failed: not a change. */
+static inline int ps3r_audio_default_changed(const wchar_t* open_id, const wchar_t* default_id) {
+    if (!default_id || !default_id[0] || !open_id) return 0;
+    return wcscmp(open_id, default_id) != 0;
+}
+#endif
