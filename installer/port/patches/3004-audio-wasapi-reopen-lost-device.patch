+++ b/libs/audio/tests/test_audio_device_recover.c
@@ -0,0 +1,47 @@
+/* Host test for the WASAPI re-open decisions (J-Stars patch 3004). gcc -I libs/audio libs/audio/tests/test_audio_device_recover.c */
+#include "../audio_wasapi_recover.h"
+#include <assert.h>
+#include <stdio.h>
+int main(void)
+{
+    /* which results mean re-open */
+    assert(ps3r_wasapi_hr_is_device_gone(0x88890004u));   /* DEVICE_INVALIDATED */
+    assert(ps3r_wasapi_hr_is_device_gone(0x88890010u));   /* SERVICE_NOT_RUNNING */
+    assert(ps3r_wasapi_hr_is_device_gone(0x88890026u));   /* RESOURCES_INVALIDATED */
+    assert(!ps3r_wasapi_hr_is_device_gone(0));            /* S_OK */
+    assert(!ps3r_wasapi_hr_is_device_gone(0x88890006u));  /* BUFFER_TOO_LARGE: caller bug, not a lost device */
+    assert(!ps3r_wasapi_hr_is_device_gone(0x8889000Bu));  /* BUFFER_OPERATION_PENDING */
+    assert(ps3r_wasapi_padding_failed_means_lost(0x88890004u));
+    assert(ps3r_wasapi_padding_failed_means_lost(0x80004005u)); /* E_FAIL */
+    assert(!ps3r_wasapi_padding_failed_means_lost(0));
+    assert(!ps3r_wasapi_padding_failed_means_lost(1));    /* S_FALSE */
+
+    /* retry timing: immediate, then 500, 1000, 2000, 2000 ... after each failure */
+    ps3r_audio_dev_state s; ps3r_audio_dev_init(&s, 1000);
+    assert(!ps3r_audio_dev_retry_due(&s, 1000));          /* healthy: nothing to retry */
+    assert(!ps3r_audio_dev_poll_due(&s, 1999) && ps3r_audio_dev_poll_due(&s, 2000));
+    ps3r_audio_dev_lost(&s, 5000);
+    assert(!ps3r_audio_dev_poll_due(&s, 99999));          /* no polling while lost */
+    assert(ps3r_audio_dev_retry_due(&s, 5000));
+    ps3r_audio_dev_open_failed(&s, 5010);
+    assert(!ps3r_audio_dev_retry_due(&s, 5509) && ps3r_audio_dev_retry_due(&s, 5510));
+    ps3r_audio_dev_open_failed(&s, 5510);
+    assert(!ps3r_audio_dev_retry_due(&s, 6509) && ps3r_audio_dev_retry_due(&s, 6510));
+    ps3r_audio_dev_open_failed(&s, 6510);
+    assert(ps3r_audio_dev_retry_due(&s, 8510) && !ps3r_audio_dev_retry_due(&s, 8509));
+    for (int i = 0; i < 20; i++) ps3r_audio_dev_open_failed(&s, 10000);
+    assert(s.next_try_ms == 12000);                        /* capped at 2 s, no overflow of the shift */
+    ps3r_audio_dev_opened(&s, 20000);
+    assert(!s.lost && s.attempts == 0 && !ps3r_audio_dev_retry_due(&s, 99999));
+    assert(!ps3r_audio_dev_poll_due(&s, 20999) && ps3r_audio_dev_poll_due(&s, 21000));
+    ps3r_audio_dev_lost(&s, 30000);                        /* a second loss starts over */
+    assert(s.attempts == 0 && ps3r_audio_dev_retry_due(&s, 30000));
+
+    /* default-device change with no HRESULT */
+    assert(!ps3r_audio_default_changed(L"{a}", L"{a}"));
+    assert(ps3r_audio_default_changed(L"{a}", L"{b}"));
+    assert(!ps3r_audio_default_changed(L"{a}", L""));      /* no default right now: not a change */
+    assert(!ps3r_audio_default_changed(L"{a}", NULL));
+    puts("test_audio_device_recover: ok");
+    return 0;
+}
