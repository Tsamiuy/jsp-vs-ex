Patch 6500: input modes and bindings of the v0.15 port, on the Windows (XInput) backend: INPUT_MODE=keyboard|kbm|
controller, PAD_KEY_<NAME> key rebinds, PAD_BTN_<NAME> controller remaps, MOUSE_SENS, and title-port hooks for mouse
look and mouse-driven menus.

keyboard: keys only, mouse-button bindings ignored; the keyboard is player 1 and a controller on port 0 moves to port 1.
kbm: keys and mouse buttons; the mouse turns the right stick while g_pad_mouse_look says so and drives menus where
g_pad_mouse_menus says so (wheel = d-pad, left click = Cross or point-and-click through g_pad_menu_layout, right
click = Circle). controller: XInput with PAD_BTN_ remaps; the keyboard is player 2. Keys: PAD_KEY_<NAME>=<virtual-key
code> for LSTICK_*, DPAD_* (PAD_KEYS_SPLIT=1), CROSS, CIRCLE, SQUARE, TRIANGLE, L1, R1, L2, R2, L3, R3, START, SELECT;
new defaults L3 = 3, R3 = 4. PAD_PAD_P2=0 keeps the old port routing. Unset INPUT_MODE: as before (keyboard fills in
for port 0 when no controller is there). Other backends unchanged.

Tested (US disc): quick Free Battle route reaches the fight as before (bench/feature/2026-11-09_1558-pad1). Key
rebinds, controller remaps and the modes left for a hands-on check with the launcher.

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 0a1540e2..5ab5614d 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -303,6 +303,227 @@ static int pad_key_down(int key)
 #define PADKEY_TAB SDL_SCANCODE_TAB
 #endif
 
+#if PAD_BACKEND_XINPUT
+/* 6500 (from the v0.15 port): INPUT_MODE=keyboard|kbm|controller, the launcher's input choice (unset = the old
+ * behaviour: the keyboard fills in for port 0 when no controller is there).
+ *   keyboard   - keys only; bindings to mouse buttons (VK 0x01-0x06) are ignored. The keyboard is player 1 and a
+ *                controller found on port 0 moves to port 1 (player 2; PAD_PAD_P2=0 off).
+ *   kbm        - keys and mouse buttons; the mouse turns the right stick while g_pad_mouse_look says so (a title
+ *                port sets it), cursor hidden and held in the window. MOUSE_SENS=<float>, 1 = default.
+ *   controller - XInput, buttons remappable with PAD_BTN_<NAME>=<XInput name>; the keyboard is player 2.
+ * PAD_KEY_<NAME>=<virtual-key code> rebinds one key: LSTICK_UP/DOWN/LEFT/RIGHT (default the arrows),
+ * DPAD_UP/DOWN/LEFT/RIGHT (I/K/J/L, with PAD_KEYS_SPLIT=1), CROSS, CIRCLE, SQUARE, TRIANGLE, L1, R1, L2, R2, L3, R3,
+ * START, SELECT. */
+enum { PAD_MODE_DEFAULT, PAD_MODE_KEYBOARD, PAD_MODE_KBM, PAD_MODE_CONTROLLER };
+static int pad_input_mode(void)
+{
+    static int m = -1;
+    if (m < 0) {
+        const char* e = getenv("INPUT_MODE");
+        m = !e ? PAD_MODE_DEFAULT : !strcmp(e, "keyboard") ? PAD_MODE_KEYBOARD :
+            !strcmp(e, "kbm") ? PAD_MODE_KBM : !strcmp(e, "controller") ? PAD_MODE_CONTROLLER : PAD_MODE_DEFAULT;
+    }
+    return m;
+}
+/* Title-port hooks (all optional; NULL = not used):
+ *   g_pad_arrows_dpad  - nonzero while the arrows should press the d-pad too (PAD_KEYS_SPLIT=1)
+ *   g_pad_mouse_look   - nonzero while the mouse should steer the camera (kbm)
+ *   g_pad_mouse_menus  - nonzero on screens where the mouse drives the menus (kbm): wheel = d-pad up/down,
+ *                        left click = Cross, right click = Circle
+ *   g_pad_menu_layout  - the current menu's cursor and item rectangles (guest 1280x720), for point-and-click
+ *   g_pad_menu_jump    - put the menu cursor next to item i at once
+ * g_pad_cursor_hidden tells the window backend to hide the cursor over the game window; it adds wheel notches to
+ * g_pad_wheel (+ = away from the user). */
+int (*g_pad_arrows_dpad)(void) = 0;
+int (*g_pad_mouse_look)(void) = 0;
+int (*g_pad_mouse_menus)(void) = 0;
+int (*g_pad_menu_layout)(int* cursor, const short (**rects)[4], int* count) = 0;
+int (*g_pad_menu_jump)(int index, int from) = 0;
+volatile int g_pad_cursor_hidden = 0;
+volatile long g_pad_wheel = 0;
+static int pad_menus_by_mouse(void)
+{
+    return pad_input_mode() == PAD_MODE_KBM && g_pad_mouse_menus && g_pad_mouse_menus();
+}
+static int pad_key_from_env(const char* name, int def)
+{
+    char var[40];
+    snprintf(var, sizeof var, "PAD_KEY_%s", name);
+    const char* e = getenv(var);
+    long v = e ? strtol(e, NULL, 0) : 0;
+    return (v > 0 && v < 256) ? (int)v : def;
+}
+
+/* kbm: while the title wants mouse look, hold the cursor at the centre of the game window, hidden, and turn each
+ * poll's movement into right-stick deflection (smoothed). Releases the cursor as soon as mouse look ends. */
+static void pad_mouse_look(PadHostState* hs)
+{
+    static int held = 0;
+    static float sx = 0.0f, sy = 0.0f;
+    const int want = pad_input_mode() == PAD_MODE_KBM && g_pad_mouse_look && g_pad_mouse_look();
+    HWND w = GetForegroundWindow();
+    RECT rc; POINT c = {0, 0};
+    if (want && w && GetClientRect(w, &rc) && ClientToScreen(w, &c)) {
+        POINT mid = { c.x + (rc.right - rc.left) / 2, c.y + (rc.bottom - rc.top) / 2 };
+        if (!held) {
+            RECT clip = { c.x, c.y, c.x + rc.right - rc.left, c.y + rc.bottom - rc.top };
+            ClipCursor(&clip); SetCursorPos(mid.x, mid.y);
+            held = 1; g_pad_cursor_hidden = 1; sx = sy = 0.0f;
+            return;
+        }
+        static float sens = -1.0f;
+        if (sens < 0.0f) { const char* e = getenv("MOUSE_SENS"); sens = e ? (float)atof(e) : 1.0f; if (sens <= 0.0f) sens = 1.0f; }
+        POINT pt; GetCursorPos(&pt);
+        const float dx = (float)(pt.x - mid.x), dy = (float)(pt.y - mid.y);
+        SetCursorPos(mid.x, mid.y);
+        sx = sx * 0.5f + dx * 6.0f * sens; sy = sy * 0.5f + dy * 6.0f * sens;
+        const float ax = sx > 127.0f ? 127.0f : sx < -127.0f ? -127.0f : sx;
+        const float ay = sy > 127.0f ? 127.0f : sy < -127.0f ? -127.0f : sy;
+        hs->analog_rx = (u8)(128 + (int)ax);
+        hs->analog_ry = (u8)(128 + (int)ay);
+    } else if (held) {
+        ClipCursor(NULL);
+        held = 0; g_pad_cursor_hidden = 0;
+    }
+}
+
+/* kbm, menu screens: wheel = d-pad up/down (one 3-poll press per notch, then 3 polls released), left click = Cross
+ * (or point-and-click through g_pad_menu_layout), right click = Circle, only with the cursor inside the window.
+ * Elsewhere the cursor is hidden over the window in any INPUT_MODE but the default. */
+static void pad_mouse_menus(PadHostState* hs)
+{
+    static int pulse = 0, dir = 0;
+    if (pad_input_mode() == PAD_MODE_DEFAULT) return;
+    const int menus = pad_menus_by_mouse();
+    if (!menus) {
+        if (!g_pad_mouse_look || !g_pad_mouse_look() || pad_input_mode() != PAD_MODE_KBM) g_pad_cursor_hidden = 1;
+        InterlockedExchange(&g_pad_wheel, 0); pulse = 0;
+        return;
+    }
+    g_pad_cursor_hidden = 0;
+    if (pulse == 0) {
+        const long wh = g_pad_wheel;
+        if (wh) { dir = wh > 0 ? 1 : -1; InterlockedExchangeAdd(&g_pad_wheel, -dir); pulse = 6; }
+    }
+    if (pulse > 0) {
+        if (pulse > 3) hs->buttons |= dir > 0 ? CELL_PAD_CTRL_UP : CELL_PAD_CTRL_DOWN;
+        pulse--;
+    }
+    HWND w = GetForegroundWindow(); POINT pt; RECT rc;
+    const int inside = w && pad_host_window_focused() && GetCursorPos(&pt) && ScreenToClient(w, &pt) && GetClientRect(w, &rc) &&
+                       pt.x >= 0 && pt.y >= 0 && pt.x < rc.right && pt.y < rc.bottom && rc.right > 0 && rc.bottom > 0;
+    const int lb = inside && (GetAsyncKeyState(VK_LBUTTON) & 0x8000);
+    const int rb = inside && (GetAsyncKeyState(VK_RBUTTON) & 0x8000);
+    if (rb) hs->buttons |= CELL_PAD_CTRL_CIRCLE;
+
+    static int target = -1, click_wait = 0, step = 0, step_up = 0, press = 0, prev_lb = 0, swallow_lb = 0;
+    if (!lb) swallow_lb = 0;
+    static POINT last = { -1, -1 };
+    int cur = 0, n = 0; const short (*r)[4] = 0;
+    if (!g_pad_menu_layout || !g_pad_menu_layout(&cur, &r, &n) || !r || n <= 0) {
+        target = -1; click_wait = 0; step = 0; press = 0;
+        if (lb && !swallow_lb) hs->buttons |= CELL_PAD_CTRL_CROSS;
+        prev_lb = lb;
+        return;
+    }
+    int hover = -1;
+    if (inside) {   /* the game image fills the client area (the window keeps the game's aspect) */
+        const int gx = (int)((long long)pt.x * 1280 / rc.right), gy = (int)((long long)pt.y * 720 / rc.bottom);
+        for (int i = 0; i < n; i++)
+            if (gx >= r[i][0] && gx < r[i][2] && gy >= r[i][1] && gy < r[i][3]) { hover = i; break; }
+    }
+    const int moved = inside && (pt.x != last.x || pt.y != last.y);
+    if (inside) last = pt;
+    const u16 dpad = CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT;
+    if (hs->buttons & (dpad | CELL_PAD_CTRL_CROSS)) { target = -1; click_wait = 0; }   /* keys win */
+    else if (moved && hover >= 0) target = hover;
+    if (lb && !prev_lb && hover >= 0) { target = hover; click_wait = 1; }
+    prev_lb = lb;
+    if (press > 0) { hs->buttons |= CELL_PAD_CTRL_CROSS; press--; return; }
+    if (step > 0) {   /* a d-pad step: 3 polls held, 3 released */
+        if (step > 3) hs->buttons |= (u16)(step_up ? CELL_PAD_CTRL_UP : CELL_PAD_CTRL_DOWN);
+        step--;
+        return;
+    }
+    if (target >= 0 && target < n && (target - cur > 1 || cur - target > 1) &&
+        g_pad_menu_jump && g_pad_menu_jump(target, cur)) return;
+    if (target >= 0 && target < n && target != cur) { step = 6; step_up = target < cur; }
+    else if (target == cur && click_wait) { click_wait = 0; press = 4; swallow_lb = 1; }
+}
+
+static void pad_poll_keyboard_port(int port);
+static void pad_poll_keyboard(void) { pad_poll_keyboard_port(0); }
+/* The keyboard as the pad on `port` (0 normally; 1 = player 2 next to a controller). Mouse only on 0. */
+static void pad_poll_keyboard_port(int port)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("PAD_NO_KEYBOARD") ? 1 : 0;
+    if (off) return;
+
+    PadHostState* hs = &s_host_state[port];
+    if (!pad_host_window_focused()) {
+        /* Release everything on focus loss, or a key held while alt-tabbing would stay down forever. */
+        hs->buttons = 0;
+        hs->analog_lx = hs->analog_ly = 128;
+        hs->analog_rx = hs->analog_ry = 128;
+        hs->connected = 1;
+        if (port == 0) { pad_mouse_look(hs); pad_mouse_menus(hs); }
+        return;
+    }
+
+    static struct { const char* name; int vk; u16 btn; } map[] = {
+        { "LSTICK_UP",   VK_UP,     CELL_PAD_CTRL_UP },     { "LSTICK_DOWN", VK_DOWN,   CELL_PAD_CTRL_DOWN },
+        { "LSTICK_LEFT", VK_LEFT,   CELL_PAD_CTRL_LEFT },   { "LSTICK_RIGHT",VK_RIGHT,  CELL_PAD_CTRL_RIGHT },
+        { "CROSS",       'Z',       CELL_PAD_CTRL_CROSS },  { "CIRCLE",      'X',       CELL_PAD_CTRL_CIRCLE },
+        { "SQUARE",      'A',       CELL_PAD_CTRL_SQUARE }, { "TRIANGLE",    'S',       CELL_PAD_CTRL_TRIANGLE },
+        { "L1",          'Q',       CELL_PAD_CTRL_L1 },     { "R1",          'W',       CELL_PAD_CTRL_R1 },
+        { "L2",          '1',       CELL_PAD_CTRL_L2 },     { "R2",          '2',       CELL_PAD_CTRL_R2 },
+        { "L3",          '3',       CELL_PAD_CTRL_L3 },     { "R3",          '4',       CELL_PAD_CTRL_R3 },
+        { "START",       VK_RETURN, CELL_PAD_CTRL_START },  { "SELECT",      VK_TAB,    CELL_PAD_CTRL_SELECT },
+    };
+    static int split = -1;
+    if (split < 0) { const char* e = getenv("PAD_KEYS_SPLIT"); split = (e && e[0] == '1') ? 1 : 0; }
+    static struct { const char* name; int vk; u16 btn; } dpad_keys[] = {
+        { "DPAD_UP",   'I', CELL_PAD_CTRL_UP },   { "DPAD_DOWN",  'K', CELL_PAD_CTRL_DOWN },
+        { "DPAD_LEFT", 'J', CELL_PAD_CTRL_LEFT }, { "DPAD_RIGHT", 'L', CELL_PAD_CTRL_RIGHT },
+    };
+    static int keys_read = 0;
+    if (!keys_read) {
+        keys_read = 1;
+        for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++) map[i].vk = pad_key_from_env(map[i].name, map[i].vk);
+        for (unsigned i = 0; i < sizeof dpad_keys / sizeof dpad_keys[0]; i++)
+            dpad_keys[i].vk = pad_key_from_env(dpad_keys[i].name, dpad_keys[i].vk);
+    }
+    const u16 dpad = CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT;
+    u16 btns = 0, stick = 0;
+    /* mouse bindings: none in keyboard mode, and in mouse menus the buttons mean Cross/Circle instead */
+    const int no_mouse = pad_input_mode() == PAD_MODE_KEYBOARD || pad_menus_by_mouse() || port != 0;
+    for (unsigned i = 0; i < sizeof map / sizeof map[0]; i++) {
+        if (no_mouse && map[i].vk >= VK_LBUTTON && map[i].vk <= VK_XBUTTON2) continue;
+        if (GetAsyncKeyState(map[i].vk) & 0x8000) btns |= map[i].btn;
+    }
+    stick = btns & dpad;   /* the arrows */
+    if (split) {
+        if (!g_pad_arrows_dpad || !g_pad_arrows_dpad()) btns &= (u16)~dpad;
+        for (unsigned i = 0; i < sizeof dpad_keys / sizeof dpad_keys[0]; i++)
+            if (GetAsyncKeyState(dpad_keys[i].vk) & 0x8000) btns |= dpad_keys[i].btn;
+    }
+
+    hs->buttons   = btns;
+    hs->connected = 1;
+    hs->analog_lx = (u8)((stick & CELL_PAD_CTRL_LEFT) ? 0 : (stick & CELL_PAD_CTRL_RIGHT) ? 255 : 128);
+    hs->analog_ly = (u8)((stick & CELL_PAD_CTRL_UP) ? 0 : (stick & CELL_PAD_CTRL_DOWN) ? 255 : 128);
+    hs->analog_rx = hs->analog_ry = 128;
+    if (port == 0) { pad_mouse_look(hs); pad_mouse_menus(hs); }
+    hs->trigger_l2 = (u8)((btns & CELL_PAD_CTRL_L2) ? 255 : 0);
+    hs->trigger_r2 = (u8)((btns & CELL_PAD_CTRL_R2) ? 255 : 0);
+
+    { static int said = 0;
+      if (!said && btns) { said = 1;
+          printf("[cellPad] keyboard active on port %d\n", port);
+          fflush(stdout); } }
+}
+#else
 static void pad_poll_keyboard(void)
 {
