     if (levels > 1) up_bytes = mtotal;   /* whole chain */
     const u32 fi = s_d3d.frame_index;
     if (!s_d3d.tex_ring) {
@@ -4069,7 +4158,7 @@ static int vp_upload_tex_slot_impl(u32 off, u32 w, u32 h, u32 fmt, int cube, u32
