+/* patch 7917: a write the engine makes straight into guest memory (the rollback snapshot's write guard notes main-memory stores) */
+static void eng_note_guest_write(const u8* p, u32 n)
+{
+    extern void ps3_rsx_note_write(u32 ea, u32 n, u32 kind);
+    if (vm_base && p >= vm_base && (u64)(p - vm_base) < 0x100000000ull) ps3_rsx_note_write((u32)(p - vm_base), n, 0);
+}
