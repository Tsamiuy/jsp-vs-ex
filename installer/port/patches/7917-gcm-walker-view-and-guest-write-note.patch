             if (dx < cx0 || dx >= cx1) continue;
@@ -1655,6 +1665,7 @@ static int gcm_2d_inline_run(u32 method, u32 io_off, u32 count)
     const u32 at = s_gcm2d.dst_offset + py * dst_pitch + px * 4;
