@@ -1330,9 +1330,18 @@ static void nv3089_engine_wrote(u32 dst_pitch, u32 x0, u32 y0, u32 x1, u32 y1)
  * pixel: an SPU holding a reservation on a 128-byte line the row overwrites
  * loses it and gets its lost-reservation event. The two byte swaps a
  * vm_read32/vm_write32 pair does cancel, so the bytes move verbatim. */
+static volatile u32 s_rsx_guest_writes = 0;   /* patch 7917: RSX-side writes into guest MAIN memory (below 0xC0000000: not the local memory), one per store / row / word run */
+void (*ps3_rsx_guest_write_hook)(u32 ea, u32 n, u32 kind) = 0;   /* patch 7917: optional observer (the rollback snapshot's write guard): ea, byte count, kind 0 = data (2D engine, report, notify) 1 = label / semaphore release */
+void ps3_rsx_note_write(u32 ea, u32 n, u32 kind)
+{
+    if (ea >= 0xC0000000u) return;
+    s_rsx_guest_writes++;
+    if (ps3_rsx_guest_write_hook) ps3_rsx_guest_write_hook(ea, n, kind);
+}
 static void gcm_store(u32 d, const u8* src, u32 n)
