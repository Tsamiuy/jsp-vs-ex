+            ps3_rsx_note_write(base + py * dst_pitch + px * 4, 4, 0);   /* patch 7917: tiled or not, the word lands in this guest page */
             const u32 at = s_gcm2d.dst_offset + py * dst_pitch + px * 4;
             if (gcm_rect_tiled(local, at, 4, 1)) {
