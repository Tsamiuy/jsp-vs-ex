                     labels++;
                 } else if (m == 0x01A4u || m == 0x1D6Cu || m == 0x1D70u || m == 0x1D74u) {
@@ -2300,8 +2313,10 @@ static void wprof_note_walker(void) {}
 /* Host thread that last walked the FIFO, for PS3_SAMPLE_DRAIN. */
 volatile unsigned long g_gcm_drain_tid;
 
+static volatile u32 s_drain_passes = 0;   /* patch 7917: read-only drain statistics for the rollback snapshot gate */
 void cellGcm_rsx_process_fifo(void)
 {
+    s_drain_passes++;
     wprof_note_walker();
     g_gcm_drain_tid = GetCurrentThreadId();
     const uint64_t ft_t0 = PS3_FT_ON() ? ps3_ft_now() : 0;
@@ -2384,6 +2399,7 @@ static void gcm_3d_method(rsx_state* st, u32 m, u32 v, int legacy_state_live)
             /* CellGcmReportData, big-endian: u64 timer, u32 value, u32 padding. */
             const u32 rea = gcm_io2ea(off);
             if (rea) {
+                ps3_rsx_note_write(rea, 16, 0);   /* patch 7917 */
                 vm_write32(rea, (u32)(ts >> 32));
                 vm_write32(rea + 4u, (u32)ts);
                 vm_write32(rea + 8u, val);
@@ -2872,6 +2888,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
                         if (!gcm_get_eq_put())
                             vm_write32(GCM_CONTROL_GUEST_ADDR + 4, s_fifo_getoff + 4 + count * 4);
                         atomic_thread_fence(memory_order_release);
+                        ps3_rsx_note_write(la, 4, 1);   /* patch 7917 */
                         vm_write32(la, v);
                         { static int rn = 0; if (s_sema_offset != 0x400u && PS3_LOG_FIRST(rn, 40))   /* TEMP */
                             fprintf(stderr, "[SEMA-REL] get=0x%08X off=0x%X val=0x%08X\n", s_fifo_getoff, s_sema_offset, v); }
@@ -4967,3 +4984,13 @@ void cellGcm_syscall_set_fifo(u32 put, u32 get)
     s_fifo_getoff  = get;
     s_fifo_calloff = 0;
 }
+
+/* Patch 7917 (rollback netcode; read only, no behaviour change): where the RSX FIFO walker is, for the snapshot gate's failure line. out[0] = drain passes so far,
+ * out[1] = get offset (IO), out[2] = flips queued, out[3] = flips reached, out[4] = flips completed, out[5] = the walker's drain thread id, out[6..12] = the 7 command words at
+ * get (0xFFFFFFFF = no IO mapping there), out[13] = RSX-side writes into guest main memory so far. No lock: an unlocked read, only for a log line and a counter. */
+void ps3_gcm_walker_view(uint32_t* out)
+{
+    out[0] = s_drain_passes; out[1] = s_fifo_getoff; out[2] = s_fifo_flips_queued; out[3] = s_fifo_flips_reached; out[4] = s_fifo_flips_completed;
+    out[5] = (uint32_t)g_gcm_drain_tid; out[13] = s_rsx_guest_writes;
+    for (u32 i = 0; i < 7; i++) { const u32 ea = gcm_io2ea(s_fifo_getoff + i * 4u); out[6 + i] = ea ? vm_read32(ea) : 0xFFFFFFFFu; }
+}
