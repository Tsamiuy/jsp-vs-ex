@@ -2009,6 +2021,7 @@ static void gcm_fifo_resync_why(const char* why, u32* getoff, u32 put)
                 if (m == 0x64u) s_sema_offset = v;
                 else if (m == 0x6Cu) {
                     atomic_thread_fence(memory_order_release);
+                    ps3_rsx_note_write(GCM_LABEL_GUEST_BASE + (s_sema_offset & 0xFFFFu), 4, 1);   /* patch 7917 */
