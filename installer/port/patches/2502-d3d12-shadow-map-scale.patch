 #define MAX_OFF_DS   6
+/* SHADOW_SCALE=<1-4> (default 2; patch 2502): depth surfaces the title samples through a depth comparison (its shadow
+ * maps) are rendered at this multiple of the guest size; 1 = the guest size. RPCS3's resolution scale does the same to
+ * them. At J-Stars' own 2048x1024 the shadow texels are large next to thin parts (sleeves, shoulder plates), and with
+ * the shadow map refitted to the camera each frame they showed as grey stair-step lines that moved whenever the camera
+ * or the character moved. Receivers sample with normalised coordinates and the comparison helper takes the size from
+ * the bound texture, so only the surface, its colour copy and the passes' viewports change. */
+static int shadow_scale(void)
+{
+    static int k = -1;
+    if (k < 0) { const char* e = getenv("SHADOW_SCALE"); k = e ? atoi(e) : 2; if (k < 1) k = 1; if (k > 4) k = 4; }
+    return k;
+}
