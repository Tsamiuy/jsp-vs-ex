+/* TEX_HINT (default on, TEX_HINT=0 off; patch 2054, from the v15 backend): slot + 1 last seen holding a texture key,
+ * by hash (0 = none). */
+static u16 s_tex_hint[4096];
+static u32 tex_hint_hash(u32 key, u32 w, u32 h, u32 fmt, int cube, u32 pitch)
+{
+    u32 x = key * 2654435761u ^ (w * 40503u) ^ (h << 11) ^ (fmt << 21) ^ (u32)cube ^ (pitch * 2246822519u);
+    return (x ^ (x >> 15)) & 4095u;
+}
+static int tex_hint_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("TEX_HINT"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+static int vp_upload_tex_slot_impl(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips, u32 pitch_arg);
 static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips, u32 pitch_arg)
+{
+    const int r = vp_upload_tex_slot_impl(off, w, h, fmt, cube, mips, pitch_arg);
+    if (r >= 0 && tex_hint_on()) {
+        const VPTexSlot* c = &s_d3d.vp_tex[r];
+        if (c->res) s_tex_hint[tex_hint_hash(c->key, c->w, c->h, c->fmt, c->cube, c->pitch)] = (u16)(r + 1);
+    }
+    return r;
+}
