+/* 2511: the AA passes' SRV windows (three of 16, t0-t15 of the per-draw table) between the depth SRVs and the
+ * per-draw windows, and their samplers: s0 point/clamp (descriptor 0), s1 linear/clamp (made once). */
+#define AA_TEX_UNITS 16
+#define AA_SRV_BASE 96
+static int s_aa_lin_samp = -1;
+static void aa_samplers(void)
+{
+    if (s_aa_lin_samp < 0 && s_d3d.samp_n < 2048) {
+        D3D12_SAMPLER_DESC sd; memset(&sd, 0, sizeof sd);
+        sd.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        sd.AddressU = sd.AddressV = sd.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        sd.MaxAnisotropy = 1; sd.MaxLOD = D3D12_FLOAT32_MAX;
+        s_aa_lin_samp = (int)s_d3d.samp_n++;
+        vp_sampler_write((u32)s_aa_lin_samp, &sd);
+    }
+    if (!s_d3d.samp_heap) return;
+    D3D12_GPU_DESCRIPTOR_HANDLE sb;
+    s_d3d.samp_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.samp_heap, &sb);
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 3, sb);
+    sb.ptr += (u64)(s_aa_lin_samp < 0 ? 1 : s_aa_lin_samp) * s_d3d.samp_inc;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 4, sb);
+}
+
+/* AA: a title port's hook returns the edge smoothing wanted for a draw that fills
+ * rt_off (0 off, 1 FXAA, 2 stronger FXAA, 3 SMAA). The pass runs right after the game copies
+ * its finished scene into the HUD's target, so the HUD drawn next stays sharp. Same
+ * root signature as the game's draws, so only the PSO, targets and viewport change.
+ * The shader is a plain FXAA: find the edge, walk along it, blend across it. */
+static ID3D12PipelineState* s_aa_pso;
+static ID3D12Resource* s_aa_tmp;
+static D3D12_RESOURCE_STATES s_aa_tmp_st;
+static int s_aa_pso_mode;
+
+static ID3D12PipelineState* aa_get_pso(int mode, DXGI_FORMAT fmt)
+{
+    if (s_aa_pso && s_aa_pso_mode == mode) return s_aa_pso;
+    if (s_aa_pso_mode < 0) return NULL;   /* failed before */
+    static const char vs[] =
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+        "O main(uint i : SV_VertexID) { O o; o.uv = float2((i << 1) & 2, i & 2);\n"
+        "  o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n";
+    static const char ps[] =
+        "Texture2D t0 : register(t0); SamplerState lin : register(s1);\n"
+        "static const float Q[12] = { 1, 1, 1, 1, 1.5, 2, 2, 2, 2, 4, 8, 8 };\n"
+        "float L(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }\n"
+        "float3 S(float2 uv, float2 px) { return t0.SampleLevel(lin, clamp(uv, px * 0.5, 1 - px * 0.5), 0).rgb; }\n"
+        "float LS(float2 uv, float2 px) { return L(S(uv, px)); }\n"
+        "float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "  uint w, h; t0.GetDimensions(w, h); const float2 px = 1.0 / float2(w, h);\n"
+        "  const float4 c = t0.SampleLevel(lin, uv, 0);\n"
+        "  const float m = L(c.rgb), n = LS(uv + float2(0, -px.y), px), so = LS(uv + float2(0, px.y), px);\n"
+        "  const float e = LS(uv + float2(px.x, 0), px), we = LS(uv + float2(-px.x, 0), px);\n"
+        "  const float lo = min(m, min(min(n, so), min(e, we))), hi = max(m, max(max(n, so), max(e, we)));\n"
+        "  const float range = hi - lo;\n"
+        "  if (range < max(AA_MIN, hi * AA_THR)) return c;\n"
+        "  const float nw = LS(uv - px, px), se = LS(uv + px, px);\n"
+        "  const float ne = LS(uv + float2(px.x, -px.y), px), sw = LS(uv + float2(-px.x, px.y), px);\n"
+        "  const bool horz = abs(nw + sw - 2 * we) + 2 * abs(n + so - 2 * m) + abs(ne + se - 2 * e)\n"
+        "                 >= abs(nw + ne - 2 * n) + 2 * abs(we + e - 2 * m) + abs(sw + se - 2 * so);\n"
+        "  const float l1 = horz ? n : we, l2 = horz ? so : e;\n"
+        "  const float g1 = abs(l1 - m), g2 = abs(l2 - m);\n"
+        "  float stepl = horz ? px.y : px.x; float avg;\n"
+        "  if (g1 >= g2) { stepl = -stepl; avg = 0.5 * (l1 + m); } else avg = 0.5 * (l2 + m);\n"
+        "  const float gs = 0.25 * max(g1, g2);\n"
+        "  float2 cu = uv; if (horz) cu.y += 0.5 * stepl; else cu.x += 0.5 * stepl;\n"
+        "  const float2 off = horz ? float2(px.x, 0) : float2(0, px.y);\n"
+        "  float2 a = cu - off, b = cu + off; float ea = LS(a, px) - avg, eb = LS(b, px) - avg;\n"
+        "  bool da = abs(ea) >= gs, db = abs(eb) >= gs;\n"
+        "  for (int i = 1; i < 12 && !(da && db); i++) {\n"
+        "    if (!da) { a -= off * Q[i]; ea = LS(a, px) - avg; da = abs(ea) >= gs; }\n"
+        "    if (!db) { b += off * Q[i]; eb = LS(b, px) - avg; db = abs(eb) >= gs; }\n"
+        "  }\n"
+        "  const float d1 = horz ? uv.x - a.x : uv.y - a.y, d2 = horz ? b.x - uv.x : b.y - uv.y;\n"
+        "  const bool near1 = d1 < d2; const float dn = min(d1, d2), span = d1 + d2;\n"
+        "  const bool less = m < avg;\n"
+        "  const bool good = ((near1 ? ea : eb) < 0) != less;\n"
+        "  float o = good ? 0.5 - dn / span : 0;\n"
+        "  const float blur = saturate(abs((2 * (n + so + e + we) + nw + ne + sw + se) / 12 - m) / range);\n"
+        "  const float sub = smoothstep(0, 1, blur); o = max(o, sub * sub * AA_SUB);\n"
+        "  float2 f = uv; if (horz) f.y += o * stepl; else f.x += o * stepl;\n"
+        "  return float4(S(f, px), c.a);\n"
+        "}\n";
+    const D3D_SHADER_MACRO defs[][4] = {
+        { { "AA_THR", "0.125" }, { "AA_MIN", "0.0312" }, { "AA_SUB", "0.75" }, { NULL, NULL } },
+        { { "AA_THR", "0.063" }, { "AA_MIN", "0.0156" }, { "AA_SUB", "1.0" }, { NULL, NULL } } };
+    ID3DBlob* vb = NULL; ID3DBlob* pb = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(vs, sizeof(vs) - 1, "aa_vs", NULL, NULL, "main", "vs_5_0", 0, 0, &vb, &e);
+    if (e) { e->lpVtbl->Release(e); e = NULL; }
+    if (SUCCEEDED(hr)) hr = D3DCompile(ps, sizeof(ps) - 1, "aa_ps", defs[mode == 2], NULL, "main", "ps_5_0", 0, 0, &pb, &e);
+    if (e) { fprintf(stderr, "[AA] %s%c", (const char*)e->lpVtbl->GetBufferPointer(e), 10); e->lpVtbl->Release(e); }
+    if (SUCCEEDED(hr)) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+        pd.pRootSignature = s_d3d.vp_root_sig;
+        pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb); pd.VS.BytecodeLength = vb->lpVtbl->GetBufferSize(vb);
+        pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb); pd.PS.BytecodeLength = pb->lpVtbl->GetBufferSize(pb);
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = UINT_MAX;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1; pd.RTVFormats[0] = fmt;
+        pd.SampleDesc.Count = 1;
+        hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_aa_pso);
+    }
+    if (vb) vb->lpVtbl->Release(vb);
+    if (pb) pb->lpVtbl->Release(pb);
+    if (FAILED(hr)) { s_aa_pso = NULL; s_aa_pso_mode = -1; fprintf(stderr, "[AA] pipeline failed (0x%08lX)%c", hr, 10); return NULL; }
+    s_aa_pso_mode = mode;
+    fprintf(stderr, "[AA] mode %d on%c", mode, 10);
+    return s_aa_pso;
+}
+
+/* AA_MODE=smaa: SMAA 1x, High preset, from third_party_smaa (MIT). Three passes after the copy of
+ * the scene: colour edges, blending weights from the two lookup textures, and the blend back into
+ * the target. The game's root signature has its own samplers: s0 point + clamp, s1 linear + wrap. */
+#include "third_party_smaa/AreaTex.h"
+#include "third_party_smaa/SearchTex.h"
+static const unsigned char s_smaa_src[] = {
+#include "third_party_smaa/SMAA_hlsl.inc"
+};
+static ID3D12PipelineState* s_smaa_pso[3];
+static ID3D12Resource* s_smaa_rt[2];
+static ID3D12Resource* s_smaa_lut[2];
+static ID3D12Resource* s_smaa_up;
+static ID3D12DescriptorHeap* s_smaa_rtv;
+static int s_smaa_state, s_smaa_lut_pending;   /* state: 0 not tried, 1 ready, -1 failed */
+
+static ID3DBlob* smaa_compile(const char* head, const char* tail, const char* target)
+{
+    const size_t hl = strlen(head), sl = sizeof s_smaa_src, tl = strlen(tail);
+    char* all = (char*)malloc(hl + sl + tl + 1);
+    if (!all) return NULL;
+    memcpy(all, head, hl); memcpy(all + hl, s_smaa_src, sl); memcpy(all + hl + sl, tail, tl); all[hl + sl + tl] = 0;
+    ID3DBlob* b = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(all, hl + sl + tl, "smaa", NULL, NULL, "main", target, 0, 0, &b, &e);
+    free(all);
+    if (e) { if (FAILED(hr)) fprintf(stderr, "[AA] %s%c", (const char*)e->lpVtbl->GetBufferPointer(e), 10); e->lpVtbl->Release(e); }
+    return SUCCEEDED(hr) ? b : NULL;
+}
+
+static int smaa_ready(u32 w, u32 h, DXGI_FORMAT fmt)
+{
+    if (s_smaa_state) return s_smaa_state > 0;
+    s_smaa_state = -1;
+    const double t0 = perf_now();
+    char head[900];
+    snprintf(head, sizeof head,
+        "#define SMAA_CUSTOM_SL 1%c#define SMAA_PRESET_HIGH 1%c"
+        "#define SMAA_RT_METRICS float4(1.0 / %u.0, 1.0 / %u.0, %u.0, %u.0)%c"
+        "SamplerState PointSampler : register(s0); SamplerState LinearSampler : register(s1);%c"
+        "#define SMAATexture2D(tex) Texture2D tex%c#define SMAATexturePass2D(tex) tex%c"
+        "#define SMAASampleLevelZero(tex, coord) tex.SampleLevel(LinearSampler, coord, 0)%c"
+        "#define SMAASampleLevelZeroPoint(tex, coord) tex.SampleLevel(PointSampler, coord, 0)%c"
+        "#define SMAASampleLevelZeroOffset(tex, coord, offset) tex.SampleLevel(LinearSampler, coord, 0, offset)%c"
+        "#define SMAASample(tex, coord) tex.Sample(LinearSampler, coord)%c"
+        "#define SMAASamplePoint(tex, coord) tex.Sample(PointSampler, coord)%c"
+        "#define SMAASampleOffset(tex, coord, offset) tex.Sample(LinearSampler, coord, offset)%c"
+        "#define SMAA_FLATTEN [flatten]%c#define SMAA_BRANCH [branch]%c",
+        10, 10, w, h, w, h, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10);
+#define SMAA_UV "float2 uv = float2((i << 1) & 2, i & 2); o.p = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); o.uv = uv;"
+    static const char* const vs[3] = {
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; float4 a : TEXCOORD1; float4 b : TEXCOORD2; float4 c : TEXCOORD3; };\n"
+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f[3]; SMAAEdgeDetectionVS(uv, f); o.a = f[0]; o.b = f[1]; o.c = f[2]; return o; }\n",
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; float4 a : TEXCOORD1; float4 b : TEXCOORD2; float4 c : TEXCOORD3; float2 px : TEXCOORD4; };\n"
+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f[3]; float2 px; SMAABlendingWeightCalculationVS(uv, px, f); o.a = f[0]; o.b = f[1]; o.c = f[2]; o.px = px; return o; }\n",
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; float4 a : TEXCOORD1; };\n"
+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f; SMAANeighborhoodBlendingVS(uv, f); o.a = f; return o; }\n" };
+    static const char* const ps[3] = {
+        "Texture2D t0 : register(t0);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0, float4 a : TEXCOORD1, float4 b : TEXCOORD2, float4 c : TEXCOORD3) : SV_Target {\n"
+        "  float4 f[3] = { a, b, c }; return float4(SMAAColorEdgeDetectionPS(uv, f, t0), 0, 0); }\n",
+        "Texture2D t0 : register(t0); Texture2D t1 : register(t1); Texture2D t2 : register(t2);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0, float4 a : TEXCOORD1, float4 b : TEXCOORD2, float4 c : TEXCOORD3, float2 px : TEXCOORD4) : SV_Target {\n"
+        "  float4 f[3] = { a, b, c }; return SMAABlendingWeightCalculationPS(uv, px, f, t0, t1, t2, float4(0, 0, 0, 0)); }\n",
+        "Texture2D t0 : register(t0); Texture2D t1 : register(t1);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0, float4 a : TEXCOORD1) : SV_Target {\n"
+        "  return SMAANeighborhoodBlendingPS(uv, a, t0, t1); }\n" };
+    for (int i = 0; i < 3; i++) {
+        ID3DBlob* vb = smaa_compile(head, vs[i], "vs_5_0");
+        ID3DBlob* pb = vb ? smaa_compile(head, ps[i], "ps_5_0") : NULL;
+        HRESULT hr = E_FAIL;
+        if (pb) {
+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+            pd.pRootSignature = s_d3d.vp_root_sig;
+            pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb); pd.VS.BytecodeLength = vb->lpVtbl->GetBufferSize(vb);
+            pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb); pd.PS.BytecodeLength = pb->lpVtbl->GetBufferSize(pb);
+            pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+            pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+            pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+            pd.SampleMask = UINT_MAX;
+            pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+                pd.NumRenderTargets = 1; pd.RTVFormats[0] = i == 2 ? fmt : DXGI_FORMAT_R8G8B8A8_UNORM;
+            pd.SampleDesc.Count = 1;
+            hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_smaa_pso[i]);
+        }
+        if (vb) vb->lpVtbl->Release(vb);
+        if (pb) pb->lpVtbl->Release(pb);
+        if (FAILED(hr)) { fprintf(stderr, "[AA] SMAA pipeline %d failed%c", i, 10); return 0; }
+    }
+    D3D12_DESCRIPTOR_HEAP_DESC hd; memset(&hd, 0, sizeof hd);
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.NumDescriptors = 2;
+    if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_smaa_rtv))) return 0;
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_smaa_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_smaa_rtv, &rh);
+    const SIZE_T rinc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td; memset(&td, 0, sizeof td);
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.DepthOrArraySize = 1; td.MipLevels = 1; td.SampleDesc.Count = 1;
+    for (int i = 0; i < 2; i++) {
+        td.Width = w; td.Height = h; td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL, &IID_ID3D12Resource, (void**)&s_smaa_rt[i]))) return 0;
+        s_d3d.device->lpVtbl->CreateRenderTargetView(s_d3d.device, s_smaa_rt[i], NULL, rh);
+        rh.ptr += rinc;
+    }
+    td.Flags = D3D12_RESOURCE_FLAG_NONE;
+    td.Width = AREATEX_WIDTH; td.Height = AREATEX_HEIGHT; td.Format = DXGI_FORMAT_R8G8_UNORM;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_smaa_lut[0]))) return 0;
+    td.Width = SEARCHTEX_WIDTH; td.Height = SEARCHTEX_HEIGHT; td.Format = DXGI_FORMAT_R8_UNORM;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_smaa_lut[1]))) return 0;
+    /* one upload buffer, rows at the 256-byte pitch copies need: 512 for the area texture, 256 for the search one */
+    const u64 sz = (u64)AREATEX_HEIGHT * 512u + (u64)SEARCHTEX_HEIGHT * 256u;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = sz; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    D3D12_HEAP_PROPERTIES up; memset(&up, 0, sizeof up); up.Type = D3D12_HEAP_TYPE_UPLOAD;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &up, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_smaa_up))) return 0;
+    u8* m = NULL;
+    if (FAILED(s_smaa_up->lpVtbl->Map(s_smaa_up, 0, NULL, (void**)&m))) return 0;
+    for (u32 y = 0; y < AREATEX_HEIGHT; y++) memcpy(m + (u64)y * 512u, areaTexBytes + (u64)y * AREATEX_PITCH, AREATEX_PITCH);
+    for (u32 y = 0; y < SEARCHTEX_HEIGHT; y++) memcpy(m + (u64)AREATEX_HEIGHT * 512u + (u64)y * 256u, searchTexBytes + (u64)y * SEARCHTEX_PITCH, SEARCHTEX_PITCH);
+    s_smaa_up->lpVtbl->Unmap(s_smaa_up, 0, NULL);
+    s_smaa_lut_pending = 1;
+    const UINT map = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv_write(AA_SRV_BASE + AA_TEX_UNITS, s_smaa_rt[0], DXGI_FORMAT_R8G8B8A8_UNORM, map);
+    srv_write(AA_SRV_BASE + AA_TEX_UNITS + 1, s_smaa_lut[0], DXGI_FORMAT_R8G8_UNORM, map);
+    srv_write(AA_SRV_BASE + AA_TEX_UNITS + 2, s_smaa_lut[1], DXGI_FORMAT_R8_UNORM, map);
+    srv_write(AA_SRV_BASE + 2 * AA_TEX_UNITS + 1, s_smaa_rt[1], DXGI_FORMAT_R8G8B8A8_UNORM, map);
+    s_smaa_state = 1;
+    fprintf(stderr, "[AA] SMAA ready, %ux%u, %.0f ms%c", w, h, (perf_now() - t0) * 1000.0, 10);
+    return 1;
+}
