+/* Returns 1 when it ran: the caller rebinds its target and forgets its cached PSO, viewport and topology. */
+static int aa_pass(int rt, int mode, D3D12_GPU_DESCRIPTOR_HANDLE gh_base)
+{
+    OffRT* r = &s_d3d.off_rt[rt];
+    ID3D12PipelineState* pso = mode == 3 ? NULL : aa_get_pso(mode, (DXGI_FORMAT)r->dxgi);
+    if (mode != 3 && !pso) return 0;
+    D3D12_RESOURCE_DESC rd;
+    { D3D12_RESOURCE_DESC* got = r->res->lpVtbl->GetDesc(r->res, &rd); (void)got; }
+    if (mode == 3 && !smaa_ready((u32)rd.Width, rd.Height, (DXGI_FORMAT)r->dxgi)) return 0;
+    int fresh = 0;
+    if (s_aa_tmp) {
+        D3D12_RESOURCE_DESC td;
+        { D3D12_RESOURCE_DESC* got = s_aa_tmp->lpVtbl->GetDesc(s_aa_tmp, &td); (void)got; }
+        if (td.Width != rd.Width || td.Height != rd.Height || td.Format != rd.Format) { wait_for_gpu(); s_aa_tmp->lpVtbl->Release(s_aa_tmp); s_aa_tmp = NULL; }
+    }
+    if (!s_aa_tmp) {
+        D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC td = rd;
+        td.Flags = D3D12_RESOURCE_FLAG_NONE;
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_aa_tmp))) { s_aa_tmp = NULL; return 0; }
+        s_aa_tmp_st = D3D12_RESOURCE_STATE_COPY_DEST;
+        fresh = 1;
+    }
+    if (fresh) {
+        srv_write(AA_SRV_BASE, s_aa_tmp, (DXGI_FORMAT)r->dxgi, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING);
+        srv_write(AA_SRV_BASE + 2 * AA_TEX_UNITS, s_aa_tmp, (DXGI_FORMAT)r->dxgi, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING);
+    }
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s_aa_tmp;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    if (s_aa_tmp_st != D3D12_RESOURCE_STATE_COPY_DEST) {
+        b.Transition.StateBefore = s_aa_tmp_st; b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    }
+    off_rt_transition(rt, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, s_aa_tmp, r->res);
+    off_rt_transition(rt, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST; b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    s_aa_tmp_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    D3D12_CPU_DESCRIPTOR_HANDLE rh = off_rt_rtv(rt);
+    s_d3d.cmd_list->lpVtbl->OMSetRenderTargets(s_d3d.cmd_list, 1, &rh, FALSE, NULL);
+    D3D12_VIEWPORT vp = {0, 0, (float)rd.Width, (float)rd.Height, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)rd.Width, (LONG)rd.Height};
+    s_d3d.cmd_list->lpVtbl->RSSetViewports(s_d3d.cmd_list, 1, &vp);
+    s_d3d.cmd_list->lpVtbl->RSSetScissorRects(s_d3d.cmd_list, 1, &sc);
+    s_d3d.cmd_list->lpVtbl->IASetPrimitiveTopology(s_d3d.cmd_list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    aa_samplers();
+    if (mode == 3) { smaa_draw(rt, gh_base); return 1; }
+    s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, pso);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh = gh_base;
+    gh.ptr += (u64)AA_SRV_BASE * s_d3d.srv_inc;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+    s_d3d.cmd_list->lpVtbl->DrawInstanced(s_d3d.cmd_list, 3, 1, 0, 0);
+    return 1;
+}
