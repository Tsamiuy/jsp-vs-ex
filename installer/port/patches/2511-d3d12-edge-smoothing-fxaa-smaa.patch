     u32   vpull_base;
 } D3D12DrawRecord;
 /* An indexed run (upload_tris_vp_ix) may take the next batch; cleared with the records. */
@@ -4785,6 +4786,7 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
       const int ui_ok = g_rsx_ui_scale && dr && dr->is_vp && pk && s_d3d.vp_vb_mapped && !dr->is_clear &&
                         dr->vertex_count >= 3 && dr->vertex_count <= 4096 && !dr->indexed && !dr->vpull;
       const int ui_log = ui_dbg && dr && (dr->rt_off & 0x0FFFFFFFu) == ui_dbg && ui_dbg_n < 900000;
+      if (dr) ((D3D12DrawRecord*)dr)->aa_after = 0;   /* 2511 */
       if (ui_log && !ui_ok) {
           ui_dbg_n++;
           fprintf(stderr, "[UIDBG] f=%llu SKIP vs=%d pk=%d is_vp=%d n=%u ix=%d vpull=%d fp=0x%08X%c",
@@ -4812,6 +4814,10 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
               if (y > box[3]) box[3] = y;
           }
           float ax = 0.0f, ay = 0.0f;
+          { extern int (*g_rsx_aa_mode)(u32 rt_off);   /* 2511 */
+            if (g_rsx_aa_mode && box[0] > -1.001f && box[0] < -0.999f && box[1] > -1.001f && box[1] < -0.999f &&
