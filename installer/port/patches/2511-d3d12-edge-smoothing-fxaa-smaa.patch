+static void smaa_barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES a, D3D12_RESOURCE_STATES b)
+{
+    D3D12_RESOURCE_BARRIER br; memset(&br, 0, sizeof br);
+    br.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    br.Transition.pResource = r; br.Transition.StateBefore = a; br.Transition.StateAfter = b;
+    br.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &br);
+}
+
+/* The viewport, scissor and topology are already set; t0 of window 0 and window 2 hold the copied scene. */
+static void smaa_draw(int rt, D3D12_GPU_DESCRIPTOR_HANDLE gh_base)
+{
+    if (s_smaa_lut_pending) {
+        s_smaa_lut_pending = 0;
+        D3D12_TEXTURE_COPY_LOCATION d, s; memset(&d, 0, sizeof d); memset(&s, 0, sizeof s);
+        d.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; s.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        s.pResource = s_smaa_up;
+        s.PlacedFootprint.Footprint.Depth = 1;
+        d.pResource = s_smaa_lut[0];
+        s.PlacedFootprint.Offset = 0;
+        s.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8_UNORM;
+        s.PlacedFootprint.Footprint.Width = AREATEX_WIDTH; s.PlacedFootprint.Footprint.Height = AREATEX_HEIGHT;
+        s.PlacedFootprint.Footprint.RowPitch = 512;
+        s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &d, 0, 0, 0, &s, NULL);
+        d.pResource = s_smaa_lut[1];
+        s.PlacedFootprint.Offset = (u64)AREATEX_HEIGHT * 512u;
+        s.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8_UNORM;
+        s.PlacedFootprint.Footprint.Width = SEARCHTEX_WIDTH; s.PlacedFootprint.Footprint.Height = SEARCHTEX_HEIGHT;
+        s.PlacedFootprint.Footprint.RowPitch = 256;
+        s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &d, 0, 0, 0, &s, NULL);
+        smaa_barrier(s_smaa_lut[0], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        smaa_barrier(s_smaa_lut[1], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_smaa_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_smaa_rtv, &rh);
+    const SIZE_T rinc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    static const float clear[4] = { 0, 0, 0, 0 };
+    for (int p = 0; p < 3; p++) {
+        D3D12_CPU_DESCRIPTOR_HANDLE h = p < 2 ? rh : off_rt_rtv(rt);
+        if (p < 2) {
+            h.ptr += (SIZE_T)p * rinc;
+            smaa_barrier(s_smaa_rt[p], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+            s_d3d.cmd_list->lpVtbl->ClearRenderTargetView(s_d3d.cmd_list, h, clear, 0, NULL);
+        }
+        s_d3d.cmd_list->lpVtbl->OMSetRenderTargets(s_d3d.cmd_list, 1, &h, FALSE, NULL);
+        s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, s_smaa_pso[p]);
+        D3D12_GPU_DESCRIPTOR_HANDLE gh = gh_base;
+        gh.ptr += (u64)(AA_SRV_BASE + p * AA_TEX_UNITS) * s_d3d.srv_inc;
+        s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+        s_d3d.cmd_list->lpVtbl->DrawInstanced(s_d3d.cmd_list, 3, 1, 0, 0);
+        if (p < 2) smaa_barrier(s_smaa_rt[p], D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+}
