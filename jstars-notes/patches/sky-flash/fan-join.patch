+/* ---------------------------------------------------------------------------
+ * fan-join (jstars-notes STAGE_TEXTURES.md §13, white sky flash). RSX
+ * assembles every DRAW_ARRAYS / DRAW_INDEX_ARRAY batch inside one BEGIN/END
+ * as ONE primitive stream. The TRIANGLES merge below and the native indexed
+ * strip already rely on that; non-indexed strips/fans and indexed fans did
+ * not: each batch was expanded as a primitive of its own. J-Stars' "Lens
+ * Godray" sun-shaft pass is a 42-vertex TRIANGLE_FAN from the sun's screen
+ * position to 41 points around the screen edge (func_005567AC), and the
+ * game's draw emitter splits a draw into batches (the indexed emitter
+ * func_00657248 cuts the first batch at a 128-byte index-buffer boundary),
+ * so the fan arrived as two or more batches: the second one became a fan
+ * centred on a screen-edge point and the wedges around the split were never
+ * drawn -- the raw sun-colour sky mask leaked through them (white sky).
+ * Here a batch that continues the previous FAN/STRIP batch of the same
+ * BEGIN/END (same epoch and fragment program, first == previous end) is
+ * expanded against the STREAM: fan triangles keep the stream's first vertex
+ * as centre, strip triangles keep the stream's parity, and the triangles are
+ * appended to the previous record. FAN_JOIN=0 restores the per-batch fans.
+ * FAN_LOG=1 prints every fan batch; FAN_LOG=<hex colour offset> prints every
+ * batch drawn into that colour target (e.g. FAN_LOG=0D7A0000). */
+static struct { int valid; int indexed; u32 prim, start, end, epoch, fp; int rec; } s_sf;
+
+static int fan_join_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("FAN_JOIN"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+
+/* Does batch [first, ...) of `prim` continue the stream the previous record holds? */
+static int sf_continues(int indexed, u32 prim, u32 first)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!fan_join_on() || !st || !s_sf.valid || s_d3d.draw_count <= 0) return 0;
+    if (s_sf.indexed != indexed || s_sf.prim != prim || s_sf.end != first) return 0;
+    if (s_sf.rec != (int)s_d3d.draw_count - 1) return 0;
+    if (s_sf.epoch != st->begin_epoch || s_sf.fp != st->shader_program) return 0;
+    if (indexed && st->restart_enable) return 0;
+    const D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+    if (!pv->is_vp || pv->topology != RSX_TOPOLOGY_TRIANGLES) return 0;
+    return 1;
+}
+
+static u32 sf_vidx(const rsx_state* st, int indexed, u32 pos)
+{
+    return indexed ? read_guest_index(st, pos) : pos;
+}
+
+/* Expand batch [first, first+count) of the stream that starts at s_sf.start
+ * into a triangle list (one triangle per vertex, like the hardware) and fetch
+ * it into vp_vb. Returns the vertices written. */
+static u32 upload_sf_cont_vp(const rsx_state* state, int indexed, u32 prim, u32 first, u32 count)
+{
+    extern uint8_t* vm_base;
+    static u32 list[3 * 256 + 16];
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped) return 0;
+    if (!state->vertex_attribs[0].enabled) return 0;
+    if (count == 0 || count > 256) return 0;
+    const u32 start = s_sf.start;
+    u32 n = 0;
+    for (u32 v = first; v < first + count; v++) {
+        if (v < start + 2) continue;          /* no triangle ends at this vertex yet */
+        if (prim == RSX_PRIMITIVE_TRIANGLE_FAN) {
+            list[n++] = sf_vidx(state, indexed, start);
+            list[n++] = sf_vidx(state, indexed, v - 1);
+            list[n++] = sf_vidx(state, indexed, v);
+        } else {                              /* strip: same parity rule as upload_strip_vp */
+            const u32 t = v - start - 2;
+            u32 i1 = v - 1, i2 = v;
+            if (t & 1u) { u32 tmp = i1; i1 = i2; i2 = tmp; }
+            list[n++] = sf_vidx(state, indexed, v - 2);
+            list[n++] = sf_vidx(state, indexed, i1);
+            list[n++] = sf_vidx(state, indexed, i2);
+        }
+    }
+    if (!n) return 0;
+    u32 maxv = (MAX_VP_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) / VP_VERT_STRIDE;
+    if (n > maxv) n = maxv - (maxv % 3u);
+    if (!n) return 0;
+    VPSlot* out = (VPSlot*)((u8*)s_d3d.vp_vb_mapped
+        + (u64)s_d3d.vp_parity * MAX_VP_VERTICES * VP_VERT_STRIDE + s_d3d.vp_vb_offset);
+    if (vf_legacy()) {
+        for (u32 i = 0; i < n; i++) read_vp_vertex(state, list[i], &out[i * 16]);
+    } else {
+        vfa_fetch_list(state, list, n, out);
+    }
+    s_d3d.vp_vb_offset += n * VP_VERT_STRIDE;
+    return n;
+}
+
+/* Append the continuation's triangles to the previous record when they landed
+ * right behind it in vp_vb. */
+static int sf_append(u32 rec, u32 emitted, u32 first, u32 count)
+{
+    if (s_d3d.draw_count <= 0) return 0;
+    D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+    if (pv->vb_byte_offset + pv->vertex_count * VP_VERT_STRIDE != rec) return 0;
+    pv->vertex_count += emitted;
+    s_sf.end = first + count;
+    return 1;
+}
+
+/* After a new record: a FAN (or non-indexed STRIP) batch starts a stream, or
+ * carries one on when it continued the stream but could not be appended. */
+static void sf_anchor(int indexed, u32 prim, u32 first, u32 count, int cont)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st || s_d3d.draw_count <= 0 ||
+        !(prim == RSX_PRIMITIVE_TRIANGLE_FAN || (!indexed && prim == RSX_PRIMITIVE_TRIANGLE_STRIP))) {
+        s_sf.valid = 0; return; }
+    if (!cont) s_sf.start = first;
+    s_sf.valid = 1; s_sf.indexed = indexed; s_sf.prim = prim; s_sf.end = first + count;
+    s_sf.epoch = st->begin_epoch; s_sf.fp = st->shader_program; s_sf.rec = (int)s_d3d.draw_count - 1;
+}
+
+static void sf_log(int indexed, u32 prim, u32 first, u32 count, int how, u32 emitted)
+{
+    static int mode = -1; static u32 want = 0; static int n = 0;
+    if (mode < 0) { const char* e = getenv("FAN_LOG"); mode = 0;
+        if (e && *e) { want = (u32)strtoul(e, NULL, 16); mode = (want == 1u) ? 1 : 2; } }
+    if (!mode) return;
+    const u32 rt = current_rt_off(NULL, NULL, NULL);
+    if (mode == 1 && prim != RSX_PRIMITIVE_TRIANGLE_FAN) return;
+    if (mode == 2 && rt != want) return;
+    if (n >= 600 && (n % 200) != 0) { n++; return; }
+    n++;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    fprintf(stderr, "[FANLOG] f=%llu %s prim=%u first=%u count=%u epoch=%u rt=0x%08X fp=0x%08X %s emitted=%u rec=%d n=%u\n",
+            (unsigned long long)s_d3d.frame_count, indexed ? "indexed" : "arrays", prim, first, count,
+            st ? st->begin_epoch : 0u, rt, st ? st->shader_program : 0u,
+            how == 1 ? "JOINED" : how == 2 ? "cont-newrec" : "new",
+            emitted, s_d3d.draw_count - 1,
+            s_d3d.draw_count > 0 ? s_d3d.draws[s_d3d.draw_count - 1].vertex_count : 0u);
+}
+
