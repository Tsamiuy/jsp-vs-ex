 #ifdef _WIN32
+/* PAD_KEY_<NAME>=<Windows virtual-key code> replaces one keyboard key, e.g.
+ * PAD_KEY_CROSS=0x5A (Z). Names: LSTICK_UP/DOWN/LEFT/RIGHT (the arrows),
+ * DPAD_UP/DOWN/LEFT/RIGHT (I/K/J/L with PAD_KEYS_SPLIT=1), CROSS, CIRCLE,
+ * SQUARE, TRIANGLE, L1, R1, L2, R2, L3, R3, START, SELECT. The launcher
+ * writes them; unset or invalid = the default key. */
+static int pad_key_from_env(const char* name, int def)
+{
+    char var[40];
+    snprintf(var, sizeof var, "PAD_KEY_%s", name);
+    const char* e = getenv(var);
+    long v = e ? strtol(e, NULL, 0) : 0;
+    return (v > 0 && v < 256) ? (int)v : def;
+}
