+/* ZETA_TARGETS (on by default; ZETA_TARGETS=0 = the old shared depth buffer):
+ * colour passes draw against a DepthRT keyed by their zeta offset instead of
+ * the one shared buffer that was cleared on every colour-target switch. RSX
+ * keeps a zeta surface's contents until the game clears it, and J-Stars draws
+ * its water as one quad after the 256x256 reflection pass and the refraction
+ * downsample: with the shared buffer cleared at that switch, the water had no
+ * depth to test against and covered every character (GREEN_SURFACE.md). The
+ * same DepthRTs are then sampled by offset like the shadow maps (the water and
+ * post passes read the scene zeta 0x0E960000 at t15). */
+static int zeta_targets_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("ZETA_TARGETS"); on = e ? atoi(e) : 1; }
+    return on;
+}
+/* The zeta offset a colour op should depth-test against: the surface's zeta
+ * when it has one (SET_SURFACE_FORMAT bits 5..7 = Z16/Z24S8). */
+static u32 rsx_color_zeta(const rsx_state* st)
+{
+    if (!st || !zeta_targets_on() || st->color_target == 0) return 0;
+    if (!((st->surface_format >> 5) & 7u)) return 0;
+    return st->surface_zeta_offset;
+}
 
