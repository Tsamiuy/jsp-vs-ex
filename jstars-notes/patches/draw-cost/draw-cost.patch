From 77fbf02f49081469560ab99a92ac404985b13c20 Mon Sep 17 00:00:00 2001
From: Tsamiuy <332672980+Tsamiuy@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:41:47 +0200
Subject: [PATCH] d3d12: cache per-program FP answers and stop reading back
 upload memory per draw (FP_INFO_CACHE, default on)

---
 libs/video/rsx_d3d12_backend.c | 193 ++++++++++++++++++++++++++++++---
 1 file changed, 180 insertions(+), 13 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 744b7cd..c3a15e7 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -3117,6 +3117,146 @@ static void hlsl_replace_all(char* buf, size_t cap, const char* find, const char
     }
 }
 
+/* FP_INFO_CACHE (default on, FP_INFO_CACHE=0 off): what the draw path needs
+ * from a fragment program, worked out once per program instead of by a walk
+ * of its microcode in every helper on every draw (the code hash, the inline
+ * constants, the gamma and TXP unit masks: up to 7 walks per draw, prepass
+ * and replay included; Hidden Leaf has ~1,300 draws a frame).
+ * Keyed by the program's address; an entry keeps the instruction blocks the
+ * walks visit (every 16-byte instruction, not the inline constants) and is
+ * used only while all of them are byte-identical. The walks decide where the
+ * next instruction is from the current one's words alone, so identical
+ * instruction blocks mean the same walk, the same END and the same answers;
+ * constants may change freely and are re-read every draw at the cached
+ * offsets. A miss runs the original functions. */
+#define FPI_SETS 512u
+#define FPI_WAYS 4u
+typedef struct {
+    const u8* p;                 /* program start (vm_base + offset) */
+    u32 nblk;                    /* instruction blocks */
+    u16* boff; u8* blk; u32 cap; /* their offsets and bytes */
+    u32 hash, size;              /* rsx_fp_code_hash, rsx_fp_program_size */
+    u32 tex_units;               /* rsx_fp_texture_gamma_units with every mask set */
+    u32 txp_units;               /* fp_txp_units */
+    int nk;                      /* rsx_fp_extract_consts's count */
+    u16 koff[FP_MAX_KCONST];     /* its constant slots (0 = counted, no data) */
+} FpInfo;
+static struct { FpInfo e[FPI_SETS][FPI_WAYS]; u8 rr[FPI_SETS]; } *s_fpi;
+static u32 s_fpi_hit, s_fpi_miss;
+static int fp_info_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("FP_INFO_CACHE"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+static u32 fpi_txp_walk(const u8* uc)   /* fp_txp_units' loop, on a pointer */
+{
+    u32 units = 0;
+    for (u32 o = 0; o + 16 <= FP_MAX_BYTES;) {
+        const u32 w0 = rsx_fp_read_word(uc + o), w1 = rsx_fp_read_word(uc + o + 4);
+        const u32 w2 = rsx_fp_read_word(uc + o + 8), w3 = rsx_fp_read_word(uc + o + 12);
+        if (!(w2 & (1u << 31)) && ((w0 >> 24) & 63u) == 0x18u)      /* TXP */
+            units |= 1u << ((w0 >> 17) & 15u);
+        o += 16;
+        if (!(w2 & (1u << 31)) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2))
+            o += 16;                                                   /* inline constant */
+        if (w0 & 1u) break;                                            /* END */
+    }
+    return units;
+}
+/* The program at fp_addr, or NULL (cache off, unresolvable, out of memory). */
+static const FpInfo* fp_info(u32 fp_addr)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!fp_info_on() || !fp_addr || !vm_base) return NULL;
+    const u32 off = cellGcmResolveLocated((fp_addr & 0x3u) == 1, fp_addr & ~0x3u);
+    if (off == 0xFFFFFFFFu) return NULL;
+    const u8* p = vm_base + off;
+    if (!s_fpi && !(s_fpi = calloc(1, sizeof *s_fpi))) return NULL;
+    const u32 set = (u32)((((uintptr_t)p) >> 4) * 2654435761u >> 7) & (FPI_SETS - 1u);
+    FpInfo* e = s_fpi->e[set];
+    for (u32 w = 0; w < FPI_WAYS; w++) {
+        FpInfo* c = &e[w];
+        if (c->p != p) continue;
+        u32 i = 0;
+        for (; i < c->nblk; i++)
+            if (memcmp(p + c->boff[i], c->blk + (size_t)i * 16u, 16) != 0) break;
+        if (i == c->nblk) { s_fpi_hit++; return c; }
+    }
+    s_fpi_miss++;
+    /* Miss: the walk every helper makes (rsx_fp_code_hash's), recording the
+     * instruction blocks and the constant slots as rsx_fp_extract_consts
+     * counts them; then the original functions for the answers. */
+    static u16 boff[FP_MAX_BYTES / 16]; u32 n = 0;
+    static u16 koff[FP_MAX_KCONST]; int nk = 0;
+    for (u32 o = 0; o + 16 <= FP_MAX_BYTES;) {
+        const u32 w0 = rsx_fp_read_word(p + o), w1 = rsx_fp_read_word(p + o + 4);
+        const u32 w2 = rsx_fp_read_word(p + o + 8), w3 = rsx_fp_read_word(p + o + 12);
+        boff[n++] = (u16)o;
+        o += 16;
+        if (!(w2 & (1u << 31)) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2)) {
+            if (nk < FP_MAX_KCONST) koff[nk++] = (o + 16 <= FP_MAX_BYTES) ? (u16)o : 0;
+            o += 16;
+        }
+        if (w0 & 1u) break;
+    }
+    FpInfo* v = &e[s_fpi->rr[set]++ % FPI_WAYS];
+    if (v->cap < n) {
+        u16* nb = (u16*)realloc(v->boff, (size_t)n * sizeof(u16));
+        if (nb) v->boff = nb;
+        u8* nk2 = (u8*)realloc(v->blk, (size_t)n * 16u);
+        if (nk2) v->blk = nk2;
+        if (!nb || !nk2) { v->p = NULL; v->nblk = 0; return NULL; }
+        v->cap = n;
+    }
+    for (u32 i = 0; i < n; i++) memcpy(v->blk + (size_t)i * 16u, p + boff[i], 16);
+    memcpy(v->boff, boff, (size_t)n * sizeof(u16));
+    v->nblk = n;
+    v->hash = rsx_fp_code_hash(p, FP_MAX_BYTES);
+    v->size = rsx_fp_program_size(p, FP_MAX_BYTES);
+    { u8 all[16]; memset(all, 0xFF, sizeof all);
+      v->tex_units = rsx_fp_texture_gamma_units(p, FP_MAX_BYTES, all); }
+    v->txp_units = fpi_txp_walk(p);
+    v->nk = nk;
+    memcpy(v->koff, koff, (size_t)nk * sizeof(u16));
+    v->p = p;
+    return v;
+}
+/* rsx_fp_extract_consts for a cached program: the same words, re-read now. */
+static int fpi_consts(const FpInfo* fi, float* out, int max_out)
+{
+    extern u32 rsx_fp_sanitize_constant_word(u32 w);
+    int n = 0;
+    for (int k = 0; k < fi->nk; k++) {
+        if (fi->koff[k] && n < max_out)
+            for (int i = 0; i < 4; i++) {
+                u32 cw = rsx_fp_sanitize_constant_word(rsx_fp_read_word(fi->p + fi->koff[k] + i * 4));
+                memcpy(&out[n * 4 + i], &cw, 4);
+            }
+        if (n < max_out) n++;
+    }
+    return n;
+}
+
+/* The per-unit texture masks the PSO keys need (gamma, expand) depend only on
+ * the unit's four registers, but were rebuilt for every bound unit of every
+ * draw, in the prepass and again in the replay. A small cache by those four
+ * values gives the same mask (FP_INFO_CACHE=0 off). */
+typedef struct { u32 fmt, ctrl1, filt, addr; u8 mask, valid; } TexMaskMemo;
+static u8 tex_mask_memo(TexMaskMemo* tab, u8 (*fn)(u32, u32, u32, u32),
+                        u32 fmt, u32 ctrl1, u32 filt, u32 addr)
+{
+    if (!fp_info_on()) return fn(fmt, ctrl1, filt, addr);
+    TexMaskMemo* m = &tab[((fmt * 2654435761u) ^ (ctrl1 * 40503u) ^ (filt >> 7) ^ (addr * 2246822519u)) & 255u];
+    if (m->valid && m->fmt == fmt && m->ctrl1 == ctrl1 && m->filt == filt && m->addr == addr)
+        return m->mask;
+    m->mask = fn(fmt, ctrl1, filt, addr);
+    m->fmt = fmt; m->ctrl1 = ctrl1; m->filt = filt; m->addr = addr; m->valid = 1;
+    return m->mask;
+}
+static TexMaskMemo s_gamma_memo[256], s_expand_memo[256];
+
 /* Which of a draw's texture units are cube textures, as a 4-bit mask. */
 static u32 dr_cube_mask(const D3D12DrawRecord* dr)
 {
@@ -3151,14 +3291,17 @@ static u64 dr_gamma_key(const D3D12DrawRecord* dr)
     u8 m[16] = {0}; int any = 0;
     for (int u = 0; u < RSX_TEX_UNITS && u < 16; u++)
         if (dr->tex[u].set) {
-            m[u] = rsx_texture_gamma_mask(dr->tex[u].fmt, dr->tex[u].ctrl1,
-                                          dr->tex[u].filt, dr->tex[u].addr);
+            m[u] = tex_mask_memo(s_gamma_memo, rsx_texture_gamma_mask, dr->tex[u].fmt,
+                                 dr->tex[u].ctrl1, dr->tex[u].filt, dr->tex[u].addr);
             if (m[u]) any = 1;
         }
     if (!any) return 0;
     u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
     if (foff == 0xFFFFFFFFu) return 0;
-    const u32 used = rsx_fp_texture_gamma_units(vm_base + foff, FP_MAX_BYTES, m);
+    const FpInfo* fi = fp_info(dr->fp_addr);
+    u32 used = 0;
+    if (fi) { for (int u = 0; u < 16; u++) if (((fi->tex_units >> u) & 1u) && m[u]) used |= 1u << u; }
+    else used = rsx_fp_texture_gamma_units(vm_base + foff, FP_MAX_BYTES, m);
     u64 k = 0;
     for (int u = 0; u < 16; u++)
         if (used & (1u << u)) k |= (u64)(m[u] & 0xFu) << (4 * u);
@@ -3182,8 +3325,8 @@ static u64 dr_expand_key(const D3D12DrawRecord* dr, u8 out[16])
     if (!dr->fp_addr || !vm_base) return 0;
     for (int u = 0; u < RSX_TEX_UNITS && u < 16; u++)
         if (dr->tex[u].set)
-            out[u] = rsx_texture_expand_mask(dr->tex[u].fmt, dr->tex[u].ctrl1,
-                                             dr->tex[u].filt, dr->tex[u].addr);
+            out[u] = tex_mask_memo(s_expand_memo, rsx_texture_expand_mask, dr->tex[u].fmt,
+                                   dr->tex[u].ctrl1, dr->tex[u].filt, dr->tex[u].addr);
     if (!on) return 0;
     u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
     if (foff == 0xFFFFFFFFu) return 0;
@@ -3246,6 +3389,7 @@ static u32 fp_txp_units(u32 fp_addr)
     extern uint8_t* vm_base;
     extern u32 cellGcmResolveLocated(int local, u32 offset);
     if (!fp_addr || !vm_base) return 0;
+    { const FpInfo* fi = fp_info(fp_addr); if (fi) return fi->txp_units; }
     const u32 off = cellGcmResolveLocated((fp_addr & 0x3u) == 1, fp_addr & ~0x3u);
     if (off == 0xFFFFFFFFu) return 0;
     const u8* uc = vm_base + off;
@@ -3533,7 +3677,9 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
             for (u32 i = 0; i < usz; i++) { uhash ^= up[i]; uhash *= 16777619u; }
         } else {
             /* Memoised rsx_fp_code_hash (same value), SHADER_HASH_MEMO=0 off. */
-            uhash = rsx_fp_code_hash_memo(vm_base + off, FP_MAX_BYTES, &usz);
+            const FpInfo* fi = fp_info(fp_addr);
+            if (fi) { uhash = fi->hash; usz = fi->size; }
+            else uhash = rsx_fp_code_hash_memo(vm_base + off, FP_MAX_BYTES, &usz);
             if (usz == 0) usz = 64;
         }
         s_perf_pso_hashbytes += (int)usz;
@@ -5222,7 +5368,9 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
          * has no fixed alpha test; guest FPs discard on it dynamically
          * (wave's colour wheel is a disc via alpha test -- without it the
          * palette drew as an opaque square). */
-        if (dr && !getenv("NO_ALPHATEST")) {
+        static int no_at = -1;   /* per draw: read once (NO_ALPHATEST) */
+        if (no_at < 0) no_at = getenv("NO_ALPHATEST") ? 1 : 0;
+        if (dr && !no_at) {
             { static int _at = 0;
               if (((dr->alpha_ctl >> 16) & 1u) && _at++ < 4)
                   printf("[ALPHATEST] enable func=%u ref=%u\n",
@@ -5246,7 +5394,16 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
             u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1,
                                              dr->fp_addr & ~0x3u);
             if (vm_base && foff != 0xFFFFFFFFu) {
-                rsx_fp_extract_consts(vm_base + foff, FP_MAX_BYTES, &ts[20], FP_MAX_KCONST);
+                /* Into a cached buffer first: ts is upload-heap (write-combined)
+                 * memory, and the TONEMAP check below read the constants back
+                 * from it on every draw, an uncached read. FP_INFO_CACHE: the
+                 * constant slots come from the program cache, no walk. */
+                static float kbuf[FP_MAX_KCONST * 4];
+                static int kdbg = -1;
+                if (kdbg < 0) { const char* e = getenv("FP_KDBG"); kdbg = (e && atoi(e)) ? 1 : 0; }
+                const FpInfo* fi = kdbg ? NULL : fp_info(dr->fp_addr);
+                const int nk = fi ? fpi_consts(fi, kbuf, FP_MAX_KCONST)
+                                  : rsx_fp_extract_consts(vm_base + foff, FP_MAX_BYTES, kbuf, FP_MAX_KCONST);
                 /* TONEMAP_EXPOSURE=<v>: A/B for the auto-exposure finding
                  * (jstars-notes COLOR_EXPOSURE.md). J-Stars' tone-map (fp
                  * 0x0FC9FC01: c0 = luminance weights 0.2125/0.7154/0.0721,
@@ -5259,7 +5416,7 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
                  * the live value so the readback can be seen working. */
                 { static float ex = -1.0f; static int seen = 0; static float last_w = -1.0f;
                   if (ex < 0.0f) { const char* e = getenv("TONEMAP_EXPOSURE"); ex = e ? (float)atof(e) : 0.0f; }
-                  float* k = &ts[20];
+                  float* k = kbuf;
                   /* The PPU builds c1 = (63.75, max(La, 1e-4), clamp(La + 0.5, 0, 63.75),
                    * key / max(La, 1e-4)) with La the adapted log-average luminance of
                    * the 20x11 target and key 0.72 (func_0055D1F8 / func_0055C5A4 in
@@ -5268,7 +5425,7 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
                    * required k[5] < 0.001 and went quiet exactly when the loop
                    * started working. Logged on the first draws, every 120th
                    * matching draw, and whenever E moves by more than 2%. */
-                  if (k[0] > 0.21f && k[0] < 0.22f && k[1] > 0.71f && k[1] < 0.72f &&
+                  if (nk >= 2 && k[0] > 0.21f && k[0] < 0.22f && k[1] > 0.71f && k[1] < 0.72f &&
                       k[4] == 63.75f && k[5] >= 0.0001f && k[5] <= 63.75f) {
                       float dw = k[7] - last_w; if (dw < 0.0f) dw = -dw;
                       if (seen < 6 || (seen % 120) == 0 || dw > 0.02f * last_w)
@@ -5277,6 +5434,7 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
                       last_w = k[7];
                       seen++;
                       if (ex > 0.0f) k[7] = ex; } }
+                memcpy(&ts[20], kbuf, (size_t)nk * 16u);
             }
             /* FPK_DBG=1: the fragment constants as the shader will see them.
              * A program whose only output is fp_k[0].xxxx renders black if
@@ -5396,10 +5554,15 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
     int uses_c03 = (vs_idx >= 0 && vs_idx < s_d3d.vp_vs_n)
                        ? s_d3d.vp_vs[vs_idx].uses_c03 : s_d3d.vp_uses_c03;
     float* c = (float*)dst;
-    float c00 = c[0];
+    /* c[0] as just copied, read from the cached source: dst is upload-heap
+     * (write-combined) memory, and reading it back was an uncached read on
+     * every draw. The switches are read once. */
+    float c00 = st->vertex_constants[0][0];
     int garbage = !(c00 > 0.0f && c00 < 8.0f);
-    if (getenv("VP_NOFIXPROJ")) garbage = 0;
-    if ((garbage && uses_c03) || getenv("VP_FIXPROJ")) {
+    static int nofix = -1, fix = -1;
+    if (nofix < 0) { nofix = getenv("VP_NOFIXPROJ") ? 1 : 0; fix = getenv("VP_FIXPROJ") ? 1 : 0; }
+    if (nofix) garbage = 0;
+    if ((garbage && uses_c03) || fix) {
         { static int _fb = 0; if (_fb++ < 6)
             printf("[VPFB] fallback proj on draw slot %u (c00=%g vs_idx=%d)\n",
                    slot, c00, vs_idx); }
@@ -7716,6 +7879,10 @@ static void render_frame(void)
             fprintf(stderr, "[PERF4] batch intervals: <20ms %u | 20-37 %u | 37-54 %u | 54-70 %u | 70-87 %u | >87 %u%c",
                     s_ivl[0], s_ivl[1], s_ivl[2], s_ivl[3], s_ivl[4], s_ivl[5], 10);
             memset(s_ivl, 0, sizeof s_ivl);
+            if (fp_info_on()) {   /* FP_INFO_CACHE, per [PERF] window */
+                fprintf(stderr, "[FPINFO] program cache: %u hits, %u misses%c", s_fpi_hit, s_fpi_miss, 10);
+                s_fpi_hit = s_fpi_miss = 0;
+            }
             if (s_vpull.ring_mapped) {   /* VPULL, per [PERF] window */
                 fprintf(stderr, "[VPULL] records %u batches %u | indices %llu | copied %.1f MB"
                                 " | CPU path: layout %u sparse %u | dropped %u%c",
