diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 7e5db75..567ccb7 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -80,6 +80,40 @@ static u32  s_flip_status = CELL_GCM_FLIP_STATUS_DONE;
  * while it's blocked in the FIFO-wrap recycle callback -- would show a
  * clear+few-draws frame as a visible flicker). */
 static volatile u32 s_flip_request_count = 0;
+/* GCM_FLIP_AT_WORD=1: report a flip as done only once the FIFO walker has
+ * reached that flip's marker. s_flip_ppu_requests counts the in-FIFO flip
+ * requests the guest made (each sets the status to WAITING);
+ * s_flip_request_count counts the markers the walker decoded. Default
+ * behaviour completes the flip on the 60 Hz beat whatever the walker has
+ * done, so a title that paces itself on flip status runs ahead of the
+ * walker: J-Stars was two flips ahead, and its SPU particle job had already
+ * recycled the vertex buffers the walker then drew (all skill effects
+ * missing; jstars-notes VFX.md). Softer than GCM_FLIP_NEEDS_FIFO, which waits
+ * for get == put. Titles that flip outside the FIFO are not affected (their
+ * request counter stays 0). */
+static volatile u32 s_flip_ppu_requests = 0;
+static int gcm_flip_at_word_blocked(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_FLIP_AT_WORD"); on = e ? atoi(e) : 0; }
+    if (!on || (s32)(s_flip_ppu_requests - s_flip_request_count) <= 0) return 0;
+    /* A marker the walker never decodes (a resync past it) must not stop
+     * flips for good: after GCM_FLIP_AT_WORD_MS (default 100) of waiting,
+     * count the owed markers as reached. */
+    { extern unsigned long long ps3_ms_now(void);
+      static unsigned long long since = 0; static u32 owed_at = 0; static int lim = -1;
+      if (lim < 0) { const char* e = getenv("GCM_FLIP_AT_WORD_MS"); lim = e ? atoi(e) : 100; }
+      const unsigned long long now = ps3_ms_now();
+      if (owed_at != s_flip_ppu_requests) { owed_at = s_flip_ppu_requests; since = now; }
+      else if (now - since >= (unsigned long long)lim) {
+          static int n = 0;
+          if (n++ < 8) fprintf(stderr, "[cellGcmSys] GCM_FLIP_AT_WORD: walker owed %d flip marker(s) for %d ms, releasing%c",
+                               (int)(s_flip_ppu_requests - s_flip_request_count), lim, 10);
+          s_flip_request_count = s_flip_ppu_requests;
+          return 0;
+      } }
+    return 1;
+}
 
 u32 cellGcm_flip_request_count(void)
 {
@@ -617,7 +651,8 @@ void cellGcmSetWaitFlip(void)
 #ifdef _WIN32
     __declspec(dllimport) void __stdcall Sleep(unsigned long);
 #endif  /* elsewhere: runtime/platform/win32_compat.h */
-    for (int i = 0; i < 64 && s_flip_status == CELL_GCM_FLIP_STATUS_WAITING; i++)
+    for (int i = 0; i < 64 && (s_flip_status == CELL_GCM_FLIP_STATUS_WAITING ||
+                                gcm_flip_at_word_blocked()); i++)
         Sleep(1);
     s_flip_status = CELL_GCM_FLIP_STATUS_DONE;
 }
@@ -707,6 +742,7 @@ void cellGcm_request_tick(void)
           GCM_PENDING_SET(s_fifo_getoff == put ? 3 : 1);
           return;
       } }
+    if (gcm_flip_at_word_blocked()) { GCM_PENDING_SET(1); return; }
     GCM_PENDING_SET(3);
 }
 
@@ -764,7 +800,7 @@ void cellGcmTickVBlank(void) { s_vblank_count++; GCM_PENDING_SET(1); }
  * the callback IS the flip interrupt -- no flip, no callback. */
 void cellGcmTickFlip(void)
 {
-    if (s_flip_status == CELL_GCM_FLIP_STATUS_WAITING)
+    if (s_flip_status == CELL_GCM_FLIP_STATUS_WAITING && !gcm_flip_at_word_blocked())
         GCM_PENDING_SET(2);
 }
 
@@ -2479,6 +2515,8 @@ static s32 gcm_flip_request(u32 bufferId, int in_fifo)
         gcm_set_current_display_buffer(bufferId);
         s_flip_pending = 1;   /* ticker: present BEFORE the next drain */
         s_flip_request_count++;
+    } else {
+        s_flip_ppu_requests++;   /* GCM_FLIP_AT_WORD: the walker owes this marker */
     }
     /* Flip requested but not yet shown: a subsequent cellGcmSetWaitFlip blocks
      * until the present thread's cellGcmTickFlip marks it done (vsync). */
