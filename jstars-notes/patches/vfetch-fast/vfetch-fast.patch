+u32 rsx_fetch_src_vertex(const rsx_fetch_src* src, u32 o)
+{
+    u32 s;
+    switch (src->topo) {
+    case RSX_FETCH_QUADS: {
+        static const u8 q6[6] = {0,1,2, 0,2,3};
+        s = (o / 6u) * 4u + q6[o % 6u];
+        break; }
+    case RSX_FETCH_STRIP:
+    case RSX_FETCH_STRIP_SWAP:
+    case RSX_FETCH_FAN: {
+        const u32 t = o / 3u, j = o % 3u;
+        if (j == 0)      s = (src->topo == RSX_FETCH_FAN) ? 0u : t;
+        else if (src->topo == RSX_FETCH_STRIP_SWAP && (t & 1u))
+                         s = (j == 1) ? t + 2u : t + 1u;
+        else             s = t + j;
+        break; }
+    default:
+        s = o;
+        break;
+    }
+    const u32 k = src->first + s;
+    if (src->isize == 2) {
+        const u8* q = src->ib + (u64)k * 2;
+        return ((u32)q[0] << 8) | q[1];
+    }
+    if (src->isize == 4) {
+        const u8* q = src->ib + (u64)k * 4;
+        return ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3];
+    }
+    return k;
+}
+
+static inline u32 rd_be16(const u8* p) { return ((u32)p[0] << 8) | p[1]; }
+
+/* Copy n float4 slots out: non-temporal 16-byte stores when the target is
+ * aligned (they stream into write-combined memory without reading it or
+ * polluting the cache), plain memcpy otherwise. */
+#if defined(__SSE2__) || defined(_M_X64) || defined(_M_AMD64)
+#include <emmintrin.h>
+static void rsx_fetch_store(float (*dst)[4], const float* src, u32 n, int aligned)
+{
+    if (!aligned) { memcpy(dst, src, (size_t)n * 16u); return; }
+    float* d = &dst[0][0];
+    for (u32 i = 0; i < n; i++) _mm_stream_ps(d + i * 4, _mm_load_ps(src + i * 4));
+}
+static void rsx_fetch_store_fence(void) { _mm_sfence(); }
+#else
+static void rsx_fetch_store(float (*dst)[4], const float* src, u32 n, int aligned)
+{
+    (void)aligned; memcpy(dst, src, (size_t)n * 16u);
+}
+static void rsx_fetch_store_fence(void) {}
+#endif
