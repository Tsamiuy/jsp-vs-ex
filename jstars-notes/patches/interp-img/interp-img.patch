+/* SPU_INTERP_IMG=<id>: run that image's jobs on the interpreter from LS 0 to
+ * the planted return address, never entering its lifted functions. The beam
+ * job (image 17) PUTs all-zero quads when lifted (jstars-notes VFX.md); if the
+ * interpreted run PUTs real vertices, the lift is wrong. */
+extern SPU_THREAD_LOCAL int g_spu_interp_only;
+static void spurs_job_interp_entry(spu_context* ctx)
+{
+    g_spu_interp_only = 1;
+    spu_interp_run_until(ctx, 0, 0x3FF00u);          /* SPU_JOB_RETURN_LS */
+    g_spu_interp_only = 0;
+}
