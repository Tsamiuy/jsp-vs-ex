+    int tex_hit = 0;
+    { static int init = 0; static u32 tw[8]; static int nt = 0, maxn = 12, nprinted = 0;
+      if (!init) { init = 1; const char* e = getenv("VP_ATTRS_TEX");
+          while (e && *e && nt < 8) { char* end; tw[nt++] = (u32)strtoul(e, &end, 16);
+              e = (*end == ',') ? end + 1 : NULL; }
+          const char* n = getenv("VP_ATTRS_N"); if (n) maxn = atoi(n); }
+      if (nt) {
