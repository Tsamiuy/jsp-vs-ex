+              fprintf(stderr, "[VPATTR]   a%d v%u bytes:", i, v);
+              for (u32 b = 0; b < 16 && b < a->stride; b++) fprintf(stderr, " %02X", q[b]);
+              fprintf(stderr, "%c", 10);
+          } }
     }
