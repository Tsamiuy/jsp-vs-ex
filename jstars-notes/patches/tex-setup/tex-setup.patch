+/* Same-batch memo in front of vp_upload_tex_slot_impl. A match frame binds
+ * ~9.4k texture units per batch, almost all of them a texture an earlier draw
+ * of the same batch already resolved; the memo answers those without the
+ * 96-slot scan. It returns only what the scan itself would: the remembered
+ * slot is re-checked against the same key fields and must still be marked
+ * used in this batch, and a key can only ever live in one slot (_impl reuses
+ * a matching slot in place and takes a free one only when nothing matches).
+ * TEXCACHE_LEGACY=1 turns the memo off; TEX_BUDGET disables it too, since
+ * the budget counts every call. */
+static int tex_verify_frame(void);
+static int vp_upload_tex_slot(u32 off, u32 w, u32 h, u32 fmt, int cube, u32 mips)
+{
+    static int legacy = -1;
+    if (legacy < 0) legacy = (getenv("TEXCACHE_LEGACY") || getenv("TEX_BUDGET")) ? 1 : 0;
+    const int perf = perf_on();
+    const double t0 = perf ? perf_now() : 0.0;
+    enum { MEMO_N = 4096 };
+    static struct { u32 gen, key, w, h, fmt; s32 cube, slot; } memo[MEMO_N];
+    u32 hh = (off * 2654435761u) ^ (w * 40503u) ^ (h << 7) ^ (fmt << 21) ^ (u32)cube;
+    hh = (hh ^ (hh >> 15)) & (MEMO_N - 1);
+    int r;
+    if (!legacy && memo[hh].gen == s_tex_gen && memo[hh].key == off && memo[hh].w == w &&
+        memo[hh].h == h && memo[hh].fmt == fmt && memo[hh].cube == cube) {
+        const VPTexSlot* c = &s_d3d.vp_tex[memo[hh].slot];
+        if (c->res && c->used && c->key == off && c->w == w && c->h == h &&
+            c->fmt == fmt && c->cube == cube) {
+            if (perf) { s_txs_n[TXO_MEMO]++; s_txs_t[TXO_MEMO] += perf_now() - t0; }
+            return memo[hh].slot;
+        }
+    }
+    r = vp_upload_tex_slot_impl(off, w, h, fmt, cube, mips);
+    if (!legacy && r >= 0) {
+        memo[hh].gen = s_tex_gen; memo[hh].key = off; memo[hh].w = w; memo[hh].h = h;
+        memo[hh].fmt = fmt; memo[hh].cube = cube; memo[hh].slot = r;
+    }
+    if (perf) { s_txs_n[s_txo]++; s_txs_t[s_txo] += perf_now() - t0; }
+    return r;
+}
+
+static int tex_verify_frame(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("TEX_VERIFY"); v = (e && !strcmp(e, "frame")) ? 1 : 0; }
+    return v;
+}
