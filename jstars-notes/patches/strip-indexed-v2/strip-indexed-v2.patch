+/* STRIP_INDEXED=2: the present thread only reads the guest indices (a
+ * restart becomes 0xFFFFFFFF) and reserves `count` vertices and `count`
+ * indices; a worker writes the indices and fetches the distinct vertices.
+ * The first version did the dedup here, and the present thread is the
+ * bottleneck: vertices fell to a third but present-thread vtx rose ~40%
+ * (strips\*, FINDINGS §42). Reserved but unused vertex slots are never
+ * indexed. Same return contract as upload_strip_vp_native_ix. */
+static u32 upload_strip_vp_native_ix2(const rsx_state* state, u32 first, u32 count, u32 t0)
+{
+    extern uint8_t* vm_base;
+    s_six_added = 0; s_six_start = s_six.off;
+    s_req_verts += count; s_req_draws++;
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped || !s_six.mapped || !count) return 0;
+    if (!state->vertex_attribs[0].enabled) return 0;
+    const u32 maxv = (MAX_VP_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) / VP_VERT_STRIDE;
+    const u32 ixroom = SIX_CAP - s_six.off;
+    if (count > maxv || count > ixroom) {
+        s_drop_draws++;
+        count = maxv < ixroom ? maxv : ixroom;
+        if (!count) return 0;
+    }
+    const int idx16 = (((state->index_array_dma >> 4) & 0xF) == 1);
+    const int restart = state->restart_enable && !(idx16 && state->restart_index > 0xFFFFu);
+    const u32 ridx = state->restart_index;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u8* ib = vm_base + cellGcmResolveLocated((state->index_array_dma & 0xF) == 0,
+                                                   state->index_array_offset);
+    VfaJob jl, *j = &jl;
+    u32* raw;
+    static u32* s_raw = NULL; static u32 s_raw_cap = 0;
+    const int async = vfa_enabled() && count <= s_vfa.arena_cap;
+    if (async) {
+        if (s_vfa.posted >= VFA_JOBS || s_vfa.arena_used + count > s_vfa.arena_cap) vfa_sync();
+        j = &s_vfa.jobs[s_vfa.posted];
+        j->list_off = s_vfa.arena_used;
+        raw = s_vfa.arena + s_vfa.arena_used;
+    } else {
+        if (count > s_raw_cap) {
+            u32* nr = (u32*)realloc(s_raw, (size_t)count * sizeof(u32));
+            if (!nr) return 0;
+            s_raw = nr; s_raw_cap = count;
+        }
+        raw = s_raw;
+    }
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        raw[k] = (restart && v == ridx) ? 0xFFFFFFFFu : v;
+    }
+    /* One BEGIN/END stream cannot change its vertex arrays between index
+     * batches, so a call continuing the record (t0 > 0, same BEGIN/END)
+     * reuses the plan: rsx_fetch_plan_init hashes the whole vertex program
+     * for its input mask, once per ~256-index call otherwise.
+     * STRIP_IX2_PLAN_REUSE=0 builds it every call. */
+    static rsx_fetch_plan s_plan; static int s_plan_ok = 0; static u32 s_plan_epoch = 0;
+    static int reuse = -1;
+    if (reuse < 0) { const char* e = getenv("STRIP_IX2_PLAN_REUSE"); reuse = (e && *e == '0') ? 0 : 1; }
+    if (reuse && t0 > 0 && s_plan_ok && s_plan_epoch == state->begin_epoch) {
+        j->plan = s_plan;
+    } else {
+        rsx_fetch_plan_init(state, vf_input_mask(state), &j->plan);
+        s_plan = j->plan; s_plan_ok = 1; s_plan_epoch = state->begin_epoch;
+    }
+    j->n = count; j->kind = 1; j->loc_base = t0;
+    j->ixo = s_six.mapped + (u64)s_d3d.vp_parity * SIX_CAP + s_six.off;
+    j->out = (VPSlot*)((u8*)s_d3d.vp_vb_mapped
+        + (u64)s_d3d.vp_parity * MAX_VP_VERTICES * VP_VERT_STRIDE + s_d3d.vp_vb_offset);
+    if (async) {
+        s_vfa.arena_used += count;
+        MemoryBarrier();
+        InterlockedIncrement(&s_vfa.posted);
+        ReleaseSemaphore(s_vfa.sem, 1, NULL);
+    } else {
+        vfa_run_strip_ix(j, raw);
+    }
+    s_six_added = count;
+    s_six.off += count;
+    s_d3d.vp_vb_offset += count * VP_VERT_STRIDE;
+    return count;
+}
