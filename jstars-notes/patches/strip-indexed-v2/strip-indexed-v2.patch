+/* STRIP_INDEXED=2 job body, on a worker (or inline). Distinct guest vertices
+ * of THIS call are fetched once (a per-call map; the first version's map
+ * spanned the whole record, but it ran on the present thread). */
+static void vfa_run_strip_ix(const VfaJob* j, const u32* raw)
+{
+    static __declspec(thread) u32 *t_key, *t_val, *t_gen, *t_vl, t_cap, t_g;
+    const u32 n = j->n;
+    u32 msz = 64; while (msz < n * 2u) msz <<= 1;           /* load <= 50% */
+    if (msz > t_cap) {
+        free(t_key); free(t_val); free(t_gen); free(t_vl);
+        t_key = (u32*)malloc(msz * sizeof(u32)); t_val = (u32*)malloc(msz * sizeof(u32));
+        t_gen = (u32*)calloc(msz, sizeof(u32)); t_vl = (u32*)malloc(msz * sizeof(u32));
+        t_cap = (t_key && t_val && t_gen && t_vl) ? msz : 0; t_g = 0;
+    }
+    if (!t_cap) {                                           /* no memory: no dedup */
+        u32 nv = 0;
+        for (u32 i = 0; i < n; i++) j->ixo[i] = (raw[i] == 0xFFFFFFFFu) ? 0xFFFFFFFFu : j->loc_base + i;
+        (void)nv;
+        /* fetch every slot; cut slots fetch vertex 0 into an unused slot */
+        static __declspec(thread) u32* t_tmp; static __declspec(thread) u32 t_tmpcap;
+        if (n > t_tmpcap) { free(t_tmp); t_tmp = (u32*)malloc(n * sizeof(u32)); t_tmpcap = t_tmp ? n : 0; }
+        if (!t_tmp) return;
+        for (u32 i = 0; i < n; i++) t_tmp[i] = (raw[i] == 0xFFFFFFFFu) ? 0u : raw[i];
+        rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, t_tmp };
+        rsx_fetch_plan_range(&j->plan, &src, 0, n, (float (*)[4])j->out);
+        return;
+    }
+    if (++t_g == 0) { memset(t_gen, 0, t_cap * sizeof(u32)); t_g = 1; }
+    const u32 mask = t_cap - 1;
+    u32 nv = 0;
+    for (u32 i = 0; i < n; i++) {
+        const u32 v = raw[i];
+        if (v == 0xFFFFFFFFu) { j->ixo[i] = 0xFFFFFFFFu; continue; }
+        u32 s = (v * 2654435761u) & mask, loc;
+        for (;;) {
+            if (t_gen[s] != t_g) { t_gen[s] = t_g; t_key[s] = v; t_val[s] = loc = nv; t_vl[nv++] = v; break; }
+            if (t_key[s] == v) { loc = t_val[s]; break; }
+            s = (s + 1) & mask;
+        }
+        j->ixo[i] = j->loc_base + loc;
+    }
+    if (nv) {
+        rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, t_vl };
+        rsx_fetch_plan_range(&j->plan, &src, 0, nv, (float (*)[4])j->out);
+    }
+}
+
+static void vfa_run(VfaJob* j)
+{
+    if (j->kind == 1) { vfa_run_strip_ix(j, s_vfa.arena + j->list_off); return; }
+    rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, s_vfa.arena + j->list_off };
+    rsx_fetch_plan_range(&j->plan, &src, 0, j->n, (float (*)[4])j->out);
+}
