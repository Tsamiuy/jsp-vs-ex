+/* Depth-only passes (SHADOW_PASSES, on by default; SHADOW_PASSES=0 = old
+ * behaviour). SET_SURFACE_COLOR_TARGET = NONE with a zeta surface is a
+ * depth-only pass: J-Stars renders its two shadow cascades that way (2048x1024
+ * at 0x0CE40000, 1024x1024 at 0x0CA30000) and its materials then sample those
+ * zeta offsets as textures. Such a pass is recorded with rt_off = ZT_TAG | the
+ * zeta offset: non-zero, so every "rt_off == 0 means the display" test still
+ * holds, and tagged, so it never names a colour RT. It draws into a DepthRT
+ * (one D3D depth resource per zeta offset) and a material that binds that
+ * offset samples the depth resource (see dr_z_info). ZPASS_DBG=1 logs it. */
+#define ZT_TAG 0x80000000u
+static int zpass_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SHADOW_PASSES"); on = e ? atoi(e) : 1; }
+    return on;
+}
+static int zpass_dbg(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("ZPASS_DBG") ? 1 : 0;
+    return on;
+}
+static int dr_is_zonly(const D3D12DrawRecord* dr) { return (dr->rt_off & ZT_TAG) != 0; }
+static int dt_find(u32 off);
