+/* Rewrite the samples of every bitcast unit into _rsx_zargbN(uv) and define
+ * those helpers ahead of main(). Each rebuilds the zeta texel's guest bytes
+ * from the R24 depth SRV (nearest texel, clamped: the bytes of neighbouring
+ * texels must not be blended) and applies the unit's CONTROL1 crossbar exactly
+ * as rsx_remap_to_d3d does for an uploaded A8R8G8B8 image, whose host
+ * components x,y,z,w hold guest R,G,B,A. Returns 0 if the HLSL does not fit. */
+static int zbitcast_rewrite(char* hlsl, size_t cap, const DrZInfo* zi)
+{
+    char helpers[8192]; size_t hl = 0;
+    helpers[0] = 0;
+    for (int u = 0; u < 16; u++) {
+        if (!(zi->bitcast_mask & (1u << u))) continue;
+        u8 sel[4];
+        rsx_texture_component_remap(zi->remap[u], 0x85u, sel);   /* A,R,G,B order */
+        char lane[4][8];
+        for (int i = 0; i < 4; i++) {
+            if (sel[i] == RSX_REMAP_ZERO)     snprintf(lane[i], sizeof lane[i], "0.0");
+            else if (sel[i] == RSX_REMAP_ONE) snprintf(lane[i], sizeof lane[i], "1.0");
+            else snprintf(lane[i], sizeof lane[i], "_g.%c", "xyzw"[sel[i] & 3u]);
+        }
+        int len = snprintf(helpers + hl, sizeof helpers - hl,
+            "float4 _rsx_zargb%d(float2 uv) {\n"
+            "    uint _w, _h; rsx_tex[%d].GetDimensions(_w, _h);\n"
+            "    int2 _p = clamp((int2)floor(uv * float2(_w, _h)), int2(0, 0),"
+            " int2((int)_w - 1, (int)_h - 1));\n"
+            "    uint _z = (uint)round(saturate(rsx_tex[%d].Load(int3(_p, 0)).r) * 16777215.0);\n"
+            "    float4 _g = float4((_z >> 8) & 255u, _z & 255u, 0u, (_z >> 16) & 255u) / 255.0;\n"
+            "    return float4(%s, %s, %s, %s);\n}\n"
+            "float4 _rsx_zargb%d_l(float2 uv, float lod) { return _rsx_zargb%d(uv); }\n",
+            u, u, u, lane[1], lane[2], lane[3], lane[0], u, u);
+        if (len < 0 || hl + (size_t)len >= sizeof helpers) return 0;
+        hl += (size_t)len;
+        char f[64], r[64];
+        snprintf(f, sizeof f, "rsx_tex[%d].Sample(rsx_samp[%d], ", u, u);
+        snprintf(r, sizeof r, "_rsx_zargb%d(", u);
+        hlsl_replace_all(hlsl, cap, f, r);
+        snprintf(f, sizeof f, "rsx_tex[%d].SampleLevel(rsx_samp[%d], ", u, u);
+        snprintf(r, sizeof r, "_rsx_zargb%d_l(", u);
+        hlsl_replace_all(hlsl, cap, f, r);
+        snprintf(f, sizeof f, "rsx_tex[%d].SampleBias(rsx_samp[%d], ", u, u);
+        hlsl_replace_all(hlsl, cap, f, r);
+    }
+    char* at = strstr(hlsl, " main(");
+    if (!at) return 0;
+    while (at > hlsl && at[-1] != '\n') at--;
+    size_t used = strlen(hlsl) + 1;
+    if (used + hl > cap) return 0;
+    memmove(at + hl, at, used - (size_t)(at - hlsl));
+    memcpy(at, helpers, hl);
+    return 1;
+}
