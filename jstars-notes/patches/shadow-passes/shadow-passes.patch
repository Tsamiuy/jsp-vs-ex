+/* One DrZInfo for the PSO call in hand (single-threaded record/replay). */
+static const DrZInfo* dr_z(const D3D12DrawRecord* dr)
+{
+    static DrZInfo zi;
+    dr_z_info(dr, &zi);
+    return &zi;
+}
