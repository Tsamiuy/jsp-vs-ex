+/* Depth render targets for depth-only passes (SHADOW_PASSES), keyed by the
+ * raw zeta offset like OffRT is keyed by the colour offset. R24G8_TYPELESS so
+ * one resource is both the pass's DSV (D24_UNORM_S8_UINT) and the material's
+ * SRV (R24_UNORM_X8_TYPELESS: .r = depth in [0,1]). Persistent across batches
+ * and frames; only the guest's own depth clears reset it (plus one clear when
+ * a resource is created). Colour passes keep the shared s_d3d.depth_buffer. */
+#define MAX_DEPTH_RTS 8
+typedef struct {
+    ID3D12Resource*       res;
+    u32                   off, w, h;   /* raw zeta offset + dims */
+    D3D12_RESOURCE_STATES st;
+    int                   fresh;       /* created, not yet cleared */
+    int                   used;        /* referenced this batch */
+} DepthRT;
+static DepthRT               s_zrt[MAX_DEPTH_RTS];
+static ID3D12DescriptorHeap* s_zrt_dsv_heap;
+static UINT                  s_zrt_dsv_inc;
+
+static int dt_find(u32 off)
+{
+    if (!off) return -1;
+    for (int i = 0; i < MAX_DEPTH_RTS; i++)
+        if (s_zrt[i].res && s_zrt[i].off == off) return i;
+    return -1;
+}
+
+static D3D12_CPU_DESCRIPTOR_HANDLE dt_dsv(int i)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h;
+    s_zrt_dsv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_zrt_dsv_heap, &h);
+    h.ptr += (SIZE_T)i * s_zrt_dsv_inc;
+    return h;
+}
+
+static void dt_transition(int i, D3D12_RESOURCE_STATES to)
+{
+    DepthRT* z = &s_zrt[i];
+    if (z->st == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource   = z->res;
+    b.Transition.StateBefore = z->st;
+    b.Transition.StateAfter  = to;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    z->st = to;
+}
+
+static void dt_release(int i)
+{
+    if (s_zrt[i].res) { s_zrt[i].res->lpVtbl->Release(s_zrt[i].res); s_zrt[i].res = NULL; }
+}
+
+/* Ensure a depth target exists for this zeta surface (pre-pass, before any
+ * command is recorded against it). */
+static int dt_get(u32 off, u32 w, u32 h)
+{
+    if (!off || !s_d3d.device) return -1;
+    if (!w) w = s_d3d.width;
+    if (!h) h = s_d3d.height;
+    if (!s_zrt_dsv_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.NumDescriptors = MAX_DEPTH_RTS;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+        if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_zrt_dsv_heap)))
+            return -1;
+        s_zrt_dsv_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+            s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+    }
+    int i = dt_find(off);
+    if (i >= 0) {
+        if (s_zrt[i].w == w && s_zrt[i].h == h) { s_zrt[i].used = 1; return i; }
+        wait_for_gpu();   /* the frame in flight may still use it (see off_rt_get) */
+        dt_release(i);
+    } else {
+        for (int k = 0; k < MAX_DEPTH_RTS && i < 0; k++) if (!s_zrt[k].res) i = k;
+        for (int k = 0; k < MAX_DEPTH_RTS && i < 0; k++) if (!s_zrt[k].used) i = k;
+        if (i < 0) return -1;
+        if (s_zrt[i].res) { wait_for_gpu(); dt_release(i); }
+    }
+    DepthRT* z = &s_zrt[i];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
