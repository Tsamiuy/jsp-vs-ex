+ * bit 0 test, bit 1 write, bits 4..6 func as GL order (NEVER..ALWAYS). The
+ * register holds the GL enum (0x200..0x207); the reset value is the bare 1. */
+static u32 rsx_zstate_pack(const rsx_state* st)
+{
+    if (!st) return 0;
+    u32 f = st->depth_func;
+    f = (f >= 0x200u && f <= 0x207u) ? f - 0x200u : (f & 7u);
+    return 0x100u | (st->depth_test_enable ? 1u : 0u) | (st->depth_mask ? 2u : 0u) | (f << 4);
