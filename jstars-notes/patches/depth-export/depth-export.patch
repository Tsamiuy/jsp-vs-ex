  * transparent texels (DXT1 punch-through: black, alpha 0) showed as black
  * rims. With one sample, coverage is "alpha >= 0.5"; that is what this adds
  * when the game's own alpha test is off. */
+/* The draw record's fp_exp32 from SET_SHADER_CONTROL: bit 0 = 32-bit colour
+ * exports (0x40), bit 1 = depth export (any of 0xE). The depth bits were never
+ * passed to the decompiler, so a program whose depth export is its cut-out
+ * kept the card's own depth: J-Stars' tree and grass cards write r1.z = 10
+ * (out of range, so the depth test fails) where the leaf texture is
+ * transparent and the fragment's own z elsewhere, and drew as whole black or
+ * green cards (jstars-notes STAGE_TEXTURES.md §12, FINDINGS §62).
+ * FP_DEPTH_EXPORT=0 leaves the depth bits out, as before. */
+static int rsx_fp_exp_bits(const rsx_state* st)
+{
+    static int zx = -1;
+    if (zx < 0) { const char* e = getenv("FP_DEPTH_EXPORT"); zx = e ? atoi(e) : 1; }
+    if (!st) return 1;
+    return ((st->shader_control & 0x40) ? 1 : 0) | ((zx && (st->shader_control & 0xE)) ? 2 : 0);
+}
+/* SET_SHADER_CONTROL bits for the decompiler from fp_exp32. */
+static u32 fp_ctrl_bits(int exp32)
+{
+    return ((exp32 & 1) ? 0x40u : 0u) | ((exp32 & 2) ? 0x2u : 0u);
+}
