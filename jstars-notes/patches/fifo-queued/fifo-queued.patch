+/* Diagnostic: how far the walker is behind the guest, as the number of flip
+ * words (0xFEADxxxx, both the lv1 form and GCM_FLIP_MARKER) and command bytes
+ * queued between get and put. Walks the commands, following JUMPs; bounded.
+ * Used by VP_CODE (jstars-notes VFX.md: are the beam's draws decoded frames
+ * after the guest wrote them, or does the guest itself draw old buffers?). */
+void cellGcm_fifo_queued(int* flips, u32* bytes);
+void cellGcm_fifo_queued(int* flips, u32* bytes)
+{
+    const u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    u32 off = s_fifo_getoff, nb = 0; int nf = 0;
+    for (int steps = 0; off != put && steps < 400000; steps++) {
+        const u32 ea = gcm_io2ea(off);
+        if (!ea) break;
+        const u32 w = vm_read32(ea);
+        if ((w & 0xFFFF0000u) == 0xFEAD0000u) { nf++; off += 4; nb += 4; continue; }
+        if ((w >> 29) == 1u) {                       /* JUMP */
+            const u32 tgt = w & 0x1FFFFFFCu;
+            if (tgt == off) break;
+            off = tgt; continue;
+        }
+        if ((w & 3u) == 2u || w == 0x00020000u) { off += 4; nb += 4; continue; }   /* CALL / RETURN */
+        const u32 cnt = (w >> 18) & 0x7FFu;
+        off += 4 + cnt * 4; nb += 4 + cnt * 4;
+    }
+    if (flips) *flips = nf;
+    if (bytes) *bytes = nb;
+}
+
