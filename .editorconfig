root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,py,sh,cs}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{bat,ps1,cs}]
end_of_line = crlf

[*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
