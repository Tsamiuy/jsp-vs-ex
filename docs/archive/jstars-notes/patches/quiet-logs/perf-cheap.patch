 static double s_vt_t0; static u64 s_vt_c0;
+/* PERF_CYCLES=1: also count the thread's cycles per call (the [PERF] cyc/vert
+ * figure). QueryThreadCycleTime is a system call; at two per draw it was
+ * ~10% of the drawing thread's samples on Hidden Leaf, and the two timer
+ * calls together ~20% (DRAW_SAMPLE, jstars-notes CPU_PROFILE §36) -- so
+ * every PERF=1 run measured a slower renderer than the game runs with. */
+static int perf_cycles(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PERF_CYCLES"); v = (e && *e && *e != '0') ? 1 : 0; }
