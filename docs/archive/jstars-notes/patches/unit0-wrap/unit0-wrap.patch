+/* Unit 0's static sampler (s0) is POINT + CLAMP for the debug-font atlas, but
+ * J-Stars binds most materials' main texture there, tiled ones included: its
+ * Temple of Athena star layer (fp 0x09CA7F81, 1024x1024 DXT5) repeated the
+ * texture's edge texels into long parallel lines and left the rest of the sky
+ * empty (jstars-notes STAGE_TEXTURES.md §5, FINDINGS §57). The draw's
+ * TEXTURE_ADDRESS word picks one of s16..s23 instead: wrap S in bits 0-3,
+ * wrap T in bits 8-11; 1 = wrap, 2 = mirror, anything else is treated as
+ * clamp (border and the mirror-once modes have no exact static sampler).
+ * Clamp on both axes keeps s0, so those draws are unchanged. The filter stays
+ * s0's: the plant boxes S0_LINEAR showed came from LINEAR, not from wrap.
+ * U0_WRAP=0 turns this off; U0_WRAP_LOG=1 prints each (fp, mode) once.
+ * Set around vp_get_fp_pso by the callers: 0 = s0, else 1 + sampler index
+ * (3 * modeS + modeT, 0 wrap / 1 mirror / 2 clamp). */
+static int s_u0_mode = 0;
+static int u0_wrap_mode(const D3D12DrawRecord* dr)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("U0_WRAP"); on = !(e && e[0] == '0'); }
+    if (!on || !dr->tex[0].set) return 0;
+    const u32 ws = dr->tex[0].addr & 0xFu, wt = (dr->tex[0].addr >> 8) & 0xFu;
+    const int ms = ws == 1 ? 0 : ws == 2 ? 1 : 2, mt = wt == 1 ? 0 : wt == 2 ? 1 : 2;
+    if (ms == 2 && mt == 2) return 0;
+    return 1 + 3 * ms + mt;
+}
