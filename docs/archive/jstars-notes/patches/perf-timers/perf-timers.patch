 }
 
+/* PERF=1: drain time and counts, read (and reset) by the D3D12 backend's
+ * [PERF2] line. "with work" = the walker advanced `get`. Many calls, little
+ * work per call and a large [PERF2] "rest" means the present loop is pacing
+ * the guest: every fence the guest waits on costs it one loop iteration. */
+static double   s_perf_drain_s;
+static unsigned s_perf_drain_n, s_perf_drain_w;
+void cellGcm_perf_drain_take(double* secs, unsigned* calls, unsigned* worked)
+{
+    *secs = s_perf_drain_s; *calls = s_perf_drain_n; *worked = s_perf_drain_w;
+    s_perf_drain_s = 0.0; s_perf_drain_n = 0; s_perf_drain_w = 0;
+}
+
 void cellGcm_rsx_process_fifo(void)
 {
+    static int perf = -1;
+    if (perf < 0) { const char* e = getenv("PERF"); perf = (e && atoi(e)) ? 1 : 0; }
+    LARGE_INTEGER t0 = {0}, t1, f;
+    if (perf) QueryPerformanceCounter(&t0);
     AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    const u32 get0 = s_fifo_getoff;
     gcm_rsx_process_fifo_unlocked();
+    const int worked = (s_fifo_getoff != get0);
     ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
+    if (perf) {
+        QueryPerformanceCounter(&t1); QueryPerformanceFrequency(&f);
+        s_perf_drain_s += (double)(t1.QuadPart - t0.QuadPart) / (double)f.QuadPart;
+        s_perf_drain_n++;
+        if (worked) s_perf_drain_w++;
+    }
 }
 
 static void gcm_rsx_process_fifo_unlocked(void)
