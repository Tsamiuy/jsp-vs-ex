+    int on;                    /* -1 = undecided */
+    ID3D12Resource* ib;
+    u32* mapped;               /* both halves */
+    u32  off;                  /* entries used in the current batch */
+    u32  gen;                  /* bumped at every batch reset */
+    u32  tag;                  /* bumped at every new record (dedup map key) */
