+                 * convention: the scale's sign only picks which edge oy counts from. */
+                const float sy = vs_[1] < 0.0f ? -vs_[1] : vs_[1];
+                vpx[0] = 2.0f * vs_[0] / (float)tw;
+                vpx[4] = 2.0f * vo_[0] / (float)tw - 1.0f;
+                vpx[1] = 2.0f * sy / (float)th;
+                vpx[5] = (vs_[1] < 0.0f) ? 1.0f - 2.0f * vo_[1] / (float)th
+                                         : 2.0f * vo_[1] / (float)th - 1.0f;
+            }
+        }
         if (zpass_dbg()) {
             static float seen[16][2]; static int ns = 0; int known = 0;
             for (int i = 0; i < ns; i++)
@@ -5999,6 +6035,14 @@ static int dt_find(u32 off)
     return -1;
 }
 
+static int dt_dims(u32 off, u32* w, u32* h)
+{
+    const int i = dt_find(off);
+    if (i < 0) return 0;
+    *w = s_zrt[i].w; *h = s_zrt[i].h;
+    return 1;
+}
