+                        (double)vo_[0], (double)vo_[1], 10); }
+        }
+        if (zpass_vpxy() && vs_[0] != 0.0f && vs_[1] != 0.0f) {
+            u32 tw = 0, th = 0;
+            if (dt_dims(dr->rt_off & ~ZT_TAG, &tw, &th) && tw && th) {
