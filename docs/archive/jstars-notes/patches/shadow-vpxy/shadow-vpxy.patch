     return on;
 }
 static int dr_is_zonly(const D3D12DrawRecord* dr) { return (dr->rt_off & ZT_TAG) != 0; }
+/* ZPASS_VPXY=1: depth-only (shadow caster) draws honour the guest's viewport
+ * scale/offset in x and y, not only the viewport rectangle. A shadow atlas
+ * places each cascade with the viewport transform; with the old identity x/y
+ * every cascade covered the whole map and the last one overwrote the others
+ * (jstars-notes SHADOWS_ENV.md). */
+static int zpass_vpxy(void) { static int on = -1; if (on < 0) on = getenv("ZPASS_VPXY") ? 1 : 0; return on; }
+static int dt_dims(u32 off, u32* w, u32* h);   /* defined with the DepthRT table */
 /* Guest depth test/write/func packed for a depth-only op's PSO: bit 8 valid,
  * bit 0 test, bit 1 write, bits 4..6 func as GL order (NEVER..ALWAYS). The
  * register holds the GL enum (0x200..0x207); the reset value is the bare 1. */
@@ -5809,6 +5819,32 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
      * fix ZPASS_CASTER_Z01=1 forces the GL [-1,1] -> [0,1] mapping (scale
