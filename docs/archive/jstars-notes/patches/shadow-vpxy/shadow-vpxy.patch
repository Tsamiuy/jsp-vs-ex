+                        if (x0 < 0) x0 = 0;
+                        if (y0 < 0) y0 = 0;
+                        if (x1 > tw) x1 = tw;
+                        if (y1 > th) y1 = th;
+                        if (x1 > x0 && y1 > y0) {
