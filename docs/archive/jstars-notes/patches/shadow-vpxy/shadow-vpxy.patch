                     if (!rec_dedup || !rd_vp_ok || memcmp(&dvp, &rd_vp, sizeof dvp) ||
@@ -11078,6 +11139,10 @@ static void d3d12_draw_arrays_impl(void* ud, u32 primitive, u32 first, u32 count
                     dr->vp_y = s_d3d.current_rsx_state->viewport_y;
                     dr->vp_w = s_d3d.current_rsx_state->viewport_w;
                     dr->vp_h = s_d3d.current_rsx_state->viewport_h;
