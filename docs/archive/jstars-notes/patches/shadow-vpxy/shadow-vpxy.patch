     if (dr && dr_is_zonly(dr)) {
+        /* ZPASS_DBG: each distinct x/y placement once (a cascade atlas shows
+         * several offsets on one target). */
+        if (zpass_dbg()) {
+            static float seenxy[16][2]; static int nxy = 0; int kn = 0;
+            for (int i = 0; i < nxy; i++)
+                if (seenxy[i][0] == vo_[0] && seenxy[i][1] == vo_[1]) kn = 1;
+            if (!kn && nxy < 16) { seenxy[nxy][0] = vo_[0]; seenxy[nxy][1] = vo_[1]; nxy++;
+                fprintf(stderr, "[ZPASS] caster xy map: target 0x%08X rect=%u,%u %ux%u scale=(%g,%g)"
