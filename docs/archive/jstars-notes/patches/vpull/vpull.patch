index 0000000..8afb8fd
--- /dev/null
+++ b/libs/video/rsx_vpull.h
@@ -0,0 +1,179 @@
+/*
+ * ps3recomp - RSX vertex pulling (VPULL): the vertex shader decodes the
+ * game's own vertex bytes instead of the CPU decoding every vertex into a
+ * 256-byte float4 slot (rsx_vertex_fetch.c).
+ *
+ * One interleaved vertex stream per draw record: every fetched attribute of
+ * the record has the same stride S and no frequency divider. Per index batch
+ * the CPU copies the guest bytes the batch spans into a byte ring and writes
+ * the batch's indices rebased to that copy (vertex k of the record sits at
+ * k * S in the record's region). The shader gets:
+ *   t8  ByteAddressBuffer   the record's region (root SRV, 4-byte aligned)
+ *   t9  ByteAddressBuffer   the decode tables below (exact values)
+ *   b2  VPullTab            per attribute: byte offset in the vertex, stride,
+ *                           type (0 = constant register), components; and
+ *                           the constant register values (vertex_data4f)
+ *
+ * The decode must give the same float bits as rsx_fetch_plan_vertex. GPU
+ * division is not correctly rounded, so the normalised types read their value
+ * from tables the CPU fills with the same expressions (rsx_vpull_fill_lut);
+ * the rest is integer work plus int->float conversions that are exact.
+ */
+#ifndef PS3RECOMP_RSX_VPULL_H
+#define PS3RECOMP_RSX_VPULL_H
+
+#include "rsx_vertex_fetch.h"
+#include <string.h>
+
+/* Decode table layout, in floats (the HLSL below hard-codes 256, 65792 and
+ * 67840). */
+#define RSX_VPULL_LUT_UB    0u                       /* p / 255.0f, p = 0..255        */
+#define RSX_VPULL_LUT_S1    256u                     /* (s16)u / 32767.0f, u = 0..65535 */
+#define RSX_VPULL_LUT_CMPXY (256u + 65536u)          /* 11-bit pattern -> x / 1023.0f */
+#define RSX_VPULL_LUT_CMPZ  (256u + 65536u + 2048u)  /* 10-bit pattern -> z / 511.0f  */
+#define RSX_VPULL_LUT_COUNT (256u + 65536u + 2048u + 1024u)
+
+/* Per-record table (constant buffer b2), 512 bytes. */
+typedef struct rsx_vpull_tab {
+    u32   attr[16][4];   /* x = byte offset of vertex 0, y = stride, z = type (0 = constant), w = n */
+    float konst[16][4];  /* vertex_data4f snapshot (components the array does not supply)      */
+} rsx_vpull_tab;
+#define RSX_VPULL_TAB_BYTES 512u
+
+/* What one batch has to copy, from rsx_vpull_layout. */
+typedef struct rsx_vpull_layout {
+    u32 base;      /* lowest attribute offset (aoff) of the stream           */
+    u32 stride;    /* S                                                       */
+    u32 extent;    /* bytes of one vertex from `base`: max(aoff - base + size) */
+    u32 pad;       /* vertices to reserve beyond the last one (extent > S)    */
+    u8  main;      /* 1 = MAIN (IO table), 0 = LOCAL                          */
+    u32 sig;       /* layout signature, for record continuation              */
+} rsx_vpull_layout;
+
+static inline void rsx_vpull_fill_lut(float* lut)
+{
+    for (u32 p = 0; p < 256u; p++) lut[RSX_VPULL_LUT_UB + p] = p / 255.0f;
+    for (u32 u = 0; u < 65536u; u++) lut[RSX_VPULL_LUT_S1 + u] = (float)(s16)(u16)u / 32767.0f;
+    for (u32 b = 0; b < 2048u; b++) { s32 x = (s32)b; if (x & 0x400) x -= 0x800;
+                                      lut[RSX_VPULL_LUT_CMPXY + b] = (float)x / 1023.0f; }
+    for (u32 b = 0; b < 1024u; b++) { s32 z = (s32)b; if (z & 0x200) z -= 0x400;
+                                      lut[RSX_VPULL_LUT_CMPZ + b] = (float)z / 511.0f; }
+}
+
+static inline u32 rsx_vpull_type_size(u32 type, u32 n)
+{
+    switch (type) {
+    case 2: return 4u * n;           /* F    */
+    case 3: case 1: case 5: return 2u * n;   /* SF, S1, S32K */
+    case 4: case 7: return n;        /* UB, UB256 */
+    case 6: return 4u;               /* CMP  */
+    default: return 0u;
+    }
+}
+
+/* Can this plan be pulled, and how? 1 = yes (lay and tab filled). Not
+ * pulled: no fetched attribute, a frequency divider, different strides or
+ * memory locations, or a type the CPU decodes as its float32 default. */
+static inline int rsx_vpull_layout_from_plan(const rsx_fetch_plan* plan, rsx_vpull_layout* lay,
+                                      rsx_vpull_tab* tab)
+{
+    if (!plan->nfetch) return 0;
+    const rsx_fetch_plan_attr* f0 = &plan->fetch[0];
+    u32 base = f0->aoff, end = 0;
+    for (u32 c = 0; c < plan->nfetch; c++) {
+        const rsx_fetch_plan_attr* f = &plan->fetch[c];
+        if (f->freq || f->stride != f0->stride || f->main != f0->main) return 0;
+        if (f->type < 1 || f->type > 7) return 0;
+        if (f->aoff < base) base = f->aoff;
+    }
+    const u32 S = f0->stride;
+    if (S == 0) return 0;
+    memset(tab, 0, sizeof *tab);
+    memcpy(tab->konst, plan->konst, sizeof tab->konst);
+    u32 sig = 2166136261u;
+    for (u32 c = 0; c < plan->nfetch; c++) {
+        const rsx_fetch_plan_attr* f = &plan->fetch[c];
+        const u32 rel = f->aoff - base;
+        if (rel > 4096u) return 0;                     /* attributes far apart: not one stream */
+        const u32 e = rel + rsx_vpull_type_size(f->type, f->n);
+        if (e > end) end = e;
+        tab->attr[f->idx][0] = rel;
+        tab->attr[f->idx][1] = S;
+        tab->attr[f->idx][2] = f->type;
+        tab->attr[f->idx][3] = f->n;
+        sig = (sig ^ (f->idx | (f->type << 8) | ((u32)f->n << 16))) * 16777619u;
+        sig = (sig ^ rel) * 16777619u;
+    }
+    sig = (sig ^ S ^ ((u32)f0->main << 31)) * 16777619u;
+    sig = (sig ^ base) * 16777619u;
+    sig = (sig ^ plan->base_index) * 16777619u;
+    for (u32 i = 0; i < 16; i++)                       /* constants change the record too */
+        for (u32 k = 0; k < 4; k++) { u32 w; memcpy(&w, &plan->konst[i][k], 4); sig = (sig ^ w) * 16777619u; }
+    lay->base = base; lay->stride = S; lay->extent = end; lay->main = f0->main;
+    lay->pad = (end > S) ? (end - 1u) / S : 0u;        /* whole vertices the tail reaches into */
+    lay->sig = sig ? sig : 1u;
+    return 1;
+}
+
+/* Copy `len` guest bytes at array offset `off` (LOCAL or MAIN) to dst, one IO
+ * page at a time for MAIN, as rsx_fetch_plan_vertex resolves them. */
+static inline void rsx_vpull_copy(u8* dst, u32 off, u32 len, int main_mem, u32 local_base)
+{
+    if (!main_mem) { memcpy(dst, vm_base + (u32)(local_base + off), len); return; }
+    while (len) {
+        const u32 pg = off >> 20;
+        u32 n = 0x100000u - (off & 0xFFFFFu);
+        if (n > len) n = len;
+        memcpy(dst, vm_base + (u32)(cellGcmResolveLocated(0, pg << 20) + (off & 0xFFFFFu)), n);
+        dst += n; off += n; len -= n;
+    }
+}
+
+/* HLSL: the decoder the vertex program prologue calls (vpull_attr). */
+#define RSX_VPULL_HLSL \
+"ByteAddressBuffer vpull_bytes : register(t8);\n" \
+"ByteAddressBuffer vpull_lut : register(t9);\n" \
+"cbuffer VPullTab : register(b2) { uint4 vpull_a[16]; float4 vpull_k[16]; };\n" \
+"uint vpull_ld(uint a) {\n" \
+"    uint s = (a & 3u) * 8u; uint2 w = vpull_bytes.Load2(a & ~3u);\n" \
+"    return s ? ((w.x >> s) | (w.y << (32u - s))) : w.x;\n" \
+"}\n" \
+"uint vpull_be32(uint a) { uint x = vpull_ld(a);\n" \
+"    return (x << 24) | ((x << 8) & 0xFF0000u) | ((x >> 8) & 0xFF00u) | (x >> 24); }\n" \
+"uint vpull_be16(uint a) { uint x = vpull_ld(a); return ((x & 0xFFu) << 8) | ((x >> 8) & 0xFFu); }\n" \
+"uint vpull_u8(uint a) { return vpull_ld(a) & 0xFFu; }\n" \
+"float vpull_tabf(uint i) { return asfloat(vpull_lut.Load(i * 4u)); }\n" \
+"float vpull_half(uint h) {\n" \
+"    uint s = (h >> 15) & 1u, e = (h >> 10) & 0x1Fu, m = h & 0x3FFu, f;\n" \
+"    if (e == 0u) f = s << 31;\n" \
+"    else if (e == 31u) f = (s << 31) | 0x7F800000u | (m << 13);\n" \
+"    else f = (s << 31) | ((e - 15u + 127u) << 23) | (m << 13);\n" \
+"    return asfloat(f);\n" \
+"}\n" \
+"float4 vpull_attr(uint i, uint vid) {\n" \
+"    uint4 d = vpull_a[i]; float4 t = vpull_k[i];\n" \
+"    [branch] if (d.z == 0u) return t;\n" \
+"    uint a = d.x + vid * d.y;\n" \
+"    [branch] if (d.z == 6u) {\n" \
+"        uint w = vpull_be32(a);\n" \
+"        return float4(vpull_tabf(65792u + (w & 0x7FFu)), vpull_tabf(65792u + ((w >> 11) & 0x7FFu)),\n" \
+"                      vpull_tabf(67840u + ((w >> 22) & 0x3FFu)), 1.0);\n" \
+"    }\n" \
+"    uint es = (d.z == 2u) ? 4u : ((d.z == 4u || d.z == 7u) ? 1u : 2u);\n" \
+"    [unroll] for (uint k = 0u; k < 4u; k++) {\n" \
+"        if (k < d.w) {\n" \
+"            uint x = vpull_ld(a + k * es);\n" \
+"            uint r = (es == 4u) ? ((x << 24) | ((x << 8) & 0xFF0000u) | ((x >> 8) & 0xFF00u) | (x >> 24))\n" \
+"                   : ((es == 2u) ? (((x & 0xFFu) << 8) | ((x >> 8) & 0xFFu)) : (x & 0xFFu));\n" \
+"            float v = asfloat(r);\n" \
+"            if (d.z == 3u) v = vpull_half(r);\n" \
+"            else if (d.z == 5u) v = (float)((int)(r << 16) >> 16);\n" \
+"            else if (d.z == 7u) v = (float)r;\n" \
+"            [branch] if (d.z == 1u || d.z == 4u) v = vpull_tabf((d.z == 1u ? 256u : 0u) + r);\n" \
+"            t[k] = v;\n" \
+"        }\n" \
+"    }\n" \
+"    return t;\n" \
+"}\n"
+
+#endif /* PS3RECOMP_RSX_VPULL_H */
