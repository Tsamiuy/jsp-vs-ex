Subject: [PATCH] video: vertex pulling for indexed strips (VPULL=1, opt-in)

---
 libs/video/rsx_d3d12_backend.c | 253 ++++++++++++++++++++++++++++++++-
 libs/video/rsx_vp_decompiler.c |  19 +++
 libs/video/rsx_vp_decompiler.h |   4 +
 libs/video/rsx_vpull.h         | 179 +++++++++++++++++++++++
 4 files changed, 449 insertions(+), 6 deletions(-)
 create mode 100644 libs/video/rsx_vpull.h

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 11313b4..9b7bc13 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -21,6 +21,7 @@
 #include "rsx_primitives.h"
 #include "rsx_vertex_fetch.h"
 #include "rsx_vp_decompiler.h"
+#include "rsx_vpull.h"
 #include "rsx_texture_layout.h"
 #include <stdio.h>
 #include <string.h>
@@ -174,6 +175,10 @@ typedef struct {
      * Valid only while ix_gen == s_six.gen, so a slot reused by any other
      * path (none of which sets these) can never be taken for one. */
     u32 ix_start, ix_count, ix_gen;
+    /* VPULL: the record's vertices are its byte region at vpull_base in the
+     * ring, decoded by the vertex shader. Valid only while vpull_gen ==
+     * s_six.gen (same rule as ix_gen). */
+    u32 vpull_base, vpull_gen, vpull_sig;
 } D3D12DrawRecord;
 
 /* MENU_A2C=1 (opt-in): alpha-to-coverage as an alpha test. RSX foliage cards
@@ -699,6 +704,34 @@ static int strip_ix_on(void)
     if (s_six.on < 0) { const char* e = getenv("STRIP_INDEXED"); s_six.on = (e && *e && *e != '0') ? 1 : 0; }
     return s_six.on;
 }
+
+/* VPULL=1 (opt-in): indexed strips decoded by the vertex shader (rsx_vpull.h).
+ * Per FIFO index batch the guest vertex bytes the batch spans are copied into
+ * a byte ring and its indices, rebased to that copy, go into the STRIP_INDEXED
+ * index buffer (restart -> strip cut). No 256-byte slots, no decode workers.
+ * A record whose attributes are not one plain interleaved stream (divider,
+ * mixed strides or memory, unknown type, a very sparse first batch) takes the
+ * CPU path as before. With PERF on, a [VPULL] line follows each [PERF4]. */
+#define VPULL_RING_BYTES (64u << 20)    /* per parity half */
+#define VPULL_RING_SLACK 4096u          /* Load2 past a record's last byte */
+#define VPULL_MARGIN     (8u << 20)     /* flush the batch below this much room */
+static struct {
+    int on;                    /* -1 = undecided */
+    ID3D12Resource* ring; u8* ring_mapped;
+    ID3D12Resource* tab;  u8* tab_mapped;   /* rsx_vpull_tab per record slot, x2 parity */
+    ID3D12Resource* lut;
+    u32 off;                   /* ring bytes used in the current batch */
+    u32 rec_base, rec_k;       /* the open record: region start, vertices reserved */
+    rsx_fetch_plan plan;       /* vpull_prepare's result for the current call */
+    rsx_vpull_layout lay;
+    rsx_vpull_tab tab_cur;
+    u32 n_rec, n_batch, n_cpu, n_sparse, n_drop; u64 bytes, idx;
+} s_vpull = { .on = -1 };
+static int vpull_on(void)
+{
+    if (s_vpull.on < 0) { const char* e = getenv("VPULL"); s_vpull.on = (e && *e && *e != '0') ? 1 : 0; }
+    return s_vpull.on;
+}
 /* The rest of the present thread's time, which [PERF] lumps into "guest"
  * (= window - render_frame):
  *   s_perf_present  swap-chain Present (vsync), after render_frame's timer;
@@ -1373,7 +1406,19 @@ static int init_d3d12(u32 width, u32 height)
         srv_range.BaseShaderRegister = 0;
         srv_range.OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
 
-        D3D12_ROOT_PARAMETER rp[3] = {0};
+        D3D12_ROOT_PARAMETER rp[6] = {0};
+        /* VPULL: t8 = the record's vertex bytes, t9 = decode tables, b2 = the
+         * record's attribute table (rsx_vpull.h). Only with VPULL on, so the
+         * default root signature stays as it was. */
+        rp[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+        rp[3].Descriptor.ShaderRegister = 8;
+        rp[3].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+        rp[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV;
+        rp[4].Descriptor.ShaderRegister = 9;
+        rp[4].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
+        rp[5].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+        rp[5].Descriptor.ShaderRegister = 2;
+        rp[5].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
         rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;   /* b0 = vp_c bank */
         rp[0].Descriptor.ShaderRegister = 0;
         rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_VERTEX;
@@ -1424,7 +1469,7 @@ static int init_d3d12(u32 width, u32 height)
         }
 
         D3D12_ROOT_SIGNATURE_DESC rd = {0};
-        rd.NumParameters = 3; rd.pParameters = rp;
+        rd.NumParameters = vpull_on() ? 6 : 3; rd.pParameters = rp;
 rd.NumStaticSamplers = RSX_TEX_UNITS; rd.pStaticSamplers = samp;
         rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
 
@@ -1464,7 +1509,36 @@ rd.NumStaticSamplers = RSX_TEX_UNITS; rd.pStaticSamplers = samp;
         else
             fprintf(stderr, "[VPVB] ALLOCATION FAILED -- no VP geometry will render%c", 10);
 
-        if (strip_ix_on()) {
+        if (vpull_on()) {   /* VPULL: byte ring, per-record tables, decode tables */
+            u64 keep = bd.Width;
+            int ok = 1;
+            bd.Width = ((u64)VPULL_RING_BYTES + VPULL_RING_SLACK) * 2;
+            ok = ok && SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                    D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                    &IID_ID3D12Resource, (void**)&s_vpull.ring)) &&
+                 SUCCEEDED(s_vpull.ring->lpVtbl->Map(s_vpull.ring, 0, &nr, (void**)&s_vpull.ring_mapped));
+            bd.Width = (u64)MAX_DRAWS * RSX_VPULL_TAB_BYTES * 2;
+            ok = ok && SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                    D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                    &IID_ID3D12Resource, (void**)&s_vpull.tab)) &&
+                 SUCCEEDED(s_vpull.tab->lpVtbl->Map(s_vpull.tab, 0, &nr, (void**)&s_vpull.tab_mapped));
+            bd.Width = (u64)RSX_VPULL_LUT_COUNT * sizeof(float);
+            void* lm = NULL;
+            ok = ok && SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
+                    D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_GENERIC_READ, NULL,
+                    &IID_ID3D12Resource, (void**)&s_vpull.lut)) &&
+                 SUCCEEDED(s_vpull.lut->lpVtbl->Map(s_vpull.lut, 0, &nr, &lm));
+            if (ok) {
+                rsx_vpull_fill_lut((float*)lm);
+                fprintf(stderr, "[VPULL] vertex pulling on: %u MB byte ring x2 parity%c",
+                        VPULL_RING_BYTES >> 20, 10);
+            } else {
+                fprintf(stderr, "[VPULL] buffer allocation failed -- VPULL off%c", 10);
+                s_vpull.ring_mapped = NULL; s_vpull.tab_mapped = NULL; s_vpull.on = 0;
+            }
+            bd.Width = keep;
+        }
+        if (strip_ix_on() || vpull_on()) {   /* VPULL draws through this index buffer too */
             u64 keep = bd.Width;
             bd.Width = (u64)SIX_CAP * sizeof(u32) * 2;   /* x2 parity, like vp_vb */
             if (SUCCEEDED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp,
@@ -2183,7 +2257,7 @@ static void compile_vp(void)
     pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
     pd.SampleMask = UINT_MAX;
     pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
-    if (strip_ix_on()) pd.IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_0xFFFFFFFF;
+    if (strip_ix_on() || vpull_on()) pd.IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_0xFFFFFFFF;
     pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
     pd.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
     /* Depth test ON (LESS_EQUAL, matching the guest's rsxtiny_DepthTestFunc 515 /
@@ -2773,6 +2847,7 @@ static void pso_async_prepass_end(void)
     }
 }
 
+static int s_vs_pull_req = 0;   /* VPULL: vp_get_vs_pull wants the pulling variant */
 static int vp_get_vs(const rsx_state* st)
 {
     extern int rsx_vp_decompile(const uint8_t*, u32, char*, u32);
@@ -2811,6 +2886,8 @@ static int vp_get_vs(const rsx_state* st)
         if (!hash) hash = 1u;
