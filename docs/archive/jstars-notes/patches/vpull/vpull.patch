     for (int i = 0; i < s_d3d.vp_vs_n; i++)
         if (s_d3d.vp_vs[i].hash == hash) { s_vs_last_batch[i] = s_vs_batch; return i; }
 
@@ -2818,7 +2895,9 @@ static int vp_get_vs(const rsx_state* st)
     /* The decompiler resolves BRA/CAL targets against this; it stayed 0, so a
      * program with branches loaded at a non-zero slot jumped to wrong code. */
     rsx_vp_set_branch_base(getenv("VP_NO_BRANCH_BASE") ? 0u : vstart / 16u);
+    rsx_vp_set_pull(s_vs_pull_req);
     int ni = rsx_vp_decompile(vuc, vlen, hlsl, sizeof hlsl);
+    rsx_vp_set_pull(0);
     if (ni <= 0) return -1;
     if (getenv("VP_DUMP")) { static int _d=0; if (_d++ < 4) {
         FILE* f = fopen("vp2_dump.hlsl", _d==1 ? "w" : "a");
@@ -4064,7 +4143,7 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
     pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
     pd.SampleMask = UINT_MAX;
     pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
-    if (strip_ix_on()) pd.IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_0xFFFFFFFF;
+    if (strip_ix_on() || vpull_on()) pd.IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_0xFFFFFFFF;
     pd.NumRenderTargets = (UINT)nrt;
     for (int _r = 0; _r < nrt; _r++) {
         pd.RTVFormats[_r] = rtfmt;
@@ -7035,6 +7114,20 @@ static void render_frame(void)
                 ibv.Format = DXGI_FORMAT_R32_UINT;
                 s_d3d.cmd_list->lpVtbl->IASetIndexBuffer(s_d3d.cmd_list, &ibv);
             }
+            /* VPULL: the decode tables once; the ring and table slot per record
+             * at the draw (set here too so no root parameter is ever unset). */
+            const u64 vpull_ring_va = s_vpull.ring_mapped
+                ? s_vpull.ring->lpVtbl->GetGPUVirtualAddress(s_vpull.ring)
+                  + (u64)s_d3d.vp_parity * (VPULL_RING_BYTES + VPULL_RING_SLACK) : 0;
+            const u64 vpull_tab_va = s_vpull.tab_mapped
+                ? s_vpull.tab->lpVtbl->GetGPUVirtualAddress(s_vpull.tab)
+                  + (u64)s_d3d.vp_parity * MAX_DRAWS * RSX_VPULL_TAB_BYTES : 0;
+            if (s_vpull.ring_mapped && s_vpull.tab_mapped) {
+                s_d3d.cmd_list->lpVtbl->SetGraphicsRootShaderResourceView(s_d3d.cmd_list, 3, vpull_ring_va);
+                s_d3d.cmd_list->lpVtbl->SetGraphicsRootShaderResourceView(s_d3d.cmd_list, 4,
+                    s_vpull.lut->lpVtbl->GetGPUVirtualAddress(s_vpull.lut));
+                s_d3d.cmd_list->lpVtbl->SetGraphicsRootConstantBufferView(s_d3d.cmd_list, 5, vpull_tab_va);
+            }
             D3D12_GPU_DESCRIPTOR_HANDLE gh_base;
             s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh_base);
             int cur_rt = -1;                       /* target A: -1 = backbuffer */
@@ -7395,6 +7488,17 @@ static void render_frame(void)
                         cap_snap_rt(cur_rt, d, 0);
                 }
                 if (s_six.ib && dr->ix_gen == s_six.gen && dr->ix_count &&
+                    dr->topology == RSX_TOPOLOGY_TRIANGLE_STRIP &&
+                    dr->vpull_gen == s_six.gen && vpull_ring_va) {
+                    /* VPULL: indices are vertex numbers in the record's own region. */
+                    s_d3d.cmd_list->lpVtbl->SetGraphicsRootShaderResourceView(s_d3d.cmd_list, 3,
+                        vpull_ring_va + dr->vpull_base);
+                    s_d3d.cmd_list->lpVtbl->SetGraphicsRootConstantBufferView(s_d3d.cmd_list, 5,
+                        vpull_tab_va + (u64)dr->cb_slot * RSX_VPULL_TAB_BYTES);
+                    s_d3d.cmd_list->lpVtbl->DrawIndexedInstanced(s_d3d.cmd_list,
+                        dr->ix_count, 1, dr->ix_start, 0, 0);
+                }
+                else if (s_six.ib && dr->ix_gen == s_six.gen && dr->ix_count &&
                     dr->topology == RSX_TOPOLOGY_TRIANGLE_STRIP)
                     s_d3d.cmd_list->lpVtbl->DrawIndexedInstanced(s_d3d.cmd_list,
                         dr->ix_count, 1, dr->ix_start, (INT)(dr->vb_byte_offset / 256), 0);
@@ -7611,6 +7715,15 @@ static void render_frame(void)
             fprintf(stderr, "[PERF4] batch intervals: <20ms %u | 20-37 %u | 37-54 %u | 54-70 %u | 70-87 %u | >87 %u%c",
                     s_ivl[0], s_ivl[1], s_ivl[2], s_ivl[3], s_ivl[4], s_ivl[5], 10);
             memset(s_ivl, 0, sizeof s_ivl);
+            if (s_vpull.ring_mapped) {   /* VPULL, per [PERF] window */
+                fprintf(stderr, "[VPULL] records %u batches %u | indices %llu | copied %.1f MB"
+                                " | CPU path: layout %u sparse %u | dropped %u%c",
+                        s_vpull.n_rec, s_vpull.n_batch, (unsigned long long)s_vpull.idx,
+                        (double)s_vpull.bytes / 1048576.0, s_vpull.n_cpu, s_vpull.n_sparse,
+                        s_vpull.n_drop, 10);
+                s_vpull.n_rec = s_vpull.n_batch = s_vpull.n_cpu = s_vpull.n_sparse = s_vpull.n_drop = 0;
+                s_vpull.bytes = s_vpull.idx = 0;
+            }
             s_perf_present = 0.0; s_perf_rf_mid = 0.0;
             s_perf_frame = 0.0; s_perf_tex = 0.0; s_perf_vtx = 0.0; s_perf_rf = 0.0;
             s_perf_gpu = 0.0; s_perf_pre = 0.0; s_perf_srv = 0.0; s_perf_pso = 0.0;
@@ -7638,6 +7751,7 @@ static void render_frame(void)
     s_d3d.vp_vb_offset = 0;
     s_d3d.draw_count = 0;
     s_six.off = 0; s_six.gen++;           /* STRIP_INDEXED records end with the batch */
+    s_vpull.off = 0;                      /* so do VPULL's */
     s_vs_batch++;          /* recorded draws consumed: their VS slots may go */
     s_d3d.vp_parity ^= 1;  /* next frame's records go to the other half */
 
@@ -8252,6 +8366,7 @@ static void d3d12_clear(void* ud, u32 flags, u32 color, float depth, u8 stencil)
     s_d3d.vb_offset    = 0;
     s_d3d.vp_vb_offset = 0;
     s_six.off = 0; s_six.gen++;
+    s_vpull.off = 0;
     s_vs_batch++;
 }
 
@@ -9723,6 +9838,107 @@ static u32 upload_strip_vp_native_ix(const rsx_state* state, u32 first, u32 coun
     return nv;
 }
 
+/* VPULL: can the current state's strips be pulled? Builds the fetch plan and
+ * the record layout into s_vpull for upload_strip_vpull. */
+static int vpull_prepare(const rsx_state* st)
+{
+    extern uint8_t* vm_base;
+    if (!st || !vm_base || !s_vpull.ring_mapped || !s_six.mapped) return 0;
+    if (!st->vertex_attribs[0].enabled) return 0;
+    rsx_fetch_plan_init(st, vf_input_mask(st), &s_vpull.plan);
+    if (rsx_vpull_layout_from_plan(&s_vpull.plan, &s_vpull.lay, &s_vpull.tab_cur)) return 1;
+    s_vpull.n_cpu++;
+    return 0;
+}
+
+static int vp_get_vs_pull(const rsx_state* st)
+{
+    s_vs_pull_req = 1;
+    const int i = vp_get_vs(st);
+    s_vs_pull_req = 0;
+    return i;
+}
+
+/* VPULL upload: one call = one FIFO index batch of a strip record. Copies the
+ * guest bytes of vertices vmin..vmax (plus the tail of the last one) to the
+ * record's region at rec_k * stride, and writes the batch's indices as
+ * rec_k + (vertex - vmin), a restart as the cut. `cont` = the batch continues
+ * the open record. Returns the indices written (s_six_added / s_six_start as
+ * for STRIP_INDEXED); 0xFFFFFFFF = a new record too sparse to pull, take the
+ * CPU path. */
+static u32 upload_strip_vpull(const rsx_state* state, u32 first, u32 count, int cont)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    s_six_added = 0; s_six_start = s_six.off;
+    const rsx_vpull_layout* lay = &s_vpull.lay;
+    const u32 S = lay->stride, bix = s_vpull.plan.base_index;
+    /* Same index and restart rules as upload_strip_vp_native. */
+    const int idx16 = (((state->index_array_dma >> 4) & 0xF) == 1);
+    const int restart = state->restart_enable && !(idx16 && state->restart_index > 0xFFFFu);
+    const u32 ridx = state->restart_index;
+    const u8* ib = vm_base + cellGcmResolveLocated((state->index_array_dma & 0xF) == 0,
+                                                   state->index_array_offset);
+    u32 vmin = 0xFFFFFFFFu, vmax = 0;
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        if (restart && v == ridx) continue;
+        v = (v + bix) & 0x000FFFFFu;
+        if (v < vmin) vmin = v;
+        if (v > vmax) vmax = v;
+    }
+    const u32 span = (vmin <= vmax) ? vmax - vmin + 1u : 0u;
+    /* A new record whose first batch spans far more vertices than it uses
+     * would copy mostly unused bytes: leave it to the CPU path. A continuing
+     * batch is pulled whatever it spans, or the strip would break. */
+    if (!cont && span > 4096u && span > 8u * count) { s_vpull.n_sparse++; return 0xFFFFFFFFu; }
+    if (!cont) { s_vpull.rec_base = (s_vpull.off + 15u) & ~15u; s_vpull.rec_k = 0; }
+    const u64 at = (u64)s_vpull.rec_base + (u64)s_vpull.rec_k * S;
+    const u64 len = span ? (u64)(span - 1u) * S + lay->extent : 0;
+    if (at + len > VPULL_RING_BYTES || count > SIX_CAP - s_six.off) { s_vpull.n_drop++; s_drop_draws++; return 0; }
+    u8* ring = s_vpull.ring_mapped + (u64)s_d3d.vp_parity * (VPULL_RING_BYTES + VPULL_RING_SLACK);
+    if (span) rsx_vpull_copy(ring + at, lay->base + vmin * S, (u32)len, lay->main, s_vpull.plan.local_base);
+    u32* ixo = s_six.mapped + (u64)s_d3d.vp_parity * SIX_CAP + s_six.off;
+    const u32 k0 = s_vpull.rec_k - vmin;   /* index = rec_k + (v - vmin), mod 2^32 */
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        ixo[k] = (restart && v == ridx) ? 0xFFFFFFFFu : k0 + ((v + bix) & 0x000FFFFFu);
+    }
+    if (span) s_vpull.rec_k += span + lay->pad;
+    s_vpull.off = (u32)((u64)s_vpull.rec_base + (u64)s_vpull.rec_k * S);
+    if (!cont && s_d3d.draw_count < MAX_DRAWS)   /* the record this batch opens takes slot draw_count */
+        memcpy(s_vpull.tab_mapped + ((u64)s_d3d.vp_parity * MAX_DRAWS + s_d3d.draw_count) * RSX_VPULL_TAB_BYTES,
+               &s_vpull.tab_cur, RSX_VPULL_TAB_BYTES);
+    s_six.off += count;
+    s_six_added = count;
+    s_vpull.n_batch++; s_vpull.n_rec += cont ? 0u : 1u; s_vpull.bytes += len; s_vpull.idx += count;
+    s_req_verts += count; s_req_draws++;
+    return count;
+}
+
+/* VPULL: does this batch continue the open pulled record? Same BEGIN/END
+ * stream and program, its indices and ring bytes end where this call starts,
+ * same attribute layout. Sets s_vpull_cont for the caller. */
+static int s_vpull_cont = 0;
+static int vpull_continues(const rsx_state* st)
+{
+    const D3D12DrawRecord* pv = s_d3d.draw_count > 0 ? &s_d3d.draws[s_d3d.draw_count - 1] : NULL;
+    s_vpull_cont = pv && s_d3d.merge_prev_draw &&
+                   pv->is_vp && pv->topology == RSX_TOPOLOGY_TRIANGLE_STRIP &&
+                   pv->vpull_gen == s_six.gen && pv->ix_gen == s_six.gen && pv->ix_count &&
+                   pv->fp_addr == (st ? st->shader_program : 0) &&
+                   pv->begin_epoch == (st ? st->begin_epoch : 0) &&
