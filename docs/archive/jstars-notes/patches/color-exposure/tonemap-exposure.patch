+            if (vm_base && foff != 0xFFFFFFFFu) {
                 rsx_fp_extract_consts(vm_base + foff, FP_MAX_BYTES, &ts[20], FP_MAX_KCONST);
+                /* TONEMAP_EXPOSURE=<v>: A/B for the auto-exposure finding
+                 * (jstars-notes COLOR_EXPOSURE.md). J-Stars' tone-map (fp
