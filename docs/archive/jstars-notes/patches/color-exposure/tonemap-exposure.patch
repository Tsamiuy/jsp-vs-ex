+                      if (seen < 6 || (seen % 300) == 0)
+                          fprintf(stderr, "[TONEMAP] fp=0x%08X exposure c1.w=%g%s%c", dr->fp_addr, k[7],
+                                  ex > 0.0f ? " (overridden)" : "", 10);
+                      seen++;
+                      if (ex > 0.0f) k[7] = ex; } }
+            }
