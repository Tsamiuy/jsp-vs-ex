+          fprintf(stderr, "[LUMRT] draw_indexed #%d prim=%u first=%u count=%u noct=%d ready=%d vb=%d\n", _n, primitive, first, count, rsx_no_color_target(), (int)s_d3d.pipeline_ready, (int)s_d3d.vb_mapped); _n++; } }
