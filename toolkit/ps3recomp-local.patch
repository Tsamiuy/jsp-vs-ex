+    /* Runs per FIFO index batch (~2,000 a frame in a fight): the mask of an
+     * unchanged program version (rsx_state.vp_gen) is reused without
+     * re-hashing it. SHADER_HASH_MEMO=0 hashes every time. */
+    static const rsx_state* memo_st = NULL; static u32 memo_gen = 0, memo_mask = 0;
+    if (shader_hash_memo_on() && st->vp_gen && st == memo_st && st->vp_gen == memo_gen)
+        return memo_mask;
+    const u8* vuc = st->vp_ucode + vstart;
+    u32 vlen = st->vp_ucode_bytes - vstart;
+    { u32 ninstr = rsx_vp_program_size_instrs(vuc, vlen);
+      if (ninstr) vlen = ninstr * 16u; }
+    /* Word-wise FNV: this runs per draw, the byte-wise vp_hash_ucode per
+     * compile. vlen is a multiple of 16. */
+    u32 h = 2166136261u;
+    for (u32 i = 0; i + 4 <= vlen; i += 4) { u32 w; memcpy(&w, vuc + i, 4); h ^= w; h *= 16777619u; }
+    h = (h ^ (vstart / 16u)) * 16777619u;
+    static struct { u32 hash, vstart, vlen, mask; } cache[256];
+    const u32 slot = (h ^ (h >> 8) ^ (h >> 16)) & 255u;
+    if (cache[slot].mask && cache[slot].hash == h &&
+        cache[slot].vstart == vstart && cache[slot].vlen == vlen) {
+        memo_st = st; memo_gen = st->vp_gen; memo_mask = cache[slot].mask;
+        return cache[slot].mask;
+    }
+    rsx_vp_input_analysis an;
+    u32 mask = 0xFFFFu;
+    if (rsx_vp_analyze_inputs(vuc, vlen, &an) >= 0 && an.exact)
+        mask = an.input_mask & 0xFFFFu;
+    /* Attribute 0 always: the uploads key on it and the debug paths
+     * (VTX_POS, RSX_DBG_VTX, IDX_DBG) read it back. */
+    mask |= 1u;
+    cache[slot].hash = h; cache[slot].vstart = vstart; cache[slot].vlen = vlen;
+    cache[slot].mask = mask;
+    { static int dbg = -1; if (dbg < 0) dbg = getenv("VFETCH_DBG") ? 1 : 0;
+      if (dbg) fprintf(stderr, "[VFETCH] vp start=%u instrs=%u mask=0x%04X%s%c",
+                       vstart / 16u, vlen / 16u, mask, mask == 0xFFFFu ? " (all)" : "", 10); }
+    memo_st = st; memo_gen = st->vp_gen; memo_mask = mask;
+    return mask;
+}
+
+/* Worker pool. The caller takes chunks too, so VFETCH_THREADS=0 is the
+ * plain single-threaded loop. Draws are recorded on one thread, so one job
+ * at a time. */
+#define VF_MAX_WORKERS 15
+#define VF_CHUNK       512u
+static struct {
+    int    n;                      /* workers, excluding the caller */
+    u32    min_split;
+    HANDLE th[VF_MAX_WORKERS];
+    HANDLE go[VF_MAX_WORKERS];     /* auto-reset, one per worker    */
+    HANDLE done;                   /* auto-reset                    */
+    volatile LONG next;            /* next chunk to take            */
+    volatile LONG busy;            /* workers still on this job     */
+    const rsx_fetch_plan* plan;
+    const rsx_fetch_src*  src;
+    float (*out)[4];
+    u32 total;
+} s_vf;
+
+static void vf_take_chunks(void)
+{
+    for (;;) {
+        const u32 c = (u32)InterlockedIncrement(&s_vf.next) - 1u;
+        const u64 o0 = (u64)c * VF_CHUNK;
+        if (o0 >= s_vf.total) return;
+        u32 o1 = (u32)o0 + VF_CHUNK; if (o1 > s_vf.total) o1 = s_vf.total;
+        rsx_fetch_plan_range(s_vf.plan, s_vf.src, (u32)o0, o1, s_vf.out);
+    }
+}
+
+static DWORD WINAPI vf_worker(LPVOID arg)
+{
+    const int me = (int)(intptr_t)arg;
+    for (;;) {
+        WaitForSingleObject(s_vf.go[me], INFINITE);
+        vf_take_chunks();
+        if (InterlockedDecrement(&s_vf.busy) == 0) SetEvent(s_vf.done);
+    }
+    return 0;
+}
+
+static void vf_pool_init(void)
+{
+    static int inited = 0;
+    if (inited) return;
+    inited = 1;
+    SYSTEM_INFO si; GetSystemInfo(&si);
+    /* Default 3 workers (fewer on small machines). Measured into a real
+     * upload heap (RTX laptop GPU, 400k vertices, 4 attributes): 1 thread
+     * 7.3 ms, 1+1 5.3 ms, 3+1 4.6 ms, 7+1 4.9 ms -- the copy into the
+     * heap saturates, and the PPU/SPU threads need the other cores. */
+    int n = (int)si.dwNumberOfProcessors / 4;
+    if (n > 3) n = 3;
+    { const char* e = getenv("VFETCH_THREADS"); if (e) n = atoi(e); }
+    if (n < 0) n = 0;
+    if (n > VF_MAX_WORKERS) n = VF_MAX_WORKERS;
+    s_vf.min_split = 2048u;
+    { const char* e = getenv("VFETCH_MIN"); if (e) s_vf.min_split = (u32)strtoul(e, NULL, 0); }
+    s_vf.done = CreateEventA(NULL, FALSE, FALSE, NULL);
+    for (int i = 0; i < n && s_vf.done; i++) {
+        s_vf.go[i] = CreateEventA(NULL, FALSE, FALSE, NULL);
+        if (!s_vf.go[i]) break;
+        s_vf.th[i] = CreateThread(NULL, 0, vf_worker, (LPVOID)(intptr_t)i, 0, NULL);
+        if (!s_vf.th[i]) { CloseHandle(s_vf.go[i]); s_vf.go[i] = NULL; break; }
+        s_vf.n = i + 1;
+    }
+    fprintf(stderr, "[VFETCH] %d worker thread(s), split draws >= %u vertices%c",
+            s_vf.n, s_vf.min_split, 10);
+}
+
+/* Fetch `total` output vertices of the current draw into out. */
+static void vf_fetch(const rsx_state* state, const rsx_fetch_src* src,
+                     u32 total, VPSlot* out)
+{
+    if (!total) return;
+    rsx_fetch_plan plan;
+    rsx_fetch_plan_init(state, vf_input_mask(state), &plan);
+    float (*o4)[4] = (float (*)[4])out;
+    vf_pool_init();
+    int nw = 0;
+    if (s_vf.n > 0 && total >= s_vf.min_split) {
+        const u32 chunks = (total + VF_CHUNK - 1u) / VF_CHUNK;
+        nw = (int)chunks - 1;               /* the caller takes one */
+        if (nw > s_vf.n) nw = s_vf.n;
+    }
+    if (nw <= 0) {
+        rsx_fetch_plan_range(&plan, src, 0, total, o4);
+    } else {
+        s_vf.plan = &plan; s_vf.src = src; s_vf.out = o4; s_vf.total = total;
+        s_vf.next = 0;
+        s_vf.busy = nw;
+        MemoryBarrier();
+        for (int i = 0; i < nw; i++) SetEvent(s_vf.go[i]);
+        vf_take_chunks();
+        WaitForSingleObject(s_vf.done, INFINITE);
+    }
+    /* VTX_POS: the first fetched position of each draw (read_vp_vertex
+     * reported every vertex until the cap; one per draw is more useful). */
+    { const rsx_vertex_attrib* a = &state->vertex_attribs[0];
+      u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+      rsx_vtx_pos_dbg(state, out[0].v, n); }
+}
+
+/* The index array, resolved once per draw (read_guest_index resolves it per
+ * index). */
+static void vf_src_init(rsx_fetch_src* s, const rsx_state* st, u32 first, int indexed, int topo)
+{
+    extern uint8_t* vm_base;
+    s->first = first;
+    s->topo  = (u8)topo;
+    s->isize = 0;
+    s->ib    = NULL;
+    s->vlist = NULL;
+    if (indexed) {
+        const int local = ((st->index_array_dma & 0xF) == 0);
+        s->ib    = vm_base + cellGcmResolveLocated(local, st->index_array_offset);
+        s->isize = (((st->index_array_dma >> 4) & 0xF) == 1) ? 2 : 4;
+    }
+}
+
+/* One vertex through the plan (the native strip path walks restarts itself),
+ * or through read_vp_vertex when there is no plan. */
+static void vf_one(const rsx_fetch_plan* plan, const rsx_state* st, u32 v, VPSlot* dst)
+{
+    if (!plan) { read_vp_vertex(st, v, dst); return; }
+    rsx_fetch_src s1 = { v, RSX_FETCH_LIST, 0, NULL, NULL };
+    rsx_fetch_plan_range(plan, &s1, 0, 1, (float (*)[4])dst);
+}
+
+/* ---------------------------------------------------------------------------
+ * VFETCH_ASYNC=1 (opt-in): strip fetches run on worker threads.
+ *
+ * In a match the present thread is the only busy thread (sampler, run3), and
+ * half its time is the strip vertex fetch -- each FIFO batch of <=256 indices,
+ * too small for the split in vf_fetch. Here the strip paths only build the
+ * vertex list and the plan (both from the CURRENT state and index buffer) and
+ * queue them; workers decode while the walker carries on with the FIFO.
+ *
+ * Nothing that reads the results may run first, so every queued fetch is
+ * finished (vfa_sync) before:
+ *   - render_frame (the command list reads vp_vb), mid-frame flushes included;
+ *   - any method that tells the guest the RSX has progressed: labels,
+ *     semaphores, SET_REFERENCE, reports (g_rsx_sync_hook, rsx_commands.c) --
+ *     so the guest cannot reuse a vertex buffer before it was read;
+ *   - blits, user commands and flips in the walker (cellGcmSys.c);
+ *   - a native-strip join that copies the previous call's last vertex, and
+ *     the STRIP_DUMP diagnostic.
+ * The fetch itself is the same code on the same inputs; only the moment it
+ * reads guest memory moves, and it stays before anything the guest can see.
+ * VTX_POS is not reported for queued fetches.
+ * ------------------------------------------------------------------------- */
+typedef struct { rsx_fetch_plan plan; u32 list_off, n; VPSlot* out; } VfaJob;
+#define VFA_JOBS 4096
+static struct {
+    int     on;                   /* -1 = not decided yet */
+    int     nthreads;
+    HANDLE  sem;
+    VfaJob* jobs;
+    u32*    arena;  u32 arena_cap, arena_used;
+    volatile LONG posted, taken, done;
+    /* VFA_WAKE (default on, =0 = the old one-ReleaseSemaphore-per-job): a job
+     * wakes a worker only if one is asleep, workers run the queue dry before
+     * sleeping, and the counters never reset (base = posted at the last sync),
+     * so a worker that is still looking at the queue cannot mistake a new
+     * job for an old one. VFA_SPIN=<n>: one worker at a time polls n pauses
+     * before sleeping (default 0: no extra CPU). VFA_INLINE=<n>: jobs under n
+     * vertices are fetched right here instead of queued (default 0). */
+    int     wake, spin;  u32 inline_max;
+    volatile LONG sleepers, spinning;
+    LONG    base;
+    u32     n_jobs, n_wakes, n_inline;  u64 n_verts;   /* per [PERF] window */
+} s_vfa = { .on = -1 };
+
+/* Claims and runs the next queued job; 0 = the queue is empty. consume_sem:
+ * the old mode's sync helper takes the job's semaphore count too. */
+static int vfa_run_one(int consume_sem)
+{
+    for (;;) {
+        const LONG t = s_vfa.taken;
+        if ((LONG)((ULONG)t - (ULONG)s_vfa.posted) >= 0) return 0;
+        if (InterlockedCompareExchange(&s_vfa.taken, t + 1, t) != t) continue;
+        if (consume_sem) WaitForSingleObject(s_vfa.sem, 0);
+        VfaJob* j = &s_vfa.jobs[(u32)t % VFA_JOBS];
+        rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, s_vfa.arena + j->list_off };
+        rsx_fetch_plan_range(&j->plan, &src, 0, j->n, (float (*)[4])j->out);
+        InterlockedIncrement(&s_vfa.done);
+        return 1;
+    }
+}
+
+/* VFA_WAKE: take one sleeping worker's place in the count (0 = none asleep). */
+static int vfa_claim_sleeper(void)
+{
+    LONG s = s_vfa.sleepers;
+    while (s > 0) {
+        const LONG o = InterlockedCompareExchange(&s_vfa.sleepers, s - 1, s);
+        if (o == s) return 1;
+        s = o;
+    }
+    return 0;
+}
+
+static int vfa_queued(void) { return (LONG)((ULONG)s_vfa.taken - (ULONG)s_vfa.posted) < 0; }
+
+/* [VFA] per [PERF] window: queued jobs, their size, worker wake-ups. */
+static void vfa_perf_line(void)
+{
+    if (s_vfa.on <= 0) return;
+    fprintf(stderr, "[VFA] jobs %u (%.0f vertices avg) | worker wakes %u | inline %u%c",
+            s_vfa.n_jobs, s_vfa.n_jobs ? (double)s_vfa.n_verts / s_vfa.n_jobs : 0.0,
+            s_vfa.n_wakes, s_vfa.n_inline, 10);
+    s_vfa.n_jobs = s_vfa.n_wakes = s_vfa.n_inline = 0; s_vfa.n_verts = 0;
+}
+
+static DWORD WINAPI vfa_worker(LPVOID arg)
+{
+    (void)arg;
+    if (!s_vfa.wake) {
+        for (;;) {
+            WaitForSingleObject(s_vfa.sem, INFINITE);
+            /* Claim the next job by CAS: vfa_sync may have run it already (it
+             * helps), in which case this wake-up finds nothing and sleeps again. */
+            vfa_run_one(0);
+        }
+    }
+    for (;;) {
+        while (vfa_run_one(0)) {}
+        if (s_vfa.spin > 0 && InterlockedCompareExchange(&s_vfa.spinning, 1, 0) == 0) {
+            int got = 0;
+            for (int i = 0; i < s_vfa.spin && !got; i++) { _mm_pause(); got = vfa_queued(); }
+            InterlockedExchange(&s_vfa.spinning, 0);
+            if (got) continue;
+        }
+        /* Announce the sleep, then look once more: a job posted in between
+         * either sees this sleeper (and releases the semaphore) or is seen
+         * here. If the poster already claimed this sleeper, its release is
+         * on the way and the wait returns at once. */
+        InterlockedIncrement(&s_vfa.sleepers);
+        if (vfa_queued() && vfa_claim_sleeper()) continue;
+        WaitForSingleObject(s_vfa.sem, INFINITE);
+    }
+    return 0;
+}
+
+static int vfa_enabled(void)
+{
+    if (s_vfa.on >= 0) return s_vfa.on;
+    s_vfa.on = 0;
+    /* On by default (2026-10-20 perf runs); VFETCH_ASYNC=0 turns it off. */
+    { const char* e = getenv("VFETCH_ASYNC"); if ((e && *e == '0') || vf_legacy()) return 0; }
+    SYSTEM_INFO si; GetSystemInfo(&si);
+    int n = (int)si.dwNumberOfProcessors / 4; if (n > 3) n = 3; if (n < 1) n = 1;
+    { const char* e = getenv("VFETCH_ASYNC_THREADS"); if (e && atoi(e) > 0) n = atoi(e); }
+    if (n > 8) n = 8;
+    { const char* e = getenv("VFA_WAKE");   s_vfa.wake = !(e && *e == '0'); }
+    { const char* e = getenv("VFA_SPIN");   s_vfa.spin = (e && s_vfa.wake) ? atoi(e) : 0; }
+    { const char* e = getenv("VFA_INLINE"); s_vfa.inline_max = e ? (u32)strtoul(e, NULL, 0) : 0u; }
+    s_vfa.jobs = (VfaJob*)malloc(sizeof(VfaJob) * VFA_JOBS);
+    s_vfa.arena_cap = MAX_VP_VERTICES;
+    s_vfa.arena = (u32*)malloc(sizeof(u32) * s_vfa.arena_cap);
+    s_vfa.sem = CreateSemaphoreA(NULL, 0, VFA_JOBS, NULL);
+    if (!s_vfa.jobs || !s_vfa.arena || !s_vfa.sem) return 0;
+    for (int i = 0; i < n; i++) {
+        HANDLE h = CreateThread(NULL, 0, vfa_worker, NULL, 0, NULL);
+        if (!h) break;
+        CloseHandle(h);
+        s_vfa.nthreads++;
+    }
+    if (!s_vfa.nthreads) return 0;
+    g_rsx_sync_hook = vfa_sync;
+    s_vfa.on = 1;
+    fprintf(stderr, "[VFETCH] async strip fetch on, %d worker thread(s), VFA_WAKE=%d VFA_SPIN=%d VFA_INLINE=%u%c",
+            s_vfa.nthreads, s_vfa.wake, s_vfa.spin, s_vfa.inline_max, 10);
+    return 1;
+}
+
+static void vfa_sync(void)
+{
+    if (s_vfa.on <= 0 || s_vfa.posted == s_vfa.base) return;
+    if (s_vfa.done != s_vfa.posted) {
+        const double t0 = perf_on() ? perf_now() : 0.0;
+        /* The present thread helps instead of only waiting. In the old mode
+         * each job it takes also consumes that job's semaphore count, so a
+         * worker does not wake for it. */
+        while (vfa_run_one(!s_vfa.wake)) {}
+        while (s_vfa.done != s_vfa.posted) _mm_pause();
+        if (perf_on()) s_perf_vfa_wait += perf_now() - t0;
+    }
+    MemoryBarrier();
+    if (s_vfa.wake) s_vfa.base = s_vfa.posted;
+    else            s_vfa.posted = s_vfa.taken = s_vfa.done = 0;
+    s_vfa.arena_used = 0;
+}
+
+/* Fetch list[0..n) into out: queued when VFETCH_ASYNC is on, else now. */
+static void vfa_fetch_list(const rsx_state* state, const u32* list, u32 n, VPSlot* out)
+{
+    if (!n) return;
+    if (!vfa_enabled()) {
+        rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, list };
+        vf_fetch(state, &src, n, out);
+        return;
+    }
+    if (n < s_vfa.inline_max || n > s_vfa.arena_cap) {   /* VFA_INLINE / cannot queue: do it here */
+        rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, list };
+        vf_fetch(state, &src, n, out);
+        s_vfa.n_inline++;
+        return;
+    }
+    if ((ULONG)s_vfa.posted - (ULONG)s_vfa.base >= VFA_JOBS || s_vfa.arena_used + n > s_vfa.arena_cap) vfa_sync();
+    VfaJob* j = &s_vfa.jobs[(u32)s_vfa.posted % VFA_JOBS];
+    rsx_fetch_plan_init(state, vf_input_mask(state), &j->plan);
+    memcpy(s_vfa.arena + s_vfa.arena_used, list, (size_t)n * sizeof(u32));
+    j->list_off = s_vfa.arena_used; j->n = n; j->out = out;
+    s_vfa.arena_used += n;
+    MemoryBarrier();
+    InterlockedIncrement(&s_vfa.posted);
+    s_vfa.n_jobs++; s_vfa.n_verts += n;
+    if (!s_vfa.wake || vfa_claim_sleeper()) { ReleaseSemaphore(s_vfa.sem, 1, NULL); s_vfa.n_wakes++; }
 }
 
