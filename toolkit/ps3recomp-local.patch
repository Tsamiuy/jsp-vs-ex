+/* Returns 1 when it ran: the caller rebinds its target and forgets its cached PSO, viewport and topology. */
+static int aa_pass(int rt, int mode, D3D12_GPU_DESCRIPTOR_HANDLE gh_base)
+{
+    OffRT* r = &s_d3d.off_rt[rt];
