+/* AA: a title port's hook returns the edge smoothing wanted for a draw that fills
+ * rt_off (0 off, 1 FXAA, 2 stronger FXAA, 3 SMAA). The pass runs right after the game copies
+ * its finished scene into the HUD's target, so the HUD drawn next stays sharp. Same
+ * root signature as the game's draws, so only the PSO, targets and viewport change.
+ * The shader is a plain FXAA: find the edge, walk along it, blend across it. */
+int (*g_rsx_aa_mode)(u32 rt_off) = 0;
+static ID3D12PipelineState* s_aa_pso;
+static ID3D12Resource* s_aa_tmp;
+static D3D12_RESOURCE_STATES s_aa_tmp_st;
+static int s_aa_pso_mode;
+static u64 s_aa_frame = (u64)-1;
+
+static ID3D12PipelineState* aa_get_pso(int mode, DXGI_FORMAT fmt)
+{
+    if (s_aa_pso && s_aa_pso_mode == mode) return s_aa_pso;
+    if (s_aa_pso_mode < 0) return NULL;   /* failed before */
+    static const char vs[] =
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+        "O main(uint i : SV_VertexID) { O o; o.uv = float2((i << 1) & 2, i & 2);\n"
+        "  o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n";
+    static const char ps[] =
+        "Texture2D t0 : register(t0); SamplerState lin : register(s1);\n"
+        "static const float Q[12] = { 1, 1, 1, 1, 1.5, 2, 2, 2, 2, 4, 8, 8 };\n"
+        "float L(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }\n"
+        "float3 S(float2 uv, float2 px) { return t0.SampleLevel(lin, clamp(uv, px * 0.5, 1 - px * 0.5), 0).rgb; }\n"
+        "float LS(float2 uv, float2 px) { return L(S(uv, px)); }\n"
+        "float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "  uint w, h; t0.GetDimensions(w, h); const float2 px = 1.0 / float2(w, h);\n"
+        "  const float4 c = t0.SampleLevel(lin, uv, 0);\n"
+        "  const float m = L(c.rgb), n = LS(uv + float2(0, -px.y), px), so = LS(uv + float2(0, px.y), px);\n"
+        "  const float e = LS(uv + float2(px.x, 0), px), we = LS(uv + float2(-px.x, 0), px);\n"
+        "  const float lo = min(m, min(min(n, so), min(e, we))), hi = max(m, max(max(n, so), max(e, we)));\n"
+        "  const float range = hi - lo;\n"
+        "  if (range < max(AA_MIN, hi * AA_THR)) return c;\n"
+        "  const float nw = LS(uv - px, px), se = LS(uv + px, px);\n"
+        "  const float ne = LS(uv + float2(px.x, -px.y), px), sw = LS(uv + float2(-px.x, px.y), px);\n"
+        "  const bool horz = abs(nw + sw - 2 * we) + 2 * abs(n + so - 2 * m) + abs(ne + se - 2 * e)\n"
+        "                 >= abs(nw + ne - 2 * n) + 2 * abs(we + e - 2 * m) + abs(sw + se - 2 * so);\n"
+        "  const float l1 = horz ? n : we, l2 = horz ? so : e;\n"
+        "  const float g1 = abs(l1 - m), g2 = abs(l2 - m);\n"
+        "  float stepl = horz ? px.y : px.x; float avg;\n"
+        "  if (g1 >= g2) { stepl = -stepl; avg = 0.5 * (l1 + m); } else avg = 0.5 * (l2 + m);\n"
+        "  const float gs = 0.25 * max(g1, g2);\n"
+        "  float2 cu = uv; if (horz) cu.y += 0.5 * stepl; else cu.x += 0.5 * stepl;\n"
+        "  const float2 off = horz ? float2(px.x, 0) : float2(0, px.y);\n"
+        "  float2 a = cu - off, b = cu + off; float ea = LS(a, px) - avg, eb = LS(b, px) - avg;\n"
+        "  bool da = abs(ea) >= gs, db = abs(eb) >= gs;\n"
+        "  for (int i = 1; i < 12 && !(da && db); i++) {\n"
+        "    if (!da) { a -= off * Q[i]; ea = LS(a, px) - avg; da = abs(ea) >= gs; }\n"
+        "    if (!db) { b += off * Q[i]; eb = LS(b, px) - avg; db = abs(eb) >= gs; }\n"
+        "  }\n"
+        "  const float d1 = horz ? uv.x - a.x : uv.y - a.y, d2 = horz ? b.x - uv.x : b.y - uv.y;\n"
+        "  const bool near1 = d1 < d2; const float dn = min(d1, d2), span = d1 + d2;\n"
+        "  const bool less = m < avg;\n"
+        "  const bool good = ((near1 ? ea : eb) < 0) != less;\n"
+        "  float o = good ? 0.5 - dn / span : 0;\n"
+        "  const float blur = saturate(abs((2 * (n + so + e + we) + nw + ne + sw + se) / 12 - m) / range);\n"
+        "  const float sub = smoothstep(0, 1, blur); o = max(o, sub * sub * AA_SUB);\n"
+        "  float2 f = uv; if (horz) f.y += o * stepl; else f.x += o * stepl;\n"
+        "  return float4(S(f, px), c.a);\n"
+        "}\n";
+    const D3D_SHADER_MACRO defs[][4] = {
+        { { "AA_THR", "0.125" }, { "AA_MIN", "0.0312" }, { "AA_SUB", "0.75" }, { NULL, NULL } },
+        { { "AA_THR", "0.063" }, { "AA_MIN", "0.0156" }, { "AA_SUB", "1.0" }, { NULL, NULL } } };
+    ID3DBlob* vb = NULL; ID3DBlob* pb = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(vs, sizeof(vs) - 1, "aa_vs", NULL, NULL, "main", "vs_5_0", 0, 0, &vb, &e);
+    if (e) { e->lpVtbl->Release(e); e = NULL; }
+    if (SUCCEEDED(hr)) hr = D3DCompile(ps, sizeof(ps) - 1, "aa_ps", defs[mode == 2], NULL, "main", "ps_5_0", 0, 0, &pb, &e);
+    if (e) { fprintf(stderr, "[AA] %s%c", (const char*)e->lpVtbl->GetBufferPointer(e), 10); e->lpVtbl->Release(e); }
+    if (SUCCEEDED(hr)) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+        pd.pRootSignature = s_d3d.vp_root_sig;
+        pd.VS.pShaderBytecode = vb->lpVtbl->GetBufferPointer(vb); pd.VS.BytecodeLength = vb->lpVtbl->GetBufferSize(vb);
+        pd.PS.pShaderBytecode = pb->lpVtbl->GetBufferPointer(pb); pd.PS.BytecodeLength = pb->lpVtbl->GetBufferSize(pb);
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = UINT_MAX;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        if (strip_ix_on() || vpull_on()) pd.IBStripCutValue = D3D12_INDEX_BUFFER_STRIP_CUT_VALUE_0xFFFFFFFF;
+        pd.NumRenderTargets = 1; pd.RTVFormats[0] = fmt;
+        pd.SampleDesc.Count = 1;
+        hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(s_d3d.device, &pd, &IID_ID3D12PipelineState, (void**)&s_aa_pso);
+    }
+    if (vb) vb->lpVtbl->Release(vb);
+    if (pb) pb->lpVtbl->Release(pb);
+    if (FAILED(hr)) { s_aa_pso = NULL; s_aa_pso_mode = -1; fprintf(stderr, "[AA] pipeline failed (0x%08lX)%c", hr, 10); return NULL; }
+    s_aa_pso_mode = mode;
+    fprintf(stderr, "[AA] mode %d on%c", mode, 10);
+    return s_aa_pso;
+}
