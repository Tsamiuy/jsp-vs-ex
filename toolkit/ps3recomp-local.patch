+    static u32* s_nl = NULL; static u32 s_nl_cap = 0;
+    int use_list = 0;
+    if (!pervertex && !vf_legacy()) {
+        u64 need = (u64)count * 4u;
+        if (need > maxv) need = maxv;
+        if (need > s_nl_cap) {
+            u32 cap = s_nl_cap ? s_nl_cap : 4096u;
+            while (cap < need) cap *= 2u;
+            u32* nv = (u32*)realloc(s_nl, (size_t)cap * sizeof(u32));
+            if (nv) { s_nl = nv; s_nl_cap = cap; }
+        }
+        use_list = s_nl && s_nl_cap >= need;
+    }
+    int prev0 = 0;   /* output 0 repeats the previous call's last vertex */
+    rsx_fetch_plan _plan, *plan = NULL;
+    if (!use_list && !vf_legacy()) { rsx_fetch_plan_init(state, vf_input_mask(state), &_plan); plan = &_plan; }
+    u32 o = 0;
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (!indexed) v = first + k;
+        else if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        if (restart && v == ridx) { if (t0 + o) s_strip_pending = 1; continue; }
+        if (o + 4 > maxv) { s_drop_draws++; break; }
+        if (s_strip_pending && t0 + o > 0) {
+            /* join: repeat the previous vertex, then this one (twice if the
+             * piece would otherwise start at an odd position). Decoded once. */
+            if (use_list) {
+                if (o == 0) {
+                    if (s_native_last_ok && !carry_off) s_nl[o] = s_native_last_vi;
+                    else { prev0 = 1; s_nl[o] = v; }   /* placeholder, fixed below */
+                }
+                else        s_nl[o] = s_nl[o - 1];
+                o++;
+                s_nl[o] = v; o++;
+                if ((t0 + o) & 1) { s_nl[o] = s_nl[o - 1]; o++; }
+                s_nl[o] = s_nl[o - 1]; o++;
+                s_strip_pending = 0;
+                continue;
+            }
+            memcpy(&out[o*16], &out[((int)o - 1)*16], VP_VERT_STRIDE); o++;
+            vf_one(plan, state, v, &out[o*16]); o++;
+            if ((t0 + o) & 1) { memcpy(&out[o*16], &out[(o - 1)*16], VP_VERT_STRIDE); o++; }
+            memcpy(&out[o*16], &out[(o - 1)*16], VP_VERT_STRIDE); o++;
+            s_strip_pending = 0;
+            continue;
+        }
+        s_strip_pending = 0;
+        if (use_list) { s_nl[o] = v; o++; }
+        else { vf_one(plan, state, v, &out[o*16]); o++; }
+    }
+    if (!use_list && o) s_native_last_ok = 0;
+    if (use_list && o) {
+        s_native_last_vi = s_nl[o - 1];   /* (a prev0 placeholder is never last) */
+        s_native_last_ok = 1;
+        if (prev0) {
+            /* out[-1] may still be queued: finish it, then fetch and copy. */
+            vfa_sync();
+            rsx_fetch_src src = { 0, RSX_FETCH_VLIST, 0, NULL, s_nl };
+            vf_fetch(state, &src, o, out);
+            memcpy(&out[0], &out[-16], VP_VERT_STRIDE);
+        } else {
+            vfa_fetch_list(state, s_nl, o, out);
+        }
+    }
+    /* STRIP_DUMP=<frame>: from that backend frame on, describe a few new strip
+     * records -- index format, restart state, first indices, first decoded
+     * positions -- to compare with what the expansion path reads. */
+    { static int sd = -1; static int nd = 0;
+      if (sd < 0) { const char* e = getenv("STRIP_DUMP"); sd = e ? atoi(e) : 0; }
+      if (sd && t0 == 0 && s_d3d.frame_count >= (u64)sd && nd < 12 && o >= 3) { nd++;
+        vfa_sync();   /* the dump reads the fetched vertices */
+        fprintf(stderr, "[STRIP] first=%u count=%u -> %u verts idx16=%d restart=%d/0x%X dma=0x%X"
+                        " fp=0x%X", first, count, o, idx16, state->restart_enable,
+                state->restart_index, state->index_array_dma, state->shader_program);
+        for (u32 k = 0; k < 6 && k < count && indexed; k++) {
+            const u8* q = ib + (u64)(first + k) * (idx16 ? 2 : 4);
+            fprintf(stderr, " i%u=%u", k, idx16 ? (((u32)q[0] << 8) | q[1])
+                                     : (((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]));
+        }
+        for (u32 k = 0; k < 3; k++)
+            fprintf(stderr, " p%u=(%.3g,%.3g,%.3g,%.3g)", k, out[k*16].v[0], out[k*16].v[1],
+                    out[k*16].v[2], out[k*16].v[3]);
+        fputc(10, stderr); } }
+    s_d3d.vp_vb_offset += o * VP_VERT_STRIDE;
+    return o;
+}
+
+/* Mid-frame flush. J-Stars' match scene (strips expanded to triangle lists)
+ * needs more than MAX_VP_VERTICES in one frame. The uploads used to clip
+ * silently once the buffer was full, so every later op that frame -- the
+ * post chain, the HUD composite and the display pass -- was never recorded,
+ * no batch ever held a display draw, and nothing was presented (jstars-notes
+ * FINDINGS §22). Before a VP upload that might not fit, run the batch so far
+ * without presenting and start an empty one; offscreen RTs keep their
+ * contents across batches, so the rest of the frame continues on top.
+ * `count` is the guest vertex/index count; strips and fans expand to at most
+ * 3x that. A batch that continues the previous record's stream (`cont`) is
+ * only split when it really does not fit, since splitting it would break the
+ * stream. VP_NO_MIDFLUSH=1 restores the old clipping. */
+#define VP_FLUSH_MARGIN 65536u   /* vertices kept free at a stream boundary */
+/* STRIP_INDEXED upload: one call = one FIFO index batch of a strip record.
+ * `t0` = the record's vertex count so far (0 = new record). Distinct guest
+ * vertices of the record are listed once (dedup map keyed by record tag and
+ * guest index) and fetched through the normal list fetch; each index becomes
+ * the record-relative vertex number, a restart becomes the cut 0xFFFFFFFF.
+ * Returns the vertices added; s_six_added / s_six_start describe the
+ * indices. */
+static u32 s_six_added, s_six_start;
+static u32 upload_strip_vp_native_ix(const rsx_state* state, u32 first, u32 count, u32 t0)
+{
+    extern uint8_t* vm_base;
+    s_six_added = 0; s_six_start = s_six.off;
+    s_req_verts += count; s_req_draws++;
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped || !s_six.mapped) return 0;
+    if (!state->vertex_attribs[0].enabled) return 0;
+    if (t0 == 0) s_six.tag++;
+    const u32 maxv = (MAX_VP_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) / VP_VERT_STRIDE;
+    const u32 ixroom = SIX_CAP - s_six.off;
+    VPSlot* out = (VPSlot*)((u8*)s_d3d.vp_vb_mapped
+        + (u64)s_d3d.vp_parity * MAX_VP_VERTICES * VP_VERT_STRIDE + s_d3d.vp_vb_offset);
+    u32* ixo = s_six.mapped + (u64)s_d3d.vp_parity * SIX_CAP + s_six.off;
+    /* Same index and restart rules as upload_strip_vp_native. */
+    const int idx16 = (((state->index_array_dma >> 4) & 0xF) == 1);
+    const int restart = state->restart_enable && !(idx16 && state->restart_index > 0xFFFFu);
+    const u32 ridx = state->restart_index;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    const u8* ib = vm_base + cellGcmResolveLocated((state->index_array_dma & 0xF) == 0,
+                                                   state->index_array_offset);
+    static u32* s_vl = NULL; static u32 s_vl_cap = 0;
+    if (count > s_vl_cap) {
+        u32 cap = s_vl_cap ? s_vl_cap : 4096u;
+        while (cap < count) cap *= 2u;
+        u32* nv = (u32*)realloc(s_vl, (size_t)cap * sizeof(u32));
+        if (!nv) return 0;
+        s_vl = nv; s_vl_cap = cap;
+    }
+    /* Dedup map: guest index -> record-relative vertex, valid for one tag. A
+     * full probe run just appends the vertex again, which is still correct. */
+    enum { DM = 1u << 16, PROBE = 8 };
+    static u32 dm_tag[DM], dm_vi[DM], dm_loc[DM];
+    u32 nv = 0, ni = 0;
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        if (ni + 1 > ixroom) { s_drop_draws++; break; }
+        if (restart && v == ridx) { ixo[ni++] = 0xFFFFFFFFu; continue; }
+        u32 h = (v * 2654435761u) >> 16, loc = 0xFFFFFFFFu, freeslot = 0xFFFFFFFFu;
+        for (u32 pz = 0; pz < PROBE; pz++) {
+            const u32 s = (h + pz) & (DM - 1);
+            if (dm_tag[s] != s_six.tag) { if (freeslot == 0xFFFFFFFFu) freeslot = s; continue; }
+            if (dm_vi[s] == v) { loc = dm_loc[s]; break; }
+        }
+        if (loc == 0xFFFFFFFFu) {
+            if (nv + 1 > maxv) { s_drop_draws++; break; }
+            loc = t0 + nv;
+            s_vl[nv++] = v;
+            if (freeslot != 0xFFFFFFFFu) { dm_tag[freeslot] = s_six.tag; dm_vi[freeslot] = v; dm_loc[freeslot] = loc; }
+        }
+        ixo[ni++] = loc;
+    }
+    if (nv) vfa_fetch_list(state, s_vl, nv, out);
+    s_six_added = ni;
+    s_six.off += ni;
+    s_d3d.vp_vb_offset += nv * VP_VERT_STRIDE;
+    return nv;
+}
+
+/* VPULL: can the current state's strips be pulled? Builds the fetch plan and
+ * the record layout into s_vpull for upload_strip_vpull. */
+static int vpull_prepare(const rsx_state* st)
+{
+    extern uint8_t* vm_base;
+    if (!st || !vm_base || !s_vpull.ring_mapped || !s_six.mapped) return 0;
+    if (!st->vertex_attribs[0].enabled) return 0;
+    /* VPULL_MEMO (default on, VPULL_MEMO=0 off): a strip record arrives as
+     * many 256-index batches with the same vertex state, and this rebuilt the
+     * fetch plan and layout for every one (13% of the drawing thread's own
+     * time on Hidden Leaf, jstars-notes CPU_PROFILE §32). The plan depends only
+     * on the vertex program (vp_gen) and the vertex-array state (vattr_gen),
+     * both renewed on every write that could change it, so while neither has
+     * changed the plan, layout and table from last time are the same. */
+    static int memo = -1;
+    if (memo < 0) { const char* e = getenv("VPULL_MEMO"); memo = (e && *e == '0') ? 0 : 1; }
+    static const rsx_state* m_st = NULL; static u32 m_vp = 0, m_attr = 0; static int m_ok = 0;
+    if (memo && st->vp_gen && st->vattr_gen && st == m_st && st->vp_gen == m_vp && st->vattr_gen == m_attr) {
+        if (!m_ok) s_vpull.n_cpu++;
+        return m_ok;
+    }
+    rsx_fetch_plan_init(st, vf_input_mask(st), &s_vpull.plan);
+    m_ok = rsx_vpull_layout_from_plan(&s_vpull.plan, &s_vpull.lay, &s_vpull.tab_cur);
+    m_st = st; m_vp = st->vp_gen; m_attr = st->vattr_gen;
+    if (m_ok) return 1;
+    s_vpull.n_cpu++;
+    return 0;
+}
+
+static int vp_get_vs_pull(const rsx_state* st)
+{
+    s_vs_pull_req = 1;
+    const int i = vp_get_vs(st);
+    s_vs_pull_req = 0;
+    return i;
+}
+
+/* VPULL upload: one call = one FIFO index batch of a strip record. Copies the
+ * guest bytes of vertices vmin..vmax (plus the tail of the last one) to the
+ * record's region at rec_k * stride, and writes the batch's indices as
+ * rec_k + (vertex - vmin), a restart as the cut. `cont` = the batch continues
+ * the open record. Returns the indices written (s_six_added / s_six_start as
+ * for STRIP_INDEXED); 0xFFFFFFFF = a new record too sparse to pull, take the
+ * CPU path. */
+static u32 upload_strip_vpull(const rsx_state* state, u32 first, u32 count, int cont)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    s_six_added = 0; s_six_start = s_six.off;
+    const rsx_vpull_layout* lay = &s_vpull.lay;
+    const u32 S = lay->stride, bix = s_vpull.plan.base_index;
+    /* Same index and restart rules as upload_strip_vp_native. */
+    const int idx16 = (((state->index_array_dma >> 4) & 0xF) == 1);
+    const int restart = state->restart_enable && !(idx16 && state->restart_index > 0xFFFFu);
+    const u32 ridx = state->restart_index;
+    const u8* ib = vm_base + cellGcmResolveLocated((state->index_array_dma & 0xF) == 0,
+                                                   state->index_array_offset);
+    u32 vmin = 0xFFFFFFFFu, vmax = 0;
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        if (restart && v == ridx) continue;
+        v = (v + bix) & 0x000FFFFFu;
+        if (v < vmin) vmin = v;
+        if (v > vmax) vmax = v;
+    }
+    const u32 span = (vmin <= vmax) ? vmax - vmin + 1u : 0u;
+    /* A new record whose first batch spans far more vertices than it uses
+     * would copy mostly unused bytes: leave it to the CPU path. A continuing
+     * batch is pulled whatever it spans, or the strip would break. */
+    if (!cont && span > 4096u && span > 8u * count) { s_vpull.n_sparse++; return 0xFFFFFFFFu; }
+    if (!cont) { s_vpull.rec_base = (s_vpull.off + 15u) & ~15u; s_vpull.rec_k = 0; s_vpull.seg_valid = 0; }
+    /* VPULL_ONCE (default on, VPULL_ONCE=0 off): the batches of one record
+     * walk the same model, so copying each batch's whole span re-copied the
+     * same vertices over and over (~47 MB per batch in the demo), which
+     * filled the 64 MB ring and split heavy frames in two (CPU_PROFILE §17,
+     * §20). A batch whose vertices lie in, or just above, the record's
+     * current segment uses the copy already made and appends only the
+     * vertices above it; a batch that starts below the segment opens a new
+     * one, as every batch did before. */
+    static int once = -1;
+    if (once < 0) { const char* e = getenv("VPULL_ONCE"); once = (e && *e == '0') ? 0 : 1; }
+    u64 at = 0, len = 0; u32 copy_lo = vmin, k0 = 0, seg_k = 0, seg_lo = 0, seg_hi = 0;
+    if (span) {
+        if (once && cont && s_vpull.seg_valid && vmin >= s_vpull.seg_lo &&
+            vmin <= s_vpull.seg_hi + 64u) {
+            seg_k = s_vpull.seg_k; seg_lo = s_vpull.seg_lo; seg_hi = s_vpull.seg_hi;
+            if (vmax >= seg_hi) {   /* append seg_hi..vmax after the segment */
+                copy_lo = seg_hi;
+                at = (u64)s_vpull.rec_base + (u64)(seg_k + (seg_hi - seg_lo)) * S;
+                len = (u64)(vmax - seg_hi) * S + lay->extent;
+                seg_hi = vmax + 1u;
+            }
+        } else {                    /* a new segment at the end of the record */
+            seg_k = s_vpull.rec_k; seg_lo = vmin; seg_hi = vmax + 1u;
+            at = (u64)s_vpull.rec_base + (u64)s_vpull.rec_k * S;
+            len = (u64)(span - 1u) * S + lay->extent;
+        }
+        k0 = seg_k - seg_lo;        /* index = seg_k + (v - seg_lo), mod 2^32 */
+    }
+    if (at + len > VPULL_RING_BYTES || count > SIX_CAP - s_six.off) { s_vpull.n_drop++; s_drop_draws++; return 0; }
+    u8* ring = s_vpull.ring_mapped + (u64)s_d3d.vp_parity * (VPULL_RING_BYTES + VPULL_RING_SLACK);
+    if (len) rsx_vpull_copy(ring + at, lay->base + copy_lo * S, (u32)len, lay->main, s_vpull.plan.local_base);
+    u32* ixo = s_six.mapped + (u64)s_d3d.vp_parity * SIX_CAP + s_six.off;
+    for (u32 k = 0; k < count; k++) {
+        u32 v;
+        if (idx16) { const u8* q = ib + (u64)(first + k) * 2; v = ((u32)q[0] << 8) | q[1]; }
+        else { const u8* q = ib + (u64)(first + k) * 4;
+               v = ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3]; }
+        ixo[k] = (restart && v == ridx) ? 0xFFFFFFFFu : k0 + ((v + bix) & 0x000FFFFFu);
+    }
+    if (span) {
+        s_vpull.seg_k = seg_k; s_vpull.seg_lo = seg_lo; s_vpull.seg_hi = seg_hi; s_vpull.seg_valid = 1;
+        s_vpull.rec_k = seg_k + (seg_hi - seg_lo) + lay->pad;
+    }
+    s_vpull.off = (u32)((u64)s_vpull.rec_base + (u64)s_vpull.rec_k * S);
+    if (!cont && s_d3d.draw_count < MAX_DRAWS)   /* the record this batch opens takes slot draw_count */
+        memcpy(s_vpull.tab_mapped + ((u64)s_d3d.vp_parity * MAX_DRAWS + s_d3d.draw_count) * RSX_VPULL_TAB_BYTES,
+               &s_vpull.tab_cur, RSX_VPULL_TAB_BYTES);
+    s_six.off += count;
+    s_six_added = count;
+    s_vpull.n_batch++; s_vpull.n_rec += cont ? 0u : 1u; s_vpull.bytes += len; s_vpull.idx += count;
+    s_req_verts += count; s_req_draws++;
+    return count;
+}
+
+/* VPULL: does this batch continue the open pulled record? Same BEGIN/END
+ * stream and program, its indices and ring bytes end where this call starts,
+ * same attribute layout. Sets s_vpull_cont for the caller. */
+static int s_vpull_cont = 0;
+static int vpull_continues(const rsx_state* st)
+{
+    const D3D12DrawRecord* pv = s_d3d.draw_count > 0 ? &s_d3d.draws[s_d3d.draw_count - 1] : NULL;
+    s_vpull_cont = pv && s_d3d.merge_prev_draw &&
+                   pv->is_vp && pv->topology == RSX_TOPOLOGY_TRIANGLE_STRIP &&
+                   pv->vpull_gen == s_six.gen && pv->ix_gen == s_six.gen && pv->ix_count &&
+                   pv->fp_addr == (st ? st->shader_program : 0) &&
+                   pv->begin_epoch == (st ? st->begin_epoch : 0) &&
+                   pv->ix_start + pv->ix_count == s_six.off &&
+                   pv->vpull_base == s_vpull.rec_base && pv->vpull_sig == s_vpull.lay.sig;
+    return s_vpull_cont;
+}
+
+static void vp_flush_if_full(u32 count, int cont)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("VP_NO_MIDFLUSH") ? 1 : 0;
+    if (off || !s_d3d.initialized || s_d3d.draw_count == 0) return;
+    u64 need = (u64)count * 3u;
+    if (need > MAX_VP_VERTICES) need = MAX_VP_VERTICES;
+    u64 room = ((u64)MAX_VP_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) / VP_VERT_STRIDE;
+    int full = room < need || s_d3d.draw_count >= MAX_DRAWS - 1;
+    if (s_six.mapped && SIX_CAP - s_six.off < count + 1) full = 1;   /* STRIP_INDEXED */
+    if (s_vpull.ring_mapped && VPULL_RING_BYTES - s_vpull.off < VPULL_MARGIN) full = 1;   /* VPULL */
+    if (!full && (cont || (room >= VP_FLUSH_MARGIN && s_d3d.draw_count < MAX_DRAWS - 64)))
+        return;
+    { static int _n = 0; if ((_n < 8 ? (_n++, 1) : 0))
+        printf("[D3D12] mid-frame flush: %u records, %llu vertices free -- running the batch without present\n",
+               s_d3d.draw_count, (unsigned long long)room); }
+    int was = s_present_this_frame;
+    s_present_this_frame = 0;
+    { double _mt = perf_on() ? perf_now() : 0.0;
+      render_frame();
+      if (perf_on()) s_perf_rf_mid += perf_now() - _mt; }
+    s_present_this_frame = was;
+    s_d3d.merge_prev_draw = 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * fan-join (jstars-notes STAGE_TEXTURES.md §13, white sky flash). RSX
+ * assembles every DRAW_ARRAYS / DRAW_INDEX_ARRAY batch inside one BEGIN/END
+ * as ONE primitive stream. The TRIANGLES merge below and the native indexed
+ * strip already rely on that; non-indexed strips/fans and indexed fans did
+ * not: each batch was expanded as a primitive of its own. J-Stars' "Lens
+ * Godray" sun-shaft pass is a 42-vertex TRIANGLE_FAN from the sun's screen
+ * position to 41 points around the screen edge (func_005567AC), and the
+ * game's draw emitter splits a draw into batches (the indexed emitter
+ * func_00657248 cuts the first batch at a 128-byte index-buffer boundary),
+ * so the fan arrived as two or more batches: the second one became a fan
+ * centred on a screen-edge point and the wedges around the split were never
+ * drawn -- the raw sun-colour sky mask leaked through them (white sky).
+ * Here a batch that continues the previous FAN/STRIP batch of the same
+ * BEGIN/END (same epoch and fragment program, first == previous end) is
+ * expanded against the STREAM: fan triangles keep the stream's first vertex
+ * as centre, strip triangles keep the stream's parity, and the triangles are
+ * appended to the previous record. FAN_JOIN=0 restores the per-batch fans.
+ * FAN_LOG=1 prints every fan batch; FAN_LOG=<hex colour offset> prints every
+ * batch drawn into that colour target (e.g. FAN_LOG=0D7A0000). */
+static struct { int valid; int indexed; u32 prim, start, end, epoch, fp; int rec; } s_sf;
+
+static int fan_join_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("FAN_JOIN"); on = (e && *e == '0') ? 0 : 1; }
+    return on;
+}
+
+/* Does batch [first, first+count) of `prim` continue the stream the previous
+ * record holds? s_sf_why says why not (FAN_LOG prints it): 1 FAN_JOIN=0,
+ * 2 no stream, 3 other primitive/path, 4 not contiguous, 5 another record in
+ * between (or a mid-frame flush), 6 other BEGIN/END, 7 other fragment program,
+ * 8 previous record not a VP triangle list, 9 a restart index in the range. */
+static int s_sf_why;
+static int sf_continues(int indexed, u32 prim, u32 first, u32 count)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    s_sf_why = 0;
+    if (!fan_join_on()) { s_sf_why = 1; return 0; }
+    if (!st || !s_sf.valid || s_d3d.draw_count <= 0) { s_sf_why = 2; return 0; }
+    if (s_sf.indexed != indexed || s_sf.prim != prim) { s_sf_why = 3; return 0; }
+    if (s_sf.end != first) { s_sf_why = 4; return 0; }
+    if (s_sf.rec != (int)s_d3d.draw_count - 1) { s_sf_why = 5; return 0; }
+    if (s_sf.epoch != st->begin_epoch) { s_sf_why = 6; return 0; }
+    if (s_sf.fp != st->shader_program) { s_sf_why = 7; return 0; }
+    const D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+    if (!pv->is_vp || pv->topology != RSX_TOPOLOGY_TRIANGLES) { s_sf_why = 8; return 0; }
+    if (indexed) {
+        /* Primitive restart (J-Stars keeps it enabled for its strips): the
+         * hardware starts a new fan at a restart index, so join only when no
+         * index the joined triangles use is the restart value. Same width
+         * rule as upload_strip_vp_native: a u16 buffer cannot hold a sentinel
+         * above 0xFFFF. */
+        const int idx16 = (((st->index_array_dma >> 4) & 0xF) == 1);
+        const int restart = st->restart_enable && !(idx16 && st->restart_index > 0xFFFFu);
+        if (restart) {
+            if (count > 256 || first == 0) { s_sf_why = 9; return 0; }
+            if (read_guest_index(st, s_sf.start) == st->restart_index) { s_sf_why = 9; return 0; }
+            for (u32 p = first - 1; p < first + count; p++)
+                if (read_guest_index(st, p) == st->restart_index) { s_sf_why = 9; return 0; }
+        }
+    }
