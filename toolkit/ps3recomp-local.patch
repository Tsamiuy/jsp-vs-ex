+static int pad_dualsense_state(XINPUT_STATE* st)
+{
+    static int started = 0;
+    if (!started) {
+        started = 1;
+        if (getenv("PAD_NO_DUALSENSE")) return 0;
+        CreateThread(NULL, 64 * 1024, ds_reader, NULL, 0, NULL);
+    }
+    if (!s_ds_ok) return 0;
+    unsigned char r[80];
+    AcquireSRWLockShared(&s_ds_lock);
+    memcpy(r, s_ds_report, sizeof r);
+    ReleaseSRWLockShared(&s_ds_lock);
+    /* d = sticks/triggers/buttons as laid out in the full report:
+     * 0 LX 1 LY 2 RX 3 RY 4 L2 5 R2 6 counter 7 hat|Sq/X/O/Tri 8 L1 R1 L2 R2 Create Options L3 R3 9 PS. */
+    unsigned char d[10];
+    if (r[0] == 0x31) memcpy(d, r + 2, 10);               /* Bluetooth, full report */
+    else if (r[0] == 0x01 && s_ds_len >= 64) memcpy(d, r + 1, 10);   /* USB */
+    else if (r[0] == 0x01) {   /* Bluetooth short report (switch not taken): DS4 order */
+        d[0] = r[1]; d[1] = r[2]; d[2] = r[3]; d[3] = r[4];
+        d[7] = r[5]; d[8] = r[6]; d[9] = r[7]; d[4] = r[8]; d[5] = r[9]; d[6] = 0;
+    } else return 0;
+    memset(st, 0, sizeof *st);
+    XINPUT_GAMEPAD* gp = &st->Gamepad;
+    static const WORD hat[8] = {
+        XINPUT_GAMEPAD_DPAD_UP, XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_RIGHT,
+        XINPUT_GAMEPAD_DPAD_RIGHT, XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_RIGHT,
+        XINPUT_GAMEPAD_DPAD_DOWN, XINPUT_GAMEPAD_DPAD_DOWN | XINPUT_GAMEPAD_DPAD_LEFT,
+        XINPUT_GAMEPAD_DPAD_LEFT, XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_LEFT };
+    if ((d[7] & 15) < 8) gp->wButtons |= hat[d[7] & 15];
+    if (d[7] & 0x10) gp->wButtons |= XINPUT_GAMEPAD_X;          /* Square */
+    if (d[7] & 0x20) gp->wButtons |= XINPUT_GAMEPAD_A;          /* Cross */
+    if (d[7] & 0x40) gp->wButtons |= XINPUT_GAMEPAD_B;          /* Circle */
+    if (d[7] & 0x80) gp->wButtons |= XINPUT_GAMEPAD_Y;          /* Triangle */
+    if (d[8] & 0x01) gp->wButtons |= XINPUT_GAMEPAD_LEFT_SHOULDER;
+    if (d[8] & 0x02) gp->wButtons |= XINPUT_GAMEPAD_RIGHT_SHOULDER;
+    if (d[8] & 0x10) gp->wButtons |= XINPUT_GAMEPAD_BACK;       /* Create */
+    if (d[8] & 0x20) gp->wButtons |= XINPUT_GAMEPAD_START;      /* Options */
+    if (d[8] & 0x40) gp->wButtons |= XINPUT_GAMEPAD_LEFT_THUMB;
+    if (d[8] & 0x80) gp->wButtons |= XINPUT_GAMEPAD_RIGHT_THUMB;
+    gp->bLeftTrigger = d[4]; gp->bRightTrigger = d[5];
+    gp->sThumbLX = (SHORT)(((int)d[0] - 128) * 256);
+    gp->sThumbLY = (SHORT)((128 - (int)d[1]) * 256 - (d[1] == 0));   /* HID: 0 = up */
+    gp->sThumbRX = (SHORT)(((int)d[2] - 128) * 256);
+    gp->sThumbRY = (SHORT)((128 - (int)d[3]) * 256 - (d[3] == 0));
+    return 1;
+}
