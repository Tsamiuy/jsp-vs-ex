+    { D3D12_RESOURCE_DESC* got = r->res->lpVtbl->GetDesc(r->res, &rd); (void)got; }
+    if (mode == 3 && !smaa_ready((u32)rd.Width, rd.Height, (DXGI_FORMAT)r->dxgi)) return 0;
+    int fresh = 0;
+    if (s_aa_tmp) {
+        D3D12_RESOURCE_DESC td;
+        { D3D12_RESOURCE_DESC* got = s_aa_tmp->lpVtbl->GetDesc(s_aa_tmp, &td); (void)got; }
