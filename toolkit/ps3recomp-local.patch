+/* PS3_SAMPLE_CHAIN=1: where the MAIN guest thread is, as a short guest call
+ * chain, whether it is running or waiting. The plain histogram only counts
+ * samples whose RIP is in lifted code, and a waiting thread's RIP is in ntdll,
+ * so "main thread 70% in ntdll" said nothing about WHAT it waits on. Here
+ * every sample of the boot thread is keyed by its first SAMP_CHAIN distinct
+ * lifted functions (the RIP's own, then return addresses found on the stack,
+ * innermost first) and flagged waiting if the RIP is in ntdll. Stack scanning
+ * can also pick up stale return addresses, so read the top chains, which
+ * repeat, rather than a single one. Other threads are sampled as before. */
+#define SAMP_CHAIN   4
+#define SAMP_CHAINS  512
+static int s_samp_chain = -1;
+static struct { uint32_t f[SAMP_CHAIN]; uint64_t n, wait; } s_chain[SAMP_CHAINS];
+static uint64_t s_chain_total, s_chain_wait;
+
+static void samp_chain_hit(const CONTEXT* c, int waiting)
+{
+    uint32_t f[SAMP_CHAIN] = {0};
+    int nf = 0;
+    uint32_t g = samp_lookup((uintptr_t)c->Rip);
+    if (g) f[nf++] = g;
+    const uintptr_t* sp = (const uintptr_t*)c->Rsp;
+    for (int i = 0; i < 1024 && nf < SAMP_CHAIN; i++) {    /* 8 KB of stack */
+        uintptr_t v;
+        __try { v = sp[i]; } __except (1) { break; }
+        uint32_t h = samp_lookup(v);
+        if (!h) continue;
+        int dup = 0;
+        for (int k = 0; k < nf; k++) if (f[k] == h) dup = 1;
+        if (!dup) f[nf++] = h;
+    }
+    s_chain_total++;
+    if (waiting) s_chain_wait++;
+    uint32_t hsh = 2166136261u;
+    for (int k = 0; k < SAMP_CHAIN; k++) { hsh ^= f[k]; hsh *= 16777619u; }
+    for (uint32_t n = 0, i = hsh % SAMP_CHAINS; n < SAMP_CHAINS; n++, i = (i + 1) % SAMP_CHAINS) {
+        if (s_chain[i].n == 0) { memcpy(s_chain[i].f, f, sizeof f); s_chain[i].n = 1; s_chain[i].wait = (uint64_t)waiting; return; }
+        if (!memcmp(s_chain[i].f, f, sizeof f)) { s_chain[i].n++; s_chain[i].wait += (uint64_t)waiting; return; }
+    }
+}
