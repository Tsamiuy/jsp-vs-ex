+        rsx_vp_set_branch_base(vstart / 16u);
+        int ni = rsx_vp_decompile(vuc, vlen, hlsl, sizeof hlsl);
+        char pn[96];
+        snprintf(pn, sizeof pn, "vp_code_%08X_%d.hlsl", code, ns);
+        FILE* f = fopen(pn, "w");
+        if (!f) return;
+        fprintf(f, "/* fp code=0x%08X fp=0x%X vp hash=0x%08X start=%u instrs=%d tex0=0x%X\n",
+                code, fp, vh, vstart / 16u, ni, s_d3d.cur_texs[0].raw);
+        for (int r = 0; r < RSX_MAX_VERTEX_CONSTANTS; r++) {
+            const float* c = st->vertex_constants[r];
+            if (c[0] != 0.0f || c[1] != 0.0f || c[2] != 0.0f || c[3] != 0.0f)
+                fprintf(f, "   c[%d] = (%g, %g, %g, %g)\n", r, (double)c[0], (double)c[1], (double)c[2], (double)c[3]);
+        }
+        fprintf(f, "*/\n%s\n", ni > 0 ? hlsl : "/* decompile failed */");
+        fclose(f);
+        fprintf(stderr, "[VPCODE] wrote %s (%d instrs)%c", pn, ni, 10);
+    }
+}
