+/* LUM_READBACK=1: write small offscreen colour targets back to guest memory.
+ * J-Stars reduces its HDR scene to a 20x11 average-luminance target
+ * (0x039FFA40, A8R8G8B8, capture rsxcap_flush1 ops 321-324) and the PPU
+ * reads that back to set the tone-map's exposure (fp 0x0FC9FC01, constant
+ * c1.w = key / max(avg, 1e-4)). The backend never wrote a render target back
+ * to guest memory, so the game read zeros and the exposure sat at
+ * 0.72 / 1e-4 = 7200 in every capture: blown-out, over-saturated colours
+ * (jstars-notes COLOR_EXPOSURE.md). Targets up to LUM_READBACK_MAXPX pixels
+ * (default 4096) are copied into a readback buffer at the end of the frame's
+ * command list and written into guest memory the next time the GPU is
+ * drained -- one frame late, which auto-exposure tolerates -- as big-endian
+ * A8R8G8B8 rows at the surface's pitch. Only R8G8B8A8 targets; linear layout
+ * assumed (no tiled regions for such a small surface). */
+static int lum_readback_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LUM_READBACK"); on = e ? atoi(e) : 0; }
+    return on;
+}
+static u32 lum_readback_maxpx(void)
+{
+    static u32 px = 0;
+    if (!px) { const char* e = getenv("LUM_READBACK_MAXPX"); px = e ? (u32)atoi(e) : 4096u;
+               if (!px) px = 4096u; }
+    return px;
+}
+/* Record the copies; runs with the frame's command list open, after every
+ * draw of the frame has been recorded. */
+static void lum_readback_issue(void)
+{
+    if (!lum_readback_on()) return;
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
