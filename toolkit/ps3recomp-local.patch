+#define SMAA_UV "float2 uv = float2((i << 1) & 2, i & 2); o.p = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); o.uv = uv;"
+    static const char* const vs[3] = {
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; float4 a : TEXCOORD1; float4 b : TEXCOORD2; float4 c : TEXCOORD3; };\n"
+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f[3]; SMAAEdgeDetectionVS(uv, f); o.a = f[0]; o.b = f[1]; o.c = f[2]; return o; }\n",
