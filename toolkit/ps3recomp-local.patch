+/* PRIM_LOG=1 (logging only): every draw whose primitive is not one the VP
+ * path handles -- POINTS (1), LINES (2), LINE_LOOP (3), LINE_STRIP (4),
+ * QUAD_STRIP (9), POLYGON (10) -- once per (call, prim, fp, target), plus a
+ * running count every 600 such draws. draw_arrays sends these to the
+ * fixed-function passthrough (no vertex program, so no transform) and
+ * draw_indexed skips them, so effects built from point sprites, lines or quad
+ * strips (skill projectiles, beams, trails) never appear (jstars-notes
+ * VFX.md). Logged per draw: fp, colour target, texture 0, count and
+ * whether a vertex program is loaded. */
+/* VP_CODE=<hex>[,<hex>...] (logging only): for draws whose fragment program
+ * has one of these code hashes (the `code=` of RSX_CAP manifests and shader
+ * headers, rsx_fp_code_hash), log the vertex layout and data and write the
+ * vertex program. Fragment-program addresses (a ring) and the effect's
+ * texture addresses change between runs; the code hash does not. Written for
+ * the Kamehameha (jstars-notes VFX.md: its draws scale by COLOR0.a, which
+ * arrives as 0): VP_CODE=9A64BF1C,AD204EA4.
+ * Per matching draw (first VP_CODE_N, default 12): `[VPCODE]` with call,
+ * prim, first, count, fp, code, tex0, divider op, VP start slot; each
+ * enabled attribute's layout and the raw bytes of the draw's first two
+ * vertices (index-resolved for indexed draws, base offset/index applied);
+ * each disabled attribute's constant register (always a3 = COLOR0).
+ * Per distinct vertex program: vp_code_<code>_<n>.hlsl = the decompiled
+ * program plus every non-zero vertex constant at that draw. */
+static void vp_code_dbg(const char* call, u32 primitive, u32 first, u32 count, int indexed)
+{
+    static int init = 0; static u32 want[8]; static int nw = 0, maxn = 12, nprinted = 0;
+    if (!init) { init = 1; const char* e = getenv("VP_CODE");
+        while (e && *e && nw < 8) { char* end; want[nw++] = (u32)strtoul(e, &end, 16);
+            e = (*end == ',') ? end + 1 : NULL; }
+        const char* n = getenv("VP_CODE_N"); if (n) maxn = atoi(n); }
+    if (!nw || nprinted >= maxn) return;
+    /* VP_CODE_FROM=<frame_count>: start logging at that frame, so draws before
+     * the moment of interest do not use up VP_CODE_N. */
+    { static long long from = -2;
+      if (from == -2) { const char* e = getenv("VP_CODE_FROM"); from = e ? atoll(e) : 0; }
+      if ((long long)s_d3d.frame_count < from) return; }
+    const rsx_state* st = s_d3d.current_rsx_state;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!st || !vm_base || !st->shader_program) return;
+    const u32 fp = st->shader_program;
+    const u32 fo = cellGcmResolveLocated((fp & 0x3u) == 1, fp & ~0x3u);
+    if (fo == 0xFFFFFFFFu) return;
+    const u32 code = rsx_fp_code_hash(vm_base + fo, FP_MAX_BYTES);
