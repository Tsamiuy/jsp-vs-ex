+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (off || !dr->fp_addr || !vm_base) return 0;
+    u8 m[16] = {0}; int any = 0;
+    for (int u = 0; u < RSX_TEX_UNITS && u < 16; u++)
+        if (dr->tex[u].set) {
+            m[u] = tex_mask_memo(s_gamma_memo, rsx_texture_gamma_mask, dr->tex[u].fmt,
+                                 dr->tex[u].ctrl1, dr->tex[u].filt, dr->tex[u].addr);
+            if (m[u]) any = 1;
+        }
+    if (!any) return 0;
+    u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
+    if (foff == 0xFFFFFFFFu) return 0;
+    const FpInfo* fi = fp_info(dr->fp_addr);
+    u32 used = 0;
+    if (fi) { for (int u = 0; u < 16; u++) if (((fi->tex_units >> u) & 1u) && m[u]) used |= 1u << u; }
+    else used = rsx_fp_texture_gamma_units(vm_base + foff, FP_MAX_BYTES, m);
+    u64 k = 0;
+    for (int u = 0; u < 16; u++)
+        if (used & (1u << u)) k |= (u64)(m[u] & 0xFu) << (4 * u);
+    return k;
+}
