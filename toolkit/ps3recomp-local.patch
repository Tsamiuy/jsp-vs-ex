+            b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+            b.Transition.StateAfter  = r->st;
+            s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+        }
+        r->rb_pending = 1;
+    }
+}
+/* Deliver the copies to guest memory; runs right after the GPU has been
+ * drained, so the previous frame's command list (and its copies) is done. */
+static void lum_readback_finish(void)
+{
+    if (!lum_readback_on()) return;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    for (int i = 0; i < MAX_OFF_RTS; i++) {
+        OffRT* r = &s_d3d.off_rt[i];
+        if (!r->rb || !r->rb_pending) continue;
+        r->rb_pending = 0;
+        if (!vm_base) continue;
+        /* Which memory the surface is in comes from its DMA context, not
+         * from trying local first: local offset 0x039FFA40 always resolves,
+         * but the 20x11 target is at IO offset 0x039FFA40 in main memory
+         * (the last 1.4 KB of the 0x3A00000 IO window), which is where the
+         * PPU reads it. v2 wrote every frame to the local alias. */
+        const int main_mem = r->dma == 0xFEED0001u;
+        u32 goff = cellGcmResolveLocated(main_mem ? 0 : 1, r->off);
+        if (goff == 0xFFFFFFFFu || goff == 0u) continue;
+        const u32 cw = r->rb_w ? r->rb_w : r->w, ch = r->rb_h ? r->rb_h : r->h;
+        const u32 gpitch = r->pitch ? r->pitch : cw * 4u;
+        if (gpitch < cw * 4u) continue;   /* a pitch narrower than the rect: never overrun */
+        void* mapped = NULL;
+        D3D12_RANGE rr = {0, (SIZE_T)r->rb_pitch * RS(ch)};
+        if (FAILED(r->rb->lpVtbl->Map(r->rb, 0, &rr, &mapped)) || !mapped) continue;
+        u64 sum = 0;
+        /* What the game's PPU will compute from these bytes (func_0055C5A4):
+         * per pixel rgb = enc.rgb/255 * (0.25 / (A/255)) when A > 0 (RGBM
+         * decode, same as the tone-map's enc.rgb/enc.a/4), L = dot(rgb,
+         * (0.2125, 0.7154, 0.0721)), then exp(mean(log(L + FLT_EPSILON))):
+         * the log-average luminance. The exposure it derives is
+         * key / max(La, 1e-4) with key 0.72 (La adapts towards Lgeo at
+         * 1 - 0.98^(15*dt) per frame). Logged as Lgeo / E~ so the value
+         * the loop is heading for can be read off without a capture. */
+        double sumlog = 0.0;
+        for (u32 y = 0; y < ch; y++) {
+            const u8* s0 = (const u8*)mapped + (size_t)y * s_rs * r->rb_pitch;
+            u8* d = vm_base + goff + (size_t)y * gpitch;
+            for (u32 x = 0; x < cw; x++) {   /* R8G8B8A8 -> big-endian A8R8G8B8 */
+                const u8* s = s0 + (size_t)x * (s_rs - 1) * 4;   /* every RS-th pixel */
+                d[x * 4 + 0] = s[x * 4 + 3]; d[x * 4 + 1] = s[x * 4 + 0];
+                d[x * 4 + 2] = s[x * 4 + 1]; d[x * 4 + 3] = s[x * 4 + 2];
+                sum += (u64)s[x * 4] + s[x * 4 + 1] + s[x * 4 + 2];
+                { const float a = (float)s[x * 4 + 3] * (1.0f / 255.0f);
+                  const float m = a > 0.0f ? 0.25f / a : 1.0f;
+                  const float L = (0.2125f * (float)s[x * 4 + 0] + 0.7154f * (float)s[x * 4 + 1] +
+                                   0.0721f * (float)s[x * 4 + 2]) * (m / 255.0f);
+                  sumlog += log((double)L + 1.1920929e-7); }
+            }
+        }
+        const double lgeo = exp(sumlog / (double)((u64)cw * ch));
+        const double epred = 0.72 / (lgeo > 1e-4 ? lgeo : 1e-4);
+        /* Log cadence is per target: v2 counted all targets together, and
+         * with two targets per frame the "every 300th" line always fell on
+         * the same one, so the 20x11 target was never seen after frame 8. */
+        { static u32 n[MAX_OFF_RTS];
+          if (n[i] < 8 || (n[i] % 60) == 0) {
+              const u8* s = (const u8*)mapped;
+              fprintf(stderr, "[LUMRB] off=0x%08X dma=0x%08X %ux%u (res %ux%u) pitch=%u -> guest 0x%X (%s) px0 R=%u G=%u B=%u A=%u meanRGB=%u Lgeo=%.4f E~%.1f%c",
+                      r->off, r->dma, cw, ch, r->w, r->h, gpitch, goff, main_mem ? "main" : "local",
+                      s[0], s[1], s[2], s[3], (unsigned)(sum / ((u64)cw * ch * 3u)), lgeo, epred, 10); }
+          n[i]++; }
+        D3D12_RANGE wr = {0, 0};
+        r->rb->lpVtbl->Unmap(r->rb, 0, &wr);
+    }
+}
+
+/* VP_CODE_LATER=<n> (with VP_CODE, logging only): re-read each logged draw's
+ * first vertex (24 bytes from attribute 0's address) n frames later, at the end
+ * of render_frame (0 = the end of the same frame), and print it as
+ * `[VPCODE-LATER] #id f=<logged>-><now> bytes: ...`. Tells "the producer
+ * writes the buffer after we fetched it" (non-zero later) from "nothing ever
+ * writes it there" (still zero). jstars-notes VFX.md (Kamehameha). */
+static struct { u32 id, ea; u64 frame; } s_vpl[256];
+static int s_vpl_n = 0;
+static int vp_code_later_n(void)
+{
+    static int n = -2;
+    if (n == -2) { const char* e = getenv("VP_CODE_LATER"); n = e ? atoi(e) : -1; }
+    return n;
+}
+static void vp_code_later(void)
+{
+    const int later = vp_code_later_n();
+    if (later < 0 || !s_vpl_n) return;
+    extern uint8_t* vm_base;
+    int keep = 0;
+    for (int i = 0; i < s_vpl_n; i++) {
+        if ((s64)(s_d3d.frame_count - s_vpl[i].frame) < (s64)later) { s_vpl[keep++] = s_vpl[i]; continue; }
+        const u8* q = vm_base + s_vpl[i].ea;
+        u32 nz = 0; for (int b = 0; b < 24; b++) if (q[b]) nz++;
+        fprintf(stderr, "[VPCODE-LATER] #%u f=%llu->%llu ea=0x%08X nonzero=%u/24 bytes:", s_vpl[i].id,
+                (unsigned long long)s_vpl[i].frame, (unsigned long long)s_d3d.frame_count, s_vpl[i].ea, nz);
+        for (int b = 0; b < 24; b++) fprintf(stderr, " %02X", q[b]);
+        fprintf(stderr, "%c", 10);
+    }
+    s_vpl_n = keep;
+}
+
+/* ---------------------------------------------------------------------------
+ * On-screen-keyboard text panel (cellOskDialog, OSK_DIALOG=2)
+ *
+ * The PS3 draws its keyboard itself, so the game has no text-entry screen. This
+ * panel stands in for it inside the game window, drawn like the game's own
+ * message box (the shop's "Purchase this item?"): a dark frame, a metal
+ * gradient panel with halftone corners, and a button strip whose highlighted
+ * button is yellow. It shows the prompt, the text being typed with a caret, and
+ * OK / Cancel. Measured from a 1280x720 frame and scaled to the back buffer.
+ * The panel is rendered on the CPU (gradients by hand, text by GDI) when the
+ * text changes; each frame the bitmap is copied over the back buffer before
+ * present (an opaque box, so a plain copy, no blending).
+ * -----------------------------------------------------------------------*/
+#define OSKP_W720 778    /* box size at 1280x720 */
+#define OSKP_H720 307
+static ID3D12Resource* s_oskp_upload[FRAME_COUNT];
+static u32 s_oskp_pitch, s_oskp_w, s_oskp_h, s_oskp_alloc[FRAME_COUNT];
+static unsigned s_oskp_gen[FRAME_COUNT];
+
+/* Grey level along a list of (position, level) points, linear in between. */
+static float oskp_ramp(const float (*k)[2], int n, float v)
+{
+    if (v <= k[0][0]) return k[0][1];
+    for (int i = 1; i < n; i++)
+        if (v <= k[i][0]) return k[i-1][1] + (k[i][1] - k[i-1][1]) * (v - k[i-1][0]) / (k[i][0] - k[i-1][0]);
+    return k[n-1][1];
+}
+
+/* The swirl in the panel's lower right corner, drawn here (not game art) into a
+ * mask: red the upper shape, green the lower one, blue their outlines. Points in
+ * 720p box units. */
+static void oskp_swirl_mask(HDC dc, float sc)
+{
+#define SP(x, y) { (LONG)(((1650 + (x)) / 3.0f) * sc), (LONG)(((280 + (y)) / 3.0f + 2.0f) * sc) }
+    const POINT a[] = { SP(0,60),
+        SP(5,30), SP(45,20), SP(75,28),      SP(110,36), SP(122,70), SP(128,105),
+        SP(134,140), SP(150,168), SP(175,165), SP(210,160), SP(240,118), SP(295,118),
+        SP(345,118), SP(380,150), SP(392,195), SP(420,170), SP(460,145), SP(505,145),
+        SP(565,145), SP(605,195), SP(605,250), SP(605,320), SP(560,390), SP(475,392),
+        SP(420,392), SP(365,365), SP(330,320), SP(300,275), SP(265,238), SP(210,235),
+        SP(185,235), SP(160,240), SP(140,242), SP(100,232), SP(65,210), SP(65,160),
+        SP(65,130), SP(70,105), SP(50,90),   SP(30,80), SP(10,75), SP(0,60) };
+    const POINT b[] = { SP(80,295),
+        SP(115,255), SP(165,235), SP(210,235), SP(265,238), SP(300,275), SP(330,320),
+        SP(365,365), SP(420,392), SP(475,405), SP(420,430), SP(340,452), SP(280,447),
+        SP(225,440), SP(205,400), SP(190,360), SP(175,315), SP(140,285), SP(80,295) };
+    const POINT c[] = { SP(400,215), SP(385,270), SP(425,325), SP(480,335) };
+#undef SP
+    HBRUSH br = CreateSolidBrush(RGB(255, 0, 0)), bg = CreateSolidBrush(RGB(0, 255, 0));
+    HPEN pen = CreatePen(PS_SOLID, (int)(1.5f * sc + 0.5f), RGB(0, 0, 255));
+    HGDIOBJ ob = SelectObject(dc, br), op = SelectObject(dc, pen);
+    BeginPath(dc); PolyBezier(dc, a, sizeof a / sizeof a[0]); CloseFigure(dc); EndPath(dc); FillPath(dc);
+    SelectObject(dc, bg);
+    BeginPath(dc); PolyBezier(dc, b, sizeof b / sizeof b[0]); CloseFigure(dc); EndPath(dc); FillPath(dc);
+    BeginPath(dc); PolyBezier(dc, a, sizeof a / sizeof a[0]); CloseFigure(dc); EndPath(dc); StrokePath(dc);
+    BeginPath(dc); PolyBezier(dc, b, sizeof b / sizeof b[0]); CloseFigure(dc); EndPath(dc); StrokePath(dc);
+    BeginPath(dc); PolyBezier(dc, c, 4); EndPath(dc); StrokePath(dc);
+    SelectObject(dc, ob); SelectObject(dc, op);
+    DeleteObject(br); DeleteObject(bg); DeleteObject(pen);
+}
+
+/* White text with the dark edge the game's own boxes have. */
+static void oskp_text(HDC dc, const wchar_t* t, RECT r, UINT fmt, COLORREF col, int edge)
+{
+    SetTextColor(dc, RGB(0x12, 0x12, 0x12));
+    if (edge > 0)
+        for (int dy = -edge; dy <= edge; dy++)
+            for (int dx = -edge; dx <= edge; dx++) {
+                if (!dx && !dy) continue;
+                RECT q = { r.left + dx, r.top + dy, r.right + dx, r.bottom + dy };
+                DrawTextW(dc, t, -1, &q, fmt);
+            }
+    SetTextColor(dc, col);
+    DrawTextW(dc, t, -1, &r, fmt);
+}
+
+static void oskp_render(u8* dst_rgba, u32 pitch, u32 W, u32 H)
+{
+    wchar_t prompt[600], text[600];
+    cellOskDialog_overlay_get(prompt, 600, text, 600);
+    const int sel = cellOskDialog_overlay_sel();
+    const int confirm = cellOskDialog_overlay_mode() != 0;   /* Yes/No or choice: no text field */
+    const int choice = cellOskDialog_overlay_mode() == 2;
+    const float sc = (float)H / OSKP_H720;          /* 720p units -> pixels */
+#define S(v) ((int)((v) * sc + 0.5f))
+    BITMAPINFO bi; memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bi.bmiHeader.biWidth = (LONG)W; bi.bmiHeader.biHeight = -(LONG)H;   /* top-down */
+    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32; bi.bmiHeader.biCompression = BI_RGB;
+    void* bits = NULL;
+    HDC dc = CreateCompatibleDC(NULL);
+    HBITMAP bmp = CreateDIBSection(dc, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+    if (!bmp || !bits) { if (bmp) DeleteObject(bmp); DeleteDC(dc); return; }
+    HGDIOBJ old = SelectObject(dc, bmp);
+    u8* px = (u8*)bits;   /* BGRX */
+
+    /* Box background by row (720p units): grey at the top, near black through
+     * the middle, the button strip brightening towards a light bottom edge. */
+    static const float frame[][2] = { {0,40},{1,49},{9,55},{10,29},{11,55},{132,6},{252,34},{253,24},{255,33},
+                                       {306,55},{307,40} };
+    /* Inner panel (x 15..760, y 12..252): a metal gradient, light at the top
+     * and bottom edges, dark in the middle. */
+    static const float panel[][2] = { {12,101},{13,110},{14,102},{15,93},{16,85},{17,82},{128,19},{247,82},{249,96},{251,112},{252,75} };
+    const int px0 = S(15), px1 = S(760), py0 = S(12), py1 = S(252);
+    void* mbits = NULL;
+    HDC mdc = CreateCompatibleDC(NULL);
+    HBITMAP mbmp = CreateDIBSection(mdc, &bi, DIB_RGB_COLORS, &mbits, NULL, 0);
+    HGDIOBJ mold = mbmp ? SelectObject(mdc, mbmp) : NULL;
+    if (mbmp && mbits) { memset(mbits, 0, (size_t)W * H * 4); oskp_swirl_mask(mdc, sc); GdiFlush(); }
+    const u8* mask = (const u8*)mbits;
+    for (u32 y = 0; y < H; y++) {
+        const float fy = y / sc;
+        const float fr = oskp_ramp(frame, sizeof frame / sizeof frame[0], fy);
+        const float pa = oskp_ramp(panel, sizeof panel / sizeof panel[0], fy);
+        for (u32 x = 0; x < W; x++) {
+            float g;
+            const int ix = (int)x, iy = (int)y;
+            if (ix >= px0 && ix < px1 && iy >= py0 && iy < py1) {
+                g = pa;
+                /* inner edge light on the left and right, fading over 5 units */
+                const float e = (ix - px0 < px1 - 1 - ix ? ix - px0 : px1 - 1 - ix) / sc;
+                if (e < 5.0f) g += (5.0f - e) * 9.0f * (1.0f - g / 120.0f);
+                /* halftone dots in the top left corner */
+                const float dx = (float)(ix - px0) / sc, dy = (float)(iy - py0) / sc;
+                if (dx < 215 && dy < 145) {
+                    const float k = (1.0f - dx / 215.0f) * (1.0f - dy / 145.0f);
+                    const float cx = fmodf(dx, 8.33f) - 4.17f, cy = fmodf(dy, 8.33f) - 4.17f;
+                    const float r = 1.25f + 0.5f * k;
+                    if (cx * cx + cy * cy < r * r) g += 90.0f * k + 3.0f;
+                }
+                /* the swirl: lit from above, shaded below, with a dark outline */
+                if (mask) {
+                    const u8* m = mask + ((size_t)y * W + x) * 4;   /* BGRX */
+                    const float v = (fy - 100.0f) / 150.0f;
+                    if (m[0]) g -= 7.0f;
+                    else if (m[2]) g += 8.0f - 6.0f * v;
+                    else if (m[1]) g += 3.0f - 13.0f * v;
+                }
+            } else {
+                g = fr;
+                const float lx = x / sc, rx = (W - 1 - x) / sc;   /* outer bevel, left and right */
+                const float ed = lx < rx ? lx : rx;
+                if (ed < 1.0f) g = 118; else if (ed < 2.0f) g = g + 40;
+                /* dark line around the panel */
+                if (ix >= px0 - S(1) && ix < px1 + S(1) && iy >= py0 - S(1) && iy < py1 + S(1)) g = 16;
+            }
+            if (g > 255) g = 255;
+            if (g < 0) g = 0;
+            u8* d = px + ((size_t)y * W + x) * 4;
+            d[0] = d[1] = d[2] = (u8)g; d[3] = 0;
+        }
+    }
+
+    /* Text field: a dark inset bar with a thin light outline. */
+    const int fx0 = S(110), fx1 = S(668), fy0 = S(106), fy1 = S(158);
+    if (!confirm)
+    for (int y = fy0; y < fy1; y++)
+        for (int x = fx0; x < fx1; x++) {
+            u8* d = px + ((size_t)y * W + x) * 4;
+            const int edge = (x == fx0 || x == fx1 - 1 || y == fy0 || y == fy1 - 1);
+            const u8 g = edge ? 0x78 : (y < fy0 + S(4) ? 0x06 : 0x0E);
+            d[0] = d[1] = d[2] = g;
+        }
+
+    /* Buttons on the strip (y 258..305), centred at x 265 (left) and 500 (right):
+     * a bar of vertical stripes that fades out towards its ends, with a thin light
+     * line along the top and bottom; the highlighted one is yellow. */
+    const int by0 = S(258), by1 = S(305);
+    for (int b = 0; b < 2; b++) {
+        const float cxu = b ? 500.0f : 265.0f, half = 104.0f, stripe = 9.0f;
+        const int hi = (b == sel);
+        for (int y = by0; y < by1; y++) {
+            const float yv = (y - by0) / (float)(by1 - by0);
+            const int line = (y - by0) < S(1.5f) || (by1 - 1 - y) < S(1.5f);
+            for (int x = S(cxu - half); x < S(cxu + half); x++) {
+                if (x < 0 || x >= (int)W) continue;
+                const int si = (int)floorf((x / sc - cxu) / stripe);   /* stripes, each one flat */
+                const float sc0 = (si + 0.5f) * stripe;
+                const float t = 1.0f - fabsf(sc0) / half;              /* 1 at the centre, 0 at the ends */
+                if (t <= 0) continue;
+                const float tl = 1.0f - fabsf(x / sc - cxu) / half;    /* the line fades smoothly */
+                const float vary = ((si * 7) & 3) * 0.022f - 0.033f;
+                u8* d = px + ((size_t)y * W + x) * 4;
+                float r, g, bl, a;
+                if (hi) {
+                    const float k = t * 1.35f > 1 ? 1 : t * 1.35f;
+                    a = t * 2.6f > 1 ? 1 : t * 2.6f;
+                    r  = (72 + (252 - 72) * k) * (1 + vary);
+                    g  = (70 + (228 - 70) * k) * (1 + vary);
+                    bl = 66 + (78 - 66) * k;
+                    if (line) { const float q = tl * 2 > 1 ? 1 : tl * 2; r += (255 - r) * q; g += (248 - g) * q; bl += (110 - bl) * q; }
+                } else {
+                    const float k = t * 2.2f > 1 ? 1 : t * 2.2f;
+                    a = k;
+                    r = g = bl = (62 + 12 * yv) * (1 + vary) * (0.82f + 0.18f * k);
+                    if (line) { const float q = tl * tl * 1.6f; r = g = bl = r + (170 - r) * (q > 1 ? 1 : q); }
+                }
+                if (r > 255) r = 255;
+                if (g > 255) g = 255;
+                d[2] = (u8)(d[2] + (r  - d[2]) * a);
+                d[1] = (u8)(d[1] + (g  - d[1]) * a);
+                d[0] = (u8)(d[0] + (bl - d[0]) * a);
+            }
+        }
+    }
+
+    GdiFlush();
+    SetBkMode(dc, TRANSPARENT);
+    HFONT fp = CreateFontW(S(31), 0, 0, 0, FW_MEDIUM, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
+                           CLIP_DEFAULT_PRECIS, ANTIALIASED_QUALITY, DEFAULT_PITCH, L"Segoe UI");
+    HFONT fx = CreateFontW(S(30), 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
+                           CLIP_DEFAULT_PRECIS, ANTIALIASED_QUALITY, DEFAULT_PITCH, L"Segoe UI");
+    HFONT fh = CreateFontW(S(19), 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS,
+                           CLIP_DEFAULT_PRECIS, ANTIALIASED_QUALITY, DEFAULT_PITCH, L"Segoe UI");
+    const int edge = S(1) > 0 ? S(1) : 1;
+    SelectObject(dc, fp);
+    RECT tr = {S(30), confirm ? S(84) : S(40), (LONG)W - S(30), confirm ? S(154) : S(96)};
+    oskp_text(dc, prompt[0] ? prompt : L"Enter text", tr, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS,
+              RGB(0xFA, 0xFA, 0xFA), edge);
+    if (!confirm) {
+        SelectObject(dc, fx); SetTextColor(dc, RGB(0xFF, 0xFF, 0xFF));
+        wchar_t shown[602]; _snwprintf(shown, 602, L"%ls|", text); shown[601] = 0;   /* caret */
+        RECT xr = {fx0 + S(16), fy0, fx1 - S(16), fy1};
+        DrawTextW(dc, shown, -1, &xr, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);
+    }
+    /* The game's own boxes have no key hints; only the typing panel needs them. */
+    if (!confirm) {
+        SelectObject(dc, fh); SetTextColor(dc, RGB(0xB4, 0xB4, 0xB4));
+        RECT hr = {S(30), S(176), (LONG)W - S(30), S(220)};
+        DrawTextW(dc, L"Type with the keyboard    Backspace: Delete    \x2190 \x2192: Choose    Enter: Confirm    Esc: Cancel",
+                  -1, &hr, DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS);
+    }
+    SelectObject(dc, fp);
+    for (int b = 0; b < 2; b++) {
+        const int c = b ? S(500) : S(265);
+        RECT br = {c - S(100), by0, c + S(100), by1};
+        oskp_text(dc, choice ? cellOskDialog_choice_label(b)
+                             : b ? (confirm ? L"No" : L"Cancel") : (confirm ? L"Yes" : L"OK"), br,
+                  DT_CENTER | DT_VCENTER | DT_SINGLELINE, RGB(0xFA, 0xFA, 0xFA), edge);
+    }
+    GdiFlush();
+#undef S
+    for (u32 y = 0; y < H; y++)                            /* BGRX -> RGBA */
+        for (u32 x = 0; x < W; x++) {
+            const u8* s = px + ((size_t)y * W + x) * 4;
+            u8* d = dst_rgba + (size_t)y * pitch + x * 4;
+            d[0] = s[2]; d[1] = s[1]; d[2] = s[0]; d[3] = 0xFF;
+        }
+    SelectObject(dc, old); DeleteObject(bmp); DeleteDC(dc);
+    if (mold) SelectObject(mdc, mold);
