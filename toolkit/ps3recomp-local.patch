+    if (!((address >> 12) & 1u)) return 0;          /* UNSIGNED_REMAP_NORMAL */
+    if (!(control1 & 0xFFFFu)) control1 = 0xAAE4u;
+    u8 remap[4]; rsx_texture_component_remap(control1, format, remap);
+    static const u8 rgba_lane[4] = {3, 0, 1, 2};
+    u8 mask = 0;
