+/* --- PSO_ASYNC: pipelines built on worker threads --------------------------
+ * The present thread still decompiles (the decompiler keeps static state) and
+ * builds the pipeline description; a worker does the two slow calls,
+ * D3DCompile and CreateGraphicsPipelineState (both documented thread-safe),
+ * and the present thread collects the result at the start of the next
+ * prepass. While a build is in flight vp_get_fp_pso returns NULL with
+ * s_pso_pending_hit set, and the draw pass skips that draw instead of
+ * drawing it with the hardcoded fallback pixel shader. */
+typedef struct {
+    volatile LONG state;        /* 0 free, 1 queued or running, 2 done */
+    VPFPEntry key;              /* pso NULL until done */
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    ID3DBlob* vsb;              /* reference held for the build */
+    ID3DBlob* pb;               /* known PS blob (reference) or NULL: hlsl compiles */
+    char* hlsl;
+    ShKey pk;
+    u32 fail_misc;
+    int pb_new, fxc_ran, disk_hit;
+    double t_fxc, t_pso;
+    HRESULT hr;
+    ID3D12PipelineState* pso;
+    char err[200];
+} PsoJob;
+#define PSO_JOBS 1024
+static struct {
+    int on;                     /* -1 undecided, 0 off, 1 skip, 2 sibling stand-in */
+    int nthreads, wait_ms, used_hi;
+    PsoJob* jobs;
+    int* queue; int q_head, q_tail;   /* ring of job indices, under cs */
+    CRITICAL_SECTION cs;
+    HANDLE sem, done_ev;
+    volatile LONG inflight;
+} s_pj = { .on = -1 };
+static int s_pso_pending_hit = 0;
+/* FP_IDCOLOR_RT=<hex surface offset>: FP_IDCOLOR only on draws into that
+ * colour target (e.g. the scene target), so the post chain, HUD and menus keep
+ * their normal output. Set around vp_get_fp_pso by the callers; such draws get
+ * their own pipelines (the code hash is salted). */
+static int s_idcolor_draw = 0;
+/* T0_WRAP (default on, T0_WRAP=0 off): unit 0's static sampler is point +
+ * CLAMP (the debug-font atlas needs it), but the games' own materials ask for
+ * their wrap mode per draw in TEXTURE_ADDRESS. A tiled texture on unit 0
+ * (J-Stars' Athena star layer) then repeated its edge row into long parallel
+ * lines across the sky (jstars-notes FINDINGS §57). Draws whose unit 0 asks
+ * for WRAP or MIRROR on s and/or t get their own pipeline in which unit 0's
+ * 2D lookups go through _t0w(): the coordinate is wrapped or mirrored in the
+ * shader and sampled with the original gradients (so mip selection does not
+ * jump at the seams). ps_5_0 has only 16 sampler registers, so extra static
+ * samplers are not an option. Set around vp_get_fp_pso.
+ * T0_LINEAR (default on, T0_LINEAR=0 off): such a draw also takes the game's
+ * own filter. When TEXTURE_FILTER asks for linear (mag [26:24] = 2, or min
+ * [18:16] = 2/4/6), _t0w samples through rsx_samp[1], which is LINEAR + WRAP
+ * like every unit but 0, and keeps clamped axes half a texel inside the
+ * edge so the wrap sampler cannot blend in the opposite edge. A repeated
+ * detail map point-sampled turned Namek's ground grainy (FINDINGS §58).
+ * The Penguin Village plant boxes are not a filter effect: they show with
+ * point filtering too (stages/s05/14_intro_b.png) and come from the alpha
+ * test that was missing until ALPHA_TEST. */
+static int s_t0_wrap = 0;   /* 9 * linear + s_mode * 3 + t_mode, 0 clamp / 1 wrap / 2 mirror; 0 = as before */
+static int t0_wrap_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("T0_WRAP"); on = e ? atoi(e) : 1; }
+    return on;
+}
+static int dr_t0_wrap(const D3D12DrawRecord* dr)
+{
+    if (!t0_wrap_on() || !dr->tex[0].off) return 0;
+    const u32 a = dr->tex[0].addr;   /* TEXTURE_ADDRESS: wrap s [3:0], t [11:8]; 1 WRAP, 2 MIRROR */
+    const u32 ws = a & 0xFu, wt = (a >> 8) & 0xFu;
+    const int ms = ws == 1u ? 1 : ws == 2u ? 2 : 0, mt = wt == 1u ? 1 : wt == 2u ? 2 : 0;
+    static int lin_on = -1, clamp_on = -1;
+    if (lin_on < 0) { const char* e = getenv("T0_LINEAR"); lin_on = e ? atoi(e) : 1; }
+    /* T0_CLAMP_LINEAR (default on, =0 off): clamped textures take the game's filter too. Point-sampled font
+     * atlases lost thin strokes as text moved: "Koro-sensei" without its hyphen (FINDINGS, 2026-11-02). */
+    if (clamp_on < 0) { const char* e = getenv("T0_CLAMP_LINEAR"); clamp_on = e ? atoi(e) : 1; }
+    if (!ms && !mt && !clamp_on) return 0;
+    const u32 f = dr->tex[0].filt, minf = (f >> 16) & 7u, magf = (f >> 24) & 7u;
+    const int lin = lin_on && (magf == 2u || minf == 2u || minf == 4u || minf == 6u);
+    return lin * 9 + ms * 3 + mt;
+}
+static u32 idcolor_rt(void)
+{
+    static int init = 0; static u32 rt = 0;
+    if (!init) { init = 1; const char* e = getenv("FP_IDCOLOR_RT"); rt = e ? (u32)strtoul(e, NULL, 16) : 0u; }
+    return rt;
+}   /* last vp_get_fp_pso returned NULL because a build is in flight */
+
+static DWORD WINAPI pso_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(s_pj.sem, INFINITE);
+        int ji = -1;
+        EnterCriticalSection(&s_pj.cs);
+        if (s_pj.q_head != s_pj.q_tail) {
+            ji = s_pj.queue[s_pj.q_head]; s_pj.q_head = (s_pj.q_head + 1) % PSO_JOBS;
+        }
+        LeaveCriticalSection(&s_pj.cs);
+        if (ji < 0) continue;
+        PsoJob* j = &s_pj.jobs[ji];
+        if (!j->pb) {
+            ID3DBlob* e = NULL;
+            j->pb = ps_blob_build(j->hlsl, j->pk, &j->hr, &e, &j->t_fxc, &j->fxc_ran, &j->disk_hit);
+            if (e) {
+                if (!j->pb) snprintf(j->err, sizeof j->err, "%s", (const char*)e->lpVtbl->GetBufferPointer(e));
+                e->lpVtbl->Release(e);
+            }
+            j->pb_new = 1;
+        }
+        if (j->pb) {
+            j->pd.PS.pShaderBytecode = j->pb->lpVtbl->GetBufferPointer(j->pb);
+            j->pd.PS.BytecodeLength  = j->pb->lpVtbl->GetBufferSize(j->pb);
+            const double t0 = perf_on() ? perf_now() : 0.0;
+            j->hr = s_d3d.device->lpVtbl->CreateGraphicsPipelineState(
+                s_d3d.device, &j->pd, &IID_ID3D12PipelineState, (void**)&j->pso);
+            if (perf_on()) j->t_pso = perf_now() - t0;
+            if (FAILED(j->hr)) j->pso = NULL;
+        } else if (SUCCEEDED(j->hr)) j->hr = E_FAIL;
+        InterlockedExchange(&j->state, 2);
+        SetEvent(s_pj.done_ev);
+    }
+    return 0;
+}
+
+static int pso_async_on(void)
+{
+    if (s_pj.on >= 0) return s_pj.on;
+    const char* e = getenv("PSO_ASYNC");
+    const int mode = (e && *e) ? atoi(e) : 1;   /* default 1: softer fight-start freezes; PSO_ASYNC=0 off */
+    if (mode <= 0) { s_pj.on = 0; return 0; }
+    if (!s_d3d.device) return 0;          /* decided again once the device exists */
+    s_pj.on = 0;
+    int n = 2;
+    { const char* t = getenv("PSO_ASYNC_THREADS"); if (t && atoi(t) > 0) n = atoi(t); }
+    if (n > 8) n = 8;
+    { const char* w = getenv("PSO_ASYNC_WAIT"); s_pj.wait_ms = w ? atoi(w) : 0; }
+    s_pj.jobs = (PsoJob*)calloc(PSO_JOBS, sizeof(PsoJob));
+    s_pj.queue = (int*)calloc(PSO_JOBS, sizeof(int));
+    s_pj.sem = CreateSemaphoreA(NULL, 0, PSO_JOBS, NULL);
+    s_pj.done_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!s_pj.jobs || !s_pj.queue || !s_pj.sem || !s_pj.done_ev) return 0;
+    InitializeCriticalSection(&s_pj.cs);
+    /* Statics the workers read are decided here, on this thread. */
+    perf_on();
+    if (shcache_on()) { shcache_dir(); shcache_compiler_id(); }
+    for (int i = 0; i < n; i++) {
+        HANDLE h = CreateThread(NULL, 0, pso_worker, NULL, 0, NULL);
+        if (!h) break;
+        CloseHandle(h);
+        s_pj.nthreads++;
+    }
+    if (!s_pj.nthreads) return 0;
+    s_pj.on = mode > 1 ? 2 : 1;
+    fprintf(stderr, "[PSO] async pipeline builds on: %d worker thread(s), mode %d, wait %d ms%c",
+            s_pj.nthreads, s_pj.on, s_pj.wait_ms, 10);
+    return s_pj.on;
+}
