+static HANDLE ds_open(int* bt)
+{
+    GUID g; HidD_GetHidGuid(&g);
+    HDEVINFO set = SetupDiGetClassDevsA(&g, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+    if (set == INVALID_HANDLE_VALUE) return INVALID_HANDLE_VALUE;
+    HANDLE found = INVALID_HANDLE_VALUE;
+    SP_DEVICE_INTERFACE_DATA ifd; ifd.cbSize = sizeof ifd;
+    for (DWORD k = 0; found == INVALID_HANDLE_VALUE && SetupDiEnumDeviceInterfaces(set, NULL, &g, k, &ifd); k++) {
+        DWORD need = 0;
+        SetupDiGetDeviceInterfaceDetailA(set, &ifd, NULL, 0, &need, NULL);
+        SP_DEVICE_INTERFACE_DETAIL_DATA_A* d = (SP_DEVICE_INTERFACE_DETAIL_DATA_A*)malloc(need);
+        if (!d) continue;
+        d->cbSize = sizeof *d;
+        if (SetupDiGetDeviceInterfaceDetailA(set, &ifd, d, need, NULL, NULL)) {
+            HANDLE h = CreateFileA(d->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                                   FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+            if (h != INVALID_HANDLE_VALUE) {
+                HIDD_ATTRIBUTES a; a.Size = sizeof a;
+                PHIDP_PREPARSED_DATA pp; HIDP_CAPS caps;
+                if (HidD_GetAttributes(h, &a) && a.VendorID == 0x054C &&
+                    (a.ProductID == 0x0CE6 || a.ProductID == 0x0DF2) &&       /* DualSense, DualSense Edge */
