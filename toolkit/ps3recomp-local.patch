+        s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, s_smaa_pso[p]);
+        D3D12_GPU_DESCRIPTOR_HANDLE gh = gh_base;
+        gh.ptr += (u64)(AA_SRV_BASE + p * RSX_TEX_UNITS) * s_d3d.srv_inc;
+        s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+        s_d3d.cmd_list->lpVtbl->DrawInstanced(s_d3d.cmd_list, 3, 1, 0, 0);
+        if (p < 2) smaa_barrier(s_smaa_rt[p], D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+}
