+static void sf_log(int indexed, u32 prim, u32 first, u32 count, int how, u32 emitted)
+{
+    static int mode = -1; static u32 want = 0; static int n = 0;
+    if (mode < 0) { const char* e = getenv("FAN_LOG"); mode = 0;
+        if (e && *e) { want = (u32)strtoul(e, NULL, 16); mode = (want == 1u) ? 1 : 2; } }
+    if (!mode) return;
+    const u32 rt = current_rt_off(NULL, NULL, NULL);
+    if (mode == 1 && prim != RSX_PRIMITIVE_TRIANGLE_FAN) return;
+    if (mode == 2 && rt != want) return;
+    if (n >= 600 && (n % 200) != 0) { n++; return; }
+    n++;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    fprintf(stderr, "[FANLOG] f=%llu %s prim=%u first=%u count=%u epoch=%u rt=0x%08X fp=0x%08X %s why=%d emitted=%u rec=%d n=%u restart=%u/0x%X dma=0x%X\n",
+            (unsigned long long)s_d3d.frame_count, indexed ? "indexed" : "arrays", prim, first, count,
+            st ? st->begin_epoch : 0u, rt, st ? st->shader_program : 0u,
+            how == 1 ? "JOINED" : how == 2 ? "cont-newrec" : "new", how == 0 ? s_sf_why : 0,
+            emitted, s_d3d.draw_count - 1,
+            s_d3d.draw_count > 0 ? s_d3d.draws[s_d3d.draw_count - 1].vertex_count : 0u,
+            st ? st->restart_enable : 0u, st ? st->restart_index : 0u, st ? st->index_array_dma : 0u);
+}
