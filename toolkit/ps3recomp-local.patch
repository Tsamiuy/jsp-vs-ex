+/* RES_SCALE: a scaled zeta is sampled through a guest-size R32_FLOAT copy made
+ * by a compute pass that keeps one depth sample per RS x RS block. J-Stars'
+ * scene draws sample the scene zeta they also write, so it is re-copied ~600
+ * times a frame; full-size copies made that RS^2 times dearer (most of the
+ * frame at RES_SCALE 3), these cost what the 1x copies cost. The effects that
+ * read the depth see it at the game's own resolution. ZSNAP_FULL=1: full-size
+ * copies. */
+static ID3D12RootSignature* s_zdown_rs;
+static ID3D12PipelineState* s_zdown_pso;
+static int s_zdown_tried;
+static int zdown_ready(void)
+{
+    if (s_zdown_pso) return 1;
+    if (s_zdown_tried || !s_d3d.device || s_rs < 2 || getenv("ZSNAP_FULL") || fx_full()) return 0;
+    s_zdown_tried = 1;
+    D3D12_DESCRIPTOR_RANGE rg[2];
+    memset(rg, 0, sizeof rg);
+    rg[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; rg[0].NumDescriptors = 1;
+    rg[0].OffsetInDescriptorsFromTableStart = 0;
+    rg[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV; rg[1].NumDescriptors = 1;
+    rg[1].OffsetInDescriptorsFromTableStart = 1;
+    D3D12_ROOT_PARAMETER rp; memset(&rp, 0, sizeof rp);
+    rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp.DescriptorTable.NumDescriptorRanges = 2; rp.DescriptorTable.pDescriptorRanges = rg;
+    rp.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rd; memset(&rd, 0, sizeof rd);
+    rd.NumParameters = 1; rd.pParameters = &rp;
+    ID3DBlob* sig = NULL; ID3DBlob* err = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err))) {
+        if (err) err->lpVtbl->Release(err);
+        return 0;
+    }
+    HRESULT hr = s_d3d.device->lpVtbl->CreateRootSignature(s_d3d.device, 0,
+        sig->lpVtbl->GetBufferPointer(sig), sig->lpVtbl->GetBufferSize(sig),
+        &IID_ID3D12RootSignature, (void**)&s_zdown_rs);
+    sig->lpVtbl->Release(sig);
+    if (FAILED(hr)) { s_zdown_rs = NULL; return 0; }
+    char cs[512];
+    snprintf(cs, sizeof cs,
+             "Texture2D<float> src : register(t0);%c"
+             "RWTexture2D<float> dst : register(u0);%c"
+             "[numthreads(8, 8, 1)] void main(uint3 id : SV_DispatchThreadID) {%c"
+             "    uint w, h; dst.GetDimensions(w, h);%c"
+             "    if (id.x >= w || id.y >= h) return;%c"
+             "    dst[id.xy] = src.Load(int3(id.xy * %u + %u, 0));%c"
+             "}%c", 10, 10, 10, 10, 10, s_rs, s_rs / 2, 10, 10);
+    ID3DBlob* cb = NULL; ID3DBlob* ce = NULL;
+    hr = D3DCompile(cs, strlen(cs), "zdown", NULL, NULL, "main", "cs_5_0", 0, 0, &cb, &ce);
+    if (FAILED(hr) || !cb) {
+        if (ce) { printf("[D3D12] zdown: %s%c", (const char*)ce->lpVtbl->GetBufferPointer(ce), 10); ce->lpVtbl->Release(ce); }
+        return 0;
+    }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd; memset(&pd, 0, sizeof pd);
+    pd.pRootSignature = s_zdown_rs;
+    pd.CS.pShaderBytecode = cb->lpVtbl->GetBufferPointer(cb);
+    pd.CS.BytecodeLength = cb->lpVtbl->GetBufferSize(cb);
+    hr = s_d3d.device->lpVtbl->CreateComputePipelineState(s_d3d.device, &pd,
+        &IID_ID3D12PipelineState, (void**)&s_zdown_pso);
+    cb->lpVtbl->Release(cb);
+    if (FAILED(hr)) { s_zdown_pso = NULL; return 0; }
+    printf("[D3D12] RES_SCALE: scaled depth targets are sampled at guest size (zdown)%c", 10);
+    return 1;
+}
+
+/* Bring the sampling copy up to date before a draw reads it. Returns 1 when
+ * it ran the compute pass (the caller re-sets its graphics pipeline state). */
+static int dt_snapshot(int i)
+{
+    DepthRT* z = &s_zrt[i];
+    if (!z->res || !z->snap) return 0;
+    D3D12_RESOURCE_BARRIER b[2] = {{0}};
+    if (z->dirty && z->down) {
+        s_p7_zsnap++; s_p7_zsnap_px += (u64)z->w * z->h;
+        s_p7_snap_by[(z - s_zrt) & 15]++;
+        const D3D12_RESOURCE_STATES was = z->st;
+        const D3D12_RESOURCE_STATES rd = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+        UINT nb = 0;
+        b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[1] = b[0];
+        if (was != rd) {
+            b[nb] = b[0]; b[nb].Transition.pResource = z->res;
+            b[nb].Transition.StateBefore = was; b[nb].Transition.StateAfter = rd; nb++; }
+        if (z->snap_st != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+            b[nb] = b[0]; b[nb].Transition.pResource = z->snap;
+            b[nb].Transition.StateBefore = z->snap_st;
+            b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS; nb++; }
+        if (nb) s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, nb, b);
+        s_d3d.cmd_list->lpVtbl->SetComputeRootSignature(s_d3d.cmd_list, s_zdown_rs);
+        s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, s_zdown_pso);
+        D3D12_GPU_DESCRIPTOR_HANDLE gh;
+        s_d3d.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &gh);
+        gh.ptr += (u64)(ZSNAP_DESC_BASE + 2 * i) * s_d3d.srv_inc;
+        s_d3d.cmd_list->lpVtbl->SetComputeRootDescriptorTable(s_d3d.cmd_list, 0, gh);
+        s_d3d.cmd_list->lpVtbl->Dispatch(s_d3d.cmd_list, (z->w + 7) / 8, (z->h + 7) / 8, 1);
+        nb = 0;
+        if (was != rd) {
+            b[nb] = b[0]; b[nb].Transition.pResource = z->res;
+            b[nb].Transition.StateBefore = rd; b[nb].Transition.StateAfter = was; nb++; }
+        b[nb] = b[0]; b[nb].Transition.pResource = z->snap;
+        b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE; nb++;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, nb, b);
+        z->snap_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        z->dirty = 0;
+        return 1;
+    }
+    if (z->dirty) {
+        s_p7_zsnap++; s_p7_zsnap_px += (u64)z->w * z->s * z->h * z->s;
+        s_p7_snap_by[(z - s_zrt) & 15]++;
+        const D3D12_RESOURCE_STATES was = z->st;
+        b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[0].Transition.pResource = z->res;
+        b[0].Transition.StateBefore = was;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[1] = b[0];
+        b[1].Transition.pResource = z->snap;
+        b[1].Transition.StateBefore = z->snap_st;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list,
+            z->snap_st == D3D12_RESOURCE_STATE_COPY_DEST ? 1u : 2u, b);
+        s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, z->snap, z->res);
+        b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b[0].Transition.StateAfter = was;
+        b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 2, b);
+        z->snap_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        z->dirty = 0;
+    } else if (z->snap_st != D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) {
+        b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[0].Transition.pResource = z->snap;
+        b[0].Transition.StateBefore = z->snap_st;
+        b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, b);
+        z->snap_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    }
+    return 0;
+}
