+/* AA_MODE=smaa: SMAA 1x, High preset, from third_party_smaa (MIT). Three passes after the copy of
+ * the scene: colour edges, blending weights from the two lookup textures, and the blend back into
+ * the target. The game's root signature has its own samplers: s0 point + clamp, s1 linear + wrap. */
+#include "third_party_smaa/AreaTex.h"
+#include "third_party_smaa/SearchTex.h"
+static const unsigned char s_smaa_src[] = {
+#include "third_party_smaa/SMAA_hlsl.inc"
+};
+static ID3D12PipelineState* s_smaa_pso[3];
+static ID3D12Resource* s_smaa_rt[2];
+static ID3D12Resource* s_smaa_lut[2];
+static ID3D12Resource* s_smaa_up;
+static ID3D12DescriptorHeap* s_smaa_rtv;
+static int s_smaa_state, s_smaa_lut_pending;   /* state: 0 not tried, 1 ready, -1 failed */
+
+static ID3DBlob* smaa_compile(const char* head, const char* tail, const char* target)
+{
+    const size_t hl = strlen(head), sl = sizeof s_smaa_src, tl = strlen(tail);
+    char* all = (char*)malloc(hl + sl + tl + 1);
+    if (!all) return NULL;
+    memcpy(all, head, hl); memcpy(all + hl, s_smaa_src, sl); memcpy(all + hl + sl, tail, tl); all[hl + sl + tl] = 0;
+    ID3DBlob* b = NULL; ID3DBlob* e = NULL;
+    HRESULT hr = D3DCompile(all, hl + sl + tl, "smaa", NULL, NULL, "main", target, 0, 0, &b, &e);
+    free(all);
+    if (e) { if (FAILED(hr)) fprintf(stderr, "[AA] %s%c", (const char*)e->lpVtbl->GetBufferPointer(e), 10); e->lpVtbl->Release(e); }
+    return SUCCEEDED(hr) ? b : NULL;
+}
