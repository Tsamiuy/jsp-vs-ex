+    }
+    if (!s_aa_tmp) {
+        D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp); hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC td = rd;
+        td.Flags = D3D12_RESOURCE_FLAG_NONE;
+        if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_aa_tmp))) { s_aa_tmp = NULL; return 0; }
+        s_aa_tmp_st = D3D12_RESOURCE_STATE_COPY_DEST;
+        fresh = 1;
+    }
+    if (fresh) {
+        srv_write(AA_SRV_BASE, s_aa_tmp, (DXGI_FORMAT)r->dxgi, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING);
+        srv_write(AA_SRV_BASE + 2 * RSX_TEX_UNITS, s_aa_tmp, (DXGI_FORMAT)r->dxgi, D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING);
+    }
+    D3D12_RESOURCE_BARRIER b; memset(&b, 0, sizeof b);
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = s_aa_tmp;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
