+    off_rt_transition(rt, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    s_d3d.cmd_list->lpVtbl->CopyResource(s_d3d.cmd_list, s_aa_tmp, r->res);
+    off_rt_transition(rt, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST; b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+    s_aa_tmp_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    D3D12_CPU_DESCRIPTOR_HANDLE rh = off_rt_rtv(rt);
+    s_d3d.cmd_list->lpVtbl->OMSetRenderTargets(s_d3d.cmd_list, 1, &rh, FALSE, NULL);
+    D3D12_VIEWPORT vp = {0, 0, (float)rd.Width, (float)rd.Height, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)rd.Width, (LONG)rd.Height};
+    s_d3d.cmd_list->lpVtbl->RSSetViewports(s_d3d.cmd_list, 1, &vp);
+    s_d3d.cmd_list->lpVtbl->RSSetScissorRects(s_d3d.cmd_list, 1, &sc);
+    s_d3d.cmd_list->lpVtbl->IASetPrimitiveTopology(s_d3d.cmd_list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    if (mode == 3) { smaa_draw(rt, gh_base); return 1; }
+    s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list, pso);
+    D3D12_GPU_DESCRIPTOR_HANDLE gh = gh_base;
+    gh.ptr += (u64)AA_SRV_BASE * s_d3d.srv_inc;
+    s_d3d.cmd_list->lpVtbl->SetGraphicsRootDescriptorTable(s_d3d.cmd_list, 1, gh);
+    s_d3d.cmd_list->lpVtbl->DrawInstanced(s_d3d.cmd_list, 3, 1, 0, 0);
+    return 1;
+}
