+        d.pResource = s_smaa_lut[1];
+        s.PlacedFootprint.Offset = (u64)AREATEX_HEIGHT * 512u;
+        s.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8_UNORM;
+        s.PlacedFootprint.Footprint.Width = SEARCHTEX_WIDTH; s.PlacedFootprint.Footprint.Height = SEARCHTEX_HEIGHT;
+        s.PlacedFootprint.Footprint.RowPitch = 256;
+        s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &d, 0, 0, 0, &s, NULL);
+        smaa_barrier(s_smaa_lut[0], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        smaa_barrier(s_smaa_lut[1], D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE rh;
+    s_smaa_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_smaa_rtv, &rh);
+    const SIZE_T rinc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    static const float clear[4] = { 0, 0, 0, 0 };
+    for (int p = 0; p < 3; p++) {
+        D3D12_CPU_DESCRIPTOR_HANDLE h = p < 2 ? rh : off_rt_rtv(rt);
+        if (p < 2) {
