+        "#define SMAA_CUSTOM_SL 1%c#define SMAA_PRESET_HIGH 1%c"
+        "#define SMAA_RT_METRICS float4(1.0 / %u.0, 1.0 / %u.0, %u.0, %u.0)%c"
+        "SamplerState PointSampler : register(s0); SamplerState LinearSampler : register(s1);%c"
+        "#define SMAATexture2D(tex) Texture2D tex%c#define SMAATexturePass2D(tex) tex%c"
+        "#define SMAASampleLevelZero(tex, coord) tex.SampleLevel(LinearSampler, coord, 0)%c"
+        "#define SMAASampleLevelZeroPoint(tex, coord) tex.SampleLevel(PointSampler, coord, 0)%c"
+        "#define SMAASampleLevelZeroOffset(tex, coord, offset) tex.SampleLevel(LinearSampler, coord, 0, offset)%c"
+        "#define SMAASample(tex, coord) tex.Sample(LinearSampler, coord)%c"
+        "#define SMAASamplePoint(tex, coord) tex.Sample(PointSampler, coord)%c"
+        "#define SMAASampleOffset(tex, coord, offset) tex.Sample(LinearSampler, coord, offset)%c"
+        "#define SMAA_FLATTEN [flatten]%c#define SMAA_BRANCH [branch]%c",
