+     * guest has requested so far) put the draw on the same timeline as the SPU
+     * job's PUTs: how many flips after the draw the vertices arrive says how
+     * far behind the real RSX must run (jstars-notes VFX.md). */
+    { extern unsigned long long ps3_ms_now(void); extern u32 cellGcm_flip_request_count(void);
+      extern void cellGcm_fifo_queued(int* flips, u32* bytes);
+      int qf = 0; u32 qb = 0; cellGcm_fifo_queued(&qf, &qb);
+      /* queued_flips: complete frames the guest has already put after this
+       * draw. 0-1 = the walker keeps up; 2 = it is two frames behind. */
+      fprintf(stderr, "[VPCODE] #%d ms=%llu flip=%u queued_flips=%d queued_bytes=%u%c", nprinted, ps3_ms_now(),
+              cellGcm_flip_request_count(), qf, qb, 10); }
+    fprintf(stderr, "[VPCODE] #%d f=%llu %s prim=%u first=%u count=%u fp=0x%X code=0x%08X tex0=0x%X divider_op=0x%08X"
+                    " vp_start=%u base_off=0x%X base_idx=%u%c", nprinted, (unsigned long long)s_d3d.frame_count,
+            call, primitive, first, count, fp, code, s_d3d.cur_texs[0].raw, st->frequency_divider_op,
+            st->transform_program_start, st->vertex_data_base_offset, st->vertex_data_base_index, 10);
