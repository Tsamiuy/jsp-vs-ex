+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f[3]; float2 px; SMAABlendingWeightCalculationVS(uv, px, f); o.a = f[0]; o.b = f[1]; o.c = f[2]; o.px = px; return o; }\n",
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; float4 a : TEXCOORD1; };\n"
+        "O main(uint i : SV_VertexID) { O o; " SMAA_UV " float4 f; SMAANeighborhoodBlendingVS(uv, f); o.a = f; return o; }\n" };
