+/* TEX_EXPAND=1: per-unit texture sign-expansion masks (SET_TEXTURE_ADDRESS
+ * bit 12, UNSIGNED_REMAP_BIASED) for the units a draw binds, built the way
+ * upstream ps3recomp 122690f's draw engine does. out[16] always receives the
+ * masks of every bound unit, so the [FPEXPAND] log can report them even when
+ * the feature is off. The returned PSO key is 0 unless TEX_EXPAND is on and
+ * the program either samples a biased unit or fetches with _bx2 (EXP_TEX,
+ * OPDEST bit 21); the decompiler then re-centres those fetches to -1..1. */
+static u64 dr_expand_key(const D3D12DrawRecord* dr, u8 out[16])
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("TEX_EXPAND"); on = e ? atoi(e) : 0; }
+    memset(out, 0, 16);
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!dr->fp_addr || !vm_base) return 0;
+    for (int u = 0; u < RSX_TEX_UNITS && u < 16; u++)
+        if (dr->tex[u].set)
+            out[u] = tex_mask_memo(s_expand_memo, rsx_texture_expand_mask, dr->tex[u].fmt,
+                                   dr->tex[u].ctrl1, dr->tex[u].filt, dr->tex[u].addr);
+    if (!on) return 0;
+    u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
+    if (foff == 0xFFFFFFFFu) return 0;
+    const u32 used = rsx_fp_texture_expand_units(vm_base + foff, FP_MAX_BYTES, out);
+    const u32 bx2  = rsx_fp_texture_bx2_units(vm_base + foff, FP_MAX_BYTES);
+    if (!used && !bx2) return 0;
+    u64 k = 1469598103934665603ull;
+    for (int u = 0; u < 16; u++) {
+        if (!(used & (1u << u))) out[u] = 0;      /* only the units it samples */
+        k = (k ^ out[u]) * 1099511628211ull;      /* FNV-1a over the masks */
+    }
+    return k | 1ull;                              /* non-zero: expand this draw */
+}
+
+/* How a draw's fragment program reads depth targets (SHADOW_PASSES). Per unit
+ * bound to a DepthRT's zeta offset:
+ *  - DEPTH24_D8/DEPTH16 with an ADDRESS zfunc: hardware depth comparison. The
+ *    shared decompiler emits it (rsx_fp_shadow_desc, `.r` of the bound SRV is
+ *    the stored depth), as rsx_draw_engine does.
+ *  - A8R8G8B8: the zeta bytes read back as colour (a bitcast). RSX stores Z24S8
+ *    big-endian as d[23:16], d[15:8], d[7:0], stencil, i.e. A, R, G, B of the
+ *    texel, and CONTROL1 then remaps them (J-Stars binds its cascades this way
+ *    with 0xAA93, which yields R,G,B = depth high/mid/low bytes). The sample is
+ *    rewritten to _rsx_zargbN(), which rebuilds those bytes from the depth.
+ *  - anything else (comparison layouts the decompiler rejects): a plain read,
+ *    .r = depth.
+ * key is a hash of the above; 0 = no depth target, the old shader exactly. */
+typedef struct {
+    u64 key;
+    u32 shadow_mask, bitcast_mask;
+    rsx_fp_shadow_desc shadow[16];
+    u16 remap[16];
+    u32 zonly_state;    /* depth-only op: its rsx_zstate_pack (PSO depth state) */
+    float poff_scale, poff_bias;   /* guest polygon offset for that depth state */
+} DrZInfo;
+
+/* An A8R8G8B8 view of a zeta surface with an ADDRESS zfunc is a depth
+ * comparison by default. J-Stars' character FP sums the .x of its PCF taps,
+ * i.e. it expects comparison results: read as bytes, a cleared (far) map gave
+ * .x ~ 1 everywhere and every character went black (FINDINGS §29).
+ * ZPASS_ARGB_BITCAST=1 restores the byte bitcast. (ZPASS_ARGB_CMP is now the
+ * default and has no effect.) */
+/* v4: an A8R8G8B8 view of a zeta is a byte bitcast again, as in v1 and as
+ * RPCS3 treats it; only DEPTH24_D8/DEPTH16 views compare. J-Stars' fog pass
+ * (fp 0x0FC9ED81, rsxcap_skin frame_01 op305) binds the scene zeta 0x0E960000
+ * at t0 as A8R8G8B8 with remap 0xAA93 and zfunc 4, floors the bytes and
+ * rebuilds the depth with dot(rgb, (1/256, 1/65536, 1/2^24)) -- a comparison
+ * result there blacked out the whole frame (ZETA_TARGETS=1 alone, FINDINGS
+ * §31). v1's black silhouettes with the bitcast came from the shadow lookups
+ * having no coordinates (TEX8/TEX9, fixed in v3), not from the bitcast.
+ * ZPASS_ARGB_CMP=1 = v2/v3 (compare when zfunc is set). */
+/* Units a fragment program reads with TXP (projective lookups). J-Stars reads
+ * the same kind of view -- a zeta as A8R8G8B8 with zfunc set -- two ways: the
+ * fog pass with TEX, rebuilding depth from the bytes; the materials with TXP
+ * shadow taps, summing .x as comparison results (fp 0x0FBFFFC1 and others,
+ * rsxcap_skin). So: A8R8G8B8 + zfunc + TXP = comparison, + TEX = bitcast.
+ * ZPASS_ARGB_TXP=0 = v4 (always bitcast). Walk as rsx_fp_texture_units. */
+static u32 fp_txp_units(u32 fp_addr)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!fp_addr || !vm_base) return 0;
+    { const FpInfo* fi = fp_info(fp_addr); if (fi) return fi->txp_units; }
+    const u32 off = cellGcmResolveLocated((fp_addr & 0x3u) == 1, fp_addr & ~0x3u);
+    if (off == 0xFFFFFFFFu) return 0;
+    const u8* uc = vm_base + off;
+    u32 units = 0;
+    for (u32 o = 0; o + 16 <= FP_MAX_BYTES;) {
+        const u32 w0 = rsx_fp_read_word(uc + o), w1 = rsx_fp_read_word(uc + o + 4);
+        const u32 w2 = rsx_fp_read_word(uc + o + 8), w3 = rsx_fp_read_word(uc + o + 12);
+        if (!(w2 & (1u << 31)) && ((w0 >> 24) & 63u) == 0x18u)      /* TXP */
+            units |= 1u << ((w0 >> 17) & 15u);
+        o += 16;
+        if (!(w2 & (1u << 31)) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2))
+            o += 16;                                                   /* inline constant */
+        if (w0 & 1u) break;                                            /* END */
+    }
+    return units;
+}
+static int zargb_txp(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("ZPASS_ARGB_TXP"); on = e ? atoi(e) : 1; }
+    return on;
+}
+
+static int zargb_cmp(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("ZPASS_ARGB_CMP") ? 1 : 0;
+    return on;
+}
+
+/* ZPASS_CMP_OFF=1: never hand a DepthRT to a DEPTH24_D8/DEPTH16 unit (it gets
+ * the old null view, i.e. "lit"). Isolates the comparison path when judging
+ * the hard black cast shadows on the ground (zeta v4 README). */
+static int zcmp_off(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("ZPASS_CMP_OFF") ? 1 : 0;
+    return on;
+}
+static int zunit_handoff_ok(u32 fmt, int zt)
+{
+    const u32 b = fmt & 0x9Fu;
+    if (zcmp_off() && b >= 0x90 && b <= 0x93) return 0;
+    return dt_handoff_ok(zt);
+}
+
+/* Comparison descriptor for a unit read as DEPTH24_D8 (fmt is the format byte
+ * to use). The decompiler only emits matching nearest/linear min+mag filters on
+ * one level; for anything else (a mip count > 1, a mipmapped min filter with a
+ * linear mag) it reports enabled=2, which silently degraded to a plain depth
+ * read. Approximate instead: compare with the min filter's linearity, and say
+ * so once under ZPASS_DBG. Float depth and cubes stay unsupported. */
+static void zcmp_desc(const D3D12DrawRecord* dr, int u, u32 fmt, rsx_fp_shadow_desc* sd)
+{
+    rsx_fp_shadow_desc_from_texture(sd, fmt, 2u, (u32)dr->tex[u].cube, dr->tex[u].mips,
+                                    dr->tex[u].filt, dr->tex[u].addr, dr->tex[u].ctl0);
+    /* ZPASS_CMP_SWAP=1: RSX compares the stored texel against the reference
+     * ("texel OP reference"), the reverse of GL's "reference OP texel" that
+     * the decompiler's helper implements (RPCS3 reverses the direction for
+     * texture compares too). Mirror the function so the helper computes the
+     * RSX result. Evidence: Yoshiwara's floor cascade t7 (zfunc GREATER)
+     * stores ~1 (empty map) with reference < stored, and the game reads 1 as
+     * lit -- GL order said "in shadow" (FINDINGS §44). */
+    { static int sw = -1; if (sw < 0) { const char* e = getenv("ZPASS_CMP_SWAP"); sw = e ? atoi(e) : 1; }   /* default on (ZPASS_CMP_SWAP=0 off) */
+      static const u8 mirror[8] = {0, 4, 2, 6, 1, 5, 3, 7};
+      if (sw && sd->enabled) sd->func = mirror[sd->func & 7u]; }
+    if (sd->enabled != 2) return;
+    const u32 base = fmt & 0x9Fu, minf = (dr->tex[u].filt >> 16) & 7u;
+    if (base == 0x91 || base == 0x93 || dr->tex[u].cube || sd->func == 0 || sd->func > 6) {
+        sd->enabled = 0;
+        return;
+    }
+    if (zpass_dbg()) {
+        static int _n = 0; if ((_n < 8 ? (_n++, 1) : 0))
+            fprintf(stderr, "[ZPASS] unit %d fmt 0x%02X filter 0x%08X mips %u: comparison"
+                            " approximated (single level, %s)%c", u, fmt, dr->tex[u].filt,
+                    dr->tex[u].mips, (minf == 2 || minf == 4 || minf == 6) ? "linear" : "nearest", 10);
+    }
+    sd->enabled = 1;
+    sd->linear = (u8)(minf == 2 || minf == 4 || minf == 6);
+}
+
+static void dr_z_info(const D3D12DrawRecord* dr, DrZInfo* zi)
+{
+    memset(zi, 0, sizeof *zi);
+    if (!zpass_on() && !zeta_targets_on()) return;
+    const u32 txp = fp_txp_units(dr->fp_addr);
+    for (int u = 0; u < RSX_TEX_UNITS && u < 16; u++) {
+        if (!dr->tex[u].set || !zunit_handoff_ok(dr->tex[u].fmt, dt_find(dr->tex[u].raw))) continue;
+        const u32 base = dr->tex[u].fmt & 0x9Fu;
+        if (base >= 0x90 && base <= 0x93) {
+            rsx_fp_shadow_desc sd;
+            zcmp_desc(dr, u, dr->tex[u].fmt, &sd);
+            if (sd.enabled == 1) { zi->shadow[u] = sd; zi->shadow_mask |= 1u << u; }
+        } else if (base == 0x85 && ((dr->tex[u].addr >> 28) & 15u) &&
+                   (zargb_cmp() || (zargb_txp() && ((txp >> u) & 1u)))) {
+            /* A8R8G8B8 view + zfunc: compared like DEPTH24_D8 (see zargb_cmp). */
+            rsx_fp_shadow_desc sd;
+            zcmp_desc(dr, u, 0x90u | (dr->tex[u].fmt & 0x60u), &sd);
+            if (sd.enabled == 1) { zi->shadow[u] = sd; zi->shadow_mask |= 1u << u; }
+        } else if (base == 0x85) {
+            zi->bitcast_mask |= 1u << u;
+            zi->remap[u] = (u16)(dr->tex[u].ctrl1 & 0xFFFFu);
+        }
+    }
+    /* A depth-only op's PSO also carries the guest depth state. */
+    if (dr_is_zonly(dr)) zi->zonly_state = dr->zstate ? dr->zstate : 0x133u;  /* LEQUAL, test+write */
+    /* ZETA_TARGETS: a colour op whose depth is kept across switches must use
+     * the guest's own depth test and write mask. With the shared buffer every
+     * op got LESS_EQUAL + write against a buffer cleared at each switch, so
+     * 2D quads drawn "with depth off" were harmless. Against kept depth they
+     * wrote their quad's depth, and the next frame's scene failed the test
+     * there: the logo boxes, the stale subtitle and the blocky patches
+     * (FINDINGS §31). ZETA_FORCED_DEPTH=1 = the forced state (v1). */
+    else if (zeta_targets_on() && dr->rt_off && dr->zt_off && dt_find(dr->zt_off) >= 0) {
+        static int forced = -1;
+        if (forced < 0) forced = getenv("ZETA_FORCED_DEPTH") ? 1 : 0;
+        /* v3: the guest's test enable and write mask (what fixed the HUD
+         * boxes), but the function stays LESS_EQUAL as in v1, under which the
+         * water rendered; ZETA_GUEST_FUNC=1 uses the guest function too (v2). */
+        static int gfunc = -1;
+        if (gfunc < 0) gfunc = getenv("ZETA_GUEST_FUNC") ? 1 : 0;
+        if (!forced) {
+            const u32 zs = dr->zstate ? dr->zstate : 0x133u;
+            zi->zonly_state = gfunc ? zs : ((zs & ~0x70u) | (3u << 4));
+        }
+    }
+    /* The guest polygon offset goes with its depth state (casters' bias
+     * against self-shadowing; ZPASS_NO_POLYOFFSET=1 = none, as before). */
+    { static int npo = -1; if (npo < 0) npo = getenv("ZPASS_NO_POLYOFFSET") ? 1 : 0;
+      if (zi->zonly_state && !npo) { zi->poff_scale = dr->poff_scale; zi->poff_bias = dr->poff_bias; } }
+    if (!zi->shadow_mask && !zi->bitcast_mask && !zi->zonly_state) return;
+    u64 k = 1469598103934665603ULL;
+    const u8* p = (const u8*)zi + sizeof zi->key;   /* everything after key */
+    for (size_t i = 0; i < sizeof *zi - sizeof zi->key; i++) {
+        k ^= p[i]; k *= 1099511628211ULL;
+    }
+    zi->key = k ? k : 1;
+}
