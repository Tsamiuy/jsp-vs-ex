+/* ---------------------------------------------------------------------------
+ * Per-draw fetch plan.
+ *
+ * rsx_fetch_attrib re-derives everything per vertex and per attribute: the
+ * env switches, the frequency rule, the context-DMA resolve through
+ * cellGcmSys. A J-Stars match frame pushes ~400k vertices through it, all 16
+ * attributes each, and that was 85-96% of the frame (FINDINGS §19).
+ *
+ * The plan does that work once per draw and keeps only the attributes the
+ * vertex program reads. Conversion rules are rsx_fetch_attrib's, unchanged:
+ * the same constant-register default, base offset/index, divider, LOCAL vs
+ * MAIN resolve and type decode.
+ *
+ * Attributes outside `mask` are written as zero: the caller's vertex
+ * layout keeps their slot, and the shader never reads it. Every vertex is
+ * stored whole (256 contiguous bytes), because the destination is usually
+ * write-combined upload-heap memory.
+ * -------------------------------------------------------------------------*/
+typedef struct rsx_fetch_plan_attr {
+    u32 aoff;      /* (array offset & 0x7FFFFFFF) + SET_VERTEX_DATA_BASE_OFFSET */
+    u32 stride;
+    u32 freq;      /* > 1: divider applies                                    */
+    u8  idx;       /* attribute register                                      */
+    u8  type;
+    u8  n;         /* components supplied, 1..4                               */
+    u8  main;      /* 1 = MAIN (IO table), 0 = LOCAL (VRAM)                   */
+    u8  modulo;    /* divider op: 1 = vi % freq, 0 = vi / freq                */
+} rsx_fetch_plan_attr;
+
+typedef struct rsx_fetch_plan {
+    u32   mask;        /* attributes written per vertex                   */
+    u32   base_index;  /* SET_VERTEX_DATA_BASE_INDEX (0 under RSX_VBASE_OFF) */
+    u32   local_base;  /* cellGcmResolveLocated(1, 0)                     */
+    u8    nconst, nfetch;
+    u8    const_idx[16];              /* in mask, read from the register */
+    rsx_fetch_plan_attr fetch[16];    /* in mask, read from guest memory */
+    float konst[16][4];               /* vertex_data4f snapshot          */
+    u8    dedup;                      /* reuse a just-decoded vertex     */
+} rsx_fetch_plan;
+
+/* Build the plan for the current state. `mask` = attributes the vertex
+ * program reads (0xFFFF = all, the old behaviour). Not thread-safe (it runs
+ * the one-time env/debug checks); the plan itself is read-only afterwards
+ * and may be shared by any number of threads. */
+void rsx_fetch_plan_init(const rsx_state* st, u32 mask, rsx_fetch_plan* plan);
+
+/* How output vertex positions map to the draw's source positions. The VP
+ * paths expand quads/strips/fans to triangle lists, so output o is not
+ * source o. */
+enum {
+    RSX_FETCH_LIST = 0,     /* o                                          */
+    RSX_FETCH_QUADS,        /* quad q -> 0,1,2, 0,2,3                     */
+    RSX_FETCH_STRIP,        /* tri t -> t, t+1, t+2                       */
+    RSX_FETCH_STRIP_SWAP,   /* as STRIP, odd triangles swap the last two  */
+    RSX_FETCH_FAN,          /* tri t -> 0, t+1, t+2                       */
+    RSX_FETCH_VLIST         /* vlist[o]: guest vertex indices, prebuilt   */
+};
+
+typedef struct rsx_fetch_src {
+    u32       first;   /* first index / vertex of the draw                     */
+    u8        topo;    /* RSX_FETCH_*                                          */
+    u8        isize;   /* 0 = non-indexed (vi = first + src), 2 = u16, 4 = u32 */
+    const u8* ib;      /* resolved index array (big-endian), when indexed      */
+    const u32* vlist;  /* RSX_FETCH_VLIST: one guest vertex index per output   */
+} rsx_fetch_src;
+
+/* Fetch output vertices [o0, o1) into out, vertex o at out + o*16 (16
+ * float4 slots per vertex). Thread-safe: disjoint ranges of one draw can
+ * run concurrently.
+ *
+ * Expanded strips and quads name the same guest vertex in up to three
+ * consecutive triangles. Decoding is a pure function of the guest bytes, so
+ * a vertex decoded a few outputs ago is copied instead of decoded again
+ * (the last 4 distinct indices are kept). VFETCH_NODEDUP=1 decodes every
+ * output. */
+void rsx_fetch_plan_range(const rsx_fetch_plan* plan, const rsx_fetch_src* src,
+                          u32 o0, u32 o1, float (*out)[4]);
+
+/* Guest vertex index of output position o (applies topo and the index
+ * array). Exposed for the debug paths and tests. */
+u32 rsx_fetch_src_vertex(const rsx_fetch_src* src, u32 o);
+
 #ifdef __cplusplus
 }
 #endif
