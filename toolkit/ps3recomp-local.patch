+/* ---------------------------------------------------------------------------
+ * Per-draw fetch plan (see rsx_vertex_fetch.h)
+ * -------------------------------------------------------------------------*/
+
+void rsx_fetch_plan_init(const rsx_state* st, u32 mask, rsx_fetch_plan* plan)
+{
+    memset(plan, 0, sizeof *plan);
+    plan->mask = mask & 0xFFFFu;
+    const int vboff = vbase_off();
+    const int nofreq = vp_nofreq();
+    vbase_dbg(st);
+    plan->base_index = vboff ? 0u : st->vertex_data_base_index;
+    plan->local_base = cellGcmResolveLocated(1, 0);
+    { static int nodedup = -1;
+      if (nodedup < 0) nodedup = getenv("VFETCH_NODEDUP") ? 1 : 0;
+      plan->dedup = nodedup ? 0 : 1; }
+    memcpy(plan->konst, st->vertex_data4f, sizeof plan->konst);
+    for (int i = 0; i < 16; i++) {
+        if (!(plan->mask & (1u << i))) continue;
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || a->stride == 0 || !vm_base) {
+            plan->const_idx[plan->nconst++] = (u8)i;
+            continue;
+        }
+        rsx_fetch_plan_attr* f = &plan->fetch[plan->nfetch++];
+        f->idx    = (u8)i;
+        f->aoff   = (vboff ? 0u : st->vertex_data_base_offset) + (a->offset & 0x7FFFFFFFu);
+        f->stride = a->stride;
+        f->freq   = (a->frequency > 1 && !nofreq) ? a->frequency : 0u;
+        f->modulo = (st->frequency_divider_op & (1u << i)) ? 1 : 0;
+        f->main   = (a->offset & 0x80000000u) ? 1 : 0;
+        f->type   = (u8)a->type;
+        u32 n = a->size ? a->size : 4; if (n > 4) n = 4;
+        f->n      = (u8)n;
+        if (f->type < 1 || f->type > 7) {   /* same report as rsx_fetch_attrib */
+            static int t = -1; if (t < 0) t = getenv("VTX_TYPEDBG") ? 1 : 0;
+            if (t) { static u32 seen = 0;
+                if (!(seen & (1u << (a->type & 31)))) { seen |= 1u << (a->type & 31);
+                    fprintf(stderr, "[VTXTYPE] UNHANDLED type=%u attr=%d size=%u stride=%u\n",
+                            a->type, i, a->size, a->stride); } }
+        }
+    }
+}
+
+u32 rsx_fetch_src_vertex(const rsx_fetch_src* src, u32 o)
+{
+    u32 s;
+    if (src->topo == RSX_FETCH_VLIST) return src->vlist[o];
+    switch (src->topo) {
+    case RSX_FETCH_QUADS: {
+        static const u8 q6[6] = {0,1,2, 0,2,3};
+        s = (o / 6u) * 4u + q6[o % 6u];
+        break; }
+    case RSX_FETCH_STRIP:
+    case RSX_FETCH_STRIP_SWAP:
+    case RSX_FETCH_FAN: {
+        const u32 t = o / 3u, j = o % 3u;
+        if (j == 0)      s = (src->topo == RSX_FETCH_FAN) ? 0u : t;
+        else if (src->topo == RSX_FETCH_STRIP_SWAP && (t & 1u))
+                         s = (j == 1) ? t + 2u : t + 1u;
+        else             s = t + j;
+        break; }
+    default:
+        s = o;
+        break;
+    }
+    const u32 k = src->first + s;
+    if (src->isize == 2) {
+        const u8* q = src->ib + (u64)k * 2;
+        return ((u32)q[0] << 8) | q[1];
+    }
+    if (src->isize == 4) {
+        const u8* q = src->ib + (u64)k * 4;
+        return ((u32)q[0] << 24) | ((u32)q[1] << 16) | ((u32)q[2] << 8) | q[3];
+    }
+    return k;
+}
+
+static inline u32 rd_be16(const u8* p) { return ((u32)p[0] << 8) | p[1]; }
+
+/* Copy n float4 slots out: non-temporal 16-byte stores when the target is
+ * aligned (they stream into write-combined memory without reading it or
+ * polluting the cache), plain memcpy otherwise. */
+#if defined(__SSE2__) || defined(_M_X64) || defined(_M_AMD64)
+#include <emmintrin.h>
+static void rsx_fetch_store(float (*dst)[4], const float* src, u32 n, int aligned)
+{
+    if (!aligned) { memcpy(dst, src, (size_t)n * 16u); return; }
+    float* d = &dst[0][0];
+    for (u32 i = 0; i < n; i++) _mm_stream_ps(d + i * 4, _mm_load_ps(src + i * 4));
+}
+static void rsx_fetch_store_fence(void) { _mm_sfence(); }
+#else
+static void rsx_fetch_store(float (*dst)[4], const float* src, u32 n, int aligned)
+{
+    (void)aligned; memcpy(dst, src, (size_t)n * 16u);
+}
+static void rsx_fetch_store_fence(void) {}
+#endif
+
+/* Decode one vertex into v (16 float4 slots, cached memory). */
+static void rsx_fetch_plan_vertex(const rsx_fetch_plan* plan, u32 vi, float (*v)[4],
+                                  u32 page[16], u32 page_ea[16])
+{
+    for (u32 c = 0; c < plan->nconst; c++) {
+        const u32 i = plan->const_idx[c];
+        memcpy(v[i], plan->konst[i], 16);
+    }
+    for (u32 c = 0; c < plan->nfetch; c++) {
+        const rsx_fetch_plan_attr* f = &plan->fetch[c];
+        const float* k4 = plan->konst[f->idx];
+
+        u32 ei = (vi + plan->base_index) & 0x000FFFFFu;
+        if (f->freq) ei = f->modulo ? (vi % f->freq) : (vi / f->freq);
+        const u32 off = f->aoff + ei * f->stride;
+
+        u32 ea;
+        if (f->main) {
+            const u32 pg = off >> 20;
+            if (pg != page[c]) { page[c] = pg; page_ea[c] = cellGcmResolveLocated(0, pg << 20); }
+            ea = page_ea[c] + (off & 0xFFFFFu);
+        } else {
+            ea = plan->local_base + off;
+        }
+        const u8* p = vm_base + ea;
+        const u32 n = f->n;
+
+        /* Components the array does not supply keep the register value. */
+        float* t = v[f->idx];
+        t[0] = k4[0]; t[1] = k4[1]; t[2] = k4[2]; t[3] = k4[3];
+        switch (f->type) {
+        case 2: /* F: float32 BE */
+            for (u32 k = 0; k < n; k++) t[k] = rsx_rd_bef(p + k * 4);
+            break;
+        case 3: /* SF: half BE */
+            for (u32 k = 0; k < n; k++) t[k] = rsx_rd_half_be(p + k * 2);
+            break;
+        case 4: /* UB: u8 normalized */
+            for (u32 k = 0; k < n; k++) t[k] = p[k] / 255.0f;
+            break;
+        case 1: /* S1: s16 normalized */
+            for (u32 k = 0; k < n; k++) t[k] = (float)(s16)rd_be16(p + k * 2) / 32767.0f;
+            break;
+        case 5: /* S32K: s16 integer */
+            for (u32 k = 0; k < n; k++) t[k] = (float)(s16)rd_be16(p + k * 2);
+            break;
+        case 7: /* UB256: u8 unnormalized */
+            for (u32 k = 0; k < n; k++) t[k] = (float)p[k];
+            break;
+        case 6: { /* CMP: signed 11/11/10, w = 1 */
+            const u32 w = ((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | (u32)p[3];
+            s32 x = (s32)(w & 0x7FFu);          if (x & 0x400) x -= 0x800;
+            s32 y = (s32)((w >> 11) & 0x7FFu);  if (y & 0x400) y -= 0x800;
+            s32 z = (s32)((w >> 22) & 0x3FFu);  if (z & 0x200) z -= 0x400;
+            t[0] = (float)x / 1023.0f;
+            t[1] = (float)y / 1023.0f;
+            t[2] = (float)z / 511.0f;
+            t[3] = 1.0f;
+            break; }
+        default:
+            for (u32 k = 0; k < n; k++) t[k] = rsx_rd_bef(p + k * 4);
+            break;
+        }
+    }
+}
+
+void rsx_fetch_plan_range(const rsx_fetch_plan* plan, const rsx_fetch_src* src,
+                          u32 o0, u32 o1, float (*out)[4])
+{
+    if (o1 <= o0) return;
+    /* MAIN arrays resolve through the IO table one 1MB page at a time; the
+     * result is linear inside a page (cellGcmResolveIO and its
+     * cellGcmResolveOffset fallback both are), so each page is resolved once
+     * per range rather than once per component read. Per call, so ranges on
+     * different threads never share it. */
+    u32 page[16], page_ea[16];
+    for (int i = 0; i < 16; i++) { page[i] = 0xFFFFFFFFu; page_ea[i] = 0; }
+
+    /* Vertices are built in a cached staging block, then copied out whole:
+     * 256 contiguous bytes each. `out` is normally a D3D12 upload heap, i.e.
+     * write-combined memory, where the old path's scattered per-component
+     * stores (the constant default first, then each component again) each
+     * cost a bus transaction, and a skipped slot would break the line.
+     * Slots outside the mask are written as zero. */
+    enum { BLK = 32 };
+    _Alignas(16) float stage[BLK][16][4];
+    const u32 nfirst = (o1 - o0 < BLK) ? o1 - o0 : BLK;
+    memset(stage, 0, (size_t)nfirst * sizeof stage[0]);
+    const int aligned = (((uintptr_t)out) & 15u) == 0;
+
+    /* The last few distinct vertices decoded, by guest index (dedup). */
+    enum { RING = 4 };
+    u32 ring_vi[RING];
+    for (int i = 0; i < RING; i++) ring_vi[i] = 0xFFFFFFFFu;
+    u32 ring_next = 0;
+    _Alignas(16) float hold[RING][16][4];    /* copies that outlive the stage block */
+
+    for (u32 b0 = o0; b0 < o1; b0 += BLK) {
+        const u32 b1 = (o1 - b0 > BLK) ? b0 + BLK : o1;
+        for (u32 o = b0; o < b1; o++) {
+            const u32 vi = rsx_fetch_src_vertex(src, o);
+            if (plan->dedup) {
+                int hit = -1;
+                for (int r = 0; r < RING; r++) if (ring_vi[r] == vi) { hit = r; break; }
+                if (hit >= 0) {
+                    memcpy(stage[o - b0], hold[hit], sizeof stage[0]);
+                    continue;
+                }
+            }
+            rsx_fetch_plan_vertex(plan, vi, stage[o - b0], page, page_ea);
+            if (plan->dedup) {
+                const u32 r = ring_next++ % RING;
+                ring_vi[r] = vi;
+                memcpy(hold[r], stage[o - b0], sizeof stage[0]);
+            }
+        }
+        rsx_fetch_store(out + (u64)b0 * 16u, &stage[0][0][0], (b1 - b0) * 16u, aligned);
+    }
+    rsx_fetch_store_fence();
+}
