+unsigned cellOskDialog_overlay_gen(void) { return (unsigned)s_ov_gen; }
+int cellOskDialog_overlay_sel(void) { return (int)s_ov_sel; }
+int cellOskDialog_overlay_mode(void) { return (int)s_ov_mode; }
+const wchar_t* cellOskDialog_choice_label(int b) { return s_choice_label[b ? 1 : 0]; }
+
+void cellOskDialog_overlay_get(wchar_t* prompt, int pmax, wchar_t* text, int tmax)
+{
+    AcquireSRWLockShared(&s_ov_lock);
+    wcsncpy(prompt, s_osk_title, (size_t)pmax - 1); prompt[pmax - 1] = 0;
+    wcsncpy(text, s_ov_text, (size_t)tmax - 1);     text[tmax - 1] = 0;
+    ReleaseSRWLockShared(&s_ov_lock);
+}
+
+static void osk_overlay_finish(s32 result)
+{
+    if (s_ov_mode != 0) {   /* confirmation or choice: report the answer, no OSK events */
+        InterlockedExchange(&s_confirm_result, result == CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK ? 1 : 0);
+        InterlockedExchange(&s_ov_active, 0);
+        InterlockedExchange(&s_ov_mode, 0);
+        InterlockedIncrement(&s_ov_gen);
+        return;
+    }
+    AcquireSRWLockExclusive(&s_ov_lock);
+    if (result == CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK) {
+        for (u32 i = 0; i <= s_ov_len; i++) s_result_text[i] = (CellOskDialogChar)s_ov_text[i];
+        s_result_length = s_ov_len;
+        if (!s_ov_len) result = CELL_OSK_DIALOG_INPUT_FIELD_RESULT_NO_INPUT_TEXT;
+    }
+    s_osk_result = result;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_ov_active, 0);
+    InterlockedIncrement(&s_ov_gen);
+    InterlockedExchange(&s_osk_state, 2);    /* FINISHED goes out on the next poll */
+}
+
+/* A typed character (UTF-16). */
+void cellOskDialog_overlay_char(unsigned ch)
+{
+    if (!s_ov_active || s_ov_mode != 0 || ch < 0x20 || ch == 0x7F) return;
+    AcquireSRWLockExclusive(&s_ov_lock);
+    if (s_ov_len < s_osk_limit && s_ov_len < CELL_OSK_MAX_TEXT_LENGTH) {
+        s_ov_text[s_ov_len++] = (wchar_t)ch; s_ov_text[s_ov_len] = 0; }
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedIncrement(&s_ov_gen);
+}
+
+/* A key press: Enter presses the highlighted button (OK or Cancel), Left/Right/
+ * Tab move the highlight, Esc cancels, Backspace deletes. Returns 1 when the key
+ * belongs to the panel. */
+static ULONGLONG s_confirm_opened;   /* GetTickCount64 when the Yes/No box opened */
+int cellOskDialog_overlay_key(unsigned vk)
+{
+    if (!s_ov_active) return 0;
+    /* The Enter that opened the Yes/No box (a pad poll saw it as START) can
+     * reach the window afterwards; it must not answer the box at once. */
+    if (vk == VK_RETURN && s_ov_mode != 0 && GetTickCount64() - s_confirm_opened < 400) return 1;
+    if (vk == VK_ESCAPE && s_ov_mode == 2) {   /* a choice: backing out is its own answer */
+        InterlockedExchange(&s_confirm_result, 2);
+        InterlockedExchange(&s_ov_active, 0);
+        InterlockedExchange(&s_ov_mode, 0);
+        InterlockedIncrement(&s_ov_gen);
+        return 1;
+    }
+    if (vk == VK_RETURN) {
+        osk_overlay_finish(s_ov_sel ? CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED
+                                    : CELL_OSK_DIALOG_INPUT_FIELD_RESULT_OK);
+        return 1;
+    }
+    if (vk == VK_LEFT || vk == VK_RIGHT || vk == VK_TAB) {
+        InterlockedExchange(&s_ov_sel, vk == VK_LEFT ? 0 : vk == VK_RIGHT ? 1 : !s_ov_sel);
+        InterlockedIncrement(&s_ov_gen);
+        return 1;
+    }
+    if (vk == VK_ESCAPE) { osk_overlay_finish(CELL_OSK_DIALOG_INPUT_FIELD_RESULT_CANCELED); return 1; }
+    if (vk == VK_BACK && s_ov_mode == 0) {
+        AcquireSRWLockExclusive(&s_ov_lock);
+        if (s_ov_len) s_ov_text[--s_ov_len] = 0;
+        ReleaseSRWLockExclusive(&s_ov_lock);
+        InterlockedIncrement(&s_ov_gen);
+    }
+    return 1;
+}
+
+static void osk_overlay_open(void)
+{
+    AcquireSRWLockExclusive(&s_ov_lock);
+    s_ov_len = 0;
+    for (; s_ov_len < s_result_length && s_ov_len < s_osk_limit; s_ov_len++)
+        s_ov_text[s_ov_len] = (wchar_t)s_result_text[s_ov_len];
+    s_ov_text[s_ov_len] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_ov_sel, 0);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+}
+/* Open the panel as a Yes/No question (No highlighted). 0 if a panel is up. */
+int cellOskDialog_confirm_open(const wchar_t* prompt)
+{
+    if (s_ov_active) return 0;
+    s_confirm_opened = GetTickCount64();
+    AcquireSRWLockExclusive(&s_ov_lock);
+    wcsncpy(s_osk_title, prompt, CELL_OSK_MAX_TEXT_LENGTH);
+    s_osk_title[CELL_OSK_MAX_TEXT_LENGTH] = 0;
+    s_ov_len = 0; s_ov_text[0] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_confirm_result, -1);
+    InterlockedExchange(&s_ov_sel, 1);
+    InterlockedExchange(&s_ov_mode, 1);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+    return 1;
+}
+/* Open the panel as a choice between two buttons (the left one highlighted).
+ * The answer comes from cellOskDialog_confirm_poll: 1 left, 0 right, 2 back. */
+int cellOskDialog_choice_open(const wchar_t* prompt, const wchar_t* left, const wchar_t* right)
+{
+    if (s_ov_active) return 0;
+    s_confirm_opened = GetTickCount64();
+    AcquireSRWLockExclusive(&s_ov_lock);
+    wcsncpy(s_osk_title, prompt, CELL_OSK_MAX_TEXT_LENGTH);
+    s_osk_title[CELL_OSK_MAX_TEXT_LENGTH] = 0;
+    wcsncpy(s_choice_label[0], left, 39);  s_choice_label[0][39] = 0;
+    wcsncpy(s_choice_label[1], right, 39); s_choice_label[1][39] = 0;
+    s_ov_len = 0; s_ov_text[0] = 0;
+    ReleaseSRWLockExclusive(&s_ov_lock);
+    InterlockedExchange(&s_confirm_result, -1);
+    InterlockedExchange(&s_ov_sel, 0);
+    InterlockedExchange(&s_ov_mode, 2);
+    InterlockedExchange(&s_ov_active, 1);
+    InterlockedIncrement(&s_ov_gen);
+    return 1;
+}
+/* -1 while open (or never opened), else 1 Yes / 0 No (choice: 1 / 0 / 2), once. */
+int cellOskDialog_confirm_poll(void)
+{
+    return (int)InterlockedExchange(&s_confirm_result, -1);
+}
+#else
+int cellOskDialog_overlay_active(void) { return 0; }
+int cellOskDialog_overlay_sel(void) { return 0; }
+int cellOskDialog_overlay_mode(void) { return 0; }
+int cellOskDialog_confirm_open(const wchar_t* prompt) { (void)prompt; return 0; }
+int cellOskDialog_choice_open(const wchar_t* prompt, const wchar_t* left, const wchar_t* right)
+{ (void)prompt; (void)left; (void)right; return 0; }
+int cellOskDialog_confirm_poll(void) { return -1; }
+#endif
