+            if (a->frequency > 1)
+                ei = (st->frequency_divider_op & (1u << i)) ? (vi % a->frequency) : (vi / a->frequency);
+            const u32 ao = st->vertex_data_base_offset + (a->offset & 0x7FFFFFFFu) + ei * a->stride;
+            const u8* q = vm_base + ((a->offset & 0x80000000u) ? cellGcmResolveLocated(0, ao)
+                                                                : cellGcmResolveLocated(1, ao));
+            if (v == 0 && vp_code_later_n() >= 0 && s_vpl_n < 256) {
+                int first_attr = 1;
+                for (int k = 0; k < i; k++) if (st->vertex_attribs[k].enabled) first_attr = 0;
+                if (first_attr) {
+                    s_vpl[s_vpl_n].id = (u32)nprinted; s_vpl[s_vpl_n].frame = s_d3d.frame_count;
+                    s_vpl[s_vpl_n].ea = (u32)(q - vm_base); s_vpl_n++;
+                }
+            }
+            /* VP_CODE_GUARD=1: page-guard the first logged draw's first vertex,
+             * so every later write into that 4 KB page -- PPU stores, the lifted
+             * dcbz (inline memset) and vector stores, host memsets, SPU DMA --
+             * is logged with its writer and the flip count (ppu_guard_page).
+             * The beam's quads are written by the SPU two flips before the draw
+             * and are zero by the time it is decoded (jstars-notes VFX.md). */
+            if (v == 0 && i == 0) {
+                static int gd = -1, armed = 0;
+                if (gd < 0) gd = getenv("VP_CODE_GUARD") ? 1 : 0;
+                if (gd && !armed) {
+                    extern void ppu_guard_page(u32 guest_ea);
+                    armed = 1;
+                    fprintf(stderr, "[VPCODE] guarding the page of 0x%08X (draw #%d)%c", (u32)(q - vm_base), nprinted, 10);
+                    ppu_guard_page((u32)(q - vm_base));
+                }
+            }
+            fprintf(stderr, "[VPCODE]     v%u (index %u, element %u) ea=0x%08X bytes:", v, vi, ei, (u32)(q - vm_base));
+            for (u32 b = 0; b < 16 && b < (a->stride ? a->stride : 16u); b++) fprintf(stderr, " %02X", q[b]);
+            fprintf(stderr, "%c", 10);
+        }
+    }
+    /* The vertex program, once per distinct program (same start-slot rules as vp_get_vs). */
+    {
+        extern int rsx_vp_decompile(const uint8_t*, u32, char*, u32);
+        if (st->vp_ucode_bytes < 16) return;
+        u32 vstart = st->transform_program_start * 16u;
+        if (vstart >= st->vp_ucode_bytes) vstart = 0;
+        const u8* vuc = st->vp_ucode + vstart;
+        u32 vlen = st->vp_ucode_bytes - vstart;
+        { u32 ninstr = rsx_vp_program_size_instrs(vuc, vlen); if (ninstr) vlen = ninstr * 16u; }
+        const u32 vh = vp_hash_ucode(vuc, vlen);
+        static u32 seen[16]; static int ns = 0;
+        for (int i = 0; i < ns; i++) if (seen[i] == vh) return;
+        if (ns >= 16) return;
+        seen[ns++] = vh;
