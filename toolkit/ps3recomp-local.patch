+/* May a texture unit bound at this DepthRT's offset sample it? Only when it
+ * holds real depth: a colour pass's zeta (ZETA_TARGETS), or a map the shadow
+ * casters drew (SHADOW_PASSES). v2 handed off every DepthRT, including the
+ * shadow cascades that only ever got the game's clears (the casters are not
+ * drawn without SHADOW_PASSES), and Ace turned into a black silhouette.
+ * ZETA_HANDOFF_ALL=1 = v2. */
+static int dt_handoff_ok(int zt)
+{
+    static int all = -1;
+    if (all < 0) all = getenv("ZETA_HANDOFF_ALL") ? 1 : 0;
+    if (zt < 0) return 0;
+    if (all) return 1;
+    return s_zrt[zt].color_used || (s_zrt[zt].cast && zpass_on());
+}
