+    /* Bit 4: 16-bit channels (X16, Y16_X16) re-centre on 32768/32767. */
+    if (mask && ((format & 0x9Fu) == 0x94u || (format & 0x9Fu) == 0x95u)) mask |= 0x10u;
+    return mask;
+}
