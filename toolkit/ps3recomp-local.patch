+        "Texture2D t0 : register(t0); Texture2D t1 : register(t1); Texture2D t2 : register(t2);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0, float4 a : TEXCOORD1, float4 b : TEXCOORD2, float4 c : TEXCOORD3, float2 px : TEXCOORD4) : SV_Target {\n"
+        "  float4 f[3] = { a, b, c }; return SMAABlendingWeightCalculationPS(uv, px, f, t0, t1, t2, float4(0, 0, 0, 0)); }\n",
+        "Texture2D t0 : register(t0); Texture2D t1 : register(t1);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0, float4 a : TEXCOORD1) : SV_Target {\n"
