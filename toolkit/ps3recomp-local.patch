+static u32 sf_vidx(const rsx_state* st, int indexed, u32 pos)
+{
+    return indexed ? read_guest_index(st, pos) : pos;
+}
+
+/* Expand batch [first, first+count) of the stream that starts at s_sf.start
+ * into a triangle list (one triangle per vertex, like the hardware) and fetch
+ * it into vp_vb. Returns the vertices written. */
+static u32 upload_sf_cont_vp(const rsx_state* state, int indexed, u32 prim, u32 first, u32 count)
+{
+    extern uint8_t* vm_base;
+    static u32 list[3 * 256 + 16];
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped) return 0;
+    if (!state->vertex_attribs[0].enabled) return 0;
+    if (count == 0 || count > 256) return 0;
+    const u32 start = s_sf.start;
+    u32 n = 0;
+    for (u32 v = first; v < first + count; v++) {
+        if (v < start + 2) continue;          /* no triangle ends at this vertex yet */
+        if (prim == RSX_PRIMITIVE_TRIANGLE_FAN) {
+            list[n++] = sf_vidx(state, indexed, start);
+            list[n++] = sf_vidx(state, indexed, v - 1);
+            list[n++] = sf_vidx(state, indexed, v);
+        } else {                              /* strip: same parity rule as upload_strip_vp */
+            const u32 t = v - start - 2;
+            u32 i1 = v - 1, i2 = v;
+            if (t & 1u) { u32 tmp = i1; i1 = i2; i2 = tmp; }
+            list[n++] = sf_vidx(state, indexed, v - 2);
+            list[n++] = sf_vidx(state, indexed, i1);
+            list[n++] = sf_vidx(state, indexed, i2);
+        }
+    }
+    if (!n) return 0;
+    u32 maxv = (MAX_VP_VERTICES * VP_VERT_STRIDE - s_d3d.vp_vb_offset) / VP_VERT_STRIDE;
+    if (n > maxv) n = maxv - (maxv % 3u);
+    if (!n) return 0;
+    VPSlot* out = (VPSlot*)((u8*)s_d3d.vp_vb_mapped
+        + (u64)s_d3d.vp_parity * MAX_VP_VERTICES * VP_VERT_STRIDE + s_d3d.vp_vb_offset);
+    if (vf_legacy()) {
+        for (u32 i = 0; i < n; i++) read_vp_vertex(state, list[i], &out[i * 16]);
+    } else {
+        vfa_fetch_list(state, list, n, out);
+    }
+    s_d3d.vp_vb_offset += n * VP_VERT_STRIDE;
+    return n;
+}
+
+/* Append the continuation's triangles to the previous record when they landed
+ * right behind it in vp_vb. */
+static int sf_append(u32 rec, u32 emitted, u32 first, u32 count)
+{
+    if (s_d3d.draw_count <= 0) return 0;
+    D3D12DrawRecord* pv = &s_d3d.draws[s_d3d.draw_count - 1];
+    if (pv->vb_byte_offset + pv->vertex_count * VP_VERT_STRIDE != rec) return 0;
+    pv->vertex_count += emitted;
+    s_sf.end = first + count;
+    return 1;
+}
+
+/* After a new record: a FAN (or non-indexed STRIP) batch starts a stream, or
+ * carries one on when it continued the stream but could not be appended. */
+static void sf_anchor(int indexed, u32 prim, u32 first, u32 count, int cont)
+{
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st || s_d3d.draw_count <= 0 ||
+        !(prim == RSX_PRIMITIVE_TRIANGLE_FAN || (!indexed && prim == RSX_PRIMITIVE_TRIANGLE_STRIP))) {
+        s_sf.valid = 0; return; }
+    if (!cont) s_sf.start = first;
+    s_sf.valid = 1; s_sf.indexed = indexed; s_sf.prim = prim; s_sf.end = first + count;
+    s_sf.epoch = st->begin_epoch; s_sf.fp = st->shader_program; s_sf.rec = (int)s_d3d.draw_count - 1;
+}
