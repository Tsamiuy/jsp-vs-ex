+/* Ensure a depth target exists for this zeta surface (pre-pass, before any
+ * command is recorded against it). */
+static int dt_get(u32 off, u32 w, u32 h, int scaled)
+{
+    u32 zs = scaled ? target_scale(off) : 1;
+    if (!off || !s_d3d.device) return -1;
+    if (!w) w = s_d3d.width;
+    if (!h) h = s_d3d.height;
+    if (!s_zrt_dsv_heap) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.NumDescriptors = MAX_DEPTH_RTS;
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_DSV;
+        if (FAILED(s_d3d.device->lpVtbl->CreateDescriptorHeap(
+                s_d3d.device, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_zrt_dsv_heap)))
+            return -1;
+        s_zrt_dsv_inc = s_d3d.device->lpVtbl->GetDescriptorHandleIncrementSize(
+            s_d3d.device, D3D12_DESCRIPTOR_HEAP_TYPE_DSV);
+    }
+    int i = dt_find(off);
+    if (i >= 0) {
+        /* Grow-only: one zeta can back targets of several sizes (and scales). */
+        if (s_zrt[i].w >= w && s_zrt[i].h >= h && s_zrt[i].s >= zs) { s_zrt[i].used = 1; return i; }
+        if (s_zrt[i].s > zs) zs = s_zrt[i].s;
+        if (s_zrt[i].w > w) w = s_zrt[i].w;
+        if (s_zrt[i].h > h) h = s_zrt[i].h;
+        wait_for_gpu();   /* the frame in flight may still use it (see off_rt_get) */
+        dt_release(i);
+    } else {
+        for (int k = 0; k < MAX_DEPTH_RTS && i < 0; k++) if (!s_zrt[k].res) i = k;
+        for (int k = 0; k < MAX_DEPTH_RTS && i < 0; k++) if (!s_zrt[k].used) i = k;
+        if (i < 0) return -1;
+        if (s_zrt[i].res) { wait_for_gpu(); dt_release(i); }
+    }
+    DepthRT* z = &s_zrt[i];
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0};
+    td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    td.Width = w * zs; td.Height = h * zs; td.DepthOrArraySize = 1; td.MipLevels = 1;
+    td.Format = DXGI_FORMAT_R24G8_TYPELESS; td.SampleDesc.Count = 1;
+    td.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+    D3D12_CLEAR_VALUE cv = {0};
+    cv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    cv.DepthStencil.Depth = 1.0f;
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &td,
+            D3D12_RESOURCE_STATE_DEPTH_WRITE, &cv,
+            &IID_ID3D12Resource, (void**)&z->res))) {
+        z->res = NULL;
+        return -1;
+    }
+    z->down = zs > 1 && zdown_ready();
+    D3D12_RESOURCE_DESC sd = td;
+    if (z->down) {
+        sd.Width = w; sd.Height = h; sd.Format = DXGI_FORMAT_R32_FLOAT;
+        sd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    }
+    if (FAILED(s_d3d.device->lpVtbl->CreateCommittedResource(
+            s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &sd,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL,
+            &IID_ID3D12Resource, (void**)&z->snap))) {
+        z->snap = NULL;
+        dt_release(i);
+        return -1;
+    }
+    if (z->down) {   /* t0 = the depth (R24 as unorm float), u0 = the copy */
+        D3D12_CPU_DESCRIPTOR_HANDLE ch;
+        s_d3d.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.srv_heap, &ch);
+        ch.ptr += (u64)(ZSNAP_DESC_BASE + 2 * i) * s_d3d.srv_inc;
+        D3D12_SHADER_RESOURCE_VIEW_DESC sv; memset(&sv, 0, sizeof sv);
+        sv.Format = DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+        sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sv.Texture2D.MipLevels = 1;
+        s_d3d.device->lpVtbl->CreateShaderResourceView(s_d3d.device, z->res, &sv, ch);
+        ch.ptr += s_d3d.srv_inc;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC uv; memset(&uv, 0, sizeof uv);
+        uv.Format = DXGI_FORMAT_R32_FLOAT;
+        uv.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        s_d3d.device->lpVtbl->CreateUnorderedAccessView(s_d3d.device, z->snap, NULL, &uv, ch);
+    }
+    D3D12_DEPTH_STENCIL_VIEW_DESC dv = {0};
+    dv.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    dv.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+    s_d3d.device->lpVtbl->CreateDepthStencilView(s_d3d.device, z->res, &dv, dt_dsv(i));
+    z->off = off; z->w = w; z->h = h; z->s = zs;
+    z->st = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    z->snap_st = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    z->fresh = 1; z->used = 1; z->dirty = 1;
+    z->color_used = 0; z->cast = 0;
+    if (zpass_dbg())
+        fprintf(stderr, "[ZPASS] depth target %d: zeta 0x%08X %ux%u%c", i, off, w, h, 10);
+    return i;
+}
